+def _engine_digest(binary: Path) -> Optional[str]:
+    """SHA256 hex digest of the engine binary file (G2).
+
+    Cached per process by (path, mtime_ns, size): the binary is
+    ~36 MB and version_info runs on every engine call, so hashing
+    it every time would be pure waste. Returns None when the file
+    cannot be read (e.g. executable without read permission) —
+    callers treat that as unpinned, never as pinned.
+    """
+    try:
+        st = binary.stat()
+    except OSError:
+        return None
+    key = (str(binary), st.st_mtime_ns, st.st_size)
+    if key in _DIGEST_CACHE:
+        return _DIGEST_CACHE[key]
+    try:
+        h = hashlib.sha256()
+        with open(binary, "rb") as f:
+            for chunk in iter(lambda: f.read(1 << 20), b""):
+                h.update(chunk)
+        digest = h.hexdigest()
+    except OSError:
+        digest = None
+    _DIGEST_CACHE[key] = digest
+    return digest
+
