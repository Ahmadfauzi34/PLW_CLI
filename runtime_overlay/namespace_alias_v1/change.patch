+def cmd_lease(args: List[str]) -> int:
+    """Namespace alias for the lease commands (additive; canonical names unchanged).
+
+    plw lease validation ... -> plw validation-lease ...
+    plw lease execution ... -> plw action-lease ...
+    """
+    import argparse
+    parser = argparse.ArgumentParser(prog="plw lease")
+    parser.add_argument("operation", choices=("validation", "execution"))
+    parser.add_argument("rest", nargs=argparse.REMAINDER)
+    opts = parser.parse_args(args)
+    if opts.operation == "validation":
+        return cmd_validation_lease(opts.rest)
+    return cmd_action_lease(opts.rest)
