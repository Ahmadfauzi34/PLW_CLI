+def _resolve_engine_target_files(
+    scan_root: str,
+    graph: Dict[str, Any],
+    *,
+    explicit_targets: List[str],
+    target_resolution: Dict[str, Any],
+    full_engine: bool,
+) -> Optional[List[str]]:
+    """Derive target-grounded engine scope (1-hop neighborhood) for kernel_work.
+
+    Guardrail #2: when target_resolution resolves one or more graph targets
+    without full_engine, scope the engine to resolved_targets union
+    direct_imports union direct_importers so blast-radius leads remain intact
+    while keeping large repositories fast.
+    """
+    if full_engine:
+        return None
+    resolution = (target_resolution or {}).get("resolution") or {}
+    state = str(resolution.get("state") or "")
+    selected = [str(item) for item in (resolution.get("selected_targets") or []) if item]
+    if state in ("RESOLVED", "MULTI_TARGET_RESOLVED") and selected:
+        try:
+            from core.topology_engine import _canon_rel
+        except ImportError:
+            _canon_rel = lambda p, _r: str(p).replace("\\", "/")
+        root_abs = os.path.abspath(scan_root or ".").replace("\\", "/")
+        seed_scope = {_canon_rel(item, root_abs) for item in selected}
+        for item in explicit_targets:
+            if str(item).strip():
+                seed_scope.add(_canon_rel(str(item), root_abs))
+        one_hop = set(seed_scope)
+        for edge in (graph.get("edges") or []):
+            if not isinstance(edge, (list, tuple)) or len(edge) != 2:
