+def _save_engine_cache(cache_key: str, layer: Dict[str, Any]) -> None:
+    if not layer.get("available") or layer.get("error"):
+        return
+    path = _engine_cache_path(cache_key)
+    ensure_private_directory(path.parent)
+    tmp_path: Optional[Path] = None
+    try:
+        with tempfile.NamedTemporaryFile(
