+def _rank_symbol(
+    symbol: str,
+    *,
+    engine_defined: Set[str],
+    scoped_defined: Set[str],
+    internal_defined: Set[str],
+    import_counts: Dict[str, int],
+    type_shape_names: Set[str],
+) -> int:
+    score = 0
