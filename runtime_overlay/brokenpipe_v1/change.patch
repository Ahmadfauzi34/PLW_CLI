 def main() -> None:
+    # Unix: when stdout is piped to `head` (or any reader that exits
+    # early), die silently on SIGPIPE (exit 141) instead of raising
+    # BrokenPipeError with a traceback at the print call / shutdown
+    # flush. This covers every command that prints long output to a
+    # pipe, not just `agent orient`. Guarded: SIGPIPE does not exist
+    # on Windows.
+    if hasattr(signal, "SIGPIPE"):
+        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
