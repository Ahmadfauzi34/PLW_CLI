+def _is_all_inline_type_clause(clause: str) -> bool:
+    """Return True when clause only has inline `type` specifiers inside `{ ... }` (and no non-type default import)."""
+    if not clause:
+        return False
+    named_match = re.search(r"\{([^}]+)\}", clause)
+    if not named_match:
+        return False
+    prefix = clause[:named_match.start()].strip()
+    if prefix and prefix != "type":
+        return False
+    specifiers = [item.strip() for item in named_match.group(1).split(",") if item.strip()]
+    return bool(specifiers) and all(re.match(r"^type\s+[A-Za-z0-9_$]", item) for item in specifiers)
+
