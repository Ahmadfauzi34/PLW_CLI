+_CHECK_FINDINGS_LIMIT = 100
+
+
+def _top_check_findings(
+    analyzer_output: Dict[str, Any],
+    limit: int = _CHECK_FINDINGS_LIMIT,
+) -> tuple:
+    """Flatten actionable findings for the `plw check --json` envelope.
+
+    The summary envelope used to carry only counts, so an agent had to
+    open the analyzer cache file to read a single finding — and the
+    human-readable path could never list one either, because it reads
+    the same top-level `findings` key. This returns the actionable
+    findings (critical/error/high/medium — anything at least as severe
+    as high), each tagged with its analyzer, in a deterministic order
+    (severity, analyzer, file/node, full JSON), bounded to `limit` with
+    a truncation flag. Low/info findings stay in the analyzer cache.
+    """
+    rank = {"critical": 0, "error": 0, "high": 1, "medium": 2}
+    collected = []
+    for name, result in analyzer_output.get("results", {}).items():
+        for finding in result.get("findings", []):
+            sev = finding.get("severity", "info")
+            if sev not in rank:
+                continue
+            item = dict(finding)
+            item.setdefault("analyzer", name)
+            collected.append(item)
+    collected.sort(key=lambda f: (
+        rank.get(f.get("severity", "medium"), 2),
+        f.get("analyzer", ""),
+        f.get("file", "") or f.get("node", ""),
+        json.dumps(f, sort_keys=True, ensure_ascii=False),
+    ))
+    return collected[:limit], len(collected) > limit
+
