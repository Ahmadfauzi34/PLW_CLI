+def _resolve_ast_positionals(operation, pos1, pos2, flag_root):
+    """Resolve `plw ast` positionals to (root, query, error).
+
+    Canonical form is query-first: `plw ast callers <query> [root]`,
+    with `--root DIR` as the always-explicit form. The legacy root-first
+    form (`plw ast callers <root> <query>`) keeps working: two
+    positionals always mean root-first, and a single positional that
+    names an existing directory means root (query is then missing, as
+    before). `doctor` and `index` keep the legacy order — their first
+    positional is always the root.
+    """
+    if flag_root is not None:
+        root = Path(flag_root).expanduser().resolve()
+        if pos2 is not None:
+            if operation == "index":
+                return root, None, (
+                    "plw ast index --root DIR <status|warm|clean>: "
+                    "unexpected extra argument"
+                )
+            return root, None, (
+                "plw ast <op> <query> --root DIR: unexpected extra argument"
+            )
+        return root, pos1, None
+    if operation in ("doctor", "index"):
+        root = (
+            Path(pos1).expanduser().resolve()
+            if pos1 is not None else Path(".").resolve()
+        )
+        return root, pos2, None
+    if pos2 is not None:
+        # Two positionals: legacy root-first, unchanged.
+        return Path(pos1).expanduser().resolve(), pos2, None
+    if pos1 is not None and Path(pos1).expanduser().is_dir():
+        return Path(pos1).expanduser().resolve(), None, None
+    return Path(".").resolve(), pos1, None
+
