+def _rs_function_records(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    """Discover conservative block-bodied Rust functions and methods.
+
+    Functions inside ``macro_rules!`` definitions are excluded: their bodies
+    are template text, not top-level items, and grouping them with real
+    functions would mislabel macro template duplication as code duplication.
+    """
+    records: List[Dict[str, Any]] = []
+    seen: set[Tuple[str, int]] = set()
+    declaration = re.compile(
+        r"(?P<pub>\bpub(?:\s*\([^)]*\))?\s+)?"
+        r"(?P<mods>(?:(?:async|unsafe|const|extern\s+\"[^\"]*\")\s+)*)"
+        r"\bfn\s+(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*(?:<[^;{}()]*>)?\s*\("
+    )
+    macro_def = re.compile(r"\bmacro_rules!\s*[A-Za-z_][A-Za-z0-9_]*\s*\{")
+    for rel, source, masked in sources:
+        macro_spans: List[Tuple[int, int]] = []
+        for macro_match in macro_def.finditer(masked):
+            macro_open = masked.find("{", macro_match.start(), macro_match.end())
+            macro_close = _matching_js_brace(masked, macro_open)
+            if macro_close >= 0:
+                macro_spans.append((macro_open, macro_close))
+        for match in declaration.finditer(masked):
+            if any(start <= match.start() <= end for start, end in macro_spans):
+                continue
+            params_open = masked.find("(", match.start(), match.end())
+            params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+            if params_close < 0:
+                continue
+            body_open = _rs_function_body_open(masked, params_close + 1)
+            if body_open < 0 or (rel, body_open) in seen:
+                continue
+            body_close = _matching_js_brace(masked, body_open)
+            if body_close < 0:
+                continue
+            params = _rs_simple_parameter_names(source, masked, params_open, params_close)
+            seen.add((rel, body_open))
+            name = match.group("name")
+            exported = bool(match.group("pub"))
+            mods = match.group("mods") or ""
+            records.append({
+                "file": rel, "source": source, "masked": masked, "name": name,
+                "start": match.start(), "params_open": params_open, "params_close": params_close,
+                "params": params, "body_open": body_open, "body_close": body_close,
+                "line_start": source.count("\n", 0, match.start()) + 1,
+                "line_end": source.count("\n", 0, body_close) + 1,
+                "exported": exported, "private": not exported,
+                "async": "async" in mods.split(), "form": "function",
+                "expr_start": -1, "expr_end": -1,
+            })
+    records.sort(key=lambda row: (row["file"], row["start"], row["name"]))
+    return records
+
+
+def _kt_function_records(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    """Discover Kotlin functions: block bodies and single-line ``=`` bodies."""
+    records: List[Dict[str, Any]] = []
+    seen: set[Tuple[str, int]] = set()
+    declaration = re.compile(
+        r"(?P<mods>(?:(?:public|private|protected|internal|open|override|suspend|inline|tailrec|operator|infix|external|actual|expect|abstract)\s+)*)"
+        r"fun\s+(?:<[^;{}()]*>\s*)?(?:(?P<receiver>[A-Za-z_][A-Za-z0-9_]*)\s*\.\s*)?"
+        r"(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*(?:<[^;{}()]*>)?\s*\("
+    )
+    for rel, source, masked in sources:
+        for match in declaration.finditer(masked):
+            params_open = masked.find("(", match.start(), match.end())
+            params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+            if params_close < 0:
+                continue
+            form, body_pos = _kt_function_body_open(masked, params_close + 1)
+            if form is None:
+                continue
+            if form == "block":
+                body_open = body_pos
+                body_close = _matching_js_brace(masked, body_open)
+                if body_close < 0 or (rel, body_open) in seen:
+                    continue
+                seen.add((rel, body_open))
+                expr_start = expr_end = -1
+                line_end = source.count("\n", 0, body_close) + 1
+            else:
+                expr_start = body_pos + 1
+                line_end_pos = source.find("\n", expr_start)
+                semi = masked.find(";", expr_start)
+                expr_end = len(source)
+                if line_end_pos >= 0:
+                    expr_end = min(expr_end, line_end_pos)
+                if semi >= 0:
+                    expr_end = min(expr_end, semi)
+                body_open = body_close = -1
+                line_end = source.count("\n", 0, expr_end) + 1
+                # A single-line capture can truncate a multi-line expression:
+                # ``= JSONObject()`` followed by ``.put(...)`` on the next
+                # line is a builder chain, not a forwarding call.  When the
+                # expression ended at a newline (not ``;``), peek at the next
+                # line: a leading ``.`` or infix operator continues it, so
+                # the record is not a single-line expression body in v1.
+                expr_continues = False
+                if expr_end < len(source) and source[expr_end] == "\n":
+                    nxt = _skip_js_space(masked, expr_end)
+                    if nxt < len(masked) and masked[nxt] == ".":
+                        expr_continues = True
+                    elif nxt < len(masked) and re.match(
+                        r"(?:&&|\|\||[+\-*/%]|\?:|as\b|is\b|!in\b|in\b)",
+                        masked[nxt:],
+                    ):
+                        expr_continues = True
+            params = _kt_simple_parameter_names(source, masked, params_open, params_close)
+            name = match.group("name")
+            mods = match.group("mods") or ""
+            private = "private" in mods.split()
+            records.append({
+                "file": rel, "source": source, "masked": masked, "name": name,
+                "start": match.start(), "params_open": params_open, "params_close": params_close,
+                "params": params, "body_open": body_open, "body_close": body_close,
+                "line_start": source.count("\n", 0, match.start()) + 1,
+                "line_end": line_end,
+                "exported": not private, "private": private,
+                "async": False, "form": "function" if form == "block" else "expression",
+                "expr_start": expr_start, "expr_end": expr_end,
+                "expr_continues": expr_continues if form == "expr" else False,
+            })
+    records.sort(key=lambda row: (row["file"], row["start"], row["name"]))
+    return records
+
