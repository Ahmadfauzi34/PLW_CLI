+def _mask_rs_noncode(source: str) -> str:
+    """Length-preserving conservative mask for Rust comments/strings/chars.
+
+    Lifetimes (``&'a str``) are NOT char literals: a quote is treated as a
+    char-literal start only when ``_brace_char_literal_end`` accepts it.
+    Raw strings (``r"..."`` / ``r#"..."#`` / ``br#"..."#``) are masked as a
+    unit so braces inside them never reach brace matching.  Nested block
+    comments are a known v1 limitation: only the first ``*/`` closes the
+    mask, like the JS mask's non-nested handling.
+    """
+    out, i, n = list(source), 0, len(source)
+    while i < n:
+        c = source[i]
+        if c == "/" and i + 1 < n and source[i + 1] in ("/", "*"):
+            block = source[i + 1] == "*"
+            out[i] = out[i + 1] = " "
+            i += 2
+            while i < n:
+                if block and source[i] == "*" and i + 1 < n and source[i + 1] == "/":
+                    out[i] = out[i + 1] = " "; i += 2; break
+                if not block and source[i] == "\n":
+                    break
+                if source[i] != "\n":
+                    out[i] = " "
+                i += 1
+            continue
+        # Raw string: r"..." / r#"..."# / br"..." / br#"..."#.
+        raw_start = -1
+        raw_hashes = 0
+        if c == "r" or (c == "b" and i + 1 < n and source[i + 1] == "r"):
+            j = i + 1 if c == "r" else i + 2
+            while j < n and source[j] == "#":
+                raw_hashes += 1; j += 1
+            if j < n and source[j] == '"':
+                raw_start = i
+        if raw_start >= 0:
+            closing = '"' + "#" * raw_hashes
+            close = source.find(closing, j + 1)
+            stop = n if close < 0 else close + len(closing)
+            for k in range(raw_start, stop):
+                if source[k] != "\n":
+                    out[k] = " "
+            i = stop
+            continue
+        if c == '"':
+            out[i] = " "; i += 1
+            escaped = False
+            while i < n:
+                ch = source[i]
+                if ch != "\n":
+                    out[i] = " "
+                if escaped:
+                    escaped = False
+                elif ch == "\\":
+                    escaped = True
+                elif ch == '"':
+                    i += 1; break
+                i += 1
+            continue
+        if c == "'":
+            char_end = _brace_char_literal_end(source, i, n)
+            if char_end > 0:
+                for k in range(i, char_end):
+                    if source[k] != "\n":
+                        out[k] = " "
+                i = char_end
+                continue
+            i += 1
+            continue
+        i += 1
+    return "".join(out)
+
