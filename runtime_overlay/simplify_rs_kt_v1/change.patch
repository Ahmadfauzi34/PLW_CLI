+def _brace_normalized_body_tokens(source: str, start: int, end: int) -> Optional[List[str]]:
+    """Tokenize a Rust/Kotlin body conservatively for exact-structure fingerprinting.
+
+    Comments/formatting are ignored, while string/char literal bytes and
+    punctuator boundaries are preserved.  Unlike the JS tokenizer there is no
+    regex/division ambiguity: ``/`` is always division in both languages.
+    Lifetimes (``'a``) tokenize as a quote plus an identifier; char literals
+    stay one token.  Rust raw strings (``r#"..."#``) and Kotlin raw strings
+    (``\"\"\"...\"\"\"``) are consumed as single tokens.
+    """
+    tokens: List[str] = []
+    i = start
+    punctuators = (
+        "::", "->", "=>", "..=", "...", "..", "?.", "?:", "==", "!=", "<=", ">=",
+        "&&", "||", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "++", "--",
+    )
+    while i < end:
+        ch = source[i]
+        if ch.isspace():
+            i += 1; continue
+        if ch == "/" and i + 1 < end and source[i + 1] == "/":
+            newline = source.find("\n", i + 2, end)
+            i = end if newline < 0 else newline + 1; continue
+        if ch == "/" and i + 1 < end and source[i + 1] == "*":
+            close = source.find("*/", i + 2, end)
+            if close < 0: return None
+            i = close + 2; continue
+        if ch == "r" or (ch == "b" and i + 1 < end and source[i + 1] == "r"):
+            j = i + 1 if ch == "r" else i + 2
+            hashes = 0
+            while j < end and source[j] == "#":
+                hashes += 1; j += 1
+            if j < end and source[j] == '"':
+                closing = '"' + "#" * hashes
+                close = source.find(closing, j + 1, end)
+                if close < 0: return None
+                tokens.append(source[i:close + len(closing)]); i = close + len(closing); continue
+        if ch == '"' and source.startswith('"""', i, end):
+            close = source.find('"""', i + 3, end)
+            if close < 0: return None
+            tokens.append(source[i:close + 3]); i = close + 3; continue
+        if ch == '"':
+            j, escaped = i + 1, False
+            while j < end:
+                current = source[j]
+                if escaped:
+                    escaped = False
+                elif current == "\\":
+                    escaped = True
+                elif current == '"':
+                    j += 1; break
+                j += 1
+            if j > end: return None
+            tokens.append(source[i:j]); i = j; continue
+        if ch == "'":
+            char_end = _brace_char_literal_end(source, i, end)
+            if char_end > 0:
+                tokens.append(source[i:char_end]); i = char_end; continue
+            tokens.append(ch); i += 1; continue
+        ident = re.match(r"[A-Za-z_][A-Za-z0-9_]*", source[i:end])
+        if ident:
+            value = ident.group(0); tokens.append(value); i += len(value); continue
+        number = re.match(
+            r"(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d[\d_]*)?)[A-Za-z]*",
+            source[i:end],
+        )
+        if number:
+            value = number.group(0); tokens.append(value); i += len(value); continue
+        matched = next((op for op in punctuators if source.startswith(op, i)), None)
+        if matched:
+            tokens.append(matched); i += len(matched); continue
+        tokens.append(ch); i += 1
+    return tokens
+
+
+def _brace_candidate_row(
+    *, rel: str, name: str, line_start: int, line_end: int,
+    kind: str, identity: Dict[str, Any], witness: Dict[str, Any], proof_rule: str,
+    validation: List[str],
+) -> Dict[str, Any]:
+    return _candidate(
+        identity={"file": rel, "kind": kind, "function": name, "line": line_start, **identity},
+        kind=kind, files=[rel], names=[name],
+        members=[_member(rel, name, line_start, line_end, private=True)], estimated_loc=1,
+        witness=witness, proof_rule=proof_rule, validation=validation,
+    )
+
