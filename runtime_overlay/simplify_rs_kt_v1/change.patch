+def _brace_redundant_else_after_terminal_candidates(
+    *, sources: List[Tuple[str, str, str]], lang: str, records_fn,
+) -> List[Dict[str, Any]]:
+    """Find a braced ``else`` following a directly terminal ``if`` branch.
+
+    Two guards beyond the JS rule, because Rust/Kotlin ``if`` can be an
+    expression: (1) the ``if`` must be in statement position (the previous
+    non-space character is not ``= ( [ ,`` and it is not preceded by
+    ``return`` or by ``else`` for an ``else if`` chain); (2) the ``else``
+    block must not end in a bare tail expression, which would be the value
+    of an expression-position ``if``.
+    """
+    kind = f"{lang}_redundant_else_after_terminal"
+    candidates: List[Dict[str, Any]] = []
+    records_by_file: Dict[str, List[Dict[str, Any]]] = {}
+    for fn in records_fn(sources=sources):
+        records_by_file.setdefault(fn["file"], []).append(fn)
+    terminal_kinds = ("return", "throw") if lang == "kt" else ("return",)
+    terminal_pattern = r"(?:^|;)\s*(?P<kind>" + "|".join(terminal_kinds) + r")\b[\s\S]*;?\s*$"
+    for rel, source, masked in sources:
+        for match in re.finditer(r"\bif\b", masked):
+            prev = match.start() - 1
+            while prev >= 0 and masked[prev].isspace():
+                prev -= 1
+            if prev >= 0 and masked[prev] in "=([,":
+                continue
+            before = masked[max(0, match.start() - 16):match.start()]
+            if re.search(r"\breturn\s*$", before) or re.search(r"\belse\s*$", before):
+                continue
+            pos = match.end()
+            paren = bracket = angle = 0
+            then_open = -1
+            while pos < len(masked):
+                ch = masked[pos]
+                if ch == "(": paren += 1
+                elif ch == ")":
+                    if paren == 0: break
+                    paren -= 1
+                elif ch == "[": bracket += 1
+                elif ch == "]":
+                    if bracket == 0: break
+                    bracket -= 1
+                elif ch == "<": angle += 1
+                elif ch == ">" and angle: angle -= 1
+                elif ch == "{" and paren == bracket == angle == 0:
+                    then_open = pos; break
+                elif ch in ";}" and paren == bracket == angle == 0:
+                    break
+                pos += 1
+            if then_open < 0:
+                continue
+            then_close = _matching_js_brace(masked, then_open)
+            if then_close < 0:
+                continue
+            then_body = masked[then_open + 1:then_close].strip()
+            terminal = re.search(terminal_pattern, then_body)
+            if not terminal:
+                continue
+            cursor = _skip_js_space(masked, then_close + 1)
+            if not masked.startswith("else", cursor):
+                continue
+            else_open = _skip_js_space(masked, cursor + 4)
+            if else_open >= len(masked) or masked[else_open] != "{":
+                continue
+            else_close = _matching_js_brace(masked, else_open)
+            if else_close < 0:
+                continue
+            else_body = masked[else_open + 1:else_close].strip()
+            if else_body and not else_body.endswith(";") and not re.search(
+                r"\breturn\b[\s\S]*;?\s*$", else_body
+            ):
+                continue
+            line_start = source.count("\n", 0, match.start()) + 1
+            line_end = source.count("\n", 0, else_close) + 1
+            enclosing = "unknown"
+            for fn in records_by_file.get(rel, []):
+                span_end = fn["body_close"] if fn["body_open"] >= 0 else fn["expr_end"]
+                if fn["start"] <= match.start() <= span_end:
+                    enclosing = fn["name"]
+                    break
+            candidates.append(_brace_candidate_row(
+                rel=rel, name=enclosing, line_start=line_start, line_end=line_end,
+                kind=kind,
+                identity={"terminal": terminal.group("kind"), "else_line": source.count("\n", 0, cursor) + 1},
+                witness={
+                    "type": f"{lang}_redundant_else_after_terminal_v1", "same_owner_file": True,
+                    "then_block_directly_terminal": True, "terminal_kind": terminal.group("kind"),
+                    "else_is_braced": True, "else_if_excluded": True,
+                    "else_if_chain_inner_if_excluded": True,
+                    "statement_position_if_only": True, "else_block_value_free": True,
+                    "condition_evaluation_preserved": True, "else_block_scope_must_be_preserved": True,
+                    "authority": f"bounded_{lang}_structural_control_flow_witness_only",
+                },
+                proof_rule="remove only the redundant else keyword while preserving the else block as a standalone block after a directly terminal then-branch",
+                validation=[
+                    "preserve condition evaluation exactly once", "preserve else-block lexical scope braces",
+                    "preserve return/throw control flow", f"run affected {lang.upper()} tests and type-check",
+                ],
+            ))
+    return candidates
+
