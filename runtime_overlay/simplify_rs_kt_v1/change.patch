+def _rs_function_body_open(masked: str, after_params: int) -> int:
+    """Find a conservative block-body brace after a Rust parameter list.
+
+    Skips the return type and ``where`` clause.  A ``;`` at depth 0 means a
+    declaration without a body (trait method, ``extern`` block item).
+    Bracket/paren/angle depth is tracked so ``-> [u8; 3]`` never ends the
+    scan early.  Returns -1 instead of guessing.
+    """
+    pos = _skip_js_space(masked, after_params)
+    paren = bracket = angle = 0
+    while pos < len(masked):
+        ch = masked[pos]
+        if ch == "(": paren += 1
+        elif ch == ")":
+            if paren == 0: return -1
+            paren -= 1
+        elif ch == "[": bracket += 1
+        elif ch == "]":
+            if bracket == 0: return -1
+            bracket -= 1
+        elif ch == "<": angle += 1
+        elif ch == ">" and angle: angle -= 1
+        elif ch == ";" and paren == bracket == angle == 0:
+            return -1
+        elif ch == "{" and paren == bracket == angle == 0:
+            return pos
+        elif ch == "}" and paren == bracket == angle == 0:
+            return -1
+        pos += 1
+    return -1
+
+
+_KT_DECLARATION_KEYWORDS = (
+    "fun", "val", "var", "class", "object", "interface", "enum", "sealed",
+    "data", "private", "public", "protected", "internal", "open", "override",
+    "suspend", "inline", "tailrec", "operator", "infix", "external", "actual",
+    "expect", "abstract", "companion", "init", "constructor", "import", "package",
+)
