+def _kt_function_body_open(masked: str, after_params: int) -> Tuple[Optional[str], int]:
+    """Find a Kotlin function body: ("block", brace_pos) or ("expr", equals_pos).
+
+    Skips the return type.  A ``;`` or enclosing ``}`` at depth 0, or a
+    following declaration line, means a declaration without a body
+    (interface member, ``external fun``).  Expression bodies are detected
+    only when ``=`` opens them; multi-line expression bodies are not
+    resolved in v1 and fall through to the single-line capture in the
+    record builder.
+    """
+    pos = _skip_js_space(masked, after_params)
+    paren = bracket = angle = 0
+    while pos < len(masked):
+        ch = masked[pos]
+        if ch == "(": paren += 1
+        elif ch == ")":
+            if paren == 0: return None, -1
+            paren -= 1
+        elif ch == "[": bracket += 1
+        elif ch == "]":
+            if bracket == 0: return None, -1
+            bracket -= 1
+        elif ch == "<": angle += 1
+        elif ch == ">" and angle: angle -= 1
+        elif ch == ";" and paren == bracket == angle == 0:
+            return None, -1
+        elif ch == "}" and paren == bracket == angle == 0:
+            return None, -1
+        elif ch == "{" and paren == bracket == angle == 0:
+            return "block", pos
+        elif ch == "=" and paren == bracket == angle == 0:
+            if pos + 1 < len(masked) and masked[pos + 1] == "=":
+                return None, -1
+            return "expr", pos
+        elif ch == "\n" and paren == bracket == angle == 0:
+            nxt = _skip_js_space(masked, pos + 1)
+            if nxt < len(masked) and masked[nxt] in "}@":
+                return None, -1
+            keyword = re.match(
+                r"(?:" + "|".join(_KT_DECLARATION_KEYWORDS) + r")\b", masked[nxt:]
+            )
+            if keyword:
+                return None, -1
+        pos += 1
+    return None, -1
+
