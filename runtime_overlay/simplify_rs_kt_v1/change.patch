+def _mask_kt_noncode(source: str) -> str:
+    """Length-preserving conservative mask for Kotlin comments/strings/chars.
+
+    Triple-quoted raw strings (``\"\"\"...\"\"\"``) are masked as a unit so
+    braces inside them never reach brace matching.  String templates
+    (``${...}``) are masked as a whole, like JS template literals: braces
+    inside a template are hidden, so a template containing a block is a
+    known v1 limitation.  Block comments are masked non-nested, like the
+    JS mask; Kotlin block comments can nest, so a nested comment containing
+    braces is a known v1 limitation.
+    """
+    out, i, n = list(source), 0, len(source)
+    while i < n:
+        c = source[i]
+        if c == "/" and i + 1 < n and source[i + 1] in ("/", "*"):
+            block = source[i + 1] == "*"
+            out[i] = out[i + 1] = " "
+            i += 2
+            while i < n:
+                if block and source[i] == "*" and i + 1 < n and source[i + 1] == "/":
+                    out[i] = out[i + 1] = " "; i += 2; break
+                if not block and source[i] == "\n":
+                    break
+                if source[i] != "\n":
+                    out[i] = " "
+                i += 1
+            continue
+        if c == '"' and source.startswith('"""', i):
+            close = source.find('"""', i + 3)
+            stop = n if close < 0 else close + 3
+            for k in range(i, stop):
+                if source[k] != "\n":
+                    out[k] = " "
+            i = stop
+            continue
+        if c == '"':
+            out[i] = " "; i += 1
+            escaped = False
+            while i < n:
+                ch = source[i]
+                if ch != "\n":
+                    out[i] = " "
+                if escaped:
+                    escaped = False
+                elif ch == "\\":
+                    escaped = True
+                elif ch == '"':
+                    i += 1; break
+                i += 1
+            continue
+        if c == "'":
+            char_end = _brace_char_literal_end(source, i, n)
+            if char_end > 0:
+                for k in range(i, char_end):
+                    if source[k] != "\n":
+                        out[k] = " "
+                i = char_end
+                continue
+            i += 1
+            continue
+        i += 1
+    return "".join(out)
+
