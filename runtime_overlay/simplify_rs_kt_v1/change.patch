+def _brace_char_literal_end(source: str, start: int, end: int) -> int:
+    """Return the index just past a char literal starting at ``start``, or -1.
+
+    Accepts one plain character or one escape (``\\n``, ``\\x41``,
+    Rust ``\\u{41}``, Kotlin ``\\u0041``).  A lifetime (``'a``) has no
+    closing quote after one character/escape, so it returns -1 and the
+    quote stays visible instead of swallowing the rest of the file.
+    """
+    if start + 2 >= end or source[start] != "'":
+        return -1
+    j = start + 1
+    if source[j] == "\\":
+        j += 1
+        if j >= end:
+            return -1
+        esc = source[j]
+        if esc == "u":
+            if j + 1 < end and source[j + 1] == "{":
+                close = source.find("}", j + 2, end)
+                if close < 0:
+                    return -1
+                j = close + 1
+            else:
+                if j + 4 >= end:
+                    return -1
+                j += 5
+        elif esc == "x":
+            if j + 2 >= end:
+                return -1
+            j += 3
+        else:
+            j += 1
+    else:
+        j += 1
+    if j < end and source[j] == "'":
+        return j + 1
+    return -1
+
