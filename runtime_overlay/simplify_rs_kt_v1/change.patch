+def _rs_simple_parameter_names(source: str, masked: str, open_pos: int, close_pos: int) -> Optional[List[str]]:
+    """Return simple Rust parameter names or None for patterns/complex forms."""
+    code = masked[open_pos + 1:close_pos]
+    pieces = _split_top_level_commas(code)
+    if len(pieces) == 1 and not pieces[0].strip():
+        return []
+    names: List[str] = []
+    for piece in pieces:
+        token = piece.strip()
+        if not token:
+            return None
+        if re.fullmatch(r"(?:mut\s+)?self", token) or re.fullmatch(
+            r"&(?:'[A-Za-z_][A-Za-z0-9_]*\s+)?(?:mut\s+)?self", token
+        ):
+            names.append("self")
+            continue
+        match = re.fullmatch(
+            r"(?:mut\s+)?(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*:[\s\S]+",
+            token,
+        )
+        if not match:
+            return None
+        names.append(match.group("name"))
+    return names
+
+
+def _kt_simple_parameter_names(source: str, masked: str, open_pos: int, close_pos: int) -> Optional[List[str]]:
+    """Return simple Kotlin parameter names or None for destructuring/complex forms."""
+    code = masked[open_pos + 1:close_pos]
+    pieces = _split_top_level_commas(code)
+    if len(pieces) == 1 and not pieces[0].strip():
+        return []
+    names: List[str] = []
+    for piece in pieces:
+        token = piece.strip()
+        if not token or any(symbol in token for symbol in ("{", "[")):
+            return None
+        match = re.fullmatch(
+            r"(?:vararg\s+)?(?:crossinline\s+|noinline\s+)?"
+            r"(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*:[\s\S]+",
+            token,
+        )
+        if not match:
+            return None
+        names.append(match.group("name"))
+    return names
+
