+def _brace_direct_forwarding_wrapper_candidates(
+    *, sources: List[Tuple[str, str, str]], lang: str, records_fn,
+) -> List[Dict[str, Any]]:
+    """Find exact-parameter forwarding wrappers in a brace language.
+
+    Rust accepts a ``return`` statement or a bare tail-expression call;
+    a call followed by ``;`` without ``return`` discards its value and is
+    NOT forwarding.  Kotlin block bodies require ``return``; Kotlin
+    single-expression bodies (``= callee(args)``) are forwarding by shape.
+    Callees are plain identifiers, plus ``self.<name>`` in Rust (method
+    delegation); ``Self::``, ``super::`` and ``crate::`` paths are deferred.
+    """
+    candidates: List[Dict[str, Any]] = []
+    kind = f"{lang}_direct_forwarding_wrapper"
+    for fn in records_fn(sources=sources):
+        params = fn.get("params")
+        if params is None or fn.get("async"):
+            continue
+        forward_params = [p for p in params if p != "self"]
+        callee: Optional[str] = None
+        if fn["form"] == "expression":
+            # A truncated multi-line expression (e.g. ``= JSONObject()``
+            # continued by ``.put(...)``) is a builder chain, not a
+            # forwarding call; _kt_function_records flags it.
+            if fn.get("expr_continues"):
+                continue
+            body_text = fn["source"][fn["expr_start"]:fn["expr_end"]].strip()
+            match = re.fullmatch(
+                r"(?P<callee>[A-Za-z_][A-Za-z0-9_]*)\s*\((?P<args>[^;{}()]*)\)",
+                body_text, flags=re.S,
+            )
+            if not match:
+                continue
+            callee = match.group("callee")
+            raw_args = [item.strip() for item in match.group("args").split(",") if item.strip()]
+        else:
+            body_mask = fn["masked"][fn["body_open"] + 1:fn["body_close"]].strip()
+            if lang == "rs":
+                callee_pattern = (
+                    r"(?P<callee>[A-Za-z_][A-Za-z0-9_]*(?:\s*\.\s*[A-Za-z_][A-Za-z0-9_]*)?)"
+                )
+                match = re.fullmatch(
+                    r"return\s+" + callee_pattern + r"\s*\((?P<args>[^;{}()]*)\)\s*;?",
+                    body_mask, flags=re.S,
+                )
+                if not match:
+                    match = re.fullmatch(
+                        callee_pattern + r"\s*\((?P<args>[^;{}()]*)\)",
+                        body_mask, flags=re.S,
+                    )
+            else:
+                match = re.fullmatch(
+                    r"return\s+(?P<callee>[A-Za-z_][A-Za-z0-9_]*)\s*\((?P<args>[^;{}()]*)\)\s*;?",
+                    body_mask, flags=re.S,
+                )
+            if not match:
+                continue
+            callee = re.sub(r"\s+", "", match.group("callee"))
+            raw_args = [item.strip() for item in match.group("args").split(",") if item.strip()]
+        if not callee or callee.split(".")[-1] == fn["name"]:
+            continue
+        if raw_args != list(forward_params):
+            continue
+        private = bool(fn["private"])
+        is_self_callee = "." in callee
+        candidates.append(_candidate(
+            identity={"file": fn["file"], "kind": kind, "function": fn["name"], "callee": callee},
+            kind=kind, files=[fn["file"]], names=[fn["name"]],
+            members=[_member(fn["file"], fn["name"], fn["line_start"], fn["line_end"], private=private)],
+            estimated_loc=max(1, fn["line_end"] - fn["line_start"] + 1),
+            witness={
+                "type": f"{lang}_direct_forwarding_wrapper_v1", "same_owner_file": True,
+                "simple_parameters_only": True, "argument_forwarding_exact": True,
+                "direct_identifier_callee": not is_self_callee,
+                "self_receiver_callee": is_self_callee,
+                "async_wrapper_excluded": True,
+                "wrapper_exported": bool(fn["exported"]), "wrapper_private": private,
+                "function_form": fn["form"], "callee": callee,
+                "authority": f"bounded_{lang}_structural_forwarding_witness_only",
+            },
+            proof_rule=f"remove/share a {lang.upper()} forwarding wrapper only when callable/API identity and all consumers remain compatible",
+            validation=[
+                "preserve exported/public callable names unless compatibility is explicitly retained",
+                "preserve receiver binding by allowing only direct identifier or self-receiver callees in v1",
+                "preserve argument order and arity", f"run affected {lang.upper()} tests and type-check",
+            ],
+        ))
+    return candidates
+
+
+def _brace_exact_function_body_duplication_candidates(
+    *, sources: List[Tuple[str, str, str]], lang: str, records_fn,
+) -> List[Dict[str, Any]]:
+    """Find conservative exact structural body duplication in a brace language."""
+    kind = f"{lang}_exact_function_body_duplication"
+    grouped: Dict[str, List[Dict[str, Any]]] = {}
+    for fn in records_fn(sources=sources):
+        if fn["body_open"] < 0:
+            continue
+        tokens = _brace_normalized_body_tokens(fn["source"], fn["body_open"] + 1, fn["body_close"])
+        if tokens is None or len(tokens) < 8:
+            continue
+        fingerprint = _sha(json.dumps(tokens, ensure_ascii=False, separators=(",", ":")))
+        grouped.setdefault(fingerprint, []).append(fn)
+    candidates: List[Dict[str, Any]] = []
+    for fingerprint, members in grouped.items():
+        if len(members) < 2:
+            continue
+        files = sorted({row["file"] for row in members})
+        names = sorted({row["name"] for row in members})
+        locs = sorted((row["line_end"] - row["line_start"] + 1 for row in members), reverse=True)
+        removable = sum(locs[1:])
+        if removable <= 0:
+            continue
+        candidates.append(_candidate(
+            identity={"kind": kind, "body": fingerprint, "files": files, "names": names},
+            kind=kind, files=files, names=names,
+            members=[_member(row["file"], row["name"], row["line_start"], row["line_end"], private=row["private"]) for row in members],
+            estimated_loc=removable, duplicate_loc=removable,
+            witness={
+                "type": f"{lang}_exact_function_body_tokens_v1", "exact_token_body_identical": True,
+                "comments_and_formatting_ignored": True, "string_and_char_literal_bytes_preserved": True,
+                "nested_block_comment_bodies_excluded_by_mask_limitation": True,
+                "member_count": len(members), "body_fingerprint": fingerprint,
+                "authority": f"bounded_{lang}_token_body_duplication_witness_only",
+            },
+            proof_rule=f"share exact {lang.upper()} function-body implementations only behind a neutral owner while preserving every public callable surface",
+            validation=[
+                "preserve exported/public functions as compatibility wrappers when required",
+                "preserve module initialization and import behavior", f"run affected {lang.upper()} tests and type-check",
+            ],
+        ))
+    return candidates
+
