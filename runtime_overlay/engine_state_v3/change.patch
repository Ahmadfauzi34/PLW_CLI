 _SCHEMA_NUM_RE = re.compile(r"^go(\d+)$")
 
 
+def _schema_number(schema: Any) -> Optional[int]:
+    """Extract numeric schema generation from labels like ``go11``."""
+    match = _SCHEMA_NUM_RE.match(str(schema or ""))
+    return int(match.group(1)) if match else None
+
+
+def _supports_cached_structural(engine: Dict[str, Any]) -> bool:
+    """Whether ``engine`` accepts ``--cached`` on structural queries (go11+)."""
+    schema_num = _schema_number(engine.get("schema"))
+    return (
+        bool(engine.get("cache_dir_supported"))
+        and schema_num is not None
+        and schema_num >= 11
+    )
+
