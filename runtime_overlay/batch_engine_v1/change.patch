+def _callee_base(expr: Any) -> str:
+    """Trailing identifier of a callee expression, mirroring the engine's
+    calleeBase (callers.go): cut at the first '<' or '[', replace '::'
+    with '.', return the last non-empty dot segment, or ''.
+
+    The engine's call rows carry the full callee expression
+    (``a.Run``), not the queried trailing name (``Run``), so batch
+    grouping must reduce it the same way the engine matches it —
+    grouping on the raw ``callee`` would strand qualified calls under
+    keys no query ever asked for (found by the dup-fixture smoke:
+    ``a.Run``/``b.Run`` rows never reached ``grouped["Run"]``).
+    """
+    if not isinstance(expr, str):
+        return ""
+    value = expr
+    for sep in ("<", "["):
+        idx = value.find(sep)
+        if idx >= 0:
+            value = value[:idx]
+    value = value.replace("::", ".")
+    for part in reversed(value.split(".")):
+        if part:
+            return part
+    return ""
+
+
+def run_batch_query(
+    mode: str,
+    root: Path,
+    queries: List[str],
+    binary: Path,
+    discovered_via: str,
+    timeout_s: int,
+) -> Dict[str, Any]:
+    """Many engine queries in one scan (G8).
+
+    ``defs`` uses the engine's positional-query batch (one index build,
+    envelope ``{"queries": [{query, total, hits}]}``).  ``callers`` and
+    ``related`` use the comma-joined flag value: one fresh AST scan,
+    one flat envelope carrying a ``"batch": true`` marker, each row
+    carrying its symbol (``callee`` for calls, ``symbol`` for related).
+
+    The result envelope is the ``run_query`` envelope plus two keys:
+    ``"batch_mode"`` (``"batch"`` or ``"fallback"``) and ``"grouped"``
+    (``{name: rows}`` — hits for defs, calls for callers, related rows
+    for related), so callers read per-symbol results without regrouping.
+
+    Old engines (before batch) answer a comma-joined ``--callers``
+    value as one never-matching name and return zero rows with exit 0
+    — a silent empty result.  The ``batch`` marker tells the two apart:
+    a multi-name request whose envelope lacks the marker means an old
+    engine, and this function falls back to one ``run_query`` per name
+    (correct, just slow) instead of presenting the empty batch as truth.
+    """
+    if mode not in ("defs", "callers", "related"):
+        raise EngineError(f"run_batch_query does not support mode: {mode}")
+    names = list(dict.fromkeys(q for q in queries if q))
+    if not names:
+        raise EngineError("run_batch_query requires at least one query")
+    engine = engine_status(binary, discovered_via)
+    if mode == "defs":
+        argv = ["--defs-only", *names]
+    elif mode == "callers":
+        argv = ["--callers", ",".join(names)]
+    else:
+        argv = ["--related", ",".join(names)]
+    result = _run_codesearch(binary, root, argv, timeout_s)
+    batch_mode = "batch"
+    grouped: Dict[str, List[Dict[str, Any]]] = {name: [] for name in names}
+    if mode == "defs":
+        per_query = result.get("queries")
+        if isinstance(per_query, list):
+            for entry in per_query:
+                if isinstance(entry, dict) and entry.get("query") in grouped:
+                    grouped[entry["query"]] = list(entry.get("hits") or [])
+        elif len(names) == 1 and isinstance(result.get("hits"), list):
+            grouped[names[0]] = list(result["hits"])
+        else:
+            batch_mode = "fallback"
+    else:
+        if len(names) > 1 and not result.get("batch"):
+            batch_mode = "fallback"
+        else:
+            key = "calls" if mode == "callers" else "related"
+            field = "callee" if mode == "callers" else "symbol"
+            for row in result.get(key) or []:
+                if not isinstance(row, dict):
+                    continue
+                owner = row.get(field)
+                if mode == "callers":
+                    owner = _callee_base(owner)
+                if owner in grouped:
+                    grouped[owner].append(row)
+                else:
+                    grouped.setdefault(str(owner), []).append(row)
+    if batch_mode == "fallback":
+        # The engine predates batch: rebuild the batch result from one
+        # run_query per name, so the envelope keeps exactly the shape a
+        # batch engine would have returned (the equivalence W1/W2 prove
+        # for batch engines). batch_mode records that it was assembled.
+        merged: Dict[str, Any] = {"query": ",".join(names)}
+        if mode == "defs":
+            merged["queries"] = []
+            for name in names:
+                single = run_query(mode, root, name, binary, discovered_via, timeout_s)
+                hits = list(single["engine_result"].get("hits") or [])
+                grouped[name] = hits
+                merged["queries"].append(
+                    {"query": name, "total": len(hits), "hits": hits})
+        else:
+            key = "calls" if mode == "callers" else "related"
+            rows: List[Dict[str, Any]] = []
+            for name in names:
+                single = run_query(mode, root, name, binary, discovered_via, timeout_s)
+                batch_rows = list(single["engine_result"].get(key) or [])
+                grouped[name] = batch_rows
+                rows.extend(batch_rows)
+            merged[key] = rows
+            merged["total"] = len(rows)
+        result = merged
+    out = envelope(mode, root, names, engine, result)
+    out["batch_mode"] = batch_mode
+    out["grouped"] = grouped
+    out["summary"]["total"] = sum(len(rows) for rows in grouped.values())
+    return out
