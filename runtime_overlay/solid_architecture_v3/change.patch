+def _canonical_brace_source_snapshot(
+    graph: Dict[str, Any],
+    root: Path,
+    extensions: Tuple[str, ...],
+    mask_fn,
+    *,
+    excluded: Optional[Set[str]] = None,
+) -> List[Tuple[str, str, str]]:
+    """Return stable brace-language source plus one shared length-preserving code mask."""
+    file_map = graph.get("file_map", {}) or {}
+    rows: List[Tuple[str, str, str]] = []
+    for raw_path in graph.get("vertices", []) or []:
+        path = str(raw_path)
+        source = file_map.get(raw_path)
+        if path.endswith(extensions) and isinstance(source, str):
+            rel = _relative_graph_path(path, root)
+            if is_declaration_file(rel) or is_generated_or_vendored_asset(rel, source):
+                if excluded is not None:
+                    excluded.add(rel)
+                continue
+            rows.append((rel, source, mask_fn(source)))
+    rows.sort(key=lambda row: row[0])
+    return rows
+
+
+def _canonical_rs_source_snapshot(
+    graph: Dict[str, Any],
+    root: Path,
+    *,
+    excluded: Optional[Set[str]] = None,
+) -> List[Tuple[str, str, str]]:
+    return _canonical_brace_source_snapshot(
+        graph, root, RS_SEMANTIC_EXTENSIONS, _mask_rs_noncode, excluded=excluded,
+    )
