-def _top_check_findings(
-    analyzer_output: Dict[str, Any],
-    limit: Optional[int] = _CHECK_FINDINGS_LIMIT,
-    compact: bool = False,
-) -> tuple:
-    """Flatten actionable findings for the `plw check --json` envelope.
-
-    The summary envelope used to carry only counts, so an agent had to
-    open the analyzer cache file to read a single finding — and the
-    human-readable path could never list one either, because it reads
-    the same top-level `findings` key. This returns the actionable
-    findings (critical/error/high/medium), each tagged with its
-    analyzer, in a deterministic order (severity, analyzer, file/node,
-    full JSON), bounded to `limit` with a truncation flag
-    (`limit=None` means uncapped). Low/info findings stay in the
-    analyzer cache.
-
-    Selection (G6): one finding per analyzer per round, in sorted
-    analyzer order, each analyzer's findings severity-sorted
-    internally — so no single analyzer can fill the envelope alone
-    (the old global sort let `perf.async` take all 100 slots). The
-    selected set is re-sorted by the documented order before it is
-    returned, so the envelope stays sorted; only its membership is
-    fair across analyzers.
-    """
-    rank = {"critical": 0, "error": 0, "high": 1, "medium": 2}
-
-    def _order(f):
-        return (
-            rank.get(f.get("severity", "medium"), 2),
-            f.get("analyzer", ""),
-            f.get("file", "") or f.get("node", ""),
-            json.dumps(f, sort_keys=True, ensure_ascii=False),
-        )
-
-    by_analyzer = {}
-    for name, result in analyzer_output.get("results", {}).items():
-        items = []
-        for finding in result.get("findings", []):
-            sev = finding.get("severity", "info")
-            if sev not in rank:
-                continue
-            item = dict(finding)
-            item.setdefault("analyzer", name)
-            raw_basis = item.get("cycle_basis")
-            if isinstance(raw_basis, list):
-                basis_cap = 2 if compact else 5
-                compacted_basis = []
-                for entry in raw_basis[:basis_cap]:
-                    if isinstance(entry, dict) and (
-                        "witness_edges" in entry or "vertices" in entry
-                    ):
-                        compacted = {
-                            k: v
-                            for k, v in entry.items()
-                            if k not in ("witness_edges", "vertices")
-                        }
-                        if isinstance(entry.get("witness_edges"), list):
-                            compacted["witness_edge_count"] = len(entry["witness_edges"])
-                        compacted_basis.append(compacted)
-                    else:
-                        compacted_basis.append(entry)
-                item["cycle_basis"] = compacted_basis
-                if len(raw_basis) > basis_cap:
-                    item["cycle_basis_omitted_count"] = len(raw_basis) - basis_cap
-                    item["cycle_basis_truncated"] = True
-            items.append(item)
-        if items:
-            items.sort(key=_order)
-            by_analyzer[name] = items
-
-    total = sum(len(v) for v in by_analyzer.values())
-    selected = []
-    names = sorted(by_analyzer)
-    round_idx = 0
-    while (limit is None or len(selected) < limit) and any(
-        round_idx < len(by_analyzer[n]) for n in names
-    ):
-        for name in names:
-            if limit is not None and len(selected) >= limit:
-                break
-            items = by_analyzer[name]
-            if round_idx < len(items):
