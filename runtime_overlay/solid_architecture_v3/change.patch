+def _set_memory_scope_explicit(explicit: bool) -> bool:
+    """Record explicit CLI memory scope configuration across runtime and facade."""
+    global _MEMORY_SCOPE_EXPLICIT
+    _MEMORY_SCOPE_EXPLICIT = bool(explicit)
+    _sync_facade_attr("_MEMORY_SCOPE_EXPLICIT", _MEMORY_SCOPE_EXPLICIT)
+    return _MEMORY_SCOPE_EXPLICIT
+
+
+def _resolve_hook(name: str, default: Callable[..., Any]) -> Callable[..., Any]:
+    """Honor test/caller monkey-patches applied on the hott_kernel facade without cyclic imports."""
+    facade = sys.modules.get("hott_kernel")
+    if facade is not None:
+        candidate = getattr(facade, name, None)
+        if callable(candidate):
+            return candidate
+    return default
