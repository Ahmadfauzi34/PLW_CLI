+    for rel, tree in trees:
+        for fn in ast.walk(tree):
+            if not isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                continue
+            for block in _iter_statement_blocks(fn):
+                for assign, ret in zip(block, block[1:]):
