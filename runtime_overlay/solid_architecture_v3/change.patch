+def _cli_context(argv: List[str]) -> None:
+    if len(argv) < 3 or argv[2].startswith("--"):
+        _emit_cli_result(_kernel_error(
+            "missing_argument",
+            "Usage: hott_kernel.py context <query> [root] [--target file[,file]] [--budget-tokens N] [--max-hops N] [--detail outline|source] [--truth-scope ID] [--no-proactive-truth] [--output prompt|summary|full]",
+        ))
+    root, query = _normalize_target_root_pair(argv)
+    target_files: List[str] = []
+    budget_tokens = DEFAULT_BUDGET_TOKENS
+    max_hops = DEFAULT_MAX_HOPS
+    detail = "source"
+    output_mode = "prompt"
+    proactive_truth = True
+    truth_scope = None
+    parse_error = None
+    for i, arg in enumerate(argv):
+        if arg in ("--target", "--targets", "--target-file", "--target-files") and i + 1 < len(argv):
+            target_files.extend(
+                value.strip()
+                for value in argv[i + 1].split(",")
+                if value.strip()
+            )
+        elif arg in ("--budget-tokens", "--budget_tokens") and i + 1 < len(argv):
+            try:
+                budget_tokens = int(argv[i + 1])
+            except ValueError:
+                parse_error = _kernel_error(
+                    "invalid_context_budget",
+                    "--budget-tokens must be an integer.",
+                    budget_tokens=argv[i + 1],
+                )
+        elif arg in ("--max-hops", "--max_hops") and i + 1 < len(argv):
+            try:
+                max_hops = int(argv[i + 1])
+            except ValueError:
+                parse_error = _kernel_error(
+                    "invalid_context_hops",
+                    "--max-hops must be an integer.",
+                    max_hops=argv[i + 1],
+                )
+        elif arg == "--detail" and i + 1 < len(argv):
+            detail = argv[i + 1]
+        elif arg == "--no-proactive-truth":
+            proactive_truth = False
+        elif arg == "--truth-scope" and i + 1 < len(argv):
+            truth_scope = argv[i + 1]
+        elif arg in ("--output", "--format") and i + 1 < len(argv):
+            raw_out = argv[i + 1]
+            output_mode = "full" if str(raw_out).strip().lower() == "json" else raw_out
+        elif arg.startswith("--output=") or arg.startswith("--format="):
+            raw_out = arg.split("=", 1)[1]
+            output_mode = "full" if str(raw_out).strip().lower() == "json" else raw_out
+    if parse_error:
+        _emit_cli_result(parse_error)
+    _emit_cli_result(kernel_context(
+        root,
+        query,
+        target_files=target_files,
+        budget_tokens=budget_tokens,
+        max_hops=max_hops,
+        detail=detail,
+        output_mode=output_mode,
+        proactive_truth=proactive_truth,
+        truth_scope=truth_scope,
+    ))
