+        for macro_match in macro_def.finditer(masked):
+            macro_open = masked.find("{", macro_match.start(), macro_match.end())
+            macro_close = _matching_js_brace(masked, macro_open)
+            if macro_close >= 0:
+                macro_spans.append((macro_open, macro_close))
+        for match in declaration.finditer(masked):
+            if any(start <= match.start() <= end for start, end in macro_spans):
+                continue
+            params_open = masked.find("(", match.start(), match.end())
+            params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+            if params_close < 0:
+                continue
+            body_open = _rs_function_body_open(masked, params_close + 1)
+            if body_open < 0 or (rel, body_open) in seen:
+                continue
+            body_close = _matching_js_brace(masked, body_open)
+            if body_close < 0:
+                continue
+            params = _rs_simple_parameter_names(source, masked, params_open, params_close)
+            seen.add((rel, body_open))
+            name = match.group("name")
+            exported = bool(match.group("pub"))
+            mods = match.group("mods") or ""
+            records.append({
+                "file": rel, "source": source, "masked": masked, "name": name,
+                "start": match.start(), "params_open": params_open, "params_close": params_close,
+                "params": params, "body_open": body_open, "body_close": body_close,
+                "line_start": source.count("\n", 0, match.start()) + 1,
+                "line_end": source.count("\n", 0, body_close) + 1,
+                "exported": exported, "private": not exported,
+                "async": "async" in mods.split(), "form": "function",
+                "expr_start": -1, "expr_end": -1,
+            })
+    records.sort(key=lambda row: (row["file"], row["start"], row["name"]))
+    return records
+
+
+_KT_FUNCTION_MODIFIERS = {
+    "public", "private", "protected", "internal", "open", "override",
+    "suspend", "inline", "tailrec", "operator", "infix", "external",
+    "actual", "expect", "abstract",
+}
+
+
+def _preceding_kt_annotations(masked: str, pos: int) -> Tuple[List[str], Set[str]]:
+    """Collect adjacent preceding Kotlin @Annotations and modifier keywords."""
+    annotations: List[str] = []
+    extra_mods: Set[str] = set()
+    idx = pos - 1
+    while idx >= 0:
+        while idx >= 0 and masked[idx].isspace():
+            idx -= 1
+        if idx < 0:
+            break
+        if masked[idx] == ")":
+            depth = 1
+            idx -= 1
+            while idx >= 0 and depth > 0:
+                if masked[idx] == ")":
+                    depth += 1
+                elif masked[idx] == "(":
+                    depth -= 1
+                idx -= 1
+            if depth != 0:
+                break
+            while idx >= 0 and masked[idx].isspace():
+                idx -= 1
+            if idx < 0:
+                break
+            end_tok = idx + 1
+            while idx >= 0 and (masked[idx].isalnum() or masked[idx] in "_.:"):
+                idx -= 1
+            if idx >= 0 and masked[idx] == "@":
+                ann = masked[idx + 1:end_tok].split(":")[-1]
+                if ann:
+                    annotations.append(ann)
+                idx -= 1
+                continue
+            break
+        if masked[idx].isalnum() or masked[idx] in "_.":
+            end_tok = idx + 1
+            while idx >= 0 and (masked[idx].isalnum() or masked[idx] in "_.:"):
+                idx -= 1
+            token = masked[idx + 1:end_tok]
+            if idx >= 0 and masked[idx] == "@":
+                ann = token.split(":")[-1]
+                if ann:
+                    annotations.append(ann)
+                idx -= 1
+                continue
+            if token in _KT_FUNCTION_MODIFIERS:
+                extra_mods.add(token)
+                continue
+            break
+        break
+    annotations.reverse()
+    return annotations, extra_mods
+
+
+def _kt_function_records(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    """Discover Kotlin functions: block bodies and single-line ``=`` bodies."""
+    records: List[Dict[str, Any]] = []
+    seen: set[Tuple[str, int]] = set()
+    declaration = re.compile(
+        r"(?P<mods>(?:(?:public|private|protected|internal|open|override|suspend|inline|tailrec|operator|infix|external|actual|expect|abstract)\s+)*)"
+        r"fun\s+(?:<[^;{}()]*>\s*)?(?:(?P<receiver>[A-Za-z_][A-Za-z0-9_]*)\s*\.\s*)?"
+        r"(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*(?:<[^;{}()]*>)?\s*\("
+    )
+    for rel, source, masked in sources:
+        for match in declaration.finditer(masked):
+            params_open = masked.find("(", match.start(), match.end())
+            params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+            if params_close < 0:
+                continue
+            form, body_pos = _kt_function_body_open(masked, params_close + 1)
+            if form is None:
+                continue
+            if form == "block":
+                body_open = body_pos
+                body_close = _matching_js_brace(masked, body_open)
+                if body_close < 0 or (rel, body_open) in seen:
+                    continue
+                seen.add((rel, body_open))
+                expr_start = expr_end = -1
+                line_end = source.count("\n", 0, body_close) + 1
+            else:
+                expr_start = body_pos + 1
+                line_end_pos = source.find("\n", expr_start)
+                semi = masked.find(";", expr_start)
+                expr_end = len(source)
+                if line_end_pos >= 0:
+                    expr_end = min(expr_end, line_end_pos)
+                if semi >= 0:
+                    expr_end = min(expr_end, semi)
+                body_open = body_close = -1
+                line_end = source.count("\n", 0, expr_end) + 1
+                # A single-line capture can truncate a multi-line expression:
+                # ``= JSONObject()`` followed by ``.put(...)`` on the next
+                # line is a builder chain, not a forwarding call.  When the
+                # expression ended at a newline (not ``;``), peek at the next
+                # line: a leading ``.`` or infix operator continues it, so
+                # the record is not a single-line expression body in v1.
+                expr_continues = False
+                if expr_end < len(source) and source[expr_end] == "\n":
+                    nxt = _skip_js_space(masked, expr_end)
+                    if nxt < len(masked) and masked[nxt] == ".":
+                        expr_continues = True
+                    elif nxt < len(masked) and re.match(
+                        r"(?:&&|\|\||[+\-*/%]|\?:|as\b|is\b|!in\b|in\b)",
+                        masked[nxt:],
+                    ):
+                        expr_continues = True
+            params = _kt_simple_parameter_names(source, masked, params_open, params_close)
+            name = match.group("name")
+            mods = match.group("mods") or ""
+            annotations, extra_mods = _preceding_kt_annotations(masked, match.start())
+            mods_set = set(mods.split()) | extra_mods
+            private = "private" in mods_set
+            is_override = "override" in mods_set
+            is_test_fn = any(
+                ann == "Test"
+                or ann.endswith(".Test")
+                or ann in {"ParameterizedTest", "RepeatedTest", "TestFactory", "TestTemplate"}
+                for ann in annotations
+            )
+            records.append({
+                "file": rel, "source": source, "masked": masked, "name": name,
+                "start": match.start(), "params_open": params_open, "params_close": params_close,
+                "params": params, "body_open": body_open, "body_close": body_close,
+                "line_start": source.count("\n", 0, match.start()) + 1,
+                "line_end": line_end,
+                "exported": not private, "private": private,
+                "async": False, "form": "function" if form == "block" else "expression",
+                "expr_start": expr_start, "expr_end": expr_end,
+                "expr_continues": expr_continues if form == "expr" else False,
+                "annotations": annotations,
+                "is_override": is_override,
+                "is_test_fn": is_test_fn,
+            })
+    records.sort(key=lambda row: (row["file"], row["start"], row["name"]))
+    return records
+
+
+def _brace_normalized_body_tokens(source: str, start: int, end: int) -> Optional[List[str]]:
+    """Tokenize a Rust/Kotlin body conservatively for exact-structure fingerprinting.
+
+    Comments/formatting are ignored, while string/char literal bytes and
+    punctuator boundaries are preserved.  Unlike the JS tokenizer there is no
+    regex/division ambiguity: ``/`` is always division in both languages.
+    Lifetimes (``'a``) tokenize as a quote plus an identifier; char literals
+    stay one token.  Rust raw strings (``r#"..."#``) and Kotlin raw strings
+    (``\"\"\"...\"\"\"``) are consumed as single tokens.
+    """
+    tokens: List[str] = []
+    i = start
+    punctuators = (
+        "::", "->", "=>", "..=", "...", "..", "?.", "?:", "==", "!=", "<=", ">=",
+        "&&", "||", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "++", "--",
+    )
+    while i < end:
+        ch = source[i]
+        if ch.isspace():
+            i += 1; continue
+        if ch == "/" and i + 1 < end and source[i + 1] == "/":
+            newline = source.find("\n", i + 2, end)
+            i = end if newline < 0 else newline + 1; continue
+        if ch == "/" and i + 1 < end and source[i + 1] == "*":
+            close = source.find("*/", i + 2, end)
+            if close < 0: return None
+            i = close + 2; continue
+        if ch == "r" or (ch == "b" and i + 1 < end and source[i + 1] == "r"):
+            j = i + 1 if ch == "r" else i + 2
+            hashes = 0
+            while j < end and source[j] == "#":
+                hashes += 1; j += 1
+            if j < end and source[j] == '"':
+                closing = '"' + "#" * hashes
+                close = source.find(closing, j + 1, end)
+                if close < 0: return None
+                tokens.append(source[i:close + len(closing)]); i = close + len(closing); continue
+        if ch == '"' and source.startswith('"""', i, end):
+            close = source.find('"""', i + 3, end)
+            if close < 0: return None
+            tokens.append(source[i:close + 3]); i = close + 3; continue
+        if ch == '"':
+            j, escaped = i + 1, False
+            while j < end:
+                current = source[j]
+                if escaped:
+                    escaped = False
+                elif current == "\\":
+                    escaped = True
+                elif current == '"':
+                    j += 1; break
+                j += 1
+            if j > end: return None
+            tokens.append(source[i:j]); i = j; continue
+        if ch == "'":
+            char_end = _brace_char_literal_end(source, i, end)
+            if char_end > 0:
+                tokens.append(source[i:char_end]); i = char_end; continue
+            tokens.append(ch); i += 1; continue
+        ident = re.match(r"[A-Za-z_][A-Za-z0-9_]*", source[i:end])
+        if ident:
+            value = ident.group(0); tokens.append(value); i += len(value); continue
+        number = re.match(
+            r"(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d[\d_]*)?)[A-Za-z]*",
+            source[i:end],
+        )
+        if number:
+            value = number.group(0); tokens.append(value); i += len(value); continue
+        matched = next((op for op in punctuators if source.startswith(op, i)), None)
+        if matched:
+            tokens.append(matched); i += len(matched); continue
+        tokens.append(ch); i += 1
+    return tokens
+
+
+def _brace_candidate_row(
+    *, rel: str, name: str, line_start: int, line_end: int,
+    kind: str, identity: Dict[str, Any], witness: Dict[str, Any], proof_rule: str,
+    validation: List[str],
+) -> Dict[str, Any]:
+    return _candidate(
+        identity={"file": rel, "kind": kind, "function": name, "line": line_start, **identity},
+        kind=kind, files=[rel], names=[name],
+        members=[_member(rel, name, line_start, line_end, private=True)], estimated_loc=1,
+        witness=witness, proof_rule=proof_rule, validation=validation,
+    )
+
+
+def _brace_direct_forwarding_wrapper_candidates(
+    *, sources: List[Tuple[str, str, str]], lang: str, records_fn,
+) -> List[Dict[str, Any]]:
+    """Find exact-parameter forwarding wrappers in a brace language.
+
+    Rust accepts a ``return`` statement or a bare tail-expression call;
+    a call followed by ``;`` without ``return`` discards its value and is
+    NOT forwarding.  Kotlin block bodies require ``return``; Kotlin
+    single-expression bodies (``= callee(args)``) are forwarding by shape.
+    Callees are plain identifiers, plus ``self.<name>`` in Rust (method
+    delegation); ``Self::``, ``super::`` and ``crate::`` paths are deferred.
+    """
+    candidates: List[Dict[str, Any]] = []
+    kind = f"{lang}_direct_forwarding_wrapper"
+    for fn in records_fn(sources=sources):
+        params = fn.get("params")
+        if params is None or fn.get("async"):
+            continue
+        if lang == "kt":
+            if fn.get("is_override") or fn.get("is_test_fn"):
+                continue
+            norm_file = f"/{str(fn['file']).replace(chr(92), '/').lower()}"
+            if (
+                "/src/test/" in norm_file
+                or "/src/androidtest/" in norm_file
+                or "/src/commontest/" in norm_file
+            ):
+                continue
+        forward_params = [p for p in params if p != "self"]
+        callee: Optional[str] = None
+        if fn["form"] == "expression":
+            # A truncated multi-line expression (e.g. ``= JSONObject()``
+            # continued by ``.put(...)``) is a builder chain, not a
+            # forwarding call; _kt_function_records flags it.
+            if fn.get("expr_continues"):
+                continue
+            expr_start = fn["expr_start"]
+            expr_mask = fn["masked"][expr_start:fn["expr_end"]]
+            match = re.fullmatch(
+                r"\s*(?P<callee>[A-Za-z_][A-Za-z0-9_]*)\s*\((?P<args>[^;{}()]*)\)\s*",
+                expr_mask, flags=re.S,
+            )
+            if not match:
+                continue
+            callee = match.group("callee")
+            raw_args = _extract_exact_forwarding_args(
+                fn["source"],
+                fn["masked"],
+                expr_start + match.start("args"),
+                expr_start + match.end("args"),
+            )
+        else:
+            body_start = fn["body_open"] + 1
+            body_mask = fn["masked"][body_start:fn["body_close"]]
+            if lang == "rs":
+                callee_pattern = (
+                    r"(?P<callee>[A-Za-z_][A-Za-z0-9_]*(?:\s*\.\s*[A-Za-z_][A-Za-z0-9_]*)?)"
+                )
+                match = re.fullmatch(
+                    r"\s*return\s+" + callee_pattern + r"\s*\((?P<args>[^;{}()]*)\)\s*;?\s*",
+                    body_mask, flags=re.S,
+                )
+                if not match:
+                    match = re.fullmatch(
+                        r"\s*" + callee_pattern + r"\s*\((?P<args>[^;{}()]*)\)\s*",
+                        body_mask, flags=re.S,
+                    )
+            else:
+                match = re.fullmatch(
+                    r"\s*return\s+(?P<callee>[A-Za-z_][A-Za-z0-9_]*)\s*\((?P<args>[^;{}()]*)\)\s*;?\s*",
+                    body_mask, flags=re.S,
+                )
+            if not match:
+                continue
+            callee = re.sub(r"\s+", "", match.group("callee"))
+            raw_args = _extract_exact_forwarding_args(
+                fn["source"],
+                fn["masked"],
+                body_start + match.start("args"),
+                body_start + match.end("args"),
+            )
+        if not callee or callee.split(".")[-1] == fn["name"]:
+            continue
+        if lang == "kt":
+            leaf = callee.split(".")[-1]
+            if leaf and leaf[0].isupper():
+                continue
+        if raw_args is None or raw_args != list(forward_params):
+            continue
+        private = bool(fn["private"])
+        is_self_callee = "." in callee
+        candidates.append(_candidate(
+            identity={"file": fn["file"], "kind": kind, "function": fn["name"], "callee": callee},
+            kind=kind, files=[fn["file"]], names=[fn["name"]],
+            members=[_member(fn["file"], fn["name"], fn["line_start"], fn["line_end"], private=private)],
+            estimated_loc=max(1, fn["line_end"] - fn["line_start"] + 1),
+            witness={
+                "type": f"{lang}_direct_forwarding_wrapper_v1", "same_owner_file": True,
+                "simple_parameters_only": True, "argument_forwarding_exact": True,
+                "direct_identifier_callee": not is_self_callee,
+                "self_receiver_callee": is_self_callee,
+                "async_wrapper_excluded": True,
+                "wrapper_exported": bool(fn["exported"]), "wrapper_private": private,
+                "function_form": fn["form"], "callee": callee,
+                "authority": f"bounded_{lang}_structural_forwarding_witness_only",
+            },
+            proof_rule=f"remove/share a {lang.upper()} forwarding wrapper only when callable/API identity and all consumers remain compatible",
+            validation=[
+                "preserve exported/public callable names unless compatibility is explicitly retained",
+                "preserve receiver binding by allowing only direct identifier or self-receiver callees in v1",
+                "preserve argument order and arity", f"run affected {lang.upper()} tests and type-check",
+            ],
+        ))
+    return candidates
+
+
+def _brace_exact_function_body_duplication_candidates(
+    *, sources: List[Tuple[str, str, str]], lang: str, records_fn,
+) -> List[Dict[str, Any]]:
+    """Find conservative exact structural body duplication in a brace language."""
+    kind = f"{lang}_exact_function_body_duplication"
+    grouped: Dict[str, List[Dict[str, Any]]] = {}
+    for fn in records_fn(sources=sources):
+        if fn["body_open"] < 0:
+            continue
+        tokens = _brace_normalized_body_tokens(fn["source"], fn["body_open"] + 1, fn["body_close"])
+        if tokens is None or len(tokens) < 8:
+            continue
+        fingerprint = _sha(json.dumps(tokens, ensure_ascii=False, separators=(",", ":")))
+        grouped.setdefault(fingerprint, []).append(fn)
+    candidates: List[Dict[str, Any]] = []
+    for fingerprint, members in grouped.items():
+        if len(members) < 2:
+            continue
+        files = sorted({row["file"] for row in members})
+        names = sorted({row["name"] for row in members})
+        locs = sorted((row["line_end"] - row["line_start"] + 1 for row in members), reverse=True)
+        removable = sum(locs[1:])
+        if removable <= 0:
+            continue
+        candidates.append(_candidate(
+            identity={"kind": kind, "body": fingerprint, "files": files, "names": names},
+            kind=kind, files=files, names=names,
+            members=[_member(row["file"], row["name"], row["line_start"], row["line_end"], private=row["private"]) for row in members],
+            estimated_loc=removable, duplicate_loc=removable,
+            witness={
+                "type": f"{lang}_exact_function_body_tokens_v1", "exact_token_body_identical": True,
+                "comments_and_formatting_ignored": True, "string_and_char_literal_bytes_preserved": True,
+                "nested_block_comment_bodies_excluded_by_mask_limitation": True,
+                "member_count": len(members), "body_fingerprint": fingerprint,
+                "authority": f"bounded_{lang}_token_body_duplication_witness_only",
+            },
+            proof_rule=f"share exact {lang.upper()} function-body implementations only behind a neutral owner while preserving every public callable surface",
+            validation=[
+                "preserve exported/public functions as compatibility wrappers when required",
+                "preserve module initialization and import behavior", f"run affected {lang.upper()} tests and type-check",
+            ],
+        ))
+    return candidates
+
