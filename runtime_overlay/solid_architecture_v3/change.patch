-    )
-    result = establish_baseline(
-        scan_root,
-        baseline_path,
-        shared_graph=graph,
-        analyzer_output=analyzer_output,
-    )
-    return {
-        "schema_version": "3.0.0-kernel",
-        "graph_cache": graph.get("cache", {}),
-        "analyzer_cache": analyzer_output.get("cache", {}),
-        **result,
-    }
