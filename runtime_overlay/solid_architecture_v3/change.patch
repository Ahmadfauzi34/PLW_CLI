+def _build_topology_engine_layer(
+    scan_root: str,
+    graph: Dict[str, Any],
+    target_files: Optional[List[str]] = None,
+    *,
+    max_symbols: Optional[int] = None,
+    full_engine: bool = False,
+    full_engine_edges: bool = False,
+    seed_terms: Optional[Sequence[str]] = None,
+) -> Dict[str, Any]:
+    """Best-effort engine symbol layer for topology/impact. Never raises.
+
+    The layer is built outside the cached SharedGraph and merged at
+    projection time, so a missing or failing engine can never break
+    topology, orient, or impact.
+    """
+    try:
+        from core.topology_engine import build_engine_layer
+    except ImportError as exc:
+        return _topology_engine_unavailable(
+            f"topology engine module unavailable: {exc}",
+            full_engine_edges=full_engine_edges,
+        )
+    try:
+        return build_engine_layer(
+            scan_root,
+            graph,
+            target_files=target_files,
+            max_symbols=max_symbols,
+            full_engine=full_engine,
+            full_engine_edges=full_engine_edges,
+            cache_mode=_ACTIVE_GRAPH_CACHE_MODE,
+            seed_terms=seed_terms,
+        )
+    except Exception as exc:
+        return _topology_engine_unavailable(
+            f"topology engine layer failed: {exc}",
+            full_engine_edges=full_engine_edges,
+        )
+
+
+def _resolve_engine_target_files(
+    scan_root: str,
+    graph: Dict[str, Any],
+    *,
+    explicit_targets: List[str],
+    target_resolution: Dict[str, Any],
+    full_engine: bool,
+) -> Optional[List[str]]:
+    """Derive target-grounded engine scope (1-hop neighborhood) for kernel_work.
+
+    Guardrail #2: when target_resolution resolves one or more graph targets
+    without full_engine, scope the engine to resolved_targets union
+    direct_imports union direct_importers so blast-radius leads remain intact
+    while keeping large repositories fast.
+    """
+    if full_engine:
+        return None
+    resolution = (target_resolution or {}).get("resolution") or {}
+    state = str(resolution.get("state") or "")
+    selected = [str(item) for item in (resolution.get("selected_targets") or []) if item]
+    if state in ("RESOLVED", "MULTI_TARGET_RESOLVED") and selected:
+        try:
+            from core.topology_engine import _canon_rel
+        except ImportError:
+            _canon_rel = lambda p, _r: str(p).replace("\\", "/")
+        root_abs = os.path.abspath(scan_root or ".").replace("\\", "/")
+        seed_scope = {_canon_rel(item, root_abs) for item in selected}
+        for item in explicit_targets:
+            if str(item).strip():
+                seed_scope.add(_canon_rel(str(item), root_abs))
+        one_hop = set(seed_scope)
+        for edge in (graph.get("edges") or []):
+            if not isinstance(edge, (list, tuple)) or len(edge) != 2:
+                continue
+            src = _canon_rel(str(edge[0]), root_abs)
+            dst = _canon_rel(str(edge[1]), root_abs)
+            if src in seed_scope:
+                one_hop.add(dst)
+            if dst in seed_scope:
+                one_hop.add(src)
+        return sorted(one_hop)
+    if explicit_targets:
+        return sorted({str(item) for item in explicit_targets if str(item).strip()}) or None
+    return None
