+"""Task-chain stage receipts, graph-signature sealing, and next-stage directives."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from typing import Any, Dict, Optional
+
+from core.kernel.runtime import (
+    GRAPH_CACHE_AVAILABLE,
+    _build_kernel_graph,
+    get_graph_cache_status,
+    graph_content_signature,
+)
+
+_TASK_RECEIPT_SCHEMA = "plw-task-receipt-v1"
+
+
+# stage -> (allowed previous stages, next stage or None)
+_TASK_PIPELINE = {
+    "orient": ((), "resolve-target"),
+    "work": ((), "resolve-target"),
+    "resolve-target": (("orient", "work", "semantic-route"), "evidence-needs"),
+    "evidence-needs": (("resolve-target",), "capability-match"),
+    "capability-match": (("evidence-needs",), "candidate-select"),
+    "candidate-select": (("capability-match",), None),
+    "candidate-capability-match": (("capability-match",), None),
+    "semantic-route": (("orient", "work"), "resolve-target"),
+}
+
+
+_TASK_RECEIPT_COMMANDS = {
+    "orient": "plw agent orient",
+    "work": "plw work",
+    "resolve-target": "plw resolve-target",
+    "evidence-needs": "plw evidence-needs",
+    "capability-match": "plw capability-match",
+    "candidate-select": "plw candidate select",
+    "candidate-capability-match": "plw candidate capability-match",
+    "semantic-route": "plw semantic route",
+}
+
+
+_TASK_RECEIPT_SEAL_KEYS = (
+    "schema_version",
+    "stage",
+    "task",
+    "normalized_task",
+    "scan_root",
+    "resolved_scan_root",
+    "fingerprint",
+    "graph_signature",
+    "result_digest",
+)
+
+
+def _normalize_receipt_task(task: Any) -> str:
+    return " ".join(str(task or "").split())
+
+
+def _extract_result_graph_signature(result: Optional[Dict[str, Any]]) -> Optional[str]:
+    if not isinstance(result, dict):
+        return None
+    for candidate in (
+        (result.get("graph_cache") or {}).get("graph_content_signature"),
+        (result.get("target_orientation") or {}).get("graph_content_signature"),
+        (result.get("target_resolution") or {}).get("graph_content_signature"),
+        (result.get("evidence_need_derivation") or {}).get("graph_content_signature"),
+        (result.get("discovery_binding") or {}).get("shared_graph_content_signature"),
+    ):
+        if isinstance(candidate, str) and candidate.startswith("sha256:"):
+            return candidate
+    return None
+
+
+def _current_graph_signature(
+    scan_root: Optional[str],
+    result: Optional[Dict[str, Any]] = None,
+) -> Optional[str]:
+    if scan_root is None:
+        return None
+    from_result = _extract_result_graph_signature(result)
+    if from_result:
+        return from_result
+    try:
+        if GRAPH_CACHE_AVAILABLE:
+            status = get_graph_cache_status(scan_root)
+            sig = status.get("graph_content_signature")
+            if status.get("status") == "valid" and isinstance(sig, str) and sig.startswith("sha256:"):
+                return sig
+        graph = _build_kernel_graph(scan_root)
+        sig = (graph.get("cache") or {}).get("graph_content_signature")
+        if isinstance(sig, str) and sig.startswith("sha256:"):
+            return sig
+        if graph_content_signature is not None:
+            return graph_content_signature(graph)
+    except Exception:
+        return None
+    return None
+
+
+def _compute_stage_result_digest(
+    stage: str,
+    result: Optional[Dict[str, Any]],
+) -> Optional[str]:
+    if not isinstance(result, dict):
+        return None
+    if stage in ("orient", "work", "resolve-target"):
+        res = (result.get("target_resolution") or {}).get("resolution") or {}
+        core: Dict[str, Any] = {
+            "stage": stage,
+            "state": res.get("state"),
+            "selected_targets": list(res.get("selected_targets") or []),
+        }
+    elif stage == "evidence-needs":
+        deriv = result.get("evidence_need_derivation") or {}
+        core = {
+            "stage": stage,
+            "needs": [
+                row.get("need")
+                for row in (deriv.get("evidence_needed") or [])
+                if isinstance(row, dict)
+            ],
+        }
+    elif stage == "capability-match":
+        sel = result.get("capability_selection") or {}
+        core = {
+            "stage": stage,
+            "candidates": [
+                row.get("capability")
+                for row in (sel.get("candidate_capabilities") or [])
+                if isinstance(row, dict)
+            ],
+        }
+    elif stage in ("candidate-select", "candidate-capability-match"):
+        csel = result.get("candidate_selection") or {}
+        core = {
+            "stage": stage,
+            "resolution": csel.get("resolution"),
+            "selected_candidate_id": csel.get("selected_candidate_id"),
+            "candidate_set_digest": csel.get("candidate_set_digest"),
+        }
+    elif stage == "semantic-route":
+        core = {
+            "stage": stage,
+            "capability": result.get("capability"),
+            "skill_path": result.get("skill_path"),
+        }
+    else:
+        core = {"stage": stage}
+    serialized = json.dumps(core, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    return "sha256:" + hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+
+
+def _task_receipt_seal_core(receipt_body: Dict[str, Any]) -> Dict[str, Any]:
+    return {key: receipt_body.get(key) for key in _TASK_RECEIPT_SEAL_KEYS}
+
+
+def _task_receipt_fingerprint(stage, task, scan_root):
+    material = stage + "\n" + task + "\n" + (scan_root or "")
+    return "sha256:" + hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def _task_receipt(
+    stage,
+    task,
+    scan_root,
+    *,
+    graph_signature: Optional[str] = None,
+    result_digest: Optional[str] = None,
+):
+    resolved_scan_root = os.path.abspath(scan_root) if scan_root is not None else None
+    norm_task = _normalize_receipt_task(task)
+    fp = _task_receipt_fingerprint(stage, task, scan_root)
+    if graph_signature is None and scan_root is not None:
+        graph_signature = _current_graph_signature(scan_root)
+    body: Dict[str, Any] = {
+        "schema_version": _TASK_RECEIPT_SCHEMA,
+        "stage": stage,
+        "task": task,
+        "normalized_task": norm_task,
+        "scan_root": scan_root,
+        "resolved_scan_root": resolved_scan_root,
+        "fingerprint": fp,
+        "graph_signature": graph_signature,
+        "result_digest": result_digest,
+    }
+    try:
+        from core.accountability_provenance import TASK_RECEIPT_ISSUER, seal_payload
+        body["provenance"] = seal_payload(_task_receipt_seal_core(body), TASK_RECEIPT_ISSUER)
+    except Exception:
+        body["provenance"] = None
+    return body
+
+
+def _task_next(stage, task, scan_root):
+    nxt = _TASK_PIPELINE[stage][1]
+    if nxt is None:
+        return None
+    cmd = _TASK_RECEIPT_COMMANDS[nxt]
+    args = [task] if scan_root is None else [task, scan_root]
+    return {"command": cmd, "args": args, "stage": nxt}
+
+
+def _attach_task_receipt(
+    result,
+    stage,
+    task,
+    scan_root,
+    *,
+    inherited_graph_signature: Optional[str] = None,
+):
+    """Add receipt+next to a successful stage result (new dict)."""
+    if not isinstance(result, dict) or result.get("error"):
+        return result
+    out = dict(result)
+    graph_sig = inherited_graph_signature or _current_graph_signature(scan_root, out)
+    res_digest = _compute_stage_result_digest(stage, out)
+    out["receipt"] = _task_receipt(
+        stage,
+        task,
+        scan_root,
+        graph_signature=graph_sig,
+        result_digest=res_digest,
+    )
+    out["next"] = _task_next(stage, task, scan_root)
+    return out
