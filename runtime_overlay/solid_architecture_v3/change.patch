+def kernel_resolve_target(
+    scan_root: str,
+    task: str,
+    *,
+    target_files: Optional[List[str]] = None,
+    top_n: int = 8,
+    neighborhood_limit: int = 8,
+) -> Dict[str, Any]:
+    """Resolve task-relevant graph nodes without selecting a PLW capability."""
+    if not TARGET_RESOLUTION_AVAILABLE:
+        return {"error": "target resolution is unavailable", "available": False}
+    root_error = _validate_scan_root(scan_root)
+    if root_error:
+        return root_error
+    if not isinstance(task, str) or not task.strip():
+        return _kernel_error("empty_target_resolution_task", "Target resolution requires a non-empty task.")
+    try:
+        graph = _build_kernel_graph(scan_root)
+        resolution = build_target_resolution(
+            graph, task, explicit_targets=target_files or None,
+            top_n=top_n, neighborhood_limit=neighborhood_limit,
+        )
+    except (TypeError, ValueError) as exc:
+        return _kernel_error("invalid_target_resolution_request", str(exc))
+    return {
+        "schema_version": "4.4.0-target-resolution",
+        "mode": "resolve-target",
+        "task": task,
+        "scan_root": scan_root,
+        "target_resolution": resolution,
+        "authority": {
+            "semantic_ownership_proven": False,
+            "selects_PLW_capability": False,
+            "execute_runtime": False,
+            "mutate_source": False,
+            "commit_truth": False,
+        },
+    }
