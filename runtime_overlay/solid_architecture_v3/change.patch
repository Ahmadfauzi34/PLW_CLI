+    graph = _build_kernel_graph(scan_root)
+    from codebase.cycle_break import analyze_cycle_breaks
+    advisor_result = analyze_cycle_breaks(graph)
+
+    plan = advisor_result.get("summary", {})
+    advisories = advisor_result.get("advisories", [])
+
+    target_norm: Optional[str] = None
+    if target_file:
+        target_norm = os.path.normpath(target_file).replace("\\", "/")
+        if target_norm.startswith("./"):
+            target_norm = target_norm[2:]
+        resolved_cb_target: Optional[str] = None
+        try:
+            from codebase.topology_analyzers import _resolve_query_target
+            resolved_cb_target, _, _ = _resolve_query_target(
+                target_norm,
+                set(graph.get("vertices", [])),
+                scan_root=scan_root,
+            )
+        except Exception:
+            resolved_cb_target = None
+        match_tokens = [target_norm]
+        if resolved_cb_target and resolved_cb_target not in match_tokens:
+            match_tokens.append(resolved_cb_target)
+        # Filter advisories and cuts affecting target_file
+        advisories = [
+            adv for adv in advisories
+            if any(any(tok in node for tok in match_tokens) for node in adv.get("cycle", []))
+        ]
+        recommended_cuts = [
+            cut for cut in plan.get("recommended_cuts", [])
+            if any(tok in cut.get("source", "") or tok in cut.get("target", "") for tok in match_tokens)
+        ]
+        optional_type_only_cuts = [
+            cut for cut in plan.get("optional_type_only_cuts", [])
+            if any(tok in cut.get("source", "") or tok in cut.get("target", "") for tok in match_tokens)
+        ]
+        plan = {
+            **plan,
+            "target_filtered": True,
+            "target_file": target_norm,
+            "cycles_affecting_target": len(advisories),
+            "runtime_cycles_affecting_target": sum(1 for a in advisories if not a.get("is_type_only")),
