+def _engine_answer_summary(
+    target_orientation: Dict[str, Any],
+    terms: Any = None,
+    *,
+    target_resolved: bool = True,
+) -> Dict[str, Any]:
+    """Summarize engine-located symbols for the agent decision frame.
+
+    The topology target may stay unresolved (or ambiguous) while the
+    engine layer already located symbol(s) in the target; the summary
+    lets the decision frame say so up front instead of reading as "no
+    answer". Returns {} when the engine located nothing, so the frame
+    stays silent instead of claiming an answer. Never raises.
+
+    Only ``calls`` edges are projected as calls: ``symbol_edges`` also
+    carries ``related`` rows (re-export, ffi, ...) which have no caller
+    or callee at all — projecting them unfiltered used to emit
+    ``{"caller": {"file": null, "line": null}, "callee": null}`` rows
+    (the engine's file/line sort puts ``related`` rows first). When
+    ``terms`` (task-seed terms) are given, rows whose names contain a
+    term rank first, stable within each group, before the [:4] cut —
+    otherwise the cut keeps whatever the engine's sort put first, which
+    need not be what the task asked about.
+    """
+    try:
+        engine = (target_orientation or {}).get("engine") or {}
+        nodes = [n for n in (engine.get("symbol_nodes") or []) if isinstance(n, dict)]
+        edges = [
+            e for e in (engine.get("symbol_edges") or [])
+            if isinstance(e, dict) and e.get("kind") == "calls"
+        ]
+        if not nodes and not edges:
+            return {}
+        terms_l = [str(t).lower() for t in (terms or []) if str(t).strip()]
+
+        def _term_score(name: str) -> tuple:
+            lowered = (name or "").lower()
+            parts = lowered.split()
+            exact = sum(1 for t in terms_l if t and (lowered == t or t in parts))
+            long_hits = sum(1 for t in terms_l if len(t) >= 4 and t in lowered)
+            all_hits = sum(1 for t in terms_l if t and t in lowered)
+            best_len = max((len(t) for t in terms_l if t and t in lowered), default=0)
+            return (exact, long_hits, best_len, all_hits)
+
+        def _ranked(rows, key):
+            if not terms_l:
+                return rows
+            scored = sorted(
+                enumerate(rows),
+                key=lambda pair: (tuple(-v for v in _term_score(key(pair[1]))), pair[0]),
+            )
+            return [row for _, row in scored]
+
+        def _call_name(edge: Dict[str, Any]) -> str:
+            caller = edge.get("caller") or {}
+            callee = edge.get("callee") or {}
+            return "%s %s" % (caller.get("symbol") or "", callee.get("symbol") or "")
+
+        nodes = _ranked(nodes, lambda n: str(n.get("symbol") or ""))
+        edges = _ranked(edges, _call_name)
+        if not target_resolved and terms_l:
+            has_match = any(
+                _term_score(str(n.get("symbol") or "")) > (0, 0, 0, 0) for n in nodes
+            ) or any(
+                _term_score(_call_name(e)) > (0, 0, 0, 0) for e in edges
+            )
+            if not has_match:
+                return {}
+        return {
+            "symbols": [
+                {
+                    "symbol": n.get("symbol"),
+                    "file": n.get("file"),
+                    "line": n.get("line"),
+                    "kind": n.get("kind"),
+                    "authority": n.get("authority"),
+                }
+                for n in nodes[:4]
+            ],
+            "calls": [
+                {
+                    "caller": {
+                        "file": (e.get("caller") or {}).get("file"),
+                        "line": (e.get("caller") or {}).get("line"),
+                    },
+                    "callee": (e.get("callee") or {}).get("symbol"),
+                }
+                for e in edges[:4]
+            ],
+            "symbol_count": len(nodes),
+            "call_count": len(edges),
+        }
+    except Exception:
+        return {}
+
+
+def kernel_work(
+    scan_root: str,
+    task: str,
+    target_files: Optional[List[str]] = None,
+    goal: str = "auto",
+    depth: str = "auto",
+    budget_tokens: int = DEFAULT_BUDGET_TOKENS,
+    max_hops: int = DEFAULT_MAX_HOPS,
+    detail: str = "source",
+    max_findings: int = 24,
+    proactive_truth: bool = True,
+    truth_scope: Optional[str] = None,
+    ui_selector: Optional[str] = None,
+    full_engine: bool = False,
+    full_engine_edges: bool = False,
+    frame_only: bool = False,
+) -> Dict[str, Any]:
+    """Build one adaptive, bounded work pack from one canonical graph snapshot.
+
+    This is the preferred agent-facing entrypoint for ordinary repository work.
+    It composes context, target briefs, analysis summary, and the existing proof
+    gate without executing commands or mutating source.
+    """
+    if not ADAPTIVE_WORK_AVAILABLE:
+        return _kernel_error(
+            "adaptive_work_unavailable",
+            "Adaptive work routing is not available.",
+        )
+    if not isinstance(task, str) or not task.strip():
+        return _kernel_error(
+            "empty_work_task",
+            "Adaptive work requires a non-empty task.",
+        )
+    normalized_goal = str(goal or "auto").strip().lower()
+    if normalized_goal not in WORK_GOALS:
+        return _kernel_error(
+            "invalid_work_goal",
+            "Adaptive work goal is invalid.",
+            requested_goal=goal,
+            supported_goals=list(WORK_GOALS),
+        )
+    normalized_depth = str(depth or "auto").strip().lower()
+    if normalized_depth not in WORK_DEPTHS:
+        return _kernel_error(
+            "invalid_work_depth",
+            "Adaptive work depth is invalid.",
+            requested_depth=depth,
+            supported_depths=list(WORK_DEPTHS),
+        )
+    root_error = _validate_scan_root(scan_root)
+    if root_error:
+        return root_error
+    if target_files is not None and not isinstance(target_files, list):
+        return _kernel_error(
+            "invalid_work_targets",
+            "Adaptive work target_files must be a list of paths.",
+        )
+    targets = list(target_files or [])
+    if (
+        len(targets) > 8
+        or any(not isinstance(value, str) or not value.strip() for value in targets)
+    ):
+        return _kernel_error(
+            "invalid_work_targets",
+            "Adaptive work accepts at most eight non-empty target paths.",
+            target_count=len(targets),
+            maximum=8,
+        )
+    if (
+        isinstance(max_findings, bool)
+        or not isinstance(max_findings, int)
+        or not 0 <= max_findings <= 100
+    ):
+        return _kernel_error(
+            "invalid_work_finding_limit",
+            "max_findings must be an integer between 0 and 100.",
+            max_findings=max_findings,
+            minimum=0,
+            maximum=100,
+        )
+    if (
+        isinstance(budget_tokens, bool)
+        or not isinstance(budget_tokens, int)
+        or not MIN_BUDGET_TOKENS <= budget_tokens <= MAX_BUDGET_TOKENS
+    ):
+        return _kernel_error(
+            "invalid_context_budget",
+            "Adaptive work budget is outside the context contract.",
+            budget_tokens=budget_tokens,
+            minimum=MIN_BUDGET_TOKENS,
+            maximum=MAX_BUDGET_TOKENS,
+        )
+    if (
+        isinstance(max_hops, bool)
+        or not isinstance(max_hops, int)
+        or not 0 <= max_hops <= MAX_HOPS
+    ):
+        return _kernel_error(
+            "invalid_context_hops",
+            "Adaptive work max_hops is outside the context contract.",
+            max_hops=max_hops,
+            minimum=0,
+            maximum=MAX_HOPS,
+        )
+    if detail not in ("outline", "source"):
+        return _kernel_error(
+            "invalid_context_detail",
+            "Adaptive work detail must be outline or source.",
+            detail=detail,
+            supported_details=["outline", "source"],
+        )
