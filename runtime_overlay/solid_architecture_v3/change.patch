+def _cli_memory_operation(op: str, argv: List[str], arg_offset: int) -> bool:
+    """Shared CLI parser for both legacy `memory_<op>` and `memory <op>` commands."""
+    usage_prefix = "hott_kernel.py memory_" if arg_offset == 2 else "memory "
+
+    if op == "store":
+        type_aliases = {
+            "episodic": "episodic",
+            "event": "episodic",
+            "log": "episodic",
+            "observation": "episodic",
+            "semantic": "semantic",
+            "architectural": "semantic",
+            "architecture": "semantic",
+            "fact": "semantic",
+            "knowledge": "semantic",
+            "note": "semantic",
+            "design": "semantic",
+            "procedural": "procedural",
+            "workflow": "procedural",
+            "skill": "procedural",
+            "strategy": "procedural",
+            "action": "procedural",
+        }
+        pos_args = []
+        idx = arg_offset
+        while idx < len(argv):
+            tok = argv[idx]
+            if tok.startswith("--"):
+                if tok in ("--type", "--source", "--importance", "--tags", "--content") and idx + 1 < len(argv):
+                    idx += 2
+                else:
+                    idx += 1
+                continue
+            pos_args.append(tok)
+            idx += 1
+        flag_type = _cli_flag_value(argv, "--type")
+        flag_content = _cli_flag_value(argv, "--content")
+        if len(pos_args) >= 2 and pos_args[0].lower() in type_aliases:
+            mem_type = type_aliases[pos_args[0].lower()]
+            content = pos_args[1]
+        elif len(pos_args) >= 1:
+            raw_t = (flag_type or "semantic").lower()
+            mem_type = type_aliases.get(raw_t, raw_t)
+            content = flag_content if (flag_content and pos_args[0].lower() in type_aliases) else pos_args[0]
+        elif flag_content:
+            raw_t = (flag_type or "semantic").lower()
+            mem_type = type_aliases.get(raw_t, raw_t)
+            content = flag_content
+        else:
+            _emit_cli_result({"error": f"Usage: {usage_prefix}store [<type>] <content> [--type episodic|semantic|procedural] [--source src] [--importance 0.5] [--tags t1,t2]"})
+            return True
+        _emit_cli_result(kernel_memory_store(
+            mem_type,
+            content,
+            _cli_flag_value(argv, "--source", default="manual"),
+            _cli_float_flag(argv, "--importance", 0.5),
+            _cli_flag_value(argv, "--tags"),
+        ))
+        return True
+    if op in ("recall", "list", "search"):
+        raw_q = argv[arg_offset] if len(argv) > arg_offset and not argv[arg_offset].startswith("--") else None
+        query = None if (raw_q is not None and op == "list" and os.path.isdir(raw_q)) else raw_q
+        _emit_cli_result(kernel_memory_recall(
+            query,
+            _cli_flag_value(argv, "--type"),
+            _cli_flag_value(argv, "--tags"),
+            _cli_int_flag(argv, "--limit", 20),
+        ))
+        return True
+    if op == "analyze":
+        analyzers_raw = _cli_flag_value(argv, "--analyzers")
+        _emit_cli_result(kernel_memory_analyze(
+            analyzers_raw.split(",") if analyzers_raw is not None else None,
+            _cli_flag_value(argv, "--output", default="full"),
+            include_historical="--include-historical" in argv,
+            include_provenance="--include-provenance" in argv,
+        ))
+        return True
+    if op in ("stats", "status"):
+        _emit_cli_result(kernel_memory_stats())
+        return True
+    if op == "associate":
+        if len(argv) < arg_offset + 3:
+            _emit_cli_result({"error": f"Usage: {usage_prefix}associate <from_id> <to_id> <type> [--strength 0.7]"})
+            return True
+        _emit_cli_result(kernel_memory_associate(
+            argv[arg_offset],
+            argv[arg_offset + 1],
+            argv[arg_offset + 2],
+            _cli_float_flag(argv, "--strength", 0.5),
+        ))
+        return True
+    if op == "consolidate":
+        content = _cli_flag_value(argv, "--content", default="")
+        raw_ids = argv[arg_offset] if len(argv) > arg_offset and not argv[arg_offset].startswith("--") else None
+        if not content and (raw_ids is None or os.path.isdir(raw_ids)):
+            _emit_cli_result(kernel_memory_consolidate_auto(
+                _cli_int_flag(argv, "--min-size", 3),
+                _cli_float_flag(argv, "--importance", 0.9),
+            ))
+            return True
+        if not raw_ids:
+            _emit_cli_result({"error": f"Usage: {usage_prefix}consolidate [<id1,id2,...> --content '...'] [--min-size 3]"})
+            return True
+        if not content:
+            _emit_cli_result({"error": "--content is required"})
+            return True
+        _emit_cli_result(kernel_memory_consolidate(
+            raw_ids.split(","),
+            content,
+            _cli_flag_value(argv, "--tags"),
+            _cli_float_flag(argv, "--importance", 0.9),
+        ))
+        return True
+    if op == "steer":
+        _emit_cli_result(kernel_memory_steer(_cli_flag_value(argv, "--output", default="full")))
+        return True
+    if op == "establish":
+        _emit_cli_result(kernel_memory_establish())
+        return True
+    if op == "drift":
+        _emit_cli_result(kernel_memory_drift())
+        return True
+    if op == "get":
+        if len(argv) < 4:
+            _emit_cli_result({"error": "Usage: memory get <memory_id>"})
+            return True
+        _emit_cli_result(kernel_memory_get(argv[3]))
+        return True
+    if op == "betti_breakdown":
+        _emit_cli_result(kernel_memory_betti_breakdown())
+        return True
+    if op == "consolidate_by_tag":
+        if len(argv) < 4:
+            _emit_cli_result({"error": "Usage: memory consolidate_by_tag <tag> [--content '...'] [--importance 0.9]"})
+            return True
+        _emit_cli_result(kernel_memory_consolidate_by_tag(
+            argv[3],
+            _cli_flag_value(argv, "--content"),
+            _cli_float_flag(argv, "--importance", 0.9),
+        ))
+        return True
+    if op == "consolidate_auto":
+        _emit_cli_result(kernel_memory_consolidate_auto(
+            _cli_int_flag(argv, "--min-size", 3),
+            _cli_float_flag(argv, "--importance", 0.9),
+        ))
+        return True
+    if op == "unconsolidated_tags":
+        _emit_cli_result(kernel_memory_unconsolidated_tags())
+        return True
+    if op == "compact":
+        only_consolidated = True
+        memory_type = "episodic"
+        dry_run = False
+        restore_all = False
+        restore_id = None
+        stats = False
+        i = 3
+        while i < len(argv):
+            arg = argv[i]
+            if arg == "--consolidated":
+                only_consolidated = True
+            elif arg == "--all":
+                only_consolidated = False
+            elif arg == "--type" and i + 1 < len(argv):
+                memory_type = argv[i + 1]
+                i += 1
+            elif arg == "--dry-run":
+                dry_run = True
+            elif arg == "--restore-all":
+                restore_all = True
+            elif arg == "--restore" and i + 1 < len(argv):
+                restore_id = argv[i + 1]
+                i += 1
+            elif arg == "--stats":
+                stats = True
+            i += 1
+        _emit_cli_result(kernel_memory_compact(
+            only_consolidated=only_consolidated,
+            memory_type=memory_type,
+            dry_run=dry_run,
+            restore_id=restore_id,
+            restore_all=restore_all,
+            stats=stats,
+        ))
+        return True
+    if op == "bridge":
+        if len(argv) < 5:
+            _emit_cli_result({"error": "Usage: memory bridge <from_id> <to_id> [type] [--strength 0.7]"})
+            return True
+        assoc_type = argv[5] if len(argv) > 5 and not argv[5].startswith("--") else "semantic"
+        _emit_cli_result(kernel_memory_bridge(
+            argv[3],
+            argv[4],
+            assoc_type,
+            _cli_float_flag(argv, "--strength", 0.7),
+            "--unsafe" not in argv,
+        ))
+        return True
+    if op == "bridge_auto":
+        _emit_cli_result(kernel_memory_bridge_auto(
+            _cli_int_flag(argv, "--min-shared-tags", 1),
+            _cli_flag_value(argv, "--type", default="semantic"),
+            "--unsafe" not in argv,
+            "--dry-run" in argv,
+        ))
+        return True
+    if op == "bridge_candidates":
+        _emit_cli_result(kernel_memory_bridge_candidates(
+            _cli_int_flag(argv, "--min-shared-tags", 1)
+        ))
+        return True
+    if op == "kan":
+        if len(argv) < 4:
+            _emit_cli_result({"error": "Usage: memory kan <query> [--mode lan|ran|both] [--max-depth 2]"})
+            return True
+        kan_mode = _cli_flag_value(argv, "--mode", default="both")
+        if kan_mode not in ("lan", "ran", "both"):
+            _emit_cli_result({"error": f"Invalid mode: {kan_mode}. Use lan, ran, or both."})
+            return True
+        _emit_cli_result(kernel_memory_kan(
+            argv[3],
+            kan_mode,
+            _cli_int_flag(argv, "--max-depth", 2),
+        ))
+        return True
+    return False
+
