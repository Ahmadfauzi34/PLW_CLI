+def _cli_flag_value(argv: List[str], *flags: str, default: Any = None) -> Any:
+    value = default
+    flag_set = set(flags)
+    is_output_flag = "--output" in flag_set
+    if is_output_flag:
+        flag_set.add("--format")
+    for i, arg in enumerate(argv):
+        if arg in flag_set and i + 1 < len(argv):
+            value = argv[i + 1]
+        elif "=" in arg:
+            flag_name, _, flag_val = arg.partition("=")
+            if flag_name in flag_set:
+                value = flag_val
+    if is_output_flag and isinstance(value, str) and value.strip().lower() == "json":
+        return "full"
+    return value
