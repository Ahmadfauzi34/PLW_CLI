+"""Shared schema, canonical language inventory, candidate builders, and brace-language lexical primitives."""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+from language_semantics import is_declaration_file
+
+SIMPLIFICATION_SCHEMA_VERSION = "self-simplification-v14-js-structural-v2"
+
+
+DEFAULT_IGNORES = {
+    ".git", "__pycache__", "node_modules", "dist", "coverage",
+    "build", ".gradle", ".angular", "target",
+}
+
+
+def _sha(value: str) -> str:
+    return f"sha256:{hashlib.sha256(value.encode('utf-8')).hexdigest()}"
+
+
+def _graph_signature(graph: Dict[str, Any]) -> str:
+    from core.shared_graph import graph_content_signature
+    return graph_content_signature(graph)
+
+
+def _canonical_language_inventory(graph: Dict[str, Any]) -> Dict[str, Any]:
+    """Describe reference coverage separately from semantic-rule coverage."""
+    suffix_counts = {
+        ".ts": 0, ".tsx": 0, ".js": 0, ".jsx": 0,
+        ".mjs": 0, ".cjs": 0, ".mts": 0, ".cts": 0,
+        ".py": 0, ".rs": 0, ".kt": 0,
+    }
+    for raw_path in graph.get("vertices", []) or []:
+        path = str(raw_path)
+        if is_declaration_file(path):
+            continue
+        for suffix in suffix_counts:
+            if path.endswith(suffix):
+                suffix_counts[suffix] += 1
+                break
+    observed = [suffix for suffix, count in suffix_counts.items() if count]
+    semantic_frontends = {
+        ".py": "python_ast",
+        ".ts": "js_structural_v2",
+        ".tsx": "js_structural_v2",
+        ".js": "js_structural_v2",
+        ".jsx": "js_structural_v2",
+        ".mjs": "js_structural_v2",
+        ".cjs": "js_structural_v2",
+        ".mts": "js_structural_v2",
+        ".cts": "js_structural_v2",
+        ".rs": "rs_structural_v1",
+        ".kt": "kt_structural_v1",
+    }
+    uncovered = [suffix for suffix in observed if suffix not in semantic_frontends]
+    python_count = suffix_counts[".py"]
+    return {
+        "reference_source_counts": suffix_counts,
+        "reference_observed_extensions": observed,
+        "semantic_rule_frontends": semantic_frontends,
+        "reference_covered_but_semantic_rules_pending": uncovered,
+        "zero_candidate_is_clean_evidence": not (python_count == 0 and bool(uncovered)),
+        "zero_candidate_interpretation": (
+            "NOT_CLEAN_EVIDENCE_SEMANTIC_FRONTEND_UNAVAILABLE"
+            if python_count == 0 and uncovered
+            else "CANDIDATE_RESULT_APPLIES_TO_ACTIVE_SEMANTIC_FRONTEND_ONLY"
+        ),
+    }
+
+
+def _matching_js_brace(masked: str, start: int) -> int:
+    if start < 0 or start >= len(masked) or masked[start] != "{":
+        return -1
+    depth = 0
+    for idx, char in enumerate(masked[start:], start):
+        depth += char == "{"
+        depth -= char == "}"
+        if depth == 0:
+            return idx
+    return -1
+
+
+def _matching_js_delimiter(masked: str, start: int, opening: str, closing: str) -> int:
+    if start < 0 or start >= len(masked) or masked[start] != opening:
+        return -1
+    depth = 0
+    for idx in range(start, len(masked)):
+        char = masked[idx]
+        if char == opening:
+            depth += 1
+        elif char == closing:
+            depth -= 1
+            if depth == 0:
+                return idx
+    return -1
+
+
+def _skip_js_space(masked: str, position: int) -> int:
+    while position < len(masked) and masked[position].isspace():
+        position += 1
+    return position
+
+
+_CONTINUATION_OPERATORS = set("=,:?([{+-*/%&|!~^.<>")
+
+
+_CONTINUATION_KEYWORDS = {
+    "else", "return", "throw", "try", "do", "case", "yield", "await",
+}
+
+
+_CLAUSE_WITH_PAREN_KEYWORDS = {"if", "for", "while", "with", "catch", "switch", "when"}
+
+
+_TAIL_CONTINUATION_START_CHARS = set(".?:+-*/%&|^=<>)];}")
+
+
+_TAIL_CONTINUATION_KEYWORDS = ("as", "is", "in", "instanceof", "else")
+
+
+_INLINE_COMMENT_RE = re.compile(r"//[^\n]*|/\*[\s\S]*?\*/")
+
+
+def _extract_exact_forwarding_args(
+    source: str, masked: str, abs_start: int, abs_end: int,
+) -> Optional[List[str]]:
+    """Extract conservative plain-identifier forwarding argument tokens using masked + raw slices."""
+    args_src = source[abs_start:abs_end]
+    args_mask = masked[abs_start:abs_end]
+    if not args_src.strip() and not args_mask.strip():
+        return []
+    pieces: List[str] = []
+    last = 0
+    paren = bracket = brace = angle = 0
+    for idx, ch in enumerate(args_mask):
+        if ch == "(":
+            paren += 1
+        elif ch == ")":
+            if paren == 0:
+                return None
+            paren -= 1
+        elif ch == "[":
+            bracket += 1
+        elif ch == "]":
+            if bracket == 0:
+                return None
+            bracket -= 1
+        elif ch == "{":
+            brace += 1
+        elif ch == "}":
+            if brace == 0:
+                return None
+            brace -= 1
+        elif ch == "<":
+            angle += 1
+        elif ch == ">" and angle:
+            angle -= 1
+        elif ch == "," and paren == bracket == brace == angle == 0:
+            m_piece = args_mask[last:idx].strip()
+            s_piece = args_src[last:idx].strip()
+            if not m_piece or m_piece != s_piece:
+                return None
+            pieces.append(m_piece)
+            last = idx + 1
+    if paren or bracket or brace or angle:
+        return None
+    m_piece = args_mask[last:].strip()
+    s_piece = args_src[last:].strip()
+    if not m_piece or m_piece != s_piece:
+        return None
+    pieces.append(m_piece)
+    return pieces
+
+
+def _preceded_by_keyword(masked: str, pos: int, keyword: str) -> bool:
+    """Return True when *pos* is immediately preceded (modulo whitespace/masked comments) by *keyword*."""
+    idx = pos - 1
+    while idx >= 0 and masked[idx].isspace():
+        idx -= 1
+    start = idx - len(keyword) + 1
+    if start < 0 or masked[start:idx + 1] != keyword:
+        return False
+    if start > 0 and (masked[start - 1].isalnum() or masked[start - 1] in "_$"):
+        return False
+    return True
+
+
+def _leading_statement_boundary_ok(prefix_raw: str) -> bool:
+    """Reject brace-less clause headers (`if (...) return`) and expression continuations before a terminal."""
+    prefix = prefix_raw.rstrip()
+    if not prefix:
+        return True
+    last = prefix[-1]
+    if last in ";}":
+        return True
+    if last in _CONTINUATION_OPERATORS:
+        return False
+    had_newline = "\n" in prefix_raw[len(prefix):]
+    if last == ")":
+        if not had_newline:
+            return False
+        depth = 1
+        idx = len(prefix) - 2
+        while idx >= 0 and depth > 0:
+            if prefix[idx] == ")":
+                depth += 1
+            elif prefix[idx] == "(":
+                depth -= 1
+            idx -= 1
+        if depth != 0:
+            return False
+        while idx >= 0 and prefix[idx].isspace():
+            idx -= 1
+        if idx >= 0 and (prefix[idx].isalnum() or prefix[idx] in "_$"):
+            end_tok = idx + 1
+            while idx >= 0 and (prefix[idx].isalnum() or prefix[idx] in "_$"):
+                idx -= 1
+            word = prefix[idx + 1:end_tok]
+            if word in _CLAUSE_WITH_PAREN_KEYWORDS:
+                return False
+        return True
+    word_match = re.search(r"[A-Za-z_$][A-Za-z0-9_$]*$", prefix)
+    if word_match and word_match.group(0) in _CONTINUATION_KEYWORDS:
+        return False
+    return had_newline
+
+
+def _terminal_top_level_statement_kind(
+    masked_segment: str,
+    terminal_kinds: Tuple[str, ...],
+    *,
+    source_segment: str = "",
+) -> Optional[str]:
+    """Return the terminal keyword iff the final top-level statement in *masked_segment* is directly terminal."""
+    n = len(masked_segment)
+    brace = paren = bracket = 0
+    last_stmt: Optional[Tuple[str, int, int]] = None
+    i = 0
+    while i < n:
+        ch = masked_segment[i]
+        if ch == "{":
+            brace += 1
+        elif ch == "}":
+            brace -= 1
+        elif ch == "(":
+            paren += 1
+        elif ch == ")":
+            paren -= 1
+        elif ch == "[":
+            bracket += 1
+        elif ch == "]":
+            bracket -= 1
+        elif brace == paren == bracket == 0 and (ch.isalpha() or ch in "_$"):
+            j = i + 1
+            while j < n and (masked_segment[j].isalnum() or masked_segment[j] in "_$"):
+                j += 1
+            word = masked_segment[i:j]
+            if word in terminal_kinds:
+                last_stmt = (word, i, j)
+            i = j
+            continue
+        if brace < 0 or paren < 0 or bracket < 0:
+            return None
+        i += 1
+    if brace != 0 or paren != 0 or bracket != 0 or last_stmt is None:
+        return None
+    kind, stmt_start, stmt_kw_end = last_stmt
+    if not _leading_statement_boundary_ok(masked_segment[:stmt_start]):
+        return None
+    src = source_segment if len(source_segment) == n else masked_segment
+    brace = paren = bracket = 0
+    saw_expr_token = False
+    line_last_nonspace = ""
+    cur_line_start = stmt_kw_end
+    for k in range(stmt_kw_end, n):
+        ch = masked_segment[k]
+        if ch == ";":
+            if brace == paren == bracket == 0:
+                return kind if not masked_segment[k + 1:].strip() else None
+            saw_expr_token = True
+            line_last_nonspace = ch
+        elif ch == "\n":
+            if brace == paren == bracket == 0:
+                rest = masked_segment[k + 1:].lstrip()
+                if not rest:
+                    return kind
+                expr_so_far = saw_expr_token or bool(_INLINE_COMMENT_RE.sub("", src[stmt_kw_end:k]).strip())
+                if not expr_so_far:
+                    return None
+                if not line_last_nonspace or line_last_nonspace not in _CONTINUATION_OPERATORS:
+                    line_word = re.search(r"([A-Za-z_]+)\s*$", masked_segment[cur_line_start:k])
+                    if not (line_word and line_word.group(1) in _TAIL_CONTINUATION_KEYWORDS):
+                        if rest[0] not in _TAIL_CONTINUATION_START_CHARS:
+                            kw_cont = re.match(r"([A-Za-z_]+)\b", rest)
+                            if not kw_cont or kw_cont.group(1) not in _TAIL_CONTINUATION_KEYWORDS:
+                                return None
+            cur_line_start = k + 1
+            line_last_nonspace = ""
+        elif not ch.isspace():
+            saw_expr_token = True
+            line_last_nonspace = ch
+        if ch == "{":
+            brace += 1
+        elif ch == "}":
+            brace -= 1
+        elif ch == "(":
+            paren += 1
+        elif ch == ")":
+            paren -= 1
+        elif ch == "[":
+            bracket += 1
+        elif ch == "]":
+            bracket -= 1
+        if brace < 0 or paren < 0 or bracket < 0:
+            return None
+    if brace or paren or bracket:
+        return None
+    return kind
+
+
+def _relative(path: Path, root: Path) -> str:
+    return path.resolve().relative_to(root.resolve()).as_posix()
+
+
+def _relative_graph_path(path: str, root: Path) -> str:
+    try:
+        return Path(path).resolve().relative_to(root.resolve()).as_posix()
+    except Exception:
+        normalized = str(path).replace("\\", "/")
+        root_norm = root.resolve().as_posix().rstrip("/")
+        prefix = root_norm + "/"
+        return normalized[len(prefix):] if normalized.startswith(prefix) else normalized
+
+
+def _member(rel: str, name: str, start: int, end: int, *, private: Optional[bool] = None) -> Dict[str, Any]:
+    return {
+        "file": rel, "name": name, "line_start": int(start), "line_end": int(end),
+        "loc": int(end) - int(start) + 1, "private": name.startswith("_") if private is None else bool(private),
+    }
+
+
+def _candidate(
+    *, identity: Dict[str, Any], kind: str, files: List[str], names: List[str],
+    members: List[Dict[str, Any]], estimated_loc: int, witness: Dict[str, Any],
+    proof_rule: str, validation: List[str], duplicate_loc: int = 0,
+) -> Dict[str, Any]:
+    """Canonical candidate envelope shared by semantic simplification rules."""
+    return {
+        "candidate_id": _sha(json.dumps(identity, sort_keys=True)),
+        "kind": kind, "files": files, "names": names, "members": members,
+        "member_count": len(members), "estimated_removable_loc": int(estimated_loc),
+        "estimated_removable_duplicate_loc": int(duplicate_loc),
+        "semantic_witness": witness,
+        "proof_obligation": {"required": True, "rule": proof_rule, "validation": validation},
+    }
