+def _cli_fiber(argv: List[str]) -> None:
+    cleaned: List[str] = []
+    i = 2
+    root_dir = None
+    while i < len(argv):
+        tok = argv[i]
+        if tok == "--json":
+            i += 1
+            continue
+        if tok == "--root" and i + 1 < len(argv):
+            root_dir = argv[i + 1]
+            i += 2
+            continue
+        if tok.startswith("--root="):
+            root_dir = tok.split("=", 1)[1]
+            i += 1
+            continue
+        cleaned.append(tok)
+        i += 1
+    if cleaned and os.path.isdir(cleaned[0]):
+        root_dir = root_dir or cleaned.pop(0)
+    elif len(cleaned) >= 2 and os.path.isdir(cleaned[-1]) and cleaned[0].replace("-", "_") in (
+        "status", "stats", "info", "list", "archives", "list_archives", "section_status"
+    ):
+        root_dir = root_dir or cleaned.pop(-1)
+    if root_dir:
+        try:
+            _bind_memory_scope_to_scan(root_dir)
+        except Exception:
+            pass
+    if not cleaned:
+        subcommand = "status"
+        rest: List[str] = []
+    else:
+        subcommand = cleaned[0].lower().replace("-", "_")
+        rest = cleaned[1:]
+    alias_map = {
+        "list": "list_archives",
+        "archives": "list_archives",
+        "stats": "status",
+        "info": "status",
+        "start_section": "section_start",
+        "add_section": "section_add",
+    }
+    subcommand = alias_map.get(subcommand, subcommand)
+    if subcommand in ("--help", "-h", "help"):
+        _emit_cli_result({
+            "mode": "fiber",
+            "usage": "plw fiber [status|init|lift|descend|section-start|section-add|section-status|switch|transport|list-archives] [args] [--root DIR] [--json]",
+        })
+        return
+    if subcommand == "transport":
+        if len(rest) < 3:
+            _emit_cli_result({
+                "error": "Usage: fiber transport <source_fiber_id> <new_task> <new_focus> [--threshold 0.6] [--max 10] [--dry-run]"
+            })
+            return
+        _emit_cli_result(kernel_fiber_transport(
+            rest[0],
+            rest[1],
+            rest[2],
+            _cli_float_flag(argv, "--threshold", 0.6),
+            _cli_int_flag(argv, "--max", 10),
+            "--dry-run" in argv,
+        ))
+    elif subcommand == "list_archives":
+        _emit_cli_result(kernel_fiber_list_archives())
+    else:
+        _emit_cli_result(kernel_fiber(subcommand, rest))
+
