+def _sync_facade_attr(name: str, value: Any) -> None:
+    """Keep the thin hott_kernel facade module synchronized on mutable runtime state."""
+    facade = sys.modules.get("hott_kernel")
+    if facade is not None:
+        setattr(facade, name, value)
