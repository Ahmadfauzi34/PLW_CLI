+                rel=rel, masked=masked, position=match.start(), line_start=line_start, line_end=line_end,
+                kind="js_try_catch_identical_terminal_return",
+                identity={"expr": try_ret["expression_fingerprint"]},
+                witness={
+                    "type": "js_try_catch_identical_terminal_return_v1",
+                    "same_owner_file": True, "terminal_return_expression_identical": True,
+                    "return_expression_nonthrowing_literal": True,
+                    "return_expression_fingerprint": try_ret["expression_fingerprint"],
+                    "try_prefix_preserved": True, "catch_prefix_preserved": True,
+                    "catch_boundary_preserved": True, "finally_absent": True,
+                    "prior_return_absent_in_try_and_catch_prefix": True,
+                    "regex_or_division_token_absent_in_candidate_span": True,
+                    "authority": "bounded_js_lexical_control_flow_witness_only",
+                },
+                proof_rule="hoist only the identical non-throwing terminal return after try/catch while preserving both prefixes and the catch boundary",
+                validation=[
+                    "preserve try-prefix side effects and await ordering",
+                    "preserve catch exception swallowing and catch-prefix side effects",
+                    "do not move a potentially throwing return expression outside the catch boundary",
+                    "run affected TS/Angular tests and reference-machine topology/context checks",
+                ],
+            ))
+    return candidates
+
+
+def _js_terminal_literal_temporary_candidates(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    """Find a terminal ``const x = <literal>; return x;`` using the shared mask."""
+    candidates: List[Dict[str, Any]] = []
+    pattern = re.compile(
+        r"\bconst\s+(?P<name>[A-Za-z_$][A-Za-z0-9_$]*)(?:\s*:\s*[^\s=;{}][^=;{}]*)?\s*=(?P<expr>[^;{}]+);"
+        r"\s*return\s+(?P=name)\s*;"
+    )
+    for rel, source, masked in sources:
+        for match in pattern.finditer(masked):
+            after = match.end()
+            while after < len(masked) and masked[after].isspace(): after += 1
+            if after >= len(masked) or masked[after] != "}":
+                continue
+            raw_expr = source[match.start("expr"):match.end("expr")].strip()
+            if not _js_nonthrowing_literal(raw_expr):
+                continue
+            name = match.group("name")
+            line_start = source.count("\n", 0, match.start()) + 1
+            line_end = source.count("\n", 0, match.end()) + 1
+            candidates.append(_js_candidate_row(
+                rel=rel, masked=masked, position=match.start(), line_start=line_start, line_end=line_end,
+                kind="js_terminal_literal_temporary",
+                identity={"binding": name, "expr": _sha(raw_expr)},
+                witness={
+                    "type": "js_terminal_literal_temporary_v1", "same_owner_file": True,
+                    "adjacent_assignment_return": True, "const_binding": True,
+                    "returned_name_matches_assignment": True, "return_expression_nonthrowing_literal": True,
+                    "terminal_return_in_same_block": True, "shared_mask_js_noncode_reused": True,
+                    "shared_nonthrowing_literal_predicate_reused": True, "shared_function_labeling_reused": True,
+                    "authority": "bounded_js_lexical_terminal_temporary_witness_only",
+                },
+                proof_rule="inline only an adjacent terminal const bound to a non-throwing literal into its return statement",
+                validation=[
+                    "preserve literal value and return ordering",
+                    "do not inline calls/member access/object literals or other potentially throwing expressions",
+                    "do not claim debugger/line-event equivalence",
+                    "run affected TS/Angular tests when applying a target patch",
+                ],
+            ))
+    return candidates
+
+
+def _js_function_body_open(masked: str, after_params: int) -> int:
+    """Find a conservative block-body brace after a JS/TS parameter list.
+
+    The helper understands the common ``): Type {`` shape and skips a leading
+    TypeScript object return type ``): { ... } {``.  Ambiguous signatures are
+    intentionally rejected by returning ``-1`` rather than guessing.
+    """
+    pos = _skip_js_space(masked, after_params)
+    colon_seen = pos < len(masked) and masked[pos] == ":"
+    while pos < len(masked):
+        if masked.startswith("=>", pos):
+            pos = _skip_js_space(masked, pos + 2)
+            return pos if pos < len(masked) and masked[pos] == "{" else -1
+        if masked[pos] == ";":
+            return -1
+        if masked[pos] == "{":
+            if not colon_seen:
+                return pos
+            prefix = masked[after_params:pos].strip()
+            last = prefix[-1:] if prefix else ""
+            # ``): {a: T} {`` or ``): Foo | {a:T} {``: first brace is type.
+            if prefix == ":" or last in ("|", "&", "<", ",", "("):
+                type_close = _matching_js_delimiter(masked, pos, "{", "}")
+                if type_close < 0:
+                    return -1
+                pos = _skip_js_space(masked, type_close + 1)
+                continue
+            return pos
+        pos += 1
+    return -1
+
+
+def _js_simple_parameter_names(source: str, masked: str, open_pos: int, close_pos: int) -> Optional[List[str]]:
+    """Return simple JS/TS parameter names or None for destructuring/defaults."""
+    raw = source[open_pos + 1:close_pos]
+    code = masked[open_pos + 1:close_pos]
+    pieces: List[Tuple[str, str]] = []
+    last = 0
+    paren = bracket = brace = angle = 0
+    for idx, ch in enumerate(code):
+        if ch == "(": paren += 1
+        elif ch == ")": paren -= 1
+        elif ch == "[": bracket += 1
+        elif ch == "]": bracket -= 1
+        elif ch == "{": brace += 1
+        elif ch == "}": brace -= 1
+        elif ch == "<": angle += 1
+        elif ch == ">" and angle: angle -= 1
+        elif ch == "," and paren == bracket == brace == angle == 0:
+            pieces.append((raw[last:idx], code[last:idx])); last = idx + 1
+    pieces.append((raw[last:], code[last:]))
+    if len(pieces) == 1 and not pieces[0][1].strip():
+        return []
+    names: List[str] = []
+    for raw_piece, code_piece in pieces:
+        token = code_piece.strip()
+        if not token or any(symbol in token for symbol in ("...", "=", "{", "[")):
+            return None
+        match = re.fullmatch(
+            r"(?:(?:public|private|protected|readonly|override)\s+)*"
+            r"(?P<name>[A-Za-z_$][A-Za-z0-9_$]*)\s*\??\s*(?::[\s\S]+)?",
+            token,
+        )
+        if not match:
+            return None
+        names.append(match.group("name"))
+    return names
+
+
+def _js_function_records(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    """Discover conservative block-bodied JS/TS functions, arrows and class methods."""
+    records: List[Dict[str, Any]] = []
+    seen: set[Tuple[str, int]] = set()
+
+    def add_record(rel: str, source: str, masked: str, *, name: str, start: int,
+                   params_open: int, params_close: int, body_open: int,
+                   exported: bool, private: bool, async_fn: bool, form: str) -> None:
+        body_close = _matching_js_brace(masked, body_open)
+        if body_close < 0 or (rel, body_open) in seen:
+            return
+        params = _js_simple_parameter_names(source, masked, params_open, params_close)
+        seen.add((rel, body_open))
+        records.append({
+            "file": rel, "source": source, "masked": masked, "name": name,
+            "start": start, "params_open": params_open, "params_close": params_close,
+            "params": params, "body_open": body_open, "body_close": body_close,
+            "line_start": source.count("\n", 0, start) + 1,
+            "line_end": source.count("\n", 0, body_close) + 1,
+            "exported": bool(exported), "private": bool(private),
+            "async": bool(async_fn), "form": form,
+        })
+
+    for rel, source, masked in sources:
+        declaration = re.compile(
+            r"(?P<export>\bexport\s+(?:default\s+)?)?(?P<async>\basync\s+)?"
+            r"\bfunction\s*\*?\s*(?P<name>[A-Za-z_$][A-Za-z0-9_$]*)\s*(?:<[^;{}()]*>)?\s*\("
+        )
+        for match in declaration.finditer(masked):
+            params_open = masked.find("(", match.start(), match.end())
+            params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+            if params_close < 0:
+                continue
+            body_open = _js_function_body_open(masked, params_close + 1)
+            if body_open < 0:
+                continue
+            name = match.group("name")
+            add_record(rel, source, masked, name=name, start=match.start(),
+                       params_open=params_open, params_close=params_close, body_open=body_open,
+                       exported=bool(match.group("export")), private=name.startswith("_"),
+                       async_fn=bool(match.group("async")), form="function_declaration")
+
+        arrow = re.compile(
+            r"(?P<export>\bexport\s+)?\b(?:const|let|var)\s+"
+            r"(?P<name>[A-Za-z_$][A-Za-z0-9_$]*)\s*(?:\??\s*:\s*[^=;]+)?\s*=\s*"
+            r"(?P<async>async\s+)?(?P<params>\([^;{}]*\)|[A-Za-z_$][A-Za-z0-9_$]*)"
+            r"\s*(?::\s*[^=;{}]+)?\s*=>\s*\{"
+        )
+        for match in arrow.finditer(masked):
+            params_text = match.group("params")
+            if params_text.startswith("("):
+                params_open = match.start("params")
+                params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+            else:
+                # Normalize one bare arrow parameter into a synthetic span that
+                # the forwarding rule can still compare directly.
+                params_open = params_close = -1
+            body_open = masked.find("{", match.start("params"), match.end())
+            if body_open < 0:
+                continue
+            name = match.group("name")
+            if params_open < 0:
+                body_close = _matching_js_brace(masked, body_open)
+                if body_close < 0 or (rel, body_open) in seen:
+                    continue
+                seen.add((rel, body_open))
+                records.append({
+                    "file": rel, "source": source, "masked": masked, "name": name,
+                    "start": match.start(), "params_open": -1, "params_close": -1,
+                    "params": [params_text], "body_open": body_open, "body_close": body_close,
+                    "line_start": source.count("\n", 0, match.start()) + 1,
+                    "line_end": source.count("\n", 0, body_close) + 1,
+                    "exported": bool(match.group("export")), "private": name.startswith("_"),
+                    "async": bool(match.group("async")), "form": "arrow_block",
+                })
+            else:
+                add_record(rel, source, masked, name=name, start=match.start(),
+                           params_open=params_open, params_close=params_close, body_open=body_open,
+                           exported=bool(match.group("export")), private=name.startswith("_"),
+                           async_fn=bool(match.group("async")), form="arrow_block")
+
+        for class_match in re.finditer(r"\bclass\s+[A-Za-z_$][A-Za-z0-9_$]*[^{};]*\{", masked):
+            class_open = masked.find("{", class_match.start(), class_match.end())
+            class_close = _matching_js_brace(masked, class_open)
+            if class_close < 0:
+                continue
+            class_body = masked[class_open + 1:class_close]
+            method = re.compile(
+                r"(?m)^[ \t]*(?P<mods>(?:(?:public|private|protected|static|readonly|override|async)\s+)*)"
+                r"(?P<name>#?[A-Za-z_$][A-Za-z0-9_$]*)\s*(?:<[^;{}()]*>)?\s*\("
+            )
+            for match in method.finditer(class_body):
+                absolute = class_open + 1 + match.start()
+                # Only direct class members; nested function-like text is ignored.
+                prefix = masked[class_open + 1:absolute]
+                if prefix.count("{") != prefix.count("}"):
+                    continue
+                name = match.group("name")
+                if name in {"if", "for", "while", "switch", "catch", "with"}:
+                    continue
+                params_open = masked.find("(", absolute, class_open + 1 + match.end())
+                params_close = _matching_js_delimiter(masked, params_open, "(", ")")
+                if params_close < 0:
+                    continue
+                body_open = _js_function_body_open(masked, params_close + 1)
+                if body_open < 0 or body_open > class_close:
+                    continue
+                mods = match.group("mods") or ""
+                add_record(rel, source, masked, name=name, start=absolute,
+                           params_open=params_open, params_close=params_close, body_open=body_open,
+                           exported=False, private=(name.startswith("#") or "private" in mods.split()),
+                           async_fn="async" in mods.split(), form="class_method")
+
+    records.sort(key=lambda row: (row["file"], row["start"], row["name"]))
+    return records
+
+
+def _js_normalized_body_tokens(source: str, start: int, end: int) -> Optional[List[str]]:
+    """Tokenize a JS body conservatively for exact-structure fingerprinting.
+
+    Comments/formatting are ignored, while string/template literal bytes and
+    punctuator boundaries are preserved. Regex/division-heavy bodies are
+    rejected because this frontend intentionally does not guess that ambiguity.
+    """
+    tokens: List[str] = []
+    i = start
+    punctuators = (
+        ">>>=", "**=", "&&=", "||=", "??=", "===", "!==", ">>>", "<<=", ">>=",
+        "=>", "==", "!=", "<=", ">=", "++", "--", "&&", "||", "??", "?.", "**",
+        "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "...",
+    )
+    while i < end:
+        ch = source[i]
+        if ch.isspace():
+            i += 1; continue
+        if ch == "/" and i + 1 < end and source[i + 1] == "/":
+            newline = source.find("\n", i + 2, end)
+            i = end if newline < 0 else newline + 1; continue
+        if ch == "/" and i + 1 < end and source[i + 1] == "*":
+            close = source.find("*/", i + 2, end)
+            if close < 0: return None
+            i = close + 2; continue
+        if ch == "/":
+            return None
+        if ch in ("'", '"', "`"):
+            quote, j, escaped = ch, i + 1, False
+            while j < end:
+                current = source[j]
+                if escaped:
+                    escaped = False
+                elif current == "\\":
+                    escaped = True
+                elif current == quote:
+                    j += 1; break
+                j += 1
+            if j > end: return None
+            tokens.append(source[i:j]); i = j; continue
+        ident = re.match(r"[A-Za-z_$][A-Za-z0-9_$]*", source[i:end])
+        if ident:
+            value = ident.group(0); tokens.append(value); i += len(value); continue
+        number = re.match(r"(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)n?", source[i:end])
+        if number:
+            value = number.group(0); tokens.append(value); i += len(value); continue
+        matched = next((op for op in punctuators if source.startswith(op, i)), None)
+        if matched:
+            tokens.append(matched); i += len(matched); continue
+        tokens.append(ch); i += 1
+    return tokens
+
+
+def _js_direct_forwarding_wrapper_candidates(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    candidates: List[Dict[str, Any]] = []
+    for fn in _js_function_records(sources=sources):
+        params = fn.get("params")
+        if params is None or fn.get("async"):
+            continue
+        body_start = fn["body_open"] + 1
+        body_mask = fn["masked"][body_start:fn["body_close"]]
+        match = re.fullmatch(
+            r"\s*return\s+(?P<callee>[A-Za-z_$][A-Za-z0-9_$]*)\s*\((?P<args>[^;{}()]*)\)\s*;?\s*",
+            body_mask,
+            flags=re.S,
+        )
+        if not match or match.group("callee") == fn["name"]:
+            continue
+        raw_args = _extract_exact_forwarding_args(
+            fn["source"],
+            fn["masked"],
+            body_start + match.start("args"),
+            body_start + match.end("args"),
+        )
+        if raw_args is None or raw_args != list(params):
+            continue
+        private = bool(fn["private"])
+        candidates.append(_candidate(
+            identity={"file": fn["file"], "kind": "js_direct_forwarding_wrapper", "function": fn["name"], "callee": match.group("callee")},
+            kind="js_direct_forwarding_wrapper", files=[fn["file"]], names=[fn["name"]],
+            members=[_member(fn["file"], fn["name"], fn["line_start"], fn["line_end"], private=private)],
+            estimated_loc=max(1, fn["line_end"] - fn["line_start"] + 1),
+            witness={
+                "type": "js_direct_forwarding_wrapper_v2", "same_owner_file": True,
+                "simple_parameters_only": True, "argument_forwarding_exact": True,
+                "direct_identifier_callee": True, "async_wrapper_excluded": True,
+                "wrapper_exported": bool(fn["exported"]), "wrapper_private": private,
+                "function_form": fn["form"], "callee": match.group("callee"),
+                "authority": "bounded_js_structural_forwarding_witness_only",
+            },
+            proof_rule="remove/share a JS forwarding wrapper only when callable/API identity and all consumers remain compatible",
+            validation=[
+                "preserve exported/public callable names unless compatibility is explicitly retained",
+                "preserve this-binding by allowing only direct identifier callees in V2",
+                "preserve argument order and arity", "run affected TS/JS tests and type-check",
+            ],
+        ))
+    return candidates
+
+
+def _js_exact_function_body_duplication_candidates(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    grouped: Dict[str, List[Dict[str, Any]]] = {}
+    for fn in _js_function_records(sources=sources):
+        raw_body = fn["source"][fn["body_open"] + 1:fn["body_close"]]
+        if fn["file"].endswith((".tsx", ".jsx")) and "<" in fn["masked"][fn["body_open"] + 1:fn["body_close"]]:
+            continue
+        tokens = _js_normalized_body_tokens(fn["source"], fn["body_open"] + 1, fn["body_close"])
+        if tokens is None or len(tokens) < 8:
+            continue
+        fingerprint = _sha(json.dumps(tokens, ensure_ascii=False, separators=(",", ":")))
+        grouped.setdefault(fingerprint, []).append(fn)
+    candidates: List[Dict[str, Any]] = []
+    for fingerprint, members in grouped.items():
+        if len(members) < 2:
+            continue
+        files = sorted({row["file"] for row in members})
+        names = sorted({row["name"] for row in members})
+        locs = sorted((row["line_end"] - row["line_start"] + 1 for row in members), reverse=True)
+        removable = sum(locs[1:])
+        if removable <= 0:
+            continue
+        candidates.append(_candidate(
+            identity={"kind": "js_exact_function_body_duplication", "body": fingerprint, "files": files, "names": names},
+            kind="js_exact_function_body_duplication", files=files, names=names,
+            members=[_member(row["file"], row["name"], row["line_start"], row["line_end"], private=row["private"]) for row in members],
+            estimated_loc=removable, duplicate_loc=removable,
+            witness={
+                "type": "js_exact_function_body_tokens_v2", "exact_token_body_identical": True,
+                "comments_and_formatting_ignored": True, "string_and_template_literal_bytes_preserved": True,
+                "regex_or_division_ambiguous_bodies_excluded": True,
+                "jsx_body_token_equivalence_not_claimed": True,
+                "member_count": len(members), "body_fingerprint": fingerprint,
+                "authority": "bounded_js_token_body_duplication_witness_only",
+            },
+            proof_rule="share exact JS/TS function-body implementations only behind a neutral owner while preserving every public callable surface",
+            validation=[
+                "preserve exported/public functions as compatibility wrappers when required",
+                "preserve module initialization and import behavior", "run affected TS/JS tests and type-check",
+            ],
+        ))
+    return candidates
+
+
+def _js_redundant_else_after_terminal_candidates(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    candidates: List[Dict[str, Any]] = []
+    for rel, source, masked in sources:
+        for match in re.finditer(r"\bif\s*\(", masked):
+            if (
+                _preceded_by_keyword(masked, match.start(), "else")
+                or _preceded_by_keyword(masked, match.start(), "return")
+            ):
+                continue
+            cond_open = masked.find("(", match.start(), match.end())
+            cond_close = _matching_js_delimiter(masked, cond_open, "(", ")")
+            if cond_close < 0:
+                continue
+            then_open = _skip_js_space(masked, cond_close + 1)
+            if then_open >= len(masked) or masked[then_open] != "{":
+                continue
+            then_close = _matching_js_brace(masked, then_open)
+            if then_close < 0:
+                continue
+            terminal_kind = _terminal_top_level_statement_kind(
+                masked[then_open + 1:then_close],
+                ("return", "throw"),
+                source_segment=source[then_open + 1:then_close],
+            )
+            if terminal_kind is None:
+                continue
+            cursor = _skip_js_space(masked, then_close + 1)
+            if not masked.startswith("else", cursor):
+                continue
+            if cursor + 4 < len(masked) and (masked[cursor + 4].isalnum() or masked[cursor + 4] in "_$"):
+                continue
+            else_open = _skip_js_space(masked, cursor + 4)
+            if else_open >= len(masked) or masked[else_open] != "{":
+                continue
+            else_close = _matching_js_brace(masked, else_open)
+            if else_close < 0:
+                continue
+            line_start = source.count("\n", 0, match.start()) + 1
+            line_end = source.count("\n", 0, else_close) + 1
+            candidates.append(_js_candidate_row(
+                rel=rel, masked=masked, position=match.start(), line_start=line_start, line_end=line_end,
+                kind="js_redundant_else_after_terminal",
+                identity={"terminal": terminal_kind, "else_line": source.count("\n", 0, cursor) + 1},
+                witness={
+                    "type": "js_redundant_else_after_terminal_v2", "same_owner_file": True,
+                    "then_block_directly_terminal": True, "terminal_kind": terminal_kind,
+                    "else_is_braced": True, "else_if_excluded": True,
+                    "else_if_chain_inner_if_excluded": True,
+                    "condition_evaluation_preserved": True, "else_block_scope_must_be_preserved": True,
+                    "authority": "bounded_js_structural_control_flow_witness_only",
+                },
+                proof_rule="remove only the redundant else keyword while preserving the else block as a standalone block after a directly terminal then-branch",
+                validation=[
+                    "preserve condition evaluation exactly once", "preserve else-block lexical scope braces",
+                    "preserve return/throw control flow", "run affected TS/JS tests and type-check",
+                ],
+            ))
+    return candidates
+
+
+def _js_boolean_guard_return_candidates(*, sources: List[Tuple[str, str, str]]) -> List[Dict[str, Any]]:
+    """Find exact, bounded ``if (condition) return bool; return !bool`` sites.
+
+    Earlier V2 code matched one greedy condition across an entire function.
+    That could attach a valid terminal pair to unrelated preceding branches.
+    This detector now emits one candidate per exact source span so identity,
+    planner input, and later selection all name the same site.
+    """
+    candidates: List[Dict[str, Any]] = []
+    terminal_pair = re.compile(
+        r"(?m)"
+        r"^(?P<indent>[ \t]*)if[ \t]*\((?P<cond>[^\r\n()]*)\)[ \t]*\{[ \t]*(?P<nl>\r?\n)"
+        r"(?P<bodyindent>[ \t]+)return[ \t]+(?P<first>true|false)(?P<semi1>;?)[ \t]*(?P=nl)"
+        r"(?P=indent)\}[ \t]*(?P=nl)"
+        r"(?:[ \t]*(?:\r?\n))*"
+        r"(?P=indent)return[ \t]+(?P<second>true|false)(?P<semi2>;?)[ \t]*(?=(?:\r?\n|$))"
+    )
+    simple_strict_string = re.compile(
+        r"^\s*(?P<left>[A-Za-z_$][A-Za-z0-9_$]*(?:\.[A-Za-z_$][A-Za-z0-9_$]*)*)"
+        r"\s*(?P<operator>===|!==|==|!=)\s*"
+        r"(?P<right>'(?:\\.|[^'\\])*'|\"(?:\\.|[^\"\\])*\")\s*$"
+    )
+    for fn in _js_function_records(sources=sources):
+        body_start = fn["body_open"] + 1
+        body_end = fn["body_close"]
