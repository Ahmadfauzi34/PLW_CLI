+            "schema_version": CODEBASE_SCHEMA_VERSION,
+            "mode": "cycle_break",
+            "scan_root": scan_root,
+            "graph_cache": graph.get("cache", {}),
+            "summary": plan,
+        }
+        if target_norm is not None:
+            out["target"] = target_norm
+        return out
