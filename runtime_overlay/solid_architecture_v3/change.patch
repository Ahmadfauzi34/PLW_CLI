+def _cli_cycle_break(argv: List[str]) -> None:
+    target_file = _cli_flag_value(argv, "--target", "--target-file", "--file")
+    output_mode = _cli_flag_value(argv, "--output", default="full")
+    flag_root = _cli_flag_value(argv, "--root")
+    pos_args: List[str] = []
+    skip_next = False
+    for idx in range(2, len(argv)):
+        if skip_next:
+            skip_next = False
+            continue
+        arg = argv[idx]
+        if arg in ("--target", "--target-file", "--file", "--output", "--format", "--root", "--cache-mode"):
+            skip_next = True
+            continue
+        if arg.startswith("-"):
+            continue
+        pos_args.append(arg)
+    if flag_root:
+        root = flag_root
+        if target_file is None and pos_args:
+            target_file = pos_args[0]
+    elif len(pos_args) >= 2:
+        p0, p1 = pos_args[0], pos_args[1]
+        if os.path.isdir(p1) and not os.path.isdir(p0):
+            root = p1
+            if target_file is None:
+                target_file = p0
+        else:
+            root = p0
+            if target_file is None:
+                target_file = p1
+    elif len(pos_args) == 1:
+        root = pos_args[0]
+    else:
+        root = "."
+    _emit_cli_result(kernel_cycle_break(root, target_file, output_mode))
+
