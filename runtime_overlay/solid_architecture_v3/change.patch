+
+
+def _function_body_fingerprint(node: ast.AST) -> str:
+    body = _without_docstring(list(getattr(node, "body", [])))
+    normalized = ast.dump(
+        ast.Module(body=body, type_ignores=[]),
+        include_attributes=False,
+        annotate_fields=True,
+    )
+    return _sha(normalized)
