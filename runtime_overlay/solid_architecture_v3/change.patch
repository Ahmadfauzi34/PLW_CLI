+    root_error = _validate_scan_root(scan_root)
+    if root_error:
+        return root_error
+    output_error = _validate_output_mode(
+        output_mode,
+        ("full", "summary", "findings"),
+    )
+    if output_error:
+        return output_error
+
+    # Step 1: Build SharedGraph (1x scan)
+    graph = _rt._resolve_hook("_build_kernel_graph", _build_kernel_graph)(scan_root)
+
+    # Step 2: Run ALL 13 analyzers
+    analyzer_output = _rt._resolve_hook("_run_kernel_analyzers", _run_kernel_analyzers)(graph, analyzer_names)
+    results = analyzer_output.get("results", {})
+
+    # Step 3: Fingerprint via invariant_encoder
+    fingerprint = None
