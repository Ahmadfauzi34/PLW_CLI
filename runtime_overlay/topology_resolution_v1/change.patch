+def rust_cargo_targets(manifest_text: str) -> Dict[str, Any]:
+    """Parse [package], [lib], and [[bin]] targets from a Cargo.toml manifest."""
+    chunks: List[Tuple[str, str]] = []
+    current = ""
+    start = 0
+    for match in _RUST_TOML_SECTION_REGEX.finditer(manifest_text):
+        chunks.append((current, manifest_text[start : match.start()]))
+        current = match.group(1).strip()
+        start = match.end()
+    chunks.append((current, manifest_text[start:]))
+
+    package_text = ""
+    for sec, body in chunks:
+        if sec == "package":
+            package_text = body
+            break
+
+    pkg_match = _RUST_TOML_NAME_REGEX.search(package_text)
+    package = pkg_match.group(1) if pkg_match else ""
+    build_match = _RUST_TOML_BUILD_REGEX.search(package_text)
+    build_script: Optional[str] = "build.rs"
+    if build_match:
+        build_script = None if build_match.group(2) == "false" else build_match.group(1)
+    autobins_match = _RUST_TOML_AUTOBINS_REGEX.search(package_text)
+    autobins = (autobins_match.group(1) != "false") if autobins_match else True
+
+    lib_declared = False
+    lib_name = package.replace("-", "_") if package else ""
+    lib_path = "src/lib.rs"
+    crate_types: List[str] = []
+    bins: List[Dict[str, str]] = []
+
+    for sec, body in chunks:
+        if sec == "lib":
+            lib_declared = True
+            nm = _RUST_TOML_NAME_REGEX.search(body)
+            if nm:
+                lib_name = nm.group(1)
+            pm = _RUST_TOML_PATH_REGEX.search(body)
+            if pm:
+                lib_path = pm.group(1)
+            ct = _RUST_TOML_CRATE_TYPE_REGEX.search(body)
+            if ct:
+                crate_types = re.findall(r'"([^"]+)"', ct.group(1))
+        elif sec == "[bin]":
+            nm = _RUST_TOML_NAME_REGEX.search(body)
+            pm = _RUST_TOML_PATH_REGEX.search(body)
+            bins.append({
+                "name": nm.group(1) if nm else "",
+                "path": pm.group(1) if pm else "",
+            })
+
+    return {
