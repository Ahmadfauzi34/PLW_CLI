+def kotlin_strip_comments_and_strings(content: str) -> str:
+    """Strip Kotlin comments (incl. nested /* /* */ */) and string/char literals.
+
+    Preserves exact newline count so line numbers never shift and avoids false
+    token matches inside comments, KDoc, raw strings, and string literals.
+    """
+    if not content:
+        return content
+    out: List[str] = []
+    pos = 0
+    n = len(content)
+    while pos < n:
+        match = _KOTLIN_STRIP_TOKEN_REGEX.search(content, pos)
+        if not match:
+            out.append(content[pos:])
+            break
+        start = match.start()
+        if start > pos:
+            out.append(content[pos:start])
+        tok = match.group(0)
+        if tok == "/*":
+            depth = 1
+            cur = match.end()
+            while cur < n and depth > 0:
+                idx_open = content.find("/*", cur)
+                idx_close = content.find("*/", cur)
+                if idx_close == -1:
+                    cur = n
+                    break
+                if idx_open != -1 and idx_open < idx_close:
+                    depth += 1
+                    cur = idx_open + 2
+                else:
+                    depth -= 1
+                    cur = idx_close + 2
+            span = content[start:cur]
+            if "\n" in span:
+                out.append("\n".join(" " * len(line) for line in span.split("\n")))
+            else:
+                out.append(" " * len(span))
+            pos = cur
+        else:
+            if "\n" in tok:
+                out.append("\n".join(" " * len(line) for line in tok.split("\n")))
+            else:
+                out.append(" " * len(tok))
+            pos = match.end()
+    return "".join(out)
+
