+def kotlin_same_package_declarations(
+    content: str,
+    _stripped: Optional[str] = None,
+) -> Dict[str, str]:
+    """Extract non-private top-level Kotlin declarations safe for same-package linking.
+
+    Returns {symbol_name: kind} with kind in {"pascal", "const", "fun"}:
+    - Excludes file-`private` top-level declarations (visibility boundary in Kotlin).
+    - Excludes extension declarations (`Modifier.onUnhandledTap`) which require dot syntax.
+    - Requires len(name) >= 3; types/vals must start uppercase; common stdlib fun names dropped.
+    """
+    clean = _stripped if _stripped is not None else kotlin_strip_comments_and_strings(content)
+    decls: Dict[str, str] = {}
+    for match in _KOTLIN_SAME_PKG_DECL_REGEX.finditer(clean):
+        mods = set((match.group("mods") or "").split())
+        if "private" in mods:
+            continue
+        if match.group("recv"):
+            continue
+        kw = match.group("kw")
+        name = match.group("name")
+        if len(name) < 3:
+            continue
+        if kw in ("class", "interface", "object", "typealias", "enum"):
+            if name[0].isupper():
+                decls.setdefault(name, "pascal")
+        elif kw in ("val", "var"):
+            if name[0].isupper():
+                decls.setdefault(name, "const")
+        elif kw == "fun":
+            if name not in _KOTLIN_STDLIB_COMMON_FUNS:
+                decls.setdefault(name, "fun")
+    return decls
+
