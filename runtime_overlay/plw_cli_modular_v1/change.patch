-def _validate_task_receipt(stage, task, scan_root, receipt):
-    """Check a previous stage's receipt against this invocation.
-
-    Returns None when the receipt chains here, else an error string.
-    """
-    if not isinstance(receipt, dict):
-        return "receipt must be a JSON object"
-    if receipt.get("schema_version") != hott_kernel._TASK_RECEIPT_SCHEMA:
-        return "receipt schema_version must be %s" % hott_kernel._TASK_RECEIPT_SCHEMA
-    prev_stage = receipt.get("stage")
-    allowed, _ = hott_kernel._TASK_PIPELINE[stage]
-    if prev_stage not in allowed:
-        return "stage %s cannot follow receipt stage %s (expected one of: %s)" % (
-            stage, prev_stage, ", ".join(allowed),
-        )
-    prev_task = receipt.get("task")
-    if hott_kernel._normalize_receipt_task(prev_task) != hott_kernel._normalize_receipt_task(task):
-        return "receipt task %r does not match this task %r" % (prev_task, task)
-    prev_root = receipt.get("scan_root")
-    if scan_root is not None:
-        if prev_root is None and prev_stage != "semantic-route":
-            return "receipt scan_root cannot be null for stage %s" % stage
-        if prev_root is not None and os.path.abspath(prev_root) != os.path.abspath(scan_root):
-            return "receipt scan_root %r does not match this root %r" % (prev_root, scan_root)
-    expect = hott_kernel._task_receipt_fingerprint(prev_stage, receipt.get("task") or "", prev_root)
-    if receipt.get("fingerprint") != expect:
-        return "receipt fingerprint does not match its stage/task/root"
-    try:
-        from core.accountability_provenance import TASK_RECEIPT_ISSUER, verify_payload
-        seal_core = hott_kernel._task_receipt_seal_core(receipt)
-        if not verify_payload(seal_core, receipt.get("provenance"), TASK_RECEIPT_ISSUER):
-            return "receipt provenance seal is missing or invalid (forged or unsealed receipt)"
-    except Exception as exc:
-        return "receipt provenance verification failed: %s" % exc
-    if scan_root is not None and prev_root is not None:
-        prev_graph_sig = receipt.get("graph_signature")
-        if not isinstance(prev_graph_sig, str) or not prev_graph_sig.startswith("sha256:"):
-            return "receipt is missing a valid graph_signature binding for target repository"
-        current_graph_sig = hott_kernel._current_graph_signature(scan_root)
-        if current_graph_sig is not None and prev_graph_sig != current_graph_sig:
-            return "receipt graph_signature %s is stale; repository changed to %s since stage %s" % (
-                prev_graph_sig[:19], current_graph_sig[:19], prev_stage,
-            )
-    return None
