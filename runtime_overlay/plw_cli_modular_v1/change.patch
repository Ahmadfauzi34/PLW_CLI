+                   "invalid_arguments", as_json=as_json, rc=2)
+        return 2
+
+    raw = sys.stdin.buffer.read()
+    try:
+        result = compact_command_output(
+            raw,
+            command=command,
+            kind=kind,
+            budget_tokens=budget,
+            store=store,
+            store_dir=store_dir,
+            telemetry=telemetry,
