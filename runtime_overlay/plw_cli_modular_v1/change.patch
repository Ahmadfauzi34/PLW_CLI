new file mode 100644
index 0000000..22ef9db
--- /dev/null
+++ b/core/cli/common.py
@@ -0,0 +1,378 @@
+"""Shared CLI parser, output-flag normalization, error reporting, and receipt helpers."""
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+import hott_kernel
+
+
+def _resolve_truth_scope(explicit_scope: Optional[str] = None) -> Optional[str]:
+    """Resolve truth-delivery scope at the CLI orchestration layer.
+
+    core truth delivery stays independent from the fibration implementation.
+    PLW may bridge to an active fiber because this CLI is the integration layer.
+    """
+    if explicit_scope and str(explicit_scope).strip():
+        return str(explicit_scope).strip()
+    env_scope = os.environ.get("PLW_TRUTH_SCOPE")
+    if env_scope and env_scope.strip():
+        return env_scope.strip()
+    try:
+        from context.fibration import load_fiber_state
+        state = load_fiber_state()
+        fiber_id = state.get("fiber_id") if isinstance(state, dict) else None
+        if fiber_id:
+            return f"fiber:{fiber_id}"
+    except Exception:
+        pass
+    return None
+
+
+def _root_flag(args: List[str]) -> Optional[str]:
+    """Return the --root DIR value if present, else None.
+
+    B1: every command that takes a [root] positional also accepts --root DIR;
+    the flag wins over the positional. Manual parsers resolve it after their
+    positional scan; argparse parsers use dest="root_flag" for the same rule.
+    """
+    for i, arg in enumerate(args):
+        if arg == "--root" and i + 1 < len(args):
+            return args[i + 1]
+    return None
+
+
+def _cli_error(message, code="invalid_arguments", *, as_json, rc=2) -> int:
+    """Emit one CLI error on the channel the output mode requires (H1/K4).
+
+    --json: a JSON envelope {"error", "detail"} on stdout, stderr empty.
+    Human: "[PLW Error] ..." on stderr, stdout empty.
+    Returns rc so callers can `return _cli_error(...)`.
+    """
+    if as_json:
+        print(json.dumps({"error": code, "detail": message}, ensure_ascii=False))
+    else:
+        print(f"[PLW Error] {message}", file=sys.stderr)
+    return rc
+
+
+class _PlwArgumentParser(argparse.ArgumentParser):
+    """ArgumentParser whose errors follow the --json contract (D2).
+
+    argparse's default error() prints usage to stderr and exits 2 --
+    right for humans, wrong for --json. This override emits through
+    _cli_error (JSON envelope on stdout when --json was passed) and
+    exits 2. The argv is stored by _parse_cli_args before parsing so
+    error() knows the output mode even when called after parsing
+    (e.g. cmd_ast's resolve_error path).
+    """
+
+    _plw_argv: List[str] = []
+
+    def error(self, message):
+        as_json = "--json" in self._plw_argv
+        if not as_json:
+            # Human mode keeps argparse's native shape: usage first,
+            # then the error line (the --json envelope carries no usage).
+            self.print_usage(sys.stderr)
+        _cli_error(message, "invalid_arguments", as_json=as_json, rc=2)
+        raise SystemExit(2)
+
+
+def _normalize_output_json_argv(parser, argv: List[str]) -> List[str]:
+    """Normalize --output json / --format json consistently for --json commands.
+
+    Preserves fail-closed behavior for invalid values (e.g. --output bogus)
+    by only rewriting explicit 'json' values when the parser accepts --json.
+    """
+    actions = getattr(parser, "_option_string_actions", {}) or {}
+    if "--json" not in actions:
+        return list(argv)
+    has_output = "--output" in actions
+    has_format = "--format" in actions
+    out: List[str] = []
+    i = 0
+    n = len(argv)
+    while i < n:
+        tok = argv[i]
+        if tok == "--":
+            out.extend(argv[i:])
+            break
+        tok_l = tok.lower()
+        if tok_l in ("--output=json", "--format=json"):
+            if tok_l.startswith("--output=") and has_output:
+                out.extend(["--output", "full", "--json"])
+            elif tok_l.startswith("--format=") and has_format:
+                out.append(tok)
+            else:
+                out.append("--json")
+            i += 1
+            continue
+        if tok_l in ("--output", "--format") and i + 1 < n and str(argv[i + 1]).strip().lower() == "json":
+            if tok_l == "--output" and has_output:
+                out.extend(["--output", "full", "--json"])
+            elif tok_l == "--format" and has_format:
+                out.extend([tok, argv[i + 1]])
+            else:
+                out.append("--json")
+            i += 2
+            continue
+        out.append(tok)
+        i += 1
+    return out
+
+
+def _parse_cli_args(parser, argv):
+    """Parse argv with a _PlwArgumentParser (D2 wrapper).
+
+    parse_intermixed_args (not parse_args): options may appear in any
+    position, which is what the old manual parsers already accepted
+    (they scanned the whole argv). Plain parse_args fails on
+    `ast index --root DIR status` -- argparse cannot match a trailing
+    nargs="?" positional after an option -- while the intermixed form
+    handles it. No parser here uses subparsers, which intermixed
+    parsing does not support. The three REMAINDER parsers
+    (lease/proof/ledger forward raw args to the kernel) fall back to
+    parse_args: intermixed parsing raises TypeError for REMAINDER.
+    The error() override still routes their failures via _cli_error.
+    """
+    norm_argv = _normalize_output_json_argv(parser, list(argv))
+    parser._plw_argv = list(norm_argv)
+    try:
+        return parser.parse_intermixed_args(norm_argv)
+    except TypeError:
+        return parser.parse_args(norm_argv)
+
+
+def _load_receipt_arg(value):
+    """Parse a --receipt value (JSON string, @path, or file path). Raises ValueError."""
+    raw = value
+    if value.startswith("@"):
+        raw = Path(value[1:]).read_text(encoding="utf-8")
+    elif not value.lstrip().startswith("{") and Path(value).is_file():
+        raw = Path(value).read_text(encoding="utf-8")
+    data = json.loads(raw)
+    if not isinstance(data, dict):
+        raise ValueError("--receipt must be a JSON object")
+    return data
+
+
+def _receipt_arg_error(message, code="receipt_mismatch", *, as_json=False):
+    return _cli_error(message, code, as_json=as_json, rc=3)
+
+
+def _validate_task_receipt(stage, task, scan_root, receipt):
+    """Check a previous stage's receipt against this invocation.
+
+    Returns None when the receipt chains here, else an error string.
+    """
+    if not isinstance(receipt, dict):
+        return "receipt must be a JSON object"
+    if receipt.get("schema_version") != hott_kernel._TASK_RECEIPT_SCHEMA:
+        return "receipt schema_version must be %s" % hott_kernel._TASK_RECEIPT_SCHEMA
+    prev_stage = receipt.get("stage")
+    allowed, _ = hott_kernel._TASK_PIPELINE[stage]
+    if prev_stage not in allowed:
+        return "stage %s cannot follow receipt stage %s (expected one of: %s)" % (
+            stage, prev_stage, ", ".join(allowed),
+        )
+    prev_task = receipt.get("task")
+    if hott_kernel._normalize_receipt_task(prev_task) != hott_kernel._normalize_receipt_task(task):
+        return "receipt task %r does not match this task %r" % (prev_task, task)
+    prev_root = receipt.get("scan_root")
+    if scan_root is not None:
+        if prev_root is None and prev_stage != "semantic-route":
+            return "receipt scan_root cannot be null for stage %s" % stage
+        if prev_root is not None and os.path.abspath(prev_root) != os.path.abspath(scan_root):
+            return "receipt scan_root %r does not match this root %r" % (prev_root, scan_root)
+    expect = hott_kernel._task_receipt_fingerprint(prev_stage, receipt.get("task") or "", prev_root)
+    if receipt.get("fingerprint") != expect:
+        return "receipt fingerprint does not match its stage/task/root"
+    try:
+        from core.accountability_provenance import TASK_RECEIPT_ISSUER, verify_payload
+        seal_core = hott_kernel._task_receipt_seal_core(receipt)
+        if not verify_payload(seal_core, receipt.get("provenance"), TASK_RECEIPT_ISSUER):
+            return "receipt provenance seal is missing or invalid (forged or unsealed receipt)"
+    except Exception as exc:
+        return "receipt provenance verification failed: %s" % exc
+    if scan_root is not None and prev_root is not None:
+        prev_graph_sig = receipt.get("graph_signature")
+        if not isinstance(prev_graph_sig, str) or not prev_graph_sig.startswith("sha256:"):
+            return "receipt is missing a valid graph_signature binding for target repository"
+        current_graph_sig = hott_kernel._current_graph_signature(scan_root)
+        if current_graph_sig is not None and prev_graph_sig != current_graph_sig:
+            return "receipt graph_signature %s is stale; repository changed to %s since stage %s" % (
+                prev_graph_sig[:19], current_graph_sig[:19], prev_stage,
+            )
+    return None
+
+
+def _check_receipt_arg(value, stage, task, scan_root, *, as_json=False, strict_chain=False):
+    """Validate a --receipt value for a stage. Returns an exit code or None."""
+    env_strict = str(os.environ.get("PLW_RECEIPT_REQUIRED") or "").strip().lower() in (
+        "1", "true", "yes", "on"
+    )
+    if value is None:
+        if strict_chain or env_strict:
+            allowed, _ = hott_kernel._TASK_PIPELINE.get(stage, ((), None))
+            if allowed:
+                return _receipt_arg_error(
+                    "stage %s requires --receipt from previous stage (%s) when --strict-chain or PLW_RECEIPT_REQUIRED=1 is enabled"
+                    % (stage, ", ".join(allowed)),
+                    code="receipt_required",
+                    as_json=as_json,
+                )
+        return None
+    try:
+        receipt = _load_receipt_arg(value)
+    except (OSError, json.JSONDecodeError, ValueError) as exc:
+        return _cli_error("--receipt unreadable: %s" % exc, "receipt_unreadable", as_json=as_json, rc=2)
+    err = _validate_task_receipt(stage, task, scan_root, receipt)
+    if err is not None:
+        return _receipt_arg_error(err, as_json=as_json)
+    return None
+
+
+def _receipt_next_lines(result):
+    """Human-form lines for a result carrying receipt+next."""
+    lines = []
+    receipt = result.get("receipt") or {}
+    if receipt.get("fingerprint"):
+        lines.append("# Receipt: %s %s (task=%s, root=%s)" % (
+            receipt.get("stage"), str(receipt.get("fingerprint"))[:19],
+            receipt.get("task"), receipt.get("scan_root"),
+        ))
+    nxt = result.get("next")
+    if nxt:
+        lines.append("# Next: %s %s" % (nxt["command"], " ".join(nxt["args"])))
+    else:
+        lines.append("# Next: pipeline complete — no further stage.")
+    return lines
+
+
+def _parse_target_task_args(args: List[str], prog: str):
+    import argparse
+    parser = _PlwArgumentParser(prog=prog)
+    parser.add_argument("task", nargs="?", default=None)
+    parser.add_argument("root", nargs="?", default=".")
+    parser.add_argument("--task", default=None, dest="task_flag")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--receipt", default=None)
+    parser.add_argument("--strict-chain", action="store_true", dest="strict_chain")
+    parser.add_argument("--target", "--targets", "--target-file", "--target-files", "--file", action="append", default=[], dest="target")
+    parser.add_argument("--top", type=int, default=8)
+    parser.add_argument("--neighbors", type=int, default=8)
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+    opts.target = [p.strip() for item in (opts.target or []) for p in str(item).split(",") if p.strip()]
+    if opts.task_flag is not None:
+        if opts.task is not None and opts.root == "." and opts.root_flag is None:
+            opts.root = opts.task
+        opts.task = opts.task_flag
+    elif opts.root != "." and opts.root_flag is None and opts.task is not None:
+        if os.path.isdir(opts.task) and not os.path.isdir(opts.root):
+            opts.root, opts.task = opts.task, opts.root
+    elif opts.target and opts.task is not None and opts.root == "." and opts.root_flag is None and os.path.isdir(opts.task):
+        opts.root = opts.task
+        opts.task = None
+    opts.root = opts.root_flag if opts.root_flag is not None else opts.root
+    if not opts.task and opts.target:
+        opts.task = " ".join(opts.target)
+    if not opts.task:
+        parser.error("the following arguments are required: task")
+    return opts
+
+
+def _print_portable_result(result: Dict[str, Any], *, as_json: bool, title: str) -> int:
+    code = 0 if not result.get("error") and result.get("ready", True) is not False else 3
+    if as_json:
+        print(json.dumps(result, indent=2, ensure_ascii=False))
+        return code
+    print(f"# [{title}]")
+    if result.get("error"):
+        print("# Error: " + str(result.get("error")))
+        # The human rendering must carry the same pointer as the JSON
+        # rendering: an alias name is not a typo, and the agent reading
+        # this first must learn the canonical name here, not only via --json.
+        # A hint without alias_of (first-contact pointer, N3) is printed
+        # on its own: the Hint line carries any pointer describe produced.
+        if result.get("alias_of"):
+            print("# Alias of: " + str(result.get("alias_of")))
+        if result.get("hint"):
+            print("# Hint: " + str(result.get("hint")))
+        return code
+    if "ready" in result:
+        print("# Version: " + str(result.get("version")))
+        print("# READY: " + ("true" if result.get("ready") else "false") + " (portable interface + target root; stable topology is a separate check)")
+        support = result.get("target_support", {}) or {}
+        print("# Stable topology: %s | supported_files=%s | extensions=%s" % (
+            "READY" if support.get("topology_ready") else "NOT_READY",
+            support.get("supported_source_files", 0),
+            ",".join(support.get("topology_extensions", []) or []),
+        ))
+        print("# Topology support reason: " + str(support.get("reason", "unknown")))
+        for name, passed in (result.get("checks", {}) or {}).items():
+            print(f"# {name}: {'PASS' if passed else 'FAIL'}")
+        browser = ((result.get("runtime") or {}).get("browser") or {})
+        print("# Chromium: " + (str(browser.get("executable")) if browser.get("available") else "optional / not found"))
+        engine = ((result.get("runtime") or {}).get("codesearch_engine") or {})
+        print("# Tree-sitter engine: " + (str(engine.get("binary")) + " schema=" + str(engine.get("schema")) if engine.get("available") else "not found (optional for PLW itself; required for structural questions)"))
+        print("# First contact: " + str((result.get("agent") or {}).get("first_contact")))
+        return code
+    if "capabilities" in result:
+        print("# Capabilities: " + str(result.get("capability_count", 0)))
+        for row in result.get("capabilities", []):
+            print(f"{row.get('command')}\t{row.get('skill_path')}")
+        return code
+    if "skills" in result:
+        print(f"# Skills: {result.get('embedded_count', 0)}/{result.get('skill_count', 0)} embedded")
+        for row in result.get("skills", []):
+            print(f"{'OK' if row.get('embedded') else 'MISSING'}\t{row.get('skill_path')}")
+        return code
+    if "content" in result:
+        print(result.get("content", ""), end="" if str(result.get("content", "")).endswith("\n") else "\n")
+        return code
+    print(json.dumps(result, indent=2, ensure_ascii=False))
+    return code
+
+
+def _print_chain_result(result: Dict[str, Any], *, as_json: bool) -> int:
+    code = 0 if isinstance(result, dict) and not result.get("error") else 3
+    if as_json:
+        print(json.dumps(result, indent=2, ensure_ascii=False))
+        return code
+    print("# [PLW Task Pipeline Chain]")
+    if isinstance(result, dict) and result.get("error"):
+        print("# Error: " + str(result.get("error")))
+        return code
+    print("# Stages executed: " + " -> ".join(result.get("stages_executed") or []))
+    print("# Graph signature: " + str(result.get("graph_signature") or "-"))
+    resolution = ((result.get("target_resolution") or {}).get("resolution") or {})
+    print("# Target state: " + str(resolution.get("state") or "unknown"))
+    print("# Selected targets: " + ", ".join(resolution.get("selected_targets") or []))
+    deriv = result.get("evidence_need_derivation") or {}
+    for row in (deriv.get("evidence_needed") or [])[:6]:
+        if isinstance(row, dict):
+            print("# Need: " + str(row.get("need")))
+    selection = result.get("capability_selection") or {}
+    for row in (selection.get("candidate_capabilities") or [])[:6]:
+        if isinstance(row, dict):
+            print("# Candidate capability: %s | covers=%s | aggregate=%s" % (
+                row.get("capability"),
+                ",".join(row.get("covers_evidence_classes") or []),
+                row.get("aggregate_score"),
+            ))
+    cand_prov = result.get("candidate_provenance")
+    if isinstance(cand_prov, dict):
+        csel = cand_prov.get("candidate_selection") or {}
+        print("# Candidate selection: %s (%s)" % (
+            csel.get("resolution") or "-",
+            csel.get("selected_candidate_id") or "-",
+        ))
+    print("# Authority: single-process read-only pipeline chain; HMAC provenance-sealed receipts")
+    for line in _receipt_next_lines(result):
+        print(line)
+    return code
