+def cmd_validation_lease(args: List[str]) -> int:
+    """Acquire or inspect one F134 single-use validation execution lease."""
+    usage = (
+        "Usage:\n"
+        "  plw validation-lease acquire <plan.json> <evidence.json> <obligations.json> <assertion.json> "
+        "--request-id ID --validator-id ID --executor-id ID --idempotency-key KEY "
+        "[--lease-ttl-seconds N] [--store-dir DIR] --allow-state-change [--json]\n"
+        "  plw validation-lease status <sha256:lease-id> [--request-id ID] [--executor-id ID] "
+        "[--store-dir DIR] [--json]"
+    )
+    if not args or args[0] in ("-h", "--help", "help"):
+        print(usage)
+        return 0 if args else 2
+    operation = args[0].lower()
+    if operation not in {"acquire", "status"}:
+        # Track 3: dispatch errors follow the --json contract (usage only in human mode).
+        _cli_error(f"Unknown validation-lease operation: {operation}", "invalid_arguments", as_json="--json" in args, rc=2)
+        if "--json" not in args:
+            print(usage, file=sys.stderr)
+        return 2
+
+    # Track 3: argparse via the shared wrapper (was a manual index loop).
+    # operation is validated above (argparse choices would print the
+    # usage without the two-form usage text this command documents).
+    parser = _PlwArgumentParser(prog="plw validation-lease")
+    parser.add_argument("positional", nargs="*")
+    parser.add_argument("--store-dir", default=None)
+    parser.add_argument("--request-id", default=None)
+    parser.add_argument("--validator-id", default=None)
+    parser.add_argument("--executor-id", default=None)
+    parser.add_argument("--idempotency-key", default=None)
+    parser.add_argument("--lease-ttl-seconds", type=int, default=15)
+    parser.add_argument("--allow-state-change", action="store_true")
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args[1:])
+    positionals = opts.positional
+    store_dir = opts.store_dir
+    request_id = opts.request_id
+    validator_id = opts.validator_id
+    executor_id = opts.executor_id
+    idempotency_key = opts.idempotency_key
+    lease_ttl_seconds = opts.lease_ttl_seconds
+    allow_state_change = opts.allow_state_change
+    as_json = opts.as_json
+
+    if operation == "status":
+        if len(positionals) != 1:
+            _cli_error("validation-lease status requires exactly one lease id",
+                       "invalid_arguments", as_json=as_json, rc=2)
+            return 2
+        if allow_state_change or validator_id is not None or idempotency_key is not None or lease_ttl_seconds != 15:
+            _cli_error("validation-lease status is read-only; remove acquire-only options",
+                       "invalid_arguments", as_json=as_json, rc=2)
+            return 2
+        result = inspect_validation_execution_lease(
+            positionals[0], request_id=request_id, executor_id=executor_id, store_dir=store_dir,
+        )
+        if as_json:
+            print(json.dumps(result, indent=2, ensure_ascii=False))
+        else:
+            print("# [PLW Validation Execution Lease Status]")
+            print(f"# Lease: {result.get('lease_id', positionals[0])}")
+            print(f"# Decision: {result.get('decision', result.get('error'))}")
+            print("# Authority: inspection only; it cannot regrant attempt registration or dispatch.")
+        return 0 if result.get("lease_found") else 3
+
+    if len(positionals) != 4:
+        _cli_error("validation-lease acquire requires <plan.json> <evidence.json> <obligations.json> <assertion.json>",
+                   "invalid_arguments", as_json=as_json, rc=2)
+        return 2
+    if not request_id or not validator_id or not executor_id or not idempotency_key:
+        _cli_error("validation-lease acquire requires --request-id, --validator-id, --executor-id, and --idempotency-key",
+                   "invalid_arguments", as_json=as_json, rc=2)
