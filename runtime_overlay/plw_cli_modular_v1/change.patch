+def _parse_ui_map_args(args: List[str], *, inspect: bool = False) -> Optional[Dict[str, Any]]:
+    # Track 3: argparse via the shared wrapper (was a manual loop that
+    # printed missing-value/bad-number/unknown-flag errors to stderr
+    # even with --json, and swallowed nothing -- kept fail-closed).
+    parser = _PlwArgumentParser(prog="plw ui inspect" if inspect else "plw ui map")
+    parser.add_argument("positional", nargs="*")
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    parser.add_argument("--no-resources", action="store_true")
+    parser.add_argument("--min-gap", type=float, default=0.0, dest="min_gap_px")
+    parser.add_argument("--max-elements", type=int, default=200)
+    parser.add_argument("--max-issues", type=int, default=100)
+    parser.add_argument("--cache-mode", default=None)
+    parser.add_argument("--root", default=None, dest="root_flag")
+    opts = _parse_cli_args(parser, args)
+    parsed: Dict[str, Any] = {
+        "as_json": opts.as_json, "read_resources": not opts.no_resources,
+        "cache_mode": opts.cache_mode, "min_gap_px": opts.min_gap_px,
+        "max_elements": opts.max_elements, "max_issues": opts.max_issues,
+        "positional": opts.positional, "root_flag": opts.root_flag,
+    }
+    needed = 2 if inspect else 1
+    max_pos = 3 if inspect else 2
+    if len(parsed["positional"]) < needed or len(parsed["positional"]) > max_pos:
+        usage = "<snapshot.json> <ui-id> [root]" if inspect else "<snapshot.json> [root]"
+        _cli_error(f"ui {'inspect' if inspect else 'map'} requires {usage}",
+                   "invalid_arguments", as_json=bool(parsed["as_json"]), rc=2)
+        return None
+    return parsed
+
+
+def _build_practical_ui_map(parsed: Dict[str, Any], *, inspect_id: Optional[str] = None) -> Dict[str, Any]:
+    positional = parsed["positional"]
+    snapshot_path = positional[0]
+    root = parsed.get("root_flag") or (positional[2] if inspect_id is not None and len(positional) == 3 else (positional[1] if inspect_id is None and len(positional) == 2 else "."))
+    if not _apply_ui_reference_cache_mode(parsed.get("cache_mode"), as_json=bool(parsed.get("as_json"))):
+        raise UIMapperError("invalid graph cache mode")
+    payload, graph, ownership = _load_ui_reference_inputs(snapshot_path, root, read_resources=bool(parsed["read_resources"]))
+    ui_reference = build_ui_reference_state(payload, ownership)
+    max_elements = 50000 if inspect_id is not None else int(parsed["max_elements"])
+    return build_ui_map(
+        payload, ui_reference=ui_reference, angular_ownership=ownership,
+        min_gap_px=float(parsed["min_gap_px"]), max_elements=max_elements,
+        max_issues=int(parsed["max_issues"]),
+    )
+
