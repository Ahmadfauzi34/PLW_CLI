+            pos_root = opts.goal
+        elif opts.goal is None and pos_root != "." and not os.path.isdir(pos_root) and " " in pos_root:
+            pos_root = "."
+    root = opts.root_flag or pos_root or "."
+    cache_mode = opts.cache_mode
+    as_json = opts.as_json
+
+    if cache_mode is not None:
