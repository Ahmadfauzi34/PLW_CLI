+    executor_id = opts.executor_id
+    allow_state_change = opts.allow_state_change
+    as_json = opts.as_json
+    lease_id = opts.lease_id
+
+    if operation == "status":
+        if lease_id is None:
+            _cli_error("action-outcome status requires a lease id",
+                       "invalid_arguments", as_json=as_json, rc=2)
+            return 2
+        if allow_state_change:
+            _cli_error("status is read-only; remove --allow-state-change",
