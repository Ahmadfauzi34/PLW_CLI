+        result = static_ui_reference(opts.query, graph,
+                                     selector=opts.selector, max_candidates=opts.max_candidates)
+    except ValueError as exc:
+        print(json.dumps({"error": str(exc), "error_code": "invalid_static_ui_query"})
+              if opts.as_json else f"[PLW Error] {exc}", file=sys.stderr)
+        return 2
+    if opts.as_json:
+        print(json.dumps(result, indent=2, ensure_ascii=False))
+    else:
+        decision = result["decision"]
+        print("# [PLW UI Static Reference]")
+        print("# Status: " + decision["status"])
+        print("# Candidates: " + str(decision["matching_candidate_count"]))
+        for item in result["candidates"]:
+            t_line = item.get("template_line")
+            d_line = item.get("template_declaration_line")
+            loc_suffix = (
+                f":{t_line}"
+                if t_line is not None
+                else (f"@decl:{d_line}" if d_line is not None else "")
+            )
+            el = item["element"]
+            label = el["label"]
+            attrs = el.get("attributes") or {}
+            ev_attr_keys = list(((item.get("match_evidence") or {}).get("attribute_terms") or {}).keys())
+            shown_attrs = []
+            for key in ev_attr_keys + ["aria-label", "title", "id", "name", "routerlink", "class"]:
+                if key in attrs and key not in {k for k, _ in shown_attrs}:
+                    val = str(attrs[key]).strip()
+                    if val:
+                        shown_attrs.append((key, val[:48]))
+                if len(shown_attrs) >= 2:
+                    break
+            attr_note = (
+                " [" + ", ".join(f"{k}={v!r}" for k, v in shown_attrs) + "]"
+                if shown_attrs and (not label or ev_attr_keys)
+                else ""
+            )
+            print(
+                f"- {item['component_file']} -> {item['template_file']}{loc_suffix} "
+                f"{el['tag']} {label!r}{attr_note}"
+            )
+        print("# Runtime geometry: UNOBSERVED; browser execution: false")
+    return 0
