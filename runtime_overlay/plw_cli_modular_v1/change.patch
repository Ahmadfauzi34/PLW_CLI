+def _validation_boundary_parser(prog: str, operations: tuple[str, ...], identity_name: str):
+    import argparse
+    parser = _PlwArgumentParser(prog=prog)
+    parser.add_argument("operation", choices=operations)
+    parser.add_argument(identity_name)
+    return parser
