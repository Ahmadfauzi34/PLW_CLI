+def _parse_ui_reference_args(
+    args: List[str], *, command: str, allow_store_dir: bool,
+) -> Optional[Dict[str, Any]]:
+    # Track 3: argparse via the shared wrapper. Parse errors raise
+    # SystemExit(2) after _cli_error (JSON on stdout when --json,
+    # text on stderr when human); the None return below is kept as
+    # a guard for the callers' `if parsed is None: return 2`.
+    parser = _PlwArgumentParser(prog=f"plw {command}")
+    parser.add_argument("positional", nargs="*")
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    parser.add_argument("--no-resources", action="store_true")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--cache-mode", default=None)
+    if allow_store_dir:
+        parser.add_argument("--store-dir", default=None)
+    opts = _parse_cli_args(parser, args)
+    return {
+        "cache_mode": opts.cache_mode,
+        "store_dir": opts.store_dir if allow_store_dir else None,
+        "as_json": opts.as_json,
+        "read_resources": not opts.no_resources,
+        "root_flag": opts.root_flag,
+        "positional": opts.positional,
+    }
+
+
+def _apply_ui_reference_cache_mode(cache_mode: Optional[str], *, as_json: bool) -> bool:
+    if cache_mode is None:
+        return True
+    cache_error = hott_kernel._set_graph_cache_mode(cache_mode)
+    if not cache_error:
+        return True
+    # Track 3: JSON errors go to stdout when --json (was: JSON to stderr).
+    if as_json:
+        print(json.dumps(cache_error, ensure_ascii=False))
+    else:
+        print(f"[PLW Error] {cache_error.get('message')}", file=sys.stderr)
+    return False
+
+
+def _resolve_geometry_query_positionals(parsed: Dict[str, Any], command: str) -> Optional[tuple[str, str, bool]]:
+    positional = parsed["positional"]
+    if not positional or len(positional) > 2:
+        # Track 3: positional-count errors follow the --json contract.
+        _cli_error(f"{command} requires <snapshot.json> and accepts at most one root path",
+                   "invalid_arguments", as_json=bool(parsed.get("as_json")), rc=2)
+        return None
+    snapshot_path = positional[0]
+    root = parsed.get("root_flag") or (positional[1] if len(positional) == 2 else ".")
+    return snapshot_path, root, bool(parsed["as_json"])
+
+
+def _load_ui_reference_inputs(snapshot_path: str, root: str, *, read_resources: bool):
+    payload = load_geometry_snapshot(snapshot_path)
+    graph = hott_kernel._build_kernel_graph(root)
+    ownership = analyze_angular_ownership(graph, read_resources=read_resources)
+    return payload, graph, ownership
+
