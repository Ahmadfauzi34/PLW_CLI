+        "proximity_px": opts.proximity_px, "focus_ui_ids": opts.focus_ui_ids or [],
+        "as_json": opts.as_json, "read_resources": not opts.no_resources,
+        "positional": opts.positional, "root_flag": opts.root_flag,
+    }
+
+
+def _parse_geometric_impact_args(args: List[str]) -> Optional[Dict[str, Any]]:
+    # Track 3: argparse via the shared wrapper (was a manual loop).
