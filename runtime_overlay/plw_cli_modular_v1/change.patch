+def cmd_kan(args: List[str]) -> int:
+    if not args:
+        print("Usage: plw kan <target_module_or_query> [root] [--mode lan|ran|both] [--depth N] [--cache-mode auto|refresh|off] [--json]")
+        return 0
+    # Track 3: argparse via the shared wrapper (was a manual loop that
+    # took args[0] as the target whatever it was and swallowed bad ints).
+    parser = _PlwArgumentParser(prog="plw kan")
+    parser.add_argument("target")
+    parser.add_argument("root", nargs="?", default=".")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--mode", default="both")
+    parser.add_argument("--depth", "--max-depth", type=int, default=2, dest="max_depth")
+    parser.add_argument("--cache-mode", default=None)
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+    target = opts.target
+    if opts.root_flag is None and opts.root is not None and os.path.isdir(target) and not os.path.isdir(opts.root):
+        target, root = opts.root, target
+    else:
+        root = opts.root_flag or opts.root or "."
+    mode = opts.mode
+    max_depth = opts.max_depth
+    cache_mode = opts.cache_mode
+    as_json = opts.as_json
+
+    if cache_mode is not None:
+        cache_error = hott_kernel._set_graph_cache_mode(cache_mode)
+        if cache_error:
+            _format_kan_output(cache_error, as_json=as_json)
+            return 2
+
+    # Check if target is a module file or path
+    is_module_target = (
+        (Path(target).exists() and not os.path.isdir(target))
+        or (os.path.isdir(root) and (Path(root) / target).exists() and not (Path(root) / target).is_dir())
+        or "/" in target
+        or any(target.endswith(ext) for ext in source_extensions(include_python=True))
+    )
+    shared_graph = None
+    if not is_module_target and " " not in target.strip() and len(target.strip()) >= 4 and os.path.isdir(root):
+        try:
+            from codebase.topology_analyzers import _resolve_query_target
+            shared_graph = hott_kernel._build_kernel_graph(root)
+            resolved_stem, _, _ = _resolve_query_target(
+                target,
+                set(shared_graph.get("vertices", [])),
+                scan_root=shared_graph.get("scan_root") or root,
+            )
+            if resolved_stem:
+                target = resolved_stem
+                is_module_target = True
+        except Exception:
+            shared_graph = None
+
+    if is_module_target:
+        try:
+            from memory.kan_extension import impute_module_relations
+
+            # Reuse the same canonical cached SharedGraph used by context/brief/impact.
+            # This keeps module-level Kan imputation inside the incremental reference
+            # machine instead of reopening and reparsing every source file.
+            if shared_graph is None:
+                shared_graph = hott_kernel._build_kernel_graph(root)
+            res = impute_module_relations(target, shared_graph=shared_graph)
+            if isinstance(res, dict):
+                res.setdefault("graph_cache", shared_graph.get("cache", {}))
+            _format_kan_output(res, as_json=as_json)
+            return 0 if "error" not in res else 1
+        except Exception as exc:
+            # A path-like target is an explicit module-level request. Do not silently
+            # reinterpret a failed module analysis as a memory query; surface the
+            # failed transition so the agent can recover deterministically.
+            res = {
+                "error": "module_kan_failed",
+                "error_code": "module_kan_failed",
+                "target": target,
+                "scan_root": root,
+                "exception_type": type(exc).__name__,
+                "message": str(exc),
+            }
+            _format_kan_output(res, as_json=as_json)
+            return 1
+
+    res = hott_kernel.kernel_memory_kan(target, mode=mode, max_depth=max_depth)
+    _format_kan_output(res, as_json=as_json)
+    return 0 if "error" not in res else 1
+
