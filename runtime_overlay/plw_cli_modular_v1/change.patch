+def cmd_lease(args: List[str]) -> int:
+    """Namespace alias for the lease commands (additive; canonical names unchanged).
+
+    plw lease validation ... -> plw validation-lease ...
+    plw lease execution ... -> plw action-lease ...
+    """
+    import argparse
+    parser = _PlwArgumentParser(
+        prog="plw lease",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="Operations map to canonical commands:\n"
+               "  validation -> plw validation-lease\n"
+               "  execution -> plw action-lease\n"
+               "Additive aliases; canonical names unchanged.")
+    parser.add_argument("operation", choices=("validation", "execution"))
+    parser.add_argument("rest", nargs=argparse.REMAINDER)
+    opts = _parse_cli_args(parser, args)
+    if opts.operation == "validation":
+        return cmd_validation_lease(opts.rest)
+    return cmd_action_lease(opts.rest)
+
+
+def cmd_proof(args: List[str]) -> int:
+    """Namespace alias for the proof commands (additive; canonical names unchanged).
+
+    plw proof obligations ... -> plw validation-coverage ...
+    plw proof postcondition ... -> plw postcondition-proof ...
+    """
+    import argparse
+    parser = _PlwArgumentParser(
+        prog="plw proof",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="Operations map to canonical commands:\n"
+               "  obligations -> plw validation-coverage\n"
+               "  postcondition -> plw postcondition-proof\n"
+               "Additive aliases; canonical names unchanged.")
+    parser.add_argument("operation", choices=("obligations", "postcondition"))
+    parser.add_argument("rest", nargs=argparse.REMAINDER)
+    opts = _parse_cli_args(parser, args)
+    if opts.operation == "obligations":
+        return cmd_validation_coverage(opts.rest)
+    return cmd_postcondition_proof(opts.rest)
+
+
+def cmd_ledger(args: List[str]) -> int:
+    """Namespace alias for the ledger commands (additive; canonical names unchanged).
+
+    plw ledger lineage ... -> plw lineage ...
+    plw ledger accountability ... -> plw accountability ...
+    plw ledger chain ... -> plw accountability-chain ...
+    plw ledger memory ... -> plw transition-memory ...
+    plw ledger model ... -> plw transition-model ...
+    plw ledger reconcile ... -> plw reconcile-outcomes ...
+    """
+    import argparse
+    parser = _PlwArgumentParser(
+        prog="plw ledger",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="Operations map to canonical commands:\n"
+               "  lineage -> plw lineage\n"
+               "  accountability -> plw accountability\n"
+               "  chain -> plw accountability-chain\n"
+               "  memory -> plw transition-memory (not plw memory)\n"
+               "  model -> plw transition-model\n"
+               "  reconcile -> plw reconcile-outcomes\n"
+               "Additive aliases; canonical names unchanged.")
+    parser.add_argument("operation", choices=(
+        "lineage", "accountability", "chain", "memory", "status", "model", "reconcile"))
+    parser.add_argument("rest", nargs=argparse.REMAINDER)
+    opts = _parse_cli_args(parser, args)
+    if opts.operation == "lineage":
+        return cmd_lineage(opts.rest)
+    if opts.operation == "accountability":
+        return cmd_accountability(opts.rest)
+    if opts.operation == "chain":
+        return cmd_accountability_chain(opts.rest)
+    if opts.operation in ("memory", "status"):
+        return cmd_transition_memory(opts.rest)
+    if opts.operation == "model":
+        return cmd_transition_model(opts.rest)
+    return cmd_reconcile_outcomes(opts.rest)
