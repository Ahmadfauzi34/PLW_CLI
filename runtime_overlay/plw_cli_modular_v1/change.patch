+                row_names = [str(n) for n in (row.get("names", []) or [])]
+                matched_f = any(
+                    t_flt.lower() in rf.lower()
+                    or (len(t_collapsed) >= 4 and t_collapsed in re.sub(r"[._-]+", "", os.path.splitext(os.path.basename(rf))[0].lower()))
+                    for rf in row_files
+                ) or any(
+                    t_flt.lower() == rn.lower()
+                    or (len(t_collapsed) >= 4 and t_collapsed == re.sub(r"[._-]+", "", rn.lower()))
+                    for rn in row_names
+                )
+                if not matched_f:
+                    return False
+            return True
+
+        target_container = result.get("candidate", {}) if reference else result
+        if isinstance(target_container, dict) and isinstance(target_container.get("candidates"), list):
