+    if opts.target_filter or opts.kind_filter:
+        t_flt = (opts.target_filter or "").strip().replace("\\", "/").strip("/")
+        t_collapsed = re.sub(r"[._-]+", "", t_flt.lower()) if t_flt else ""
+        k_flt = (opts.kind_filter or "").strip().lower()
+
+        def _match_cand(row: Dict[str, Any]) -> bool:
+            if k_flt and k_flt not in str(row.get("kind", "")).lower():
+                return False
+            if t_flt:
