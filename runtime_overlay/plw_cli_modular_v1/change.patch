@@ -0,0 +1,277 @@
+"""Tree-sitter / codesearch-go AST CLI command handler and positional argument resolver."""
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any, Dict, List
+
+from core.cli.common import _PlwArgumentParser, _parse_cli_args
+
+
+def _resolve_ast_positionals(operation, pos1, pos2, flag_root):
+    """Resolve `plw ast` positionals to (root, query, error).
+
+    Two positionals always mean root-first: `plw ast callers <root>
+    <query>`. A single positional is the query (root is the current
+    directory) unless it names an existing directory, in which case it
+    is the root and the query is missing. `--root DIR` is the
+    always-explicit form and wins over any positional. `doctor` and
+    `index` keep the legacy order — their first positional is always
+    the root.
+    """
+    if flag_root is not None:
+        # D3: --root wins over positionals (B1 rule, unified). Two
+        # positionals: the first (positional root) is ignored, the
+        # second is the query (or the index status word).
+        root = Path(flag_root).expanduser().resolve()
+        return root, pos2 if pos2 is not None else pos1, None
+    if operation == "index" and pos1 in ("status", "warm", "clean"):
+        root = (
+            Path(pos2).expanduser().resolve()
+            if pos2 is not None else Path(".").resolve()
+        )
+        return root, pos1, None
+    if operation in ("doctor", "index"):
+        root = (
+            Path(pos1).expanduser().resolve()
+            if pos1 is not None else Path(".").resolve()
+        )
+        return root, pos2, None
+    if pos2 is not None:
+        # Two positionals: legacy root-first, unchanged.
+        return Path(pos1).expanduser().resolve(), pos2, None
+    if pos1 is not None and Path(pos1).expanduser().is_dir():
+        return Path(pos1).expanduser().resolve(), None, None
+    return Path(".").resolve(), pos1, None
+
+
+def cmd_ast(args: List[str]) -> int:
+    """Tree-sitter structural queries via the codesearch-go engine.
+
+    Read-only discovery over the target root: where a symbol is
+    defined, who calls it, what it relates to, or a ranked search.
+    The engine is an external binary (explicit --binary, CODESEARCH_BIN,
+    or PATH) supplied by the agent harness; a missing or incompatible
+    engine fails closed with exit 3 and an error envelope.  Callers are
+    name-based leads, not type-resolved proof: read the cited file
+    before claiming a call.  `plw ast index <root> status|warm|clean`
+    reports, builds, or deletes the engine's gob index for that root
+    (G9); the index lives under PLW's cache root unless --cache-dir
+    or CODESEARCH_CACHE_DIR says otherwise.
+
+    Argument order: two positionals are always root-first (root, then
+    query); a single positional is the query unless it names a
+    directory, in which case it is the root; --root DIR is always
+    explicit.
+    """
+    import argparse
+    parser = _PlwArgumentParser(prog="plw ast", epilog="Argument order: two positionals are always root-first (root, then query); a single positional is the query unless it names a directory, in which case it is the root; --root DIR is always explicit.")
+    parser.add_argument(
+        "operation",
+        choices=(
+            "defs", "def", "definitions", "symbols",
+            "callers", "refs", "references",
+            "related", "search", "doctor", "index",
+            "status", "warm", "clean",
+        ),
+    )
+    parser.add_argument("root", nargs="?", default=None)
+    parser.add_argument("query", nargs="?", default=None)
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--file", "--target", default=None, dest="file_flag")
+    parser.add_argument("--binary", default=None)
+    parser.add_argument("--cache-dir", default=None)
+    parser.add_argument("--timeout", type=int, default=120)
+    parser.add_argument("--limit", type=int, default=None)
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+    if opts.operation in ("status", "warm", "clean"):
+        idx_mode = opts.operation
+        opts.operation = "index"
+        if opts.query is None:
+            opts.query = idx_mode
+    elif opts.operation in ("def", "definitions", "symbols"):
+        opts.operation = "defs"
+    elif opts.operation in ("refs", "references"):
+        opts.operation = "callers"
+    query_derived_from_file = False
+    if opts.file_flag and opts.query is None and opts.operation in ("defs", "callers", "related", "search"):
+        if opts.root is None or os.path.isdir(opts.root):
+            opts.query = Path(opts.file_flag).stem
+            query_derived_from_file = True
+    root, query, resolve_error = _resolve_ast_positionals(
+        opts.operation, opts.root, opts.query, opts.root_flag,
+    )
+    if resolve_error:
+        parser.error(resolve_error)
+    try:
+        from core.codesearch_engine import (
+            DEFAULT_TIMEOUT_S,
+            discover_codesearch,
+            doctor_envelope,
+            error_envelope,
+            run_batch_query,
+            run_index_command,
+            run_query,
+            EngineError,
+        )
+    except Exception as exc:  # engine module must never take the CLI down
+        result: Dict[str, Any] = error_envelope(
+            opts.operation, str(root), query or "",
+            f"codesearch engine module unavailable: {exc}",
+        )
+        print(json.dumps(result, indent=2, ensure_ascii=False))
+        return 3
+    timeout_s = opts.timeout if opts.timeout is not None else DEFAULT_TIMEOUT_S
+    try:
+        if opts.operation == "doctor":
+            result = doctor_envelope(root, opts.binary, opts.cache_dir)
+        elif opts.operation == "index":
+            if (query or "") not in ("status", "warm", "clean"):
+                parser.error("plw ast index requires status|warm|clean")
+            binary, discovered_via = discover_codesearch(opts.binary)
+            result = run_index_command(
+                query, root, binary, discovered_via,
+                timeout_s, opts.cache_dir,
+            )
+        else:
+            if not query:
+                parser.error(
+                    "plw ast defs|callers|related|search requires <query> — "
+                    "write the query alone (root is the current directory), "
+                    "write the root first then the query, or use --root DIR"
+                )
+            binary, discovered_via = discover_codesearch(opts.binary)
+            # G8: a comma-separated query answers all names in one scan.
+            names = [n.strip() for n in query.split(",") if n.strip()] \
+                if opts.operation in ("defs", "callers", "related") else []
+            if len(names) > 1:
+                result = run_batch_query(
+                    opts.operation, root, names,
+                    binary, discovered_via, timeout_s,
+                    opts.cache_dir, opts.limit,
+                )
+            else:
+                result = run_query(
+                    opts.operation, root, query,
+                    binary, discovered_via, timeout_s, opts.limit,
+                    opts.cache_dir,
+                )
+    except EngineError as exc:
+        result = error_envelope(opts.operation, str(root), query or "", str(exc))
+    if opts.file_flag and not query_derived_from_file and result.get("ok") and opts.operation in ("defs", "callers", "related", "search"):
+        f_flt = str(opts.file_flag).strip().replace("\\", "/").strip("/")
+        f_l = f_flt.lower()
+        has_sep_or_ext = ("/" in f_l) or (os.path.splitext(os.path.basename(f_l))[1] != "")
+        f_collapsed = re.sub(r"[._-]+", "", os.path.splitext(os.path.basename(f_l))[0])
+
+        def _row_matches_strict(row: Any) -> bool:
+            if not isinstance(row, dict):
+                return False
+            rp = str(row.get("path") or "").replace("\\", "/").strip().lstrip("./")
+            if not rp:
+                return False
+            rp_l = rp.lower()
+            if has_sep_or_ext:
+                if rp_l == f_l or rp_l.endswith("/" + f_l) or rp_l.startswith(f_l + "/") or ("/" + f_l + "/") in ("/" + rp_l + "/"):
+                    return True
+                if os.path.splitext(os.path.basename(f_l))[1] == "":
+                    rp_no_ext = os.path.splitext(rp_l)[0]
+                    if rp_no_ext == f_l or rp_no_ext.endswith("/" + f_l):
+                        return True
+                return False
+            stem_l = os.path.splitext(os.path.basename(rp_l))[0]
+            if stem_l == f_l:
+                return True
+            if len(f_collapsed) >= 4 and re.sub(r"[._-]+", "", stem_l) == f_collapsed:
+                return True
+            return False
+
+        def _row_matches_segment(row: Any) -> bool:
+            if not isinstance(row, dict):
+                return False
+            rp = str(row.get("path") or "").replace("\\", "/").strip().lstrip("./")
+            if not rp:
+                return False
+            rp_l = rp.lower()
+            return ("/" + f_l + "/") in ("/" + rp_l + "/") or f_l in os.path.basename(rp_l)
+
+        def _filter_ast_list(rows: List[Any]) -> List[Any]:
+            strict = [r for r in rows if _row_matches_strict(r)]
+            if strict or has_sep_or_ext:
+                return strict
+            return [r for r in rows if _row_matches_segment(r)]
+
+        eng_res = result.get("engine_result")
+        total_filtered = 0
+        if isinstance(eng_res, dict):
+            for rk in ("hits", "calls", "related"):
+                if isinstance(eng_res.get(rk), list):
+                    eng_res[rk] = _filter_ast_list(eng_res[rk])
+                    total_filtered = len(eng_res[rk])
+        grouped_map = result.get("grouped")
+        if isinstance(grouped_map, dict):
+            total_filtered = 0
+            for gk in list(grouped_map.keys()):
+                if isinstance(grouped_map[gk], list):
+                    grouped_map[gk] = _filter_ast_list(grouped_map[gk])
+                    total_filtered += len(grouped_map[gk])
+        if isinstance(result.get("summary"), dict):
+            result["summary"]["total"] = total_filtered
+            if "shown" in result["summary"]:
+                result["summary"]["shown"] = total_filtered
+        result["file_filter"] = opts.file_flag
+    if opts.as_json:
+        print(json.dumps(result, indent=2, ensure_ascii=False))
+    else:
+        def _print_row(row):
+            if "snippet" in row:
+                print(f"{row.get('path')}:{row.get('start')}\t{row.get('kind')}\t{row.get('snippet')}")
+            elif "caller" in row:
+                print(f"{row.get('path')}:{row.get('line')}\tcaller={row.get('caller')}\t{row.get('text', '').strip()}")
+            else:
+                print(f"{row.get('path')}:{row.get('line')}\t{row.get('kind')}\t{row.get('detail')}")
+        print("# [PLW AST]")
+        if not result.get("ok"):
+            print("# Error: " + str(result.get("error")))
+        elif result.get("mode") == "index":
+            engine = result.get("engine") or {}
+            status = result.get("engine_result") or {}
+            print("# Operation: " + str(result.get("operation")))
+            print("# Engine: " + str(engine.get("binary")) + " schema=" + str(engine.get("schema")))
+            print("# Cache dir: " + str(status.get("cache_dir")))
+            print("# Index: " + str(status.get("index_path")))
+            print("# Exists: " + str(status.get("exists")) + " schema=" + str(status.get("schema")))
+            print("# Files: " + str(status.get("files")) + " chunks=" + str(status.get("chunks")) +
+                  " size_bytes=" + str(status.get("size_bytes")))
+            stale = status.get("stale") or {}
+            print("# Stale: changed=" + str(stale.get("changed")) + " added=" + str(stale.get("added")) +
+                  " removed=" + str(stale.get("removed")))
+            if status.get("removed") is not None:
+                print("# Removed: " + str(status.get("removed")))
+        else:
+            engine = result.get("engine") or {}
+            print("# Mode: " + str(result.get("mode")))
+            print("# Engine: " + str(engine.get("binary")) + " schema=" + str(engine.get("schema")))
+            print("# Total: " + str((result.get("summary") or {}).get("total")))
+            shown = (result.get("summary") or {}).get("shown")
+            if shown is not None:
+                print("# Shown: " + str(shown))
+            if result.get("fallback_hint"):
+                print("# Hint: " + str(result.get("fallback_hint")))
+            grouped = result.get("grouped")
+            if isinstance(grouped, dict):
+                print("# Batch: " + str(result.get("batch_mode")) +
+                      " (" + str(len(grouped)) + " symbols)")
+                for name in grouped:
+                    print("# " + str(name) + ":")
+                    for row in grouped[name]:
+                        _print_row(row)
+            else:
+                rows = ((result.get("engine_result") or {}).get("hits")
+                        or (result.get("engine_result") or {}).get("calls")
+                        or (result.get("engine_result") or {}).get("related") or [])
+                for row in rows:
+                    _print_row(row)
+    return 0 if result.get("ok") else 3
