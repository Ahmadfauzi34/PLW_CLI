+def cmd_check(args: List[str]) -> int:
+    parser = _PlwArgumentParser(prog="plw check")
+    parser.add_argument("root", nargs="?", default=".")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--analyzers", default=None)
+    parser.add_argument(
+        "--include-perf",
+        action="store_true",
+        dest="include_perf",
+        help="Opt in to perf.* coding-pattern heuristics (excluded from default structural check)",
+    )
+    parser.add_argument("--cache-mode", default=None)
+    parser.add_argument("--limit", type=int, default=None)
+    parser.add_argument("--target", "--targets", "--file", "--files", action="append", default=[], dest="target_filters")
+    parser.add_argument("--all", action="store_true", dest="all_findings")
+    parser.add_argument("--compact", action="store_true", dest="compact")
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+    root = opts.root_flag or opts.root or "."
+    analyzers = opts.analyzers.split(",") if opts.analyzers else None
+    cache_mode = opts.cache_mode
+    as_json = opts.as_json
+    target_filters = [p.strip() for item in (opts.target_filters or []) for p in str(item).split(",") if p.strip()]
+    # --all wins over --limit; --compact defaults to the compact slot cap when neither --all nor --limit is set.
+    if opts.all_findings:
+        findings_limit = None
+    elif opts.limit is not None:
+        findings_limit = opts.limit
+    elif opts.compact:
+        findings_limit = hott_kernel._CHECK_COMPACT_FINDINGS_LIMIT
+    else:
+        findings_limit = hott_kernel._CHECK_FINDINGS_LIMIT
+
+    if cache_mode is not None:
+        cache_error = hott_kernel._set_graph_cache_mode(cache_mode)
+        if cache_error:
+            _format_check_output(cache_error, as_json=as_json)
+            return 2
+
+    res = hott_kernel.kernel_analyze(
+        root,
+        analyzer_names=analyzers,
+        output_mode="summary",
+        findings_limit=None if target_filters else findings_limit,
+        compact=opts.compact,
+        include_perf=opts.include_perf,
+    )
+    if target_filters and "error" not in res and isinstance(res.get("findings"), list):
+        root_abs = os.path.abspath(root).replace("\\", "/").rstrip("/")
+        path_keys = (
+            "file", "target_file", "source", "convergence", "source_boundary",
+            "target_boundary", "cycle", "files", "intermediate_nodes",
+            "path_one", "path_two", "cycle_basis",
+        )
+
+        def _extract_paths(obj: Any, acc: List[str]) -> None:
+            if isinstance(obj, str) and obj.strip():
+                acc.append(obj.strip())
+            elif isinstance(obj, list):
+                for it in obj:
+                    _extract_paths(it, acc)
+
+        def _norm_rel(raw_path: str) -> str:
+            rp = raw_path.replace("\\", "/").strip()
+            if root_abs and rp.startswith(root_abs + "/"):
+                return rp[len(root_abs) + 1:].lower()
+            return rp.lstrip("./").lower()
+
+        def _norm_flt(flt: str) -> str:
+            f_norm = flt.replace("\\", "/").strip().strip("/")
+            if root_abs and f_norm.startswith(root_abs + "/"):
+                f_norm = f_norm[len(root_abs) + 1:]
+            return f_norm.lower()
+
+        def _path_matches_strict(rp_l: str, f_l: str) -> bool:
+            if not f_l:
+                return False
+            has_sep_or_ext = ("/" in f_l) or (os.path.splitext(os.path.basename(f_l))[1] != "")
+            if has_sep_or_ext:
+                if rp_l == f_l or rp_l.endswith("/" + f_l) or rp_l.startswith(f_l + "/") or ("/" + f_l + "/") in ("/" + rp_l + "/"):
+                    return True
+                if os.path.splitext(os.path.basename(f_l))[1] == "":
+                    rp_no_ext = os.path.splitext(rp_l)[0]
+                    if rp_no_ext == f_l or rp_no_ext.endswith("/" + f_l):
+                        return True
+                return False
+            base = os.path.basename(rp_l)
+            stem = os.path.splitext(base)[0]
+            if stem == f_l or base == f_l:
+                return True
+            f_col = re.sub(r"[._-]+", "", f_l)
+            if len(f_col) >= 4 and re.sub(r"[._-]+", "", stem) == f_col:
+                return True
+            return False
+
+        def _path_matches_segment(rp_l: str, f_l: str) -> bool:
+            if not f_l or "/" in f_l or os.path.splitext(os.path.basename(f_l))[1] != "":
+                return False
+            return ("/" + f_l + "/") in ("/" + rp_l + "/") or rp_l == f_l
+
+        orig_findings = res["findings"]
+        finding_paths: List[Tuple[Dict[str, Any], List[str]]] = []
+        for finding in orig_findings:
+            if not isinstance(finding, dict):
+                continue
+            cand_paths: List[str] = []
+            for pk in path_keys:
+                if pk in finding:
+                    _extract_paths(finding.get(pk), cand_paths)
+            finding_paths.append((finding, [_norm_rel(cp) for cp in cand_paths]))
+
+        matched_ids: set[int] = set()
+        for raw_flt in target_filters:
+            f_l = _norm_flt(raw_flt)
+            strict_hits = [
+                idx for idx, (_, rps) in enumerate(finding_paths)
+                if any(_path_matches_strict(rp_l, f_l) for rp_l in rps)
+            ]
+            if strict_hits:
+                matched_ids.update(strict_hits)
+            else:
+                seg_hits = [
+                    idx for idx, (_, rps) in enumerate(finding_paths)
+                    if any(_path_matches_segment(rp_l, f_l) for rp_l in rps)
+                ]
+                matched_ids.update(seg_hits)
+        filtered_findings = [finding_paths[i][0] for i in sorted(matched_ids)]
+        truncated_after_filter = False
+        total_matched = len(filtered_findings)
+        if findings_limit is not None and total_matched > findings_limit:
+            filtered_findings = filtered_findings[:findings_limit]
+            truncated_after_filter = True
+        res["findings"] = filtered_findings
+        res["findings_truncated"] = truncated_after_filter
+        res["target_filter"] = target_filters
+        res["unfiltered_findings_count"] = len(orig_findings)
+        summary = res.get("unified_summary")
+        if isinstance(summary, dict):
+            sev_counts: Dict[str, int] = {}
+            for item in filtered_findings:
+                sev = str(item.get("severity") or "info").lower()
+                sev_counts[sev] = sev_counts.get(sev, 0) + 1
+            summary["total_findings"] = total_matched
+            summary["findings_by_severity"] = sev_counts
+    _format_check_output(res, as_json=as_json)
+    return 0 if "error" not in res else 1
+
