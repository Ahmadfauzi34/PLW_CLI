+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+    if opts.operation not in ("describe", "route"):
+        if opts.operation is not None and os.path.isdir(opts.operation):
+            if opts.root_flag is None:
+                opts.root_flag = opts.operation
+            if opts.value is not None:
+                opts.operation = "route"
+            else:
+                opts.operation = "describe"
+                opts.value = "check"
+        elif opts.operation is not None and opts.value is None:
+            opts.value = opts.operation
+            opts.operation = "describe"
+        else:
+            parser.error(f"argument operation: invalid choice: {opts.operation!r} (choose from 'describe', 'route')")
+    from core.semantic_affordance import ALIAS_TO_CANONICAL, COMMAND_CONTRACTS, FIRST_CONTACT_HELP
+    _plw_terms = set(COMMAND_CONTRACTS) | set(ALIAS_TO_CANONICAL) | set(FIRST_CONTACT_HELP)
+    if opts.extra2 is not None and opts.extra is not None and opts.value is not None:
+        if opts.operation == "describe" and (
+            opts.value.lower() in _plw_terms or not os.path.isdir(opts.value)
+        ) and not os.path.isdir(opts.extra):
+            opts.value = f"{opts.value} {opts.extra}"
+            opts.extra = opts.extra2
+    if opts.extra is not None and opts.value is not None:
+        val_is_dir = os.path.isdir(opts.value) and opts.value.lower() not in _plw_terms
+        if val_is_dir and not os.path.isdir(opts.extra):
+            if opts.root_flag is None:
