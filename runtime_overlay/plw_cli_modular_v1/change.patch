+def cmd_fullstack_state(args: List[str]) -> int:
+    import argparse
+    parser = _PlwArgumentParser(prog="plw fullstack-state")
+    parser.add_argument("root")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("behavior_json")
+    parser.add_argument("postcondition_json")
+    parser.add_argument("spec_json")
+    parser.add_argument("--geometry-impact", action="append", default=[])
+    parser.add_argument("--ui-reference", action="append", default=[])
+    parser.add_argument("--current-revision", required=True)
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    # argparse cannot mix a nargs="?" leading positional with required
+    # positionals after it when an optional sits between them, so root stays
+    # required and a missing leading root is supplied here: --root alone
+    # (or any flag-first call) still works, and no-args still errors.
+    argv = list(args)
+    if argv and argv[0].startswith("-"):
+        argv.insert(0, ".")
+    opts = _parse_cli_args(parser, argv)
+    opts.root = opts.root_flag if opts.root_flag is not None else opts.root
+    try:
+        behavior = load_execution_backed_scenario_evidence(opts.behavior_json)
+        postcondition = load_full_stack_json_artifact(opts.postcondition_json)
+        spec = load_full_stack_json_artifact(opts.spec_json)
