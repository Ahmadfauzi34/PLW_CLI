-def _root_flag(args: List[str]) -> Optional[str]:
-    """Return the --root DIR value if present, else None.
-
-    B1: every command that takes a [root] positional also accepts --root DIR;
-    the flag wins over the positional. Manual parsers resolve it after their
-    positional scan; argparse parsers use dest="root_flag" for the same rule.
-    """
-    for i, arg in enumerate(args):
-        if arg == "--root" and i + 1 < len(args):
-            return args[i + 1]
-    return None
