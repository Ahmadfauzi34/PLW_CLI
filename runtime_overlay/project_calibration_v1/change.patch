diff --git a/core/cli/calibration_cmds.py b/core/cli/calibration_cmds.py
new file mode 100644
index 0000000..8e4aad7
--- /dev/null
+++ b/core/cli/calibration_cmds.py
@@ -0,0 +1,465 @@
+"""CLI command handler for project-scoped recursive minor calibration (`plw calibrate`)."""
+
+import json
+import os
+from typing import Any, Dict, List, Optional
+
+from codebase.topology_analyzers import analyze_test_reachability
+from core.analyzer_registry import analyze_orphan
+from core.cli.common import _PlwArgumentParser, _cli_error, _parse_cli_args
+from core.graph_cache import build_cached_shared_graph
+from core.project_calibration import (
+    CALIBRATION_REL_PATH,
+    audit_calibration_rules,
+    empty_calibration_config,
+    load_project_calibration,
+    match_repo_glob,
+    normalize_repo_pattern,
+    prune_stale_rules,
+    repo_relative_path,
+    suggest_calibration_candidates,
+    validate_calibration_payload,
+    validate_dir_name,
+    write_project_calibration,
+)
+from core.shared_graph import DEFAULT_IGNORE_DIRS, discover_source_files
+
+_VALID_OPERATIONS = ("status", "init", "add", "remove", "prune", "suggest")
+_VALID_KINDS = ("entrypoint", "test", "test_helper", "ignore_dir", "exclude_path", "alias", "suppress")
+
+
+def _emit_calibration_result(payload: Dict[str, Any], *, as_json: bool, title: str) -> int:
+    if as_json:
+        print(json.dumps(payload, indent=2, ensure_ascii=False))
+        return 0
+    print(f"# [{title}]")
+    if "status" in payload:
+        print(f"# Status: {payload['status']}")
+    if "path" in payload:
+        print(f"# Path: {payload['path']}")
+    if payload.get("digest"):
+        print(f"# Digest: {payload['digest']}")
+    if "counts" in payload and isinstance(payload["counts"], dict):
+        parts = [f"{k}={v}" for k, v in payload["counts"].items() if v]
+        print("# Rules: " + (", ".join(parts) if parts else "none"))
+    if "stale_count" in payload:
+        print(f"# Stale rules: {payload['stale_count']}")
+    if "removed_count" in payload:
+        print(f"# Removed stale rules: {payload['removed_count']}")
+    if "candidate_count" in payload:
+        print(f"# Candidates: {payload['candidate_count']}")
+        for cand in (payload.get("candidates") or [])[:15]:
+            cmd_str = " ".join(cand.get("apply_command") or [])
+            print(f"  - [{cand.get('action')}:{cand.get('kind')}] {cand.get('pattern')} :: {cand.get('evidence')}")
+            if cmd_str:
+                print(f"    cmd: {cmd_str}")
+    return 0
+
+
+def _discover_rel_paths(root: str, config: Optional[Dict[str, Any]]) -> List[str]:
+    ign = set(DEFAULT_IGNORE_DIRS)
+    if config:
+        ign |= set(config.get("ignore_dirs", []))
+    discovered = discover_source_files(root, ign)
+    return [repo_relative_path(fp, root) for fp in discovered]
+
+
+def cmd_calibrate(args: List[str]) -> int:
+    """Manage project-scoped `.plw/calibration.json` minor conventions cleanly and fail-closed."""
+    parser = _PlwArgumentParser(prog="plw calibrate")
+    parser.add_argument("operation", nargs="?", default="status")
+    parser.add_argument("root", nargs="?", default=".")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--kind", choices=_VALID_KINDS, default=None)
+    parser.add_argument("--pattern", "--prefix", default=None, dest="pattern")
+    parser.add_argument("--reason", default="")
+    parser.add_argument("--entry-kind", default="custom", dest="entry_kind")
+    parser.add_argument("--analyzer", default=None)
+    parser.add_argument("--rule-type", default="", dest="rule_type")
+    parser.add_argument("--target", default=None)
+    parser.add_argument("--added-by", default="agent", dest="added_by")
+    parser.add_argument("--allow-unmatched", action="store_true", dest="allow_unmatched")
+    parser.add_argument("--dry-run", action="store_true", dest="dry_run")
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+
+    op = str(opts.operation or "status").strip().lower()
+    root = opts.root_flag if opts.root_flag is not None else opts.root
+    if op not in _VALID_OPERATIONS:
+        root_as_op = str(opts.root or "").strip().lower()
+        if opts.root_flag is None and opts.root == "." and os.path.isdir(opts.operation):
+            root = opts.operation
+            op = "status"
+        elif opts.root_flag is None and root_as_op in _VALID_OPERATIONS and os.path.isdir(opts.operation):
+            root = opts.operation
+            op = root_as_op
+        else:
+            return _cli_error(
+                f"Unknown calibrate operation {opts.operation!r}; expected one of: {', '.join(_VALID_OPERATIONS)}",
+                as_json=opts.as_json,
+                rc=2,
+            )
+
+    if not os.path.isdir(root):
+        return _cli_error(
+            f"Target root directory does not exist: {root}",
+            code="root_not_found",
+            as_json=opts.as_json,
+            rc=2,
+        )
+
+    if op == "status":
+        state = load_project_calibration(root)
+        if state is None:
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-status-v1",
+                    "status": "absent",
+                    "present": False,
+                    "valid": True,
+                    "path": CALIBRATION_REL_PATH,
+                    "scan_root": os.path.abspath(root),
+                    "counts": {},
+                    "stale_rules": [],
+                    "stale_count": 0,
+                },
+                as_json=opts.as_json,
+                title="PLW Project Calibration",
+            )
+        if not state.get("valid"):
+            return _cli_error(
+                f"Invalid {CALIBRATION_REL_PATH}: {state.get('error')}",
+                code="invalid_calibration",
+                as_json=opts.as_json,
+                rc=2,
+            )
+        cfg = state["config"]
+        rel_paths = _discover_rel_paths(root, cfg)
+        audit = audit_calibration_rules(cfg, rel_paths, scan_root=root)
+        return _emit_calibration_result(
+            {
+                "schema_version": "plw-calibration-status-v1",
+                "status": "active",
+                "present": True,
+                "valid": True,
+                "path": state["path"],
+                "scan_root": os.path.abspath(root),
+                "digest": state["digest"],
+                "counts": audit["counts"],
+                "total_rules": audit["total_rules"],
+                "matched_files": audit["matched_files"],
+                "stale_rules": audit["stale_rules"],
+                "stale_count": audit["stale_count"],
+                "config": cfg,
+            },
+            as_json=opts.as_json,
+            title="PLW Project Calibration",
+        )
+
+    if op == "init":
+        state = load_project_calibration(root)
+        if state is not None:
+            if not state.get("valid"):
+                return _cli_error(
+                    f"Existing {CALIBRATION_REL_PATH} is invalid: {state.get('error')}",
+                    code="invalid_calibration",
+                    as_json=opts.as_json,
+                    rc=2,
+                )
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-init-v1",
+                    "status": "already_initialized",
+                    "path": state["path"],
+                    "digest": state["digest"],
+                    "config": state["config"],
+                },
+                as_json=opts.as_json,
+                title="PLW Project Calibration Init",
+            )
+        cfg = empty_calibration_config()
+        if opts.dry_run:
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-init-v1",
+                    "status": "dry_run",
+                    "path": CALIBRATION_REL_PATH,
+                    "config": cfg,
+                },
+                as_json=opts.as_json,
+                title="PLW Project Calibration Init",
+            )
+        written = write_project_calibration(root, cfg)
+        return _emit_calibration_result(
+            {
+                "schema_version": "plw-calibration-init-v1",
+                "status": "initialized",
+                "path": written["path"],
+                "digest": written["digest"],
+                "config": written["config"],
+            },
+            as_json=opts.as_json,
+            title="PLW Project Calibration Init",
+        )
+
+    if op == "suggest":
+        graph = build_cached_shared_graph(root)
+        orphan_res = analyze_orphan(graph)
+        reach_res = analyze_test_reachability(graph)
+        payload = suggest_calibration_candidates(root, graph, orphan_res, reach_res)
+        return _emit_calibration_result(payload, as_json=opts.as_json, title="PLW Calibration Suggestions")
+
+    if op == "prune":
+        state = load_project_calibration(root)
+        if state is None:
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-prune-v1",
+                    "status": "absent",
+                    "path": CALIBRATION_REL_PATH,
+                    "removed_count": 0,
+                    "removed_rules": [],
+                },
+                as_json=opts.as_json,
+                title="PLW Calibration Prune",
+            )
+        if not state.get("valid"):
+            return _cli_error(
+                f"Invalid {CALIBRATION_REL_PATH}: {state.get('error')}",
+                code="invalid_calibration",
+                as_json=opts.as_json,
+                rc=2,
+            )
+        cfg = state["config"]
+        rel_paths = _discover_rel_paths(root, cfg)
+        pruned_cfg, removed = prune_stale_rules(cfg, rel_paths, scan_root=root)
+        if not removed:
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-prune-v1",
+                    "status": "clean",
+                    "path": state["path"],
+                    "digest": state["digest"],
+                    "removed_count": 0,
+                    "removed_rules": [],
+                },
+                as_json=opts.as_json,
+                title="PLW Calibration Prune",
+            )
+        if opts.dry_run:
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-prune-v1",
+                    "status": "dry_run",
+                    "path": state["path"],
+                    "removed_count": len(removed),
+                    "removed_rules": removed,
+                },
+                as_json=opts.as_json,
+                title="PLW Calibration Prune",
+            )
+        written = write_project_calibration(root, pruned_cfg)
+        return _emit_calibration_result(
+            {
+                "schema_version": "plw-calibration-prune-v1",
+                "status": "pruned",
+                "path": written["path"],
+                "digest": written["digest"],
+                "removed_count": len(removed),
+                "removed_rules": removed,
+            },
+            as_json=opts.as_json,
+            title="PLW Calibration Prune",
+        )
+
+    if not opts.kind:
+        return _cli_error(f"calibrate {op} requires --kind", as_json=opts.as_json, rc=2)
+    if not opts.pattern:
+        return _cli_error(f"calibrate {op} requires --pattern", as_json=opts.as_json, rc=2)
+
+    state = load_project_calibration(root)
+    if state is not None and not state.get("valid"):
+        return _cli_error(
+            f"Invalid {CALIBRATION_REL_PATH}: {state.get('error')}",
+            code="invalid_calibration",
+            as_json=opts.as_json,
+            rc=2,
+        )
+
+    if op == "remove":
+        if state is None:
+            return _cli_error(
+                f"Cannot remove rule: {CALIBRATION_REL_PATH} does not exist under {root}",
+                code="calibration_absent",
+                as_json=opts.as_json,
+                rc=2,
+            )
+        cfg = json.loads(json.dumps(state["config"]))
+        removed_count = 0
+        try:
+            if opts.kind == "ignore_dir":
+                dname = validate_dir_name(opts.pattern)
+                before = len(cfg["ignore_dirs"])
+                cfg["ignore_dirs"] = [d for d in cfg["ignore_dirs"] if d != dname]
+                removed_count = before - len(cfg["ignore_dirs"])
+            elif opts.kind == "alias":
+                before = len(cfg["import_aliases"])
+                cfg["import_aliases"] = [a for a in cfg["import_aliases"] if a["prefix"] != opts.pattern.strip()]
+                removed_count = before - len(cfg["import_aliases"])
+            elif opts.kind == "suppress":
+                pat = normalize_repo_pattern(opts.pattern)
+                before = len(cfg["suppress_findings"])
+                kept_sup = []
+                for item in cfg["suppress_findings"]:
+                    same_pat = item["file_pattern"] == pat
+                    same_analyzer = (not opts.analyzer) or (item["analyzer"] == opts.analyzer)
+                    same_type = (not opts.rule_type) or (item.get("rule_type", "") == opts.rule_type)
+                    if same_pat and same_analyzer and same_type:
+                        removed_count += 1
+                    else:
+                        kept_sup.append(item)
+                cfg["suppress_findings"] = kept_sup
+            else:
+                sec = {
+                    "entrypoint": "entrypoints",
+                    "test": "test_paths",
+                    "test_helper": "test_paths",
+                    "exclude_path": "exclude_paths",
+                }[opts.kind]
+                pat = normalize_repo_pattern(opts.pattern)
+                before = len(cfg[sec])
+                cfg[sec] = [r for r in cfg[sec] if r["pattern"] != pat]
+                removed_count = before - len(cfg[sec])
+        except ValueError as exc:
+            return _cli_error(str(exc), as_json=opts.as_json, rc=2)
+
+        if removed_count == 0:
+            return _cli_error(
+                f"No matching {opts.kind} rule found for pattern {opts.pattern!r}",
+                code="rule_not_found",
+                as_json=opts.as_json,
+                rc=2,
+            )
+        if opts.dry_run:
+            return _emit_calibration_result(
+                {
+                    "schema_version": "plw-calibration-remove-v1",
+                    "status": "dry_run",
+                    "path": CALIBRATION_REL_PATH,
+                    "removed_count": removed_count,
+                },
+                as_json=opts.as_json,
+                title="PLW Calibration Remove",
+            )
+        written = write_project_calibration(root, cfg)
+        return _emit_calibration_result(
+            {
+                "schema_version": "plw-calibration-remove-v1",
+                "status": "removed",
+                "path": written["path"],
+                "digest": written["digest"],
+                "removed_count": removed_count,
+            },
+            as_json=opts.as_json,
+            title="PLW Calibration Remove",
+        )
+
+    cfg = json.loads(json.dumps(state["config"])) if state else empty_calibration_config()
+    matched_files: List[str] = []
+    try:
+        if opts.kind == "ignore_dir":
+            dname = validate_dir_name(opts.pattern)
+            if dname not in cfg["ignore_dirs"]:
+                cfg["ignore_dirs"].append(dname)
+            added_rule: Any = dname
+        elif opts.kind == "alias":
+            if not opts.target:
+                return _cli_error("calibrate add --kind alias requires --target", as_json=opts.as_json, rc=2)
+            added_rule = {
+                "prefix": opts.pattern.strip(),
+                "target": opts.target,
+                "reason": opts.reason,
+                "added_by": opts.added_by,
+            }
+            cfg["import_aliases"].append(added_rule)
+        elif opts.kind == "suppress":
+            if not opts.analyzer:
+                return _cli_error("calibrate add --kind suppress requires --analyzer", as_json=opts.as_json, rc=2)
+            pat = normalize_repo_pattern(opts.pattern)
+            added_rule = {
+                "analyzer": opts.analyzer,
+                "file_pattern": pat,
+                "rule_type": opts.rule_type,
+                "reason": opts.reason,
+                "added_by": opts.added_by,
+            }
+            cfg["suppress_findings"].append(added_rule)
+        else:
+            pat = normalize_repo_pattern(opts.pattern)
+            sec = {
+                "entrypoint": "entrypoints",
+                "test": "test_paths",
+                "test_helper": "test_paths",
+                "exclude_path": "exclude_paths",
+            }[opts.kind]
+            added_rule = {"pattern": pat, "reason": opts.reason, "added_by": opts.added_by}
+            if opts.kind == "entrypoint":
+                added_rule["kind"] = opts.entry_kind
+            elif opts.kind in ("test", "test_helper"):
+                added_rule["role"] = opts.kind
+            cfg[sec].append(added_rule)
+
+        validated = validate_calibration_payload(cfg)
+    except ValueError as exc:
+        return _cli_error(str(exc), as_json=opts.as_json, rc=2)
+
+    if opts.kind not in ("ignore_dir", "alias"):
+        check_pat = added_rule["file_pattern"] if opts.kind == "suppress" else added_rule["pattern"]
+        rel_paths = _discover_rel_paths(root, cfg if opts.kind != "exclude_path" else state["config"] if state else None)
+        matched_files = [rp for rp in rel_paths if match_repo_glob(rp, check_pat)]
+        if not matched_files and not opts.allow_unmatched:
+            basename = os.path.basename(check_pat)
+            hints = [rp for rp in rel_paths if os.path.basename(rp) == basename][:3]
+            hint_msg = (
+                f" Did you mean repo-relative path(s): {', '.join(hints)} or '**/{basename}'?"
+                if hints
+                else ""
+            )
+            return _cli_error(
+                f"Pattern {check_pat!r} matched 0 source files under {root}.{hint_msg} "
+                "Pass --allow-unmatched to register intentionally.",
+                code="unmatched_pattern",
+                as_json=opts.as_json,
+                rc=2,
+            )
+
+    if opts.dry_run:
+        return _emit_calibration_result(
+            {
+                "schema_version": "plw-calibration-add-v1",
+                "status": "dry_run",
+                "path": CALIBRATION_REL_PATH,
+                "kind": opts.kind,
+                "matched_files_count": len(matched_files),
+                "matched_files": matched_files[:20],
+                "rule": added_rule,
+            },
+            as_json=opts.as_json,
+            title="PLW Calibration Add",
+        )
+
+    written = write_project_calibration(root, validated)
+    return _emit_calibration_result(
+        {
+            "schema_version": "plw-calibration-add-v1",
+            "status": "added",
+            "path": written["path"],
+            "digest": written["digest"],
+            "kind": opts.kind,
+            "matched_files_count": len(matched_files),
+            "matched_files": matched_files[:20],
+            "rule": added_rule,
+        },
+        as_json=opts.as_json,
+        title="PLW Calibration Add",
+    )
