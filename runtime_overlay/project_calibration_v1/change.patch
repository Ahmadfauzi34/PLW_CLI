diff --git a/core/project_calibration.py b/core/project_calibration.py
new file mode 100644
index 0000000..7a8fbbd
--- /dev/null
+++ b/core/project_calibration.py
@@ -0,0 +1,910 @@
+"""Project-scoped minor calibration registry for PLW.
+
+Allows a repository to declare minor project-specific conventions in
+`<scan_root>/.plw/calibration.json` without modifying PLW core binaries:
+  - ignore_dirs: extra directory basenames excluded during discovery
+  - exclude_paths: repo-relative path globs omitted from graph/analysis
+  - entrypoints: repo-relative path globs promoted to entrypoints (e.g. JNI/FFI bridges, tooling)
+  - test_paths: repo-relative path globs marked as test or test_helper
+  - import_aliases: extra alias prefix -> repo-relative target rules merged with tsconfig paths
+  - suppress_findings: bounded finding suppressions ONLY for non-structural-invariant analyzers
+  - style_preferences: optional project preferences (e.g. simplify_ignore_patterns, notes)
+
+Guardrails:
+  - Fail-closed validation: rejects absolute paths, `..` traversal, empty suppression reasons,
+    and strictly forbids suppressing `topo.circular` or `hott.*` structural invariants.
+  - Zero circular dependencies: imports only stdlib and `language_semantics.normalize_path`.
+"""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+import re
+import tempfile
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Set, Tuple
+
+from language_semantics import normalize_path
+
+CALIBRATION_SCHEMA_VERSION = "plw-project-calibration-v1"
+CALIBRATION_REL_PATH = ".plw/calibration.json"
+
+ALLOWED_SUPPRESS_ANALYZERS: frozenset[str] = frozenset({
+    "topo.orphan",
+    "topo.test_reachability",
+    "topo.risk",
+    "perf.async",
+    "perf.deopt",
+    "perf.gc",
+    "perf.cache",
+})
+
+FORBIDDEN_SUPPRESS_ANALYZERS: frozenset[str] = frozenset({
+    "topo.circular",
+    "hott.isomorphism",
+    "hott.sheaf",
+    "hott.homotopy",
+    "hott.manifold",
+})
+
+TEST_PATH_ROLES: frozenset[str] = frozenset({"test", "test_helper"})
+
+_WIN_DRIVE_RE = re.compile(r"^[A-Za-z]:")
+_GLOB_CACHE: Dict[str, re.Pattern[str]] = {}
+
+
+def _utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def calibration_file_path(scan_root: str = ".") -> str:
+    root_abs = os.path.abspath(str(scan_root or "."))
+    return os.path.join(root_abs, ".plw", "calibration.json")
+
+
+def empty_calibration_config() -> Dict[str, Any]:
+    return {
+        "schema_version": CALIBRATION_SCHEMA_VERSION,
+        "updated_at": _utc_now(),
+        "ignore_dirs": [],
+        "exclude_paths": [],
+        "entrypoints": [],
+        "test_paths": [],
+        "import_aliases": [],
+        "suppress_findings": [],
+        "style_preferences": {
+            "simplify_ignore_patterns": [],
+            "notes": "",
+        },
+    }
+
+
+def validate_dir_name(raw_name: Any) -> str:
+    name = str(raw_name or "").strip()
+    if not name or name in (".", ".."):
+        raise ValueError(f"Invalid ignore_dir name: {raw_name!r}")
+    if "/" in name or "\\" in name or "*" in name or "?" in name or ":" in name:
+        raise ValueError(f"ignore_dir must be a single directory basename without slashes or globs: {raw_name!r}")
+    return name
+
+
+def normalize_repo_pattern(raw_pattern: Any, *, field_name: str = "pattern") -> str:
+    value = str(raw_pattern or "").strip().replace("\\", "/")
+    while value.startswith("./"):
+        value = value[2:]
+    value = value.rstrip("/")
+    if not value:
+        raise ValueError(f"{field_name} must be a non-empty repo-relative path or glob")
+    if value.startswith("/") or _WIN_DRIVE_RE.match(value):
+        raise ValueError(f"{field_name} must be repo-relative (not absolute): {raw_pattern!r}")
+    parts = value.split("/")
+    if any(part == ".." or part == "" for part in parts):
+        raise ValueError(f"{field_name} must not contain empty segments or '..' traversal: {raw_pattern!r}")
+    return value
+
+
+def repo_relative_path(file_path: str, scan_root: str = ".") -> str:
+    """Convert a corpus/graph file path into a normalized repo-relative POSIX path."""
+    root_norm = normalize_path(scan_root or ".")
+    fp_norm = normalize_path(file_path or "")
+    if root_norm in ("", "."):
+        rel = fp_norm
+    elif fp_norm == root_norm:
+        rel = ""
+    elif fp_norm.startswith(root_norm + "/"):
+        rel = fp_norm[len(root_norm) + 1 :]
+    else:
+        try:
+            root_abs = os.path.abspath(str(scan_root or "."))
+            fp_abs = os.path.abspath(str(file_path or ""))
+            candidate = os.path.relpath(fp_abs, root_abs).replace("\\", "/")
+            if candidate != ".." and not candidate.startswith("../"):
+                rel = candidate
+            else:
+                rel = fp_norm
+        except (OSError, ValueError):
+            rel = fp_norm
+    while rel.startswith("./"):
+        rel = rel[2:]
+    return rel
+
+
+def _compile_repo_glob(pattern: str) -> re.Pattern[str]:
+    cached = _GLOB_CACHE.get(pattern)
+    if cached is not None:
+        return cached
+    out: List[str] = ["^"]
+    i = 0
+    n = len(pattern)
+    while i < n:
+        if pattern[i : i + 3] == "**/":
+            out.append("(?:.*/)?")
+            i += 3
+            continue
+        if pattern[i : i + 2] == "**":
+            out.append(".*")
+            i += 2
+            continue
+        ch = pattern[i]
+        if ch == "*":
+            out.append("[^/]*")
+        elif ch == "?":
+            out.append("[^/]")
+        else:
+            out.append(re.escape(ch))
+        i += 1
+    out.append("$")
+    compiled = re.compile("".join(out))
+    _GLOB_CACHE[pattern] = compiled
+    return compiled
+
+
+def match_repo_glob(rel_path: str, pattern: str) -> bool:
+    rel = str(rel_path or "").replace("\\", "/").lstrip("./")
+    if not rel or not pattern:
+        return False
+    regex = _compile_repo_glob(pattern)
+    return bool(regex.match(rel))
+
+
+def _clean_reason(raw_reason: Any, *, required: bool = False, min_len: int = 8, field: str = "reason") -> str:
+    text = str(raw_reason or "").strip()
+    if required and len(text) < min_len:
+        raise ValueError(
+            f"{field} is required and must be at least {min_len} characters for auditability"
+        )
+    return text
+
+
+def _normalize_meta_fields(item: Dict[str, Any]) -> Dict[str, str]:
+    out: Dict[str, str] = {}
+    if item.get("added_by") is not None and str(item.get("added_by")).strip():
+        out["added_by"] = str(item.get("added_by")).strip()
+    if item.get("added_at") is not None and str(item.get("added_at")).strip():
+        out["added_at"] = str(item.get("added_at")).strip()
+    return out
+
+
+def validate_calibration_payload(raw: Any) -> Dict[str, Any]:
+    """Validate and canonicalize a `.plw/calibration.json` payload (fail-closed)."""
+    if not isinstance(raw, dict):
+        raise ValueError("Calibration file must contain a JSON object")
+    schema = str(raw.get("schema_version") or CALIBRATION_SCHEMA_VERSION).strip()
+    if schema != CALIBRATION_SCHEMA_VERSION:
+        raise ValueError(
+            f"Unsupported calibration schema_version {schema!r}; expected {CALIBRATION_SCHEMA_VERSION!r}"
+        )
+
+    raw_ignore = raw.get("ignore_dirs", [])
+    if not isinstance(raw_ignore, list):
+        raise ValueError("ignore_dirs must be a list of directory names")
+    ignore_dirs = sorted({validate_dir_name(item) for item in raw_ignore})
+
+    def _validate_path_entries(key: str, *, allow_kind: bool = False, allow_role: bool = False) -> List[Dict[str, Any]]:
+        items = raw.get(key, [])
+        if not isinstance(items, list):
+            raise ValueError(f"{key} must be a list")
+        by_pattern: Dict[str, Dict[str, Any]] = {}
+        for idx, item in enumerate(items):
+            if not isinstance(item, dict):
+                raise ValueError(f"{key}[{idx}] must be an object")
+            pat = normalize_repo_pattern(item.get("pattern"), field_name=f"{key}[{idx}].pattern")
+            reason = _clean_reason(item.get("reason"), required=False)
+            entry: Dict[str, Any] = {"pattern": pat, "reason": reason}
+            if allow_kind:
+                kind = str(item.get("kind") or "custom").strip().lower()
+                if not re.match(r"^[a-z][a-z0-9_-]{0,40}$", kind):
+                    raise ValueError(f"{key}[{idx}].kind must be alphanumeric/underscore/hyphen: {kind!r}")
+                entry["kind"] = kind
+            if allow_role:
+                role = str(item.get("role") or "test").strip().lower()
+                if role not in TEST_PATH_ROLES:
+                    raise ValueError(f"{key}[{idx}].role must be one of {sorted(TEST_PATH_ROLES)}: {role!r}")
+                entry["role"] = role
+            entry.update(_normalize_meta_fields(item))
+            by_pattern[pat] = entry
+        return [by_pattern[p] for p in sorted(by_pattern)]
+
+    exclude_paths = _validate_path_entries("exclude_paths")
+    entrypoints = _validate_path_entries("entrypoints", allow_kind=True)
+    test_paths = _validate_path_entries("test_paths", allow_role=True)
+
+    raw_aliases = raw.get("import_aliases", [])
+    if not isinstance(raw_aliases, list):
+        raise ValueError("import_aliases must be a list")
+    aliases_by_prefix: Dict[str, Dict[str, Any]] = {}
+    for idx, item in enumerate(raw_aliases):
+        if not isinstance(item, dict):
+            raise ValueError(f"import_aliases[{idx}] must be an object")
+        prefix = str(item.get("prefix") or "").strip()
+        if not prefix or ".." in prefix or prefix.startswith("/"):
+            raise ValueError(f"import_aliases[{idx}].prefix is invalid: {prefix!r}")
+        target = normalize_repo_pattern(item.get("target"), field_name=f"import_aliases[{idx}].target")
+        entry = {
+            "prefix": prefix,
+            "target": target,
+            "reason": _clean_reason(item.get("reason"), required=False),
+            **_normalize_meta_fields(item),
+        }
+        aliases_by_prefix[prefix] = entry
+    import_aliases = [aliases_by_prefix[k] for k in sorted(aliases_by_prefix)]
+
+    raw_sup = raw.get("suppress_findings", [])
+    if not isinstance(raw_sup, list):
+        raise ValueError("suppress_findings must be a list")
+    sup_by_key: Dict[Tuple[str, str, str], Dict[str, Any]] = {}
+    for idx, item in enumerate(raw_sup):
+        if not isinstance(item, dict):
+            raise ValueError(f"suppress_findings[{idx}] must be an object")
+        analyzer = str(item.get("analyzer") or "").strip()
+        if analyzer in FORBIDDEN_SUPPRESS_ANALYZERS or analyzer.startswith("hott.") or analyzer == "topo.circular":
+            raise ValueError(
+                f"suppress_findings[{idx}].analyzer={analyzer!r} is forbidden: "
+                "structural cycle and HoTT invariants cannot be suppressed"
+            )
+        if analyzer not in ALLOWED_SUPPRESS_ANALYZERS:
+            raise ValueError(
+                f"suppress_findings[{idx}].analyzer={analyzer!r} is not supported; "
+                f"allowed: {', '.join(sorted(ALLOWED_SUPPRESS_ANALYZERS))}"
+            )
+        file_pattern = normalize_repo_pattern(
+            item.get("file_pattern"), field_name=f"suppress_findings[{idx}].file_pattern"
+        )
+        rule_type = str(item.get("rule_type") or "").strip()
+        reason = _clean_reason(
+            item.get("reason"),
+            required=True,
+            min_len=8,
+            field=f"suppress_findings[{idx}].reason",
+        )
+        entry = {
+            "analyzer": analyzer,
+            "file_pattern": file_pattern,
+            "rule_type": rule_type,
+            "reason": reason,
+            **_normalize_meta_fields(item),
+        }
+        sup_by_key[(analyzer, file_pattern, rule_type)] = entry
+    suppress_findings = [sup_by_key[k] for k in sorted(sup_by_key)]
+
+    raw_style = raw.get("style_preferences") or {}
+    if not isinstance(raw_style, dict):
+        raise ValueError("style_preferences must be an object")
+    raw_simp_ignores = raw_style.get("simplify_ignore_patterns") or []
+    if not isinstance(raw_simp_ignores, list):
+        raise ValueError("style_preferences.simplify_ignore_patterns must be a list")
+    simp_ignores = sorted({
+        normalize_repo_pattern(item, field_name="style_preferences.simplify_ignore_patterns")
+        for item in raw_simp_ignores
+    })
+    style_preferences = {
+        "simplify_ignore_patterns": simp_ignores,
+        "notes": str(raw_style.get("notes") or "").strip(),
+    }
+
+    normalized: Dict[str, Any] = {
+        "schema_version": CALIBRATION_SCHEMA_VERSION,
+        "ignore_dirs": ignore_dirs,
+        "exclude_paths": exclude_paths,
+        "entrypoints": entrypoints,
+        "test_paths": test_paths,
+        "import_aliases": import_aliases,
+        "suppress_findings": suppress_findings,
+        "style_preferences": style_preferences,
+    }
+    if raw.get("updated_at"):
+        normalized["updated_at"] = str(raw["updated_at"]).strip()
+    return normalized
+
+
+def calibration_digest(config: Dict[str, Any]) -> str:
+    """Stable content digest over semantic calibration rules (ignores updated_at)."""
+    semantic = {
+        k: v
+        for k, v in config.items()
+        if k != "updated_at"
+    }
+    encoded = json.dumps(semantic, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return f"sha256:{hashlib.sha256(encoded).hexdigest()}"
+
+
+def load_project_calibration(scan_root: str = ".") -> Optional[Dict[str, Any]]:
+    """Load and validate `<scan_root>/.plw/calibration.json` if present."""
+    path = calibration_file_path(scan_root)
+    if not os.path.exists(path):
+        return None
+    if not os.path.isfile(path):
+        return {
+            "present": True,
+            "valid": False,
+            "path": CALIBRATION_REL_PATH,
+            "error": "Calibration path exists but is not a regular file",
+            "digest": None,
+        }
+    raw_bytes = b""
+    try:
+        with open(path, "rb") as handle:
+            raw_bytes = handle.read()
+        raw_text = raw_bytes.decode("utf-8")
+        raw_obj = json.loads(raw_text)
+        config = validate_calibration_payload(raw_obj)
+    except Exception as exc:
+        return {
+            "present": True,
+            "valid": False,
+            "path": CALIBRATION_REL_PATH,
+            "error": f"{type(exc).__name__}: {exc}",
+            "digest": f"sha256:{hashlib.sha256(raw_bytes).hexdigest()}" if raw_bytes else None,
+        }
+    return {
+        "present": True,
+        "valid": True,
+        "path": CALIBRATION_REL_PATH,
+        "digest": calibration_digest(config),
+        "config": config,
+    }
+
+
+def write_project_calibration(scan_root: str, config: Dict[str, Any]) -> Dict[str, Any]:
+    """Validate and atomically write `<scan_root>/.plw/calibration.json`."""
+    validated = validate_calibration_payload(config)
+    validated["updated_at"] = _utc_now()
+    path = calibration_file_path(scan_root)
+    parent = os.path.dirname(path)
+    os.makedirs(parent, exist_ok=True)
+    tmp_path: Optional[str] = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w",
+            encoding="utf-8",
+            dir=parent,
+            prefix=".calibration_",
+            suffix=".tmp",
+            delete=False,
+        ) as handle:
+            tmp_path = handle.name
+            json.dump(validated, handle, indent=2, ensure_ascii=False)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(tmp_path, path)
+        tmp_path = None
+    finally:
+        if tmp_path and os.path.exists(tmp_path):
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+    return {
+        "path": CALIBRATION_REL_PATH,
+        "digest": calibration_digest(validated),
+        "config": validated,
+    }
+
+
+def calibration_alias_rules(config: Dict[str, Any], scan_root_norm: str = ".") -> List[Dict[str, Any]]:
+    """Convert calibration `import_aliases` to language_semantics alias_rule dicts."""
+    rules: List[Dict[str, Any]] = []
+    for item in config.get("import_aliases", []) or []:
+        prefix = str(item.get("prefix") or "")
+        target = str(item.get("target") or "")
+        if not prefix or not target:
+            continue
+        is_wildcard = prefix.endswith("/*") or prefix.endswith("/")
+        norm_prefix = prefix[:-1] if prefix.endswith("/*") else prefix
+        norm_target = target[:-2] if target.endswith("/*") else target.rstrip("/")
+        full_target = (
+            normalize_path(os.path.join(scan_root_norm, norm_target))
+            if scan_root_norm and scan_root_norm != "."
+            else normalize_path(norm_target)
+        )
+        if is_wildcard:
+            rules.append({
+                "type": "wildcard",
+                "prefix": norm_prefix,
+                "base": full_target,
+                "source": CALIBRATION_REL_PATH,
+            })
+        else:
+            rules.append({
+                "type": "exact",
+                "pattern": norm_prefix,
+                "target": full_target,
+                "source": CALIBRATION_REL_PATH,
+            })
+    rules.sort(
+        key=lambda rule: (
+            len(rule.get("prefix", rule.get("pattern", ""))),
+            rule.get("source", ""),
+        ),
+        reverse=True,
+    )
+    return rules
+
+
+def filter_excluded_paths(
+    paths: Iterable[str],
+    scan_root: str,
+    config: Dict[str, Any],
+) -> Tuple[List[str], List[str]]:
+    """Partition paths into `(kept_paths, excluded_paths)` using `exclude_paths` globs."""
+    rules = config.get("exclude_paths", []) or []
+    if not rules:
+        return list(paths), []
+    patterns = [r["pattern"] for r in rules]
+    kept: List[str] = []
+    excluded: List[str] = []
+    for fp in paths:
+        rel = repo_relative_path(fp, scan_root)
+        if any(match_repo_glob(rel, pat) for pat in patterns):
+            excluded.append(fp)
+        else:
+            kept.append(fp)
+    return kept, excluded
+
+
+def match_entrypoint_rule(rel_path: str, config: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    for rule in config.get("entrypoints", []) or []:
+        if match_repo_glob(rel_path, rule["pattern"]):
+            return rule
+    return None
+
+
+def match_test_path_rule(rel_path: str, config: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    for rule in config.get("test_paths", []) or []:
+        if match_repo_glob(rel_path, rule["pattern"]):
+            return rule
+    return None
+
+
+def _alias_target_exists(scan_root: str, target: str, rel_paths: Sequence[str]) -> bool:
+    clean = target[:-2] if target.endswith("/*") else target.rstrip("/")
+    if not clean:
+        return False
+    prefix = clean + "/"
+    if any(rp == clean or rp.startswith(prefix) for rp in rel_paths):
+        return True
+    candidate = os.path.join(os.path.abspath(scan_root or "."), clean)
+    return os.path.exists(candidate)
+
+
+def audit_calibration_rules(
+    config: Dict[str, Any],
+    rel_paths: Sequence[str],
+    *,
+    scan_root: str = ".",
+) -> Dict[str, Any]:
+    """Audit how many files each rule in calibration matches and report stale rules."""
+    stale_rules: List[Dict[str, Any]] = []
+    match_counts: Dict[str, int] = {}
+
+    def _audit_section(section: str, key: str = "pattern") -> None:
+        rules = config.get(section, []) or []
+        matched = 0
+        for item in rules:
+            pat = item[key]
+            hits = [rp for rp in rel_paths if match_repo_glob(rp, pat)]
+            if hits:
+                matched += len(hits)
+            else:
+                stale_entry: Dict[str, Any] = {
+                    "section": section,
+                    key: pat,
+                    "reason": "matched_zero_source_files",
+                }
+                if section == "suppress_findings":
+                    stale_entry["analyzer"] = item.get("analyzer")
+                    if item.get("rule_type"):
+                        stale_entry["rule_type"] = item.get("rule_type")
+                stale_rules.append(stale_entry)
+        match_counts[section] = matched
+
+    _audit_section("exclude_paths")
+    _audit_section("entrypoints")
+    _audit_section("test_paths")
+    _audit_section("suppress_findings", key="file_pattern")
+
+    alias_matched = 0
+    for item in config.get("import_aliases", []) or []:
+        if _alias_target_exists(scan_root, item["target"], rel_paths):
+            alias_matched += 1
+        else:
+            stale_rules.append({
+                "section": "import_aliases",
+                "prefix": item["prefix"],
+                "target": item["target"],
+                "reason": "alias_target_missing",
+            })
+    match_counts["import_aliases"] = alias_matched
+
+    total_rules = (
+        len(config.get("ignore_dirs", []))
+        + len(config.get("exclude_paths", []))
+        + len(config.get("entrypoints", []))
+        + len(config.get("test_paths", []))
+        + len(config.get("import_aliases", []))
+        + len(config.get("suppress_findings", []))
+    )
+    return {
+        "total_rules": total_rules,
+        "counts": {
+            "ignore_dirs": len(config.get("ignore_dirs", [])),
+            "exclude_paths": len(config.get("exclude_paths", [])),
+            "entrypoints": len(config.get("entrypoints", [])),
+            "test_paths": len(config.get("test_paths", [])),
+            "import_aliases": len(config.get("import_aliases", [])),
+            "suppress_findings": len(config.get("suppress_findings", [])),
+        },
+        "matched_files": match_counts,
+        "stale_rules": stale_rules,
+        "stale_count": len(stale_rules),
+    }
+
+
+def prune_stale_rules(
+    config: Dict[str, Any],
+    rel_paths: Sequence[str],
+    *,
+    scan_root: str = ".",
+) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
+    """Remove stale rules that match 0 source files and return `(pruned_config, removed_rules)`."""
+    audit = audit_calibration_rules(config, rel_paths, scan_root=scan_root)
+    stale = audit["stale_rules"]
+    if not stale:
+        return dict(config), []
+
+    updated = json.loads(json.dumps(config))
+    stale_by_section: Dict[str, Set[Tuple[str, ...]]] = {}
+    for s in stale:
+        sec = s["section"]
+        if sec == "suppress_findings":
+            stale_by_section.setdefault(sec, set()).add(
+                (str(s.get("analyzer") or ""), str(s.get("file_pattern") or ""), str(s.get("rule_type") or ""))
+            )
+        elif sec == "import_aliases":
+            stale_by_section.setdefault(sec, set()).add((str(s.get("prefix") or ""),))
+        else:
+            stale_by_section.setdefault(sec, set()).add((str(s.get("pattern") or ""),))
+
+    for sec in ("exclude_paths", "entrypoints", "test_paths"):
+        drop = stale_by_section.get(sec, set())
+        if drop:
+            updated[sec] = [r for r in updated.get(sec, []) if (r["pattern"],) not in drop]
+    if "suppress_findings" in stale_by_section:
+        drop_sup = stale_by_section["suppress_findings"]
+        updated["suppress_findings"] = [
+            r
+            for r in updated.get("suppress_findings", [])
+            if (r["analyzer"], r["file_pattern"], str(r.get("rule_type") or "")) not in drop_sup
+        ]
+    if "import_aliases" in stale_by_section:
+        drop_alias = stale_by_section["import_aliases"]
+        updated["import_aliases"] = [
+            r for r in updated.get("import_aliases", []) if (r["prefix"],) not in drop_alias
+        ]
+    return validate_calibration_payload(updated), stale
+
+
+def _finding_matches_rule(
+    finding: Dict[str, Any],
+    rule: Dict[str, Any],
+    scan_root: str,
+) -> bool:
+    rule_type = str(rule.get("rule_type") or "").strip()
+    if rule_type and str(finding.get("type") or "") != rule_type:
+        return False
+    pattern = str(rule.get("file_pattern") or "")
+    if not pattern:
+        return False
+    fp = finding.get("file")
+    if isinstance(fp, str) and fp.strip():
+        return match_repo_glob(repo_relative_path(fp, scan_root), pattern)
+    multi = finding.get("source_files") or finding.get("files")
+    if isinstance(multi, list) and multi:
+        rels = [repo_relative_path(str(item), scan_root) for item in multi if str(item).strip()]
+        return bool(rels) and all(match_repo_glob(rel, pattern) for rel in rels)
+    return False
+
+
+def apply_finding_suppressions(
+    analyzer_name: str,
+    result: Dict[str, Any],
+    shared_graph: Dict[str, Any],
+) -> Dict[str, Any]:
+    """Apply bounded project-calibration finding suppressions transparently."""
+    calibration = shared_graph.get("calibration")
+    if not isinstance(calibration, dict) or not calibration.get("valid"):
+        return result
+    if analyzer_name not in ALLOWED_SUPPRESS_ANALYZERS:
+        return result
+    if not isinstance(result, dict) or "error" in result:
+        return result
+    raw_findings = result.get("findings")
+    if not isinstance(raw_findings, list) or not raw_findings:
+        return result
+    rules = [
+        rule
+        for rule in (calibration.get("suppress_findings") or [])
+        if isinstance(rule, dict) and rule.get("analyzer") == analyzer_name
+    ]
+    if not rules:
+        return result
+
+    scan_root = str(shared_graph.get("scan_root") or ".")
+    kept: List[Dict[str, Any]] = []
+    suppressed: List[Dict[str, Any]] = []
+    for finding in raw_findings:
+        if not isinstance(finding, dict):
+            kept.append(finding)
+            continue
+        matched_rule: Optional[Dict[str, Any]] = None
+        for rule in rules:
+            if _finding_matches_rule(finding, rule, scan_root):
+                matched_rule = rule
+                break
+        if matched_rule is None:
+            kept.append(finding)
+        else:
+            target_label = finding.get("file")
+            if not target_label:
+                multi = finding.get("source_files") or finding.get("files") or []
+                target_label = multi[0] if len(multi) == 1 else f"({len(multi)} files)"
+            else:
+                target_label = repo_relative_path(str(target_label), scan_root)
+            suppressed.append({
+                "analyzer": analyzer_name,
+                "type": finding.get("type"),
+                "severity": finding.get("severity"),
+                "target": target_label,
+                "file_pattern": matched_rule["file_pattern"],
+                "reason": matched_rule["reason"],
+            })
+
+    if not suppressed:
+        return result
+
+    updated = dict(result)
+    updated["findings"] = kept
+    summary = dict(result.get("summary") or {})
+    if "total_findings" in summary:
+        summary["total_findings"] = len(kept)
+    if analyzer_name == "topo.test_reachability":
+        summary["high_influence_without_test_path"] = sum(
+            1 for item in kept if item.get("type") == "high_influence_without_test_path"
+        )
+        summary["isolated_test_count"] = sum(
+            1 for item in kept if item.get("type") == "isolated_test"
+        )
+        summary["testless_component_count"] = sum(
+            1 for item in kept if item.get("type") == "testless_component"
+        )
+    elif analyzer_name == "topo.risk":
+        summary["high_risk"] = sum(1 for item in kept if item.get("risk_level") == "high")
+        summary["medium_risk"] = sum(1 for item in kept if item.get("risk_level") == "medium")
+        summary["low_risk"] = sum(1 for item in kept if item.get("risk_level") == "low")
+    summary["calibrated_suppressed_count"] = len(suppressed)
+    summary["calibrated_suppressed"] = suppressed
+    updated["summary"] = summary
+    return updated
+
+
+def suggest_calibration_candidates(
+    scan_root: str,
+    shared_graph: Dict[str, Any],
+    orphan_result: Dict[str, Any],
+    reach_result: Dict[str, Any],
+) -> Dict[str, Any]:
+    """Derive read-only minor calibration candidates from structural evidence."""
+    root_abs = os.path.abspath(str(scan_root or "."))
+    rel_paths = [repo_relative_path(fp, scan_root) for fp in shared_graph.get("vertices", [])]
+    file_map = shared_graph.get("file_map") or {}
+    cal_state = load_project_calibration(scan_root)
+    config = cal_state.get("config") if cal_state and cal_state.get("valid") else None
+
+    candidates: List[Dict[str, Any]] = []
+    seen_keys: Set[Tuple[str, str, str]] = set()
+
+    def _add_candidate(
+        action: str,
+        kind: str,
+        pattern: str,
+        reason: str,
+        evidence: str,
+        confidence: float,
+        *,
+        entry_kind: str = "",
+        analyzer: str = "",
+        rule_type: str = "",
+        target: str = "",
+    ) -> None:
+        key = (action, kind, pattern)
+        if key in seen_keys:
+            return
+        seen_keys.add(key)
+        cmd_parts = ["plw", "calibrate"]
+        if action == "prune":
+            cmd_parts.append("prune")
+        else:
+            cmd_parts.extend(["add", "--kind", kind, "--pattern", pattern])
+            if entry_kind:
+                cmd_parts.extend(["--entry-kind", entry_kind])
+            if analyzer:
+                cmd_parts.extend(["--analyzer", analyzer])
+            if rule_type:
+                cmd_parts.extend(["--rule-type", rule_type])
+            if target:
+                cmd_parts.extend(["--target", target])
+            cmd_parts.extend(["--reason", reason])
+        cmd_parts.extend(["--root", scan_root])
+        candidates.append({
+            "action": action,
+            "kind": kind,
+            "pattern": pattern,
+            "entry_kind": entry_kind or None,
+            "analyzer": analyzer or None,
+            "rule_type": rule_type or None,
+            "target": target or None,
+            "reason": reason,
+            "evidence": evidence,
+            "confidence": confidence,
+            "apply_command": cmd_parts,
+        })
+
+    if config is not None:
+        audit = audit_calibration_rules(config, rel_paths, scan_root=root_abs)
+        for stale in audit["stale_rules"]:
+            label = stale.get("pattern") or stale.get("file_pattern") or stale.get("prefix") or ""
+            _add_candidate(
+                "prune",
+                stale["section"],
+                label,
+                f"Existing {stale['section']} rule matches zero source files",
+                str(stale),
+                0.95,
+            )
+
+    test_dir_markers = ("/test/", "/tests/", "/__tests__/", "/e2e/", "/androidTest/", "/src/test/")
+    for finding in orphan_result.get("findings", []) or []:
+        fp = finding.get("file")
+        if not isinstance(fp, str) or not fp:
+            continue
+        rel = repo_relative_path(fp, scan_root)
+        norm_wrapped = "/" + rel.lower()
+        content = file_map.get(fp, "")
+        base = os.path.basename(rel).lower()
+
+        if any(m in norm_wrapped for m in test_dir_markers):
+            _add_candidate(
+                "add",
+                "test_helper",
+                rel,
+                "File sits inside test directory without production dependents; likely test harness/setup helper",
+                f"topo.orphan on {rel} under test directory",
+                0.88,
+            )
+            continue
+
+        if fp.endswith(".kt") and ("external fun " in content or "@JavascriptInterface" in content or "bridge" in base):
+            _add_candidate(
+                "add",
+                "entrypoint",
+                rel,
+                "Kotlin native/JNI bridge invoked across language boundary rather than Kotlin callers",
+                f"topo.orphan + bridge/external symbol markers in {rel}",
+                0.9,
+                entry_kind="jni_bridge",
+            )
+            continue
+
+        if fp.endswith(".rs") and ("#[no_mangle]" in content or 'extern "C"' in content):
+            _add_candidate(
+                "add",
+                "entrypoint",
+                rel,
+                "Rust FFI boundary module exported via extern/no_mangle",
+                f"topo.orphan + FFI markers in {rel}",
+                0.9,
+                entry_kind="ffi_entry",
+            )
+            continue
+
+        if "/scripts/" in norm_wrapped or rel.startswith("scripts/") or base in ("build.ts", "build.js", "global-setup.ts", "global-setup.js"):
+            _add_candidate(
+                "add",
+                "entrypoint",
+                rel,
+                "Build/automation helper script executed directly rather than imported",
+                f"topo.orphan on build/script helper {rel}",
+                0.85,
+                entry_kind="tooling",
+            )
+
+    for finding in reach_result.get("findings", []) or []:
+        ftype = finding.get("type")
+        fp = finding.get("file")
+        if not isinstance(fp, str) or not fp:
+            continue
+        rel = repo_relative_path(fp, scan_root)
+        norm_wrapped = "/" + rel.lower()
+        base = os.path.basename(rel).lower()
+        if ftype == "isolated_test":
+            _add_candidate(
+                "add",
+                "test_helper",
+                rel,
+                "Test-surface file has no direct production import; review if shared fixture/setup helper",
+                f"topo.test_reachability isolated_test on {rel}",
+                0.75,
+            )
+        elif ftype == "high_influence_without_test_path":
+            if "/scripts/" in norm_wrapped or rel.startswith("scripts/") or base in ("build.ts", "build.js", "vite.config.ts", "playwright.config.ts"):
+                _add_candidate(
+                    "add",
+                    "entrypoint",
+                    rel,
+                    "Tooling/build config entrypoint verified by build workflow rather than unit test imports",
+                    f"topo.test_reachability high_influence_without_test_path on {rel}",
+                    0.82,
+                    entry_kind="tooling",
+                )
+
+    return {
+        "schema_version": "plw-calibration-suggestions-v1",
+        "scan_root": root_abs,
+        "calibration_present": bool(cal_state and cal_state.get("present")),
+        "calibration_digest": cal_state.get("digest") if cal_state else None,
+        "candidate_count": len(candidates),
+        "candidates": candidates,
+        "authority": {
+            "read_only": True,
+            "auto_mutates_calibration": False,
+        },
+    }
+
+
+__all__ = [
+    "ALLOWED_SUPPRESS_ANALYZERS",
+    "CALIBRATION_REL_PATH",
+    "CALIBRATION_SCHEMA_VERSION",
+    "FORBIDDEN_SUPPRESS_ANALYZERS",
+    "TEST_PATH_ROLES",
+    "apply_finding_suppressions",
+    "audit_calibration_rules",
+    "calibration_alias_rules",
+    "calibration_digest",
+    "calibration_file_path",
+    "empty_calibration_config",
+    "filter_excluded_paths",
+    "load_project_calibration",
+    "match_entrypoint_rule",
+    "match_repo_glob",
+    "match_test_path_rule",
+    "normalize_repo_pattern",
+    "prune_stale_rules",
+    "repo_relative_path",
+    "suggest_calibration_candidates",
+    "validate_calibration_payload",
+    "validate_dir_name",
+    "write_project_calibration",
+]
