+                if cand == target_norm or os.path.splitext(cand)[0] == target_base:
+                    return True
+            return False
+        for cand in _python_module_candidates(raw_import, ["."]):
+            cand_base = os.path.splitext(cand)[0]
+            if (
+                cand == target_norm
+                or cand_base == target_base
+                or target_norm.endswith("/" + cand)
+                or target_base.endswith("/" + cand_base)
+                or target_pkg.endswith("/" + cand_base)
+                or target_pkg == cand_base
+            ):
+                return True
+        return False
+
+    matched_import: Optional[Dict[str, Any]] = None
+
+    def _visit(node: ast.AST, in_func: bool, in_type_checking: bool) -> Optional[Dict[str, Any]]:
+        nonlocal matched_import
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            for child in node.body:
+                res = _visit(child, True, in_type_checking)
+                if res is not None:
+                    return res
+            return None
+        if isinstance(node, ast.If):
+            child_tc = in_type_checking or _is_type_checking_guard(node.test)
+            for child in node.body:
+                res = _visit(child, in_func, child_tc)
+                if res is not None:
+                    return res
+            for child in node.orelse:
+                res = _visit(child, in_func, in_type_checking)
+                if res is not None:
+                    return res
+            return None
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                raw_import = alias.name.replace(".", "/")
+                if _matches_target(raw_import, False):
+                    candidate = {
+                        "has_import": True,
+                        "is_type_only": in_type_checking,
+                        "is_dynamic": in_func,
+                        "symbols": [alias.asname or alias.name.split(".")[0]],
+                        "raw_statement": f"import {alias.name}",
+                    }
+                    if not in_func and not in_type_checking:
+                        return candidate
+                    if matched_import is None:
+                        matched_import = candidate
+        elif isinstance(node, ast.ImportFrom):
+            symbols = [alias.asname or alias.name for alias in node.names]
