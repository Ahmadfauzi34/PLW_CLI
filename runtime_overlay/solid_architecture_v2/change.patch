+def _record_resolved_edge(
+    state: _ImportResolutionState,
+    fp: str,
+    target: str,
+    nature: str,
+    usages: List[str],
+    resolved_targets: List[str],
+) -> None:
+    """Record one resolved dependency edge along with its nature and semantic usages."""
+    state.edges.append((fp, target))
+    state.resolved_edge_natures.setdefault((fp, target), []).append(nature)
+    if usages:
+        state.resolved_edge_usages.setdefault((fp, target), []).extend(usages)
+    resolved_targets.append(target)
