+def _resolve_rust_import(
+    state: _ImportResolutionState,
+    fp: str,
+    item: Dict[str, Any],
+    resolved_targets: List[str],
+) -> None:
+    if item.get("rust_mod"):
+        _resolve_rust_mod_declaration(state, fp, item, resolved_targets)
+        return
+
+    raw_import = item["raw_import"]
+    nature = item.get("import_nature", "runtime")
+    usages = item.get("semantic_usages", [])
+    segs = raw_import.split("::")
+    own_root, own_mod = state.rust_index.file_module.get(fp, (fp, ()))
+    target_root = own_root
+    anchored = False
+    own_package = False
+
+    if segs[0] == "crate":
+        base: Tuple[str, ...] = ()
+        rest = segs[1:]
+        anchored = True
+    elif segs[0] == "self":
+        base = own_mod
+        rest = segs[1:]
+        anchored = True
+    elif segs[0] == "super":
+        ups = 0
+        while ups < len(segs) and segs[ups] == "super":
+            ups += 1
+        base = own_mod[: max(0, len(own_mod) - ups)]
+        rest = segs[ups:]
+        anchored = True
+    elif segs[0] in RUST_STDLIB_CRATES:
+        state.external_imports.append({
+            "importer": fp,
+            "raw_import": raw_import,
+            "reason": "rust_stdlib",
+        })
+        return
+    elif segs[0] in state.rust_index.package_lib:
+        target_root = state.rust_index.package_lib[segs[0]]
+        base = ()
+        rest = segs[1:]
+        own_package = True
+    else:
+        base = ()
+        rest = segs
+
+    full = base + tuple(rest)
+    matched = None
+    if rest:
+        matched = state.rust_index.module_index.get((target_root, full))
+    if not matched and rest and not item.get("wildcard"):
+        matched = state.rust_index.symbol_index.get(
+            (target_root, base + tuple(rest[:-1]), rest[-1])
+        )
+    if matched:
+        _record_resolved_edge(state, fp, matched, nature, usages, resolved_targets)
+    elif anchored or own_package or (
+        rest and rest[0] in state.rust_index.top_modules.get(target_root, set())
