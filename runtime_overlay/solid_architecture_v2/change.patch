+        state.unresolved_imports.append({
+            "importer": fp,
+            "raw_import": raw_import,
+            "reason": "rust_glob" if item.get("wildcard") else "rust_unresolved",
+        })
+    else:
+        state.external_imports.append({
+            "importer": fp,
+            "raw_import": raw_import,
+            "reason": "rust_external",
+        })
