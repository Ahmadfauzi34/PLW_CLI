+def _resolve_rust_mod_declaration(
+    state: _ImportResolutionState,
+    fp: str,
+    item: Dict[str, Any],
+    resolved_targets: List[str],
+) -> None:
+    raw_import = item["raw_import"]
+    nature = item.get("import_nature", "runtime")
+    usages = item.get("semantic_usages", [])
+    own_root, own_mod = state.rust_index.file_module.get(fp, (fp, ()))
+    target_mod = own_mod + (raw_import,)
+    matched = state.rust_index.module_index.get((own_root, target_mod))
+    if matched is None and own_root == fp:
+        mod_dir = os.path.dirname(fp)
+        mod_cands = [
