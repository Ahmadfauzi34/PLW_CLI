+    norm = normalize_path(str(rel_path)).lstrip("./")
+    lower = norm.lower()
+    if is_declaration_file(lower):
+        return True
+    if lower == "public/assets" or lower.startswith("public/assets/") or "/public/assets/" in lower:
+        return True
+    if lower.endswith(_MINIFIED_ASSET_EXTENSIONS):
+        return True
+    if content:
+        if lower.endswith(".py"):
+            py_markers = ("@generated", "Code generated", "DO NOT EDIT", "Generated by ", "auto-generated", "Auto-generated")
+            for line in content.splitlines()[:25]:
+                stripped = line.strip()
+                if stripped.startswith("#") and any(marker in stripped for marker in py_markers):
+                    return True
+        else:
+            head = content[:8192]
+            if any(marker in head for marker in _GENERATED_HEADER_MARKERS):
+                return True
+    return False
