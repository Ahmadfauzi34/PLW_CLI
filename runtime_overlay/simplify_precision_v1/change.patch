+def _preceded_by_keyword(masked: str, pos: int, keyword: str) -> bool:
+    """Return True when *pos* is immediately preceded (modulo whitespace/masked comments) by *keyword*."""
+    idx = pos - 1
+    while idx >= 0 and masked[idx].isspace():
+        idx -= 1
+    start = idx - len(keyword) + 1
+    if start < 0 or masked[start:idx + 1] != keyword:
+        return False
+    if start > 0 and (masked[start - 1].isalnum() or masked[start - 1] in "_$"):
+        return False
+    return True
+
