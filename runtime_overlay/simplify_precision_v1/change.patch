+def is_generated_or_vendored_asset(rel_path: str, content: str = "") -> bool:
+    """Return True for declaration files, static public assets, minified bundles, and generated glue.
+
+    Deliberately excludes bare ``"wasm-bindgen"`` so hand-written adapter wrappers
+    that mention wasm-bindgen in JSDoc comments (for example ``node.mjs``) remain
+    in scope.
