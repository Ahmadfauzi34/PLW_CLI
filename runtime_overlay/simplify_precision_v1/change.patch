+def _leading_statement_boundary_ok(prefix_raw: str) -> bool:
+    """Reject brace-less clause headers (`if (...) return`) and expression continuations before a terminal."""
+    prefix = prefix_raw.rstrip()
+    if not prefix:
+        return True
+    last = prefix[-1]
+    if last in ";}":
+        return True
+    if last in _CONTINUATION_OPERATORS:
+        return False
+    had_newline = "\n" in prefix_raw[len(prefix):]
+    if last == ")":
+        if not had_newline:
+            return False
+        depth = 1
+        idx = len(prefix) - 2
+        while idx >= 0 and depth > 0:
+            if prefix[idx] == ")":
+                depth += 1
+            elif prefix[idx] == "(":
+                depth -= 1
+            idx -= 1
+        if depth != 0:
+            return False
+        while idx >= 0 and prefix[idx].isspace():
+            idx -= 1
+        if idx >= 0 and (prefix[idx].isalnum() or prefix[idx] in "_$"):
+            end_tok = idx + 1
+            while idx >= 0 and (prefix[idx].isalnum() or prefix[idx] in "_$"):
+                idx -= 1
+            word = prefix[idx + 1:end_tok]
+            if word in _CLAUSE_WITH_PAREN_KEYWORDS:
+                return False
+        return True
+    word_match = re.search(r"[A-Za-z_$][A-Za-z0-9_$]*$", prefix)
+    if word_match and word_match.group(0) in _CONTINUATION_KEYWORDS:
+        return False
+    return had_newline
+
