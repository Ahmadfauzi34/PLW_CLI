+                j += 1
+            word = masked_segment[i:j]
+            if word in terminal_kinds:
+                last_stmt = (word, i, j)
+            i = j
+            continue
+        if brace < 0 or paren < 0 or bracket < 0:
+            return None
+        i += 1
+    if brace != 0 or paren != 0 or bracket != 0 or last_stmt is None:
+        return None
+    kind, stmt_start, stmt_kw_end = last_stmt
+    if not _leading_statement_boundary_ok(masked_segment[:stmt_start]):
+        return None
+    src = source_segment if len(source_segment) == n else masked_segment
+    brace = paren = bracket = 0
+    saw_expr_token = False
+    line_last_nonspace = ""
+    cur_line_start = stmt_kw_end
+    for k in range(stmt_kw_end, n):
+        ch = masked_segment[k]
+        if ch == ";":
+            if brace == paren == bracket == 0:
+                return kind if not masked_segment[k + 1:].strip() else None
+            saw_expr_token = True
+            line_last_nonspace = ch
+        elif ch == "\n":
+            if brace == paren == bracket == 0:
+                rest = masked_segment[k + 1:].lstrip()
+                if not rest:
+                    return kind
+                expr_so_far = saw_expr_token or bool(_INLINE_COMMENT_RE.sub("", src[stmt_kw_end:k]).strip())
+                if not expr_so_far:
+                    return None
+                if not line_last_nonspace or line_last_nonspace not in _CONTINUATION_OPERATORS:
+                    line_word = re.search(r"([A-Za-z_]+)\s*$", masked_segment[cur_line_start:k])
+                    if not (line_word and line_word.group(1) in _TAIL_CONTINUATION_KEYWORDS):
+                        if rest[0] not in _TAIL_CONTINUATION_START_CHARS:
+                            kw_cont = re.match(r"([A-Za-z_]+)\b", rest)
+                            if not kw_cont or kw_cont.group(1) not in _TAIL_CONTINUATION_KEYWORDS:
+                                return None
+            cur_line_start = k + 1
+            line_last_nonspace = ""
+        elif not ch.isspace():
+            saw_expr_token = True
+            line_last_nonspace = ch
+        if ch == "{":
+            brace += 1
+        elif ch == "}":
+            brace -= 1
+        elif ch == "(":
+            paren += 1
+        elif ch == ")":
+            paren -= 1
+        elif ch == "[":
+            bracket += 1
+        elif ch == "]":
+            bracket -= 1
+        if brace < 0 or paren < 0 or bracket < 0:
+            return None
+    if brace or paren or bracket:
+        return None
+    return kind
