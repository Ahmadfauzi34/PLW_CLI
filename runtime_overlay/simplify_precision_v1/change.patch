+def _extract_exact_forwarding_args(
+    source: str, masked: str, abs_start: int, abs_end: int,
+) -> Optional[List[str]]:
+    """Extract conservative plain-identifier forwarding argument tokens using masked + raw slices."""
+    args_src = source[abs_start:abs_end]
+    args_mask = masked[abs_start:abs_end]
+    if not args_src.strip() and not args_mask.strip():
+        return []
+    pieces: List[str] = []
+    last = 0
+    paren = bracket = brace = angle = 0
+    for idx, ch in enumerate(args_mask):
+        if ch == "(":
+            paren += 1
+        elif ch == ")":
+            if paren == 0:
+                return None
+            paren -= 1
+        elif ch == "[":
+            bracket += 1
+        elif ch == "]":
+            if bracket == 0:
+                return None
+            bracket -= 1
+        elif ch == "{":
+            brace += 1
+        elif ch == "}":
+            if brace == 0:
+                return None
+            brace -= 1
+        elif ch == "<":
+            angle += 1
+        elif ch == ">" and angle:
+            angle -= 1
+        elif ch == "," and paren == bracket == brace == angle == 0:
+            m_piece = args_mask[last:idx].strip()
+            s_piece = args_src[last:idx].strip()
+            if not m_piece or m_piece != s_piece:
+                return None
+            pieces.append(m_piece)
+            last = idx + 1
+    if paren or bracket or brace or angle:
+        return None
+    m_piece = args_mask[last:].strip()
+    s_piece = args_src[last:].strip()
+    if not m_piece or m_piece != s_piece:
+        return None
+    pieces.append(m_piece)
+    return pieces
