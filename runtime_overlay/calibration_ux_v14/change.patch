+    def _estimate_tokens(block_text: str, cards: List[str]) -> int:
+        if not block_text:
+            return 0
+        c_chars = sum(
+            len(line)
+            for card in cards
+            for line in card.splitlines()
+            if line.startswith("  L")
+        )
+        n_chars = max(0, len(block_text) - c_chars)
+        return math.ceil((c_chars / CHARS_PER_TOKEN_CODE) + (n_chars / CHARS_PER_TOKEN_NARRATIVE))
+
+    def _over_budget(block_text: str, cards: List[str]) -> bool:
+        return len(block_text) > char_budget or _estimate_tokens(block_text, cards) > budget_tokens
