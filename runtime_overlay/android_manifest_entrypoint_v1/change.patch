+# G5a: Android entrypoints from the manifest. The basename entrypoint
+# rules never match a Kotlin class name, so manifest-declared
+# Activities/Services/etc. were reported orphan.
+_ANDROID_MANIFEST_COMPONENT_TAGS = (
+    "application",
+    "activity",
+    "service",
+    "receiver",
+    "provider",
+)
+_ANDROID_NS = "http://schemas.android.com/apk/res/android"
+# Generated merged manifests live under build/ — never source truth.
+_ANDROID_MANIFEST_SKIP_DIRS = frozenset({
+    ".git", "node_modules", "build", "dist", ".gradle", "out",
+})
+
+
+def _android_manifest_names(content: str) -> List[str]:
+    """Component class names declared in one AndroidManifest.xml.
+
+    Only application/activity/service/receiver/provider count:
+    activity-alias names are manifest-only aliases, not classes, and
+    must never resolve to a file. Returns raw android:name values
+    (relative `.Foo`, qualified `pkg.Foo`, or bare `Foo`).
+    """
+    try:
+        root = ET.fromstring(content)
+    except ET.ParseError:
+        return []
+    names: List[str] = []
+    for element in root.iter():
+        tag = element.tag.rsplit("}", 1)[-1]
+        if tag not in _ANDROID_MANIFEST_COMPONENT_TAGS:
+            continue
+        name = element.get(f"{{{_ANDROID_NS}}}name") or element.get("name") or ""
+        if name:
+            names.append(name)
+    return names
+
+
+def android_manifest_entrypoints(
+    root: str, kt_files: Iterable[Tuple[str, str]]
+) -> Set[str]:
+    """Files declared as Android components in AndroidManifest.xml files.
+
+    Resolution is name-only against the Kotlin top-level index, unique
+    match required: a relative name (`.host.Foo`) resolves by simple
+    name; a fully-qualified name (`pkg.Foo`) additionally requires the
+    file's declared package to match. Ambiguous (same simple name in
+    two packages), missing, `$`-nested, or unparseable names resolve to
+    nothing — fail-closed, never a guessed entrypoint.
+    """
+    by_name: Dict[str, List[Tuple[str, str]]] = {}
+    for path, content in kt_files:
+        package = kotlin_package_of(content)
+        for name in kotlin_top_level_names(content):
+            by_name.setdefault(name, []).append((normalize_path(path), package))
+
+    entrypoints: Set[str] = set()
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames[:] = sorted(d for d in dirnames if d not in _ANDROID_MANIFEST_SKIP_DIRS)
+        for filename in sorted(filenames):
+            if filename != "AndroidManifest.xml":
+                continue
+            try:
+                with open(
+                    os.path.join(dirpath, filename),
+                    encoding="utf-8",
+                    errors="ignore",
+                ) as fh:
+                    content = fh.read()
+            except OSError:
+                continue
+            for raw in _android_manifest_names(content):
+                if "$" in raw:
+                    continue
+                simple = raw.rsplit(".", 1)[-1]
+                candidates = by_name.get(simple, [])
+                if len(candidates) == 1:
+                    entrypoints.add(candidates[0][0])
+                elif len(candidates) > 1 and not raw.startswith(".") and "." in raw:
+                    package = raw.rsplit(".", 1)[0]
+                    matched = [p for p, pkg in candidates if pkg == package]
+                    if len(matched) == 1:
+                        entrypoints.add(matched[0])
+    return entrypoints
+
