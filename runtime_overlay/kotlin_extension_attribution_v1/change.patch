+                    continue
+                exists, ret = _kotlin_member_return(
+                    state, pkg, first, callee.group(1)
+                )
+                if exists and ret is not None and ret != first:
+                    return None
+            return first
+    if len(segments) == 1 and segments[0] in ("it", "this"):
+        if depth > 0:
+            return None
+        # Review #3: lexical scope, not nearest text. `it` binds only
+        # to let/also, `this` only to run/apply/with; a scope lambda
+        # with an explicit parameter (`{ x ->`) binds neither; and the
+        # use must sit inside the scope block (brace depth > 0), so a
+        # closed or sibling scope never matches.
+        scope_recv = _kotlin_enclosing_scope_receiver(
+            body, use_offset, segments[0]
+        )
+        if scope_recv:
+            return _kotlin_receiver_type(
+                scope_recv, member, pkg, state, body,
+                use_offset, local_types, depth + 1,
+            )
+        return None
+    last = segments[-1].rstrip("?")
+    if "(" in last or ")" in last:
+        return None
+    if len(segments) == 1 and last in local_types:
+        return local_types[last]
+    prop_types = index.prop_types_pkg.get((pkg, last))
+    if prop_types is not None and len(prop_types) == 1:
+        return next(iter(prop_types))
+    global_types = index.prop_types_global.get(last)
+    if global_types is not None and len(global_types) == 1:
+        return next(iter(global_types))
+    return None
+
