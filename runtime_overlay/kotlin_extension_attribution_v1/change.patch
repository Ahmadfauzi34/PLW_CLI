+def _kotlin_type_spans(clean: str) -> List[Tuple[str, int, Optional[str], Optional[int], Optional[int]]]:
+    """Spans of every class/interface/object header in stripped source.
+
+    Returns (name, header_start, ctor_param_span, body_start, body_end);
+    body bounds are None when the type has no body block. The body
+    search stops at a new top-level declaration, so a body-less
+    `class Foo` never swallows the next function's body as its own.
+    """
+    headers: List[Tuple[int, str, int]] = []
+    for match in _KOTLIN_TYPE_HEADER_REGEX.finditer(clean):
+        headers.append((match.start(), match.group(1), match.end()))
+    for match in _KOTLIN_OBJECT_HEADER_REGEX.finditer(clean):
+        before = clean[max(0, match.start() - 12):match.start()]
+        if before.rstrip().endswith("companion"):
+            continue
+        headers.append((match.start(), match.group(1), match.end()))
+    headers.sort()
+    spans: List[Tuple[str, int, Optional[str], Optional[int], Optional[int]]] = []
+    for header_start, name, hend in headers:
+        pos = hend
+        # Skip type parameters `<...>` (nesting-aware).
+        while pos < len(clean) and clean[pos] in " \t":
+            pos += 1
+        if pos < len(clean) and clean[pos] == "<":
+            depth = 0
+            while pos < len(clean):
+                if clean[pos] == "<":
+                    depth += 1
+                elif clean[pos] == ">":
+                    depth -= 1
+                    if depth == 0:
+                        pos += 1
+                        break
+                pos += 1
+        # Constructor paren span, if present.
+        ctor_span: Optional[str] = None
+        while pos < len(clean) and clean[pos] in " \t":
+            pos += 1
+        if pos < len(clean) and clean[pos] == "(":
+            start = pos
+            depth = 0
+            while pos < len(clean):
+                if clean[pos] == "(":
+                    depth += 1
+                elif clean[pos] == ")":
+                    depth -= 1
+                    if depth == 0:
+                        ctor_span = clean[start + 1:pos]
+                        pos += 1
+                        break
+                pos += 1
+        # Body `{` at paren depth 0, bounded, stopping at a new
+        # top-level declaration.
+        body_start: Optional[int] = None
+        body_end: Optional[int] = None
+        depth = 0
+        limit = min(len(clean), pos + 2000)
+        while pos < limit:
+            ch = clean[pos]
+            if ch == "(":
+                depth += 1
+            elif ch == ")":
+                depth -= 1
+            elif ch == "{" and depth == 0:
+                body_start = pos
+                break
+            elif ch == "\n" and depth == 0:
+                rest = clean[pos + 1:pos + 40].lstrip()
+                if any(
+                    rest == kw or rest.startswith(kw + " ")
+                    or rest.startswith(kw + "(")
+                    for kw in _KOTLIN_TOP_LEVEL_KEYWORDS
+                ):
+                    break
+            pos += 1
+        if body_start is not None:
+            depth = 0
+            pos = body_start
+            while pos < len(clean):
+                ch = clean[pos]
+                if ch == "{":
+                    depth += 1
+                elif ch == "}":
+                    depth -= 1
+                    if depth == 0:
+                        body_end = pos + 1
+                        break
+                pos += 1
+        spans.append((name, header_start, ctor_span, body_start, body_end))
+    return spans
+
