+def _kotlin_enclosing_scope_receiver(
+    body: str, use_offset: int, binder: str
+) -> Optional[str]:
+    """Receiver of the lexically enclosing scope function for `it`/`this`.
+
+    Walks scope calls from nearest to farthest (bounded window) and
+    takes the first whose block still encloses the use (brace depth > 0
+    from its `{`), whose binder matches (`it` <- let/also,
+    `this` <- run/apply/with), and whose lambda has no explicit
+    parameter (an explicit `x ->` means `it` belongs to an outer scope).
+    """
+    want = _KOTLIN_IT_BINDERS if binder == "it" else _KOTLIN_THIS_BINDERS
+    window_start = max(0, use_offset - 2000)
+    scope_text = body[window_start:use_offset]
+    for match in reversed(list(_KOTLIN_SCOPE_FN_REGEX.finditer(scope_text))):
+        fn = match.group(2) or "with"
+        if fn not in want:
+            continue
+        brace_pos = window_start + match.end() - 1
+        depth = 0
+        for ch in body[brace_pos:use_offset]:
+            if ch == "{":
+                depth += 1
+            elif ch == "}":
+                depth -= 1
+        if depth <= 0:
+            continue
+        if _KOTLIN_EXPLICIT_PARAM_REGEX.match(body, brace_pos + 1):
+            continue
+        recv = match.group(1) or match.group(3)
+        if recv:
+            return recv
+    return None
+
