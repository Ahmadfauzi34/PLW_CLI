+def _kotlin_receiver_type(
+    expr: str,
+    member: str,
+    pkg: str,
+    state: _ImportResolutionState,
+    body: str,
+    use_offset: int,
+    local_types: Dict[str, str],
+    depth: int = 0,
+) -> Optional[str]:
+    """Resolve the receiver type of a `.member` use, or None (fail closed).
+
+    Evidence, in order:
+    (a) literal type: the first segment is a capitalized name equal to a
+        declared receiver for `member`, and every later segment is a call
+        (`Modifier`, `Modifier.fillMaxSize()`).
+    (b) property type: the last segment is a property whose declared type
+        is unique — package-scoped first, then global.
+    (c) local type: a single-segment receiver declared as `val`/`var`/
+        param in the using file.
+    (e) scope-function chain: `it`/`this` inside `?.let { }` / `run` /
+        `also` / `apply` / `with(...)` resolves to the scope call's
+        receiver type (recursed once).
+    A receiver ending in a call whose root is not a known receiver type
+    has an unknowable return type and resolves to None.
+    """
+    expr = expr.strip().rstrip("?")
+    if not expr:
+        return None
+    segments = [s for s in expr.split(".") if s]
+    if not segments:
+        return None
+    index = state.kotlin_index
+    receivers = {
+        recv
+        for (p, recv, m) in index.ext_index
+        if p == pkg and m == member
+    }
+    first = re.sub(r"<[^>]*>$", "", segments[0]).rstrip("?")
+    if first and first[0].isupper() and first in receivers:
+        rest = segments[1:]
+        if all("(" in seg for seg in rest):
+            return first
+    if len(segments) == 1 and segments[0] in ("it", "this"):
+        if depth > 0:
+            return None
+        # Search the 300 chars before the use for the nearest scope call.
+        scope_text = body[max(0, use_offset - 300):use_offset]
+        scope_matches = list(_KOTLIN_SCOPE_FN_REGEX.finditer(scope_text))
+        if scope_matches:
+            last = scope_matches[-1]
+            scope_recv = last.group(1) or last.group(3)
+            if scope_recv:
+                return _kotlin_receiver_type(
+                    scope_recv, member, pkg, state, body,
+                    use_offset, local_types, depth + 1,
+                )
+        return None
+    last = segments[-1].rstrip("?")
+    if "(" in last or ")" in last:
+        return None
+    if len(segments) == 1 and last in local_types:
+        return local_types[last]
+    prop_types = index.prop_types_pkg.get((pkg, last))
+    if prop_types is not None and len(prop_types) == 1:
+        return next(iter(prop_types))
+    global_types = index.prop_types_global.get(last)
+    if global_types is not None and len(global_types) == 1:
+        return next(iter(global_types))
+    return None
