+def kotlin_class_members(
+    content: str,
+    _stripped: Optional[str] = None,
+) -> Dict[Tuple[str, str], Optional[str]]:
+    """Map (type, member) -> declared return/property type (or None).
+
+    Members of a class/interface/object body at brace depth 1 (direct
+    members only): `fun name(...): Ret` gives the base return type,
+    `val`/`var name: Type` gives the property type, a `fun` without a
+    declared return gives None (member exists, return unknown).
+    Constructor `val`/`var` params count as members too
+    (`data class User(val text: String)` -> `User.text`).
+    Nested types are blanked out of the enclosing body, so a nested
+    class's members never leak to its outer type. Companion-object
+    members are NOT indexed (their receiver is `Foo.Companion`, not
+    `Foo`). Conflicting known return types for one member collapse to
+    None — existence is certain, the return is not.
+    """
+    clean = _stripped if _stripped is not None else kotlin_strip_comments_and_strings(content)
+    members: Dict[Tuple[str, str], Optional[str]] = {}
+
+    def _add(type_name: str, member: str, ret: Optional[str]) -> None:
+        key = (type_name, member)
+        if key not in members:
+            members[key] = ret
+        elif members[key] is None:
+            members[key] = ret
+        elif ret is not None and members[key] != ret:
+            members[key] = None
+
+    spans = _kotlin_type_spans(clean)
+    for name, header_start, ctor_span, body_start, body_end in spans:
+        if ctor_span:
+            for match in _KOTLIN_PROP_TYPE_REGEX.finditer(ctor_span):
+                _add(name, match.group(1), match.group(2))
+        if body_start is None or body_end is None:
+            continue
+        blanked = list(clean[body_start:body_end])
+        for _n2, h2, _c2, bs2, be2 in spans:
+            if bs2 is None or be2 is None:
+                continue
+            if body_start < bs2 < body_end:
+                for i in range(h2 - body_start, be2 - body_start):
+                    if 0 <= i < len(blanked):
+                        blanked[i] = " "
+        depth = 0
+        depth1: List[str] = []
+        for ch in blanked:
+            if ch == "{":
+                depth += 1
+            elif ch == "}":
+                depth -= 1
+            elif depth == 1:
+                depth1.append(ch)
+        own = "".join(depth1)
+        for match in _KOTLIN_MEMBER_FUN_REGEX.finditer(own):
+            _add(name, match.group(1), match.group(2))
+        for match in _KOTLIN_PROP_TYPE_REGEX.finditer(own):
+            _add(name, match.group(1), match.group(2))
+    return members
+
