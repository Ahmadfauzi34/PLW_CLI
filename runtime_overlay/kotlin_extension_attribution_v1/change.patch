+    has an unknowable return type and resolves to None.
+    """
+    expr = expr.strip().rstrip("?")
+    if not expr:
+        return None
+    segments = [s for s in expr.split(".") if s]
+    if not segments:
+        return None
+    index = state.kotlin_index
+    receivers = {
