+def kotlin_extension_declarations(
+    content: str,
+    _stripped: Optional[str] = None,
+) -> Dict[Tuple[str, str], str]:
+    """Extract non-private top-level Kotlin extension declarations.
+
+    Returns {(receiver, member): kind} with kind in {"ext_fun", "ext_val"}:
+    the receiver is the full dotted base type (`TimelineItem.ToolCall`,
+    `JSONArray?` -> `JSONArray`, `List<TimelineItem>` -> `List`). Same
+    guards as `kotlin_same_package_declarations`: private excluded,
+    len(name) >= 3. Unlike same-package declarations, extensions REQUIRE
+    dot syntax, so they are indexed separately and resolved only with
+    receiver-type evidence — never by name alone.
+    """
+    clean = _stripped if _stripped is not None else kotlin_strip_comments_and_strings(content)
+    decls: Dict[Tuple[str, str], str] = {}
+    for match in _KOTLIN_SAME_PKG_DECL_REGEX.finditer(clean):
+        mods = set((match.group("mods") or "").split())
+        if "private" in mods:
+            continue
+        recv = match.group("recv")
+        if not recv:
+            continue
+        kw = match.group("kw")
+        name = match.group("name")
+        if len(name) < 3:
+            continue
+        receiver = ".".join(
+            re.sub(r"<.*$", "", seg).rstrip("?")
+            for seg in recv.rstrip(".").split(".")
+        )
+        if not receiver or not receiver[0].isupper():
+            continue
+        kind = "ext_fun" if kw == "fun" else "ext_val"
+        decls.setdefault((receiver, name), kind)
+    return decls
+
