+    if first and first[0].isupper() and first in receivers:
+        rest = segments[1:]
+        if all("(" in seg for seg in rest):
+            # Review #1: break the chain when local evidence says an
+            # intermediate call changes the type (its declared return
+            # type is known and differs from the first segment).
+            # Unknown or SDK calls keep the builder-pattern heuristic.
+            for seg in rest:
+                callee = re.match(r"([A-Za-z_][\w]*)\s*\(", seg)
