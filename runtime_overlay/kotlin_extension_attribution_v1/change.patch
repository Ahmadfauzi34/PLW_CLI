+def _kotlin_class_ctor_param_spans(clean: str) -> List[str]:
+    """Return the raw text inside each class constructor header's parens.
+
+    Scans `class Name(` headers with a paren-depth walk (defaults may
+    contain nested parens, e.g. `= System.currentTimeMillis()`), so a
+    naive `[^)]*` match would stop early. Only `class` headers are
+    scanned: constructor `val`/`var` params ARE the properties, while a
+    plain param (`cause: Throwable?`) is not accessible via dot syntax
+    and must never enter a property-type index.
+    """
+    spans: List[str] = []
+    for match in re.finditer(
+        r"(?:^|\s)(?:data\s+|sealed\s+|open\s+|abstract\s+|internal\s+|"
+        r"public\s+|private\s+|protected\s+|enum\s+)*class\s+[\w]+\s*\(",
+        clean,
+        re.MULTILINE,
+    ):
+        start = match.end() - 1  # the opening paren
+        depth = 0
+        pos = start
+        while pos < len(clean):
+            ch = clean[pos]
+            if ch == "(":
+                depth += 1
+            elif ch == ")":
+                depth -= 1
+                if depth == 0:
+                    spans.append(clean[start + 1:pos])
+                    break
+            pos += 1
+    return spans
+
