+def _kotlin_variant_path_pair(a: str, b: str) -> bool:
+    """True when two files are plausibly build variants of one FQN.
+
+    Same length, identical segments except exactly one, and that
+    segment sits directly under a source-set root (`src`, `kotlin`,
+    or `java`): Gradle layout src/debug vs src/release, or a
+    simplified kotlin/<variant> layout. Separate modules differ in a
+    module segment, not under a source-set root, so they are not
+    variants of each other.
+    """
+    sa = a.replace(os.sep, "/").split("/")
+    sb = b.replace(os.sep, "/").split("/")
+    if len(sa) != len(sb):
+        return False
+    diffs = [i for i, (x, y) in enumerate(zip(sa, sb)) if x != y]
+    if len(diffs) != 1:
+        return False
+    i = diffs[0]
+    return i > 0 and sa[i - 1] in ("src", "kotlin", "java")
+
