+def _kotlin_dot_member_uses(body: str) -> List[Tuple[str, str, int]]:
+    """List (member, receiver_expr, dot_offset) for every `.member` use.
+
+    The receiver expression is recovered by walking backwards from the
+    dot with paren-depth tracking, so `Modifier.fillMaxSize()` survives
+    as one expression while `a, b).member` stops at the comma. Package
+    and import lines must already be stripped from `body`.
+    """
+    uses: List[Tuple[str, str, int]] = []
+    for match in _KOTLIN_DOT_MEMBER_REGEX.finditer(body):
+        member = match.group(1)
+        pos = match.start() - 1
+        depth = 0
+        start = pos + 1
+        while pos >= 0:
+            ch = body[pos]
+            if ch == ")":
+                depth += 1
+            elif ch == "(":
+                depth -= 1
+                if depth < 0:
+                    break
+            elif ch in " \t\r\n,":
+                if depth == 0:
+                    break
+            elif ch.isalnum() or ch in "_.?<>":
+                pass
+            else:
+                break
+            start = pos
+            pos -= 1
+        receiver = body[start:match.start()].strip()
+        uses.append((member, receiver, match.start()))
+    return uses
+
