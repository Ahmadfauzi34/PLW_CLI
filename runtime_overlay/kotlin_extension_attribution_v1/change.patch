+def _resolve_kotlin_ambiguous_import(
+    state: _ImportResolutionState,
+    fp: str,
+    pkg: str,
+    member: str,
+    owners: List[str],
+) -> Optional[str]:
+    """Resolve a multi-owner Kotlin import via receiver-type evidence.
+
+    Every `.member` use site in the importing file votes for the owner
+    whose extension declaration matches the receiver type. Exactly one
+    voted owner wins; disagreement or no resolvable use site stays
+    ambiguous (None) — never first-owner-wins.
+    """
+    body = state.kotlin_index.stripped_map.get(fp)
+    if body is None:
+        body = _kotlin_strip_comments_and_strings(state.file_map.get(fp, ""))
+    body = re.sub(
+        r"^[ \t]*(?:package|import)\b[^\n]*",
+        "",
+        body,
+        flags=re.MULTILINE,
+    )
+    local_types = _kotlin_local_declared_types(body)
+    votes: Set[str] = set()
+    for use_member, receiver, dot_offset in _kotlin_dot_member_uses(body):
+        if use_member != member:
+            continue
+        recv_type = _kotlin_receiver_type(
+            receiver, member, pkg, state, body, dot_offset, local_types
+        )
+        if recv_type is None:
+            continue
+        owner = state.kotlin_index.ext_index.get((pkg, recv_type, member))
+        if owner is not None and owner in owners:
+            votes.add(owner)
+    if len(votes) == 1:
+        return next(iter(votes))
+    return None
+
