+_KOTLIN_DOT_MEMBER_REGEX = re.compile(r"\.([A-Za-z_][\w]*)")
+_KOTLIN_SCOPE_FN_REGEX = re.compile(
+    r"([\w.?]+)\.(let|run|also|apply)\s*\{"
+    r"|with\s*\(([\w.]+)\)\s*\{"
+)
+
+_KOTLIN_IT_BINDERS = frozenset({"let", "also"})
+_KOTLIN_THIS_BINDERS = frozenset({"run", "apply", "with"})
+_KOTLIN_EXPLICIT_PARAM_REGEX = re.compile(
+    r"\s*(?:[A-Za-z_][\w]*|\([^)]*\))\s*->"
+)
