+_KOTLIN_DOT_MEMBER_REGEX = re.compile(r"\.([A-Za-z_][\w]*)")
+_KOTLIN_SCOPE_FN_REGEX = re.compile(
+    r"([\w.?]+)\.(let|run|also|apply)\s*\{"
+    r"|with\s*\(([\w.]+)\)\s*\{"
+)
