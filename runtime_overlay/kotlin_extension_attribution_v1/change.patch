+def kotlin_constructor_property_types(
+    content: str,
+    _stripped: Optional[str] = None,
+) -> Dict[str, Set[str]]:
+    """Map property name -> set of declared base types (constructor only).
+
+    Collects ONLY `val`/`var` constructor params: `val cause: ErrorCause`
+    is a property, `cause: Throwable?` (plain param) is not. The base
+    type strips generics and nullability (`List<Foo>` -> `List`,
+    `AppNotice?` -> `AppNotice`). A name maps to several types when
+    different classes declare the same property with different types;
+    callers must treat that as ambiguous (fail closed).
+    """
+    clean = _stripped if _stripped is not None else kotlin_strip_comments_and_strings(content)
+    props: Dict[str, Set[str]] = {}
+    for span in _kotlin_class_ctor_param_spans(clean):
+        for match in _KOTLIN_PROP_TYPE_REGEX.finditer(span):
+            props.setdefault(match.group(1), set()).add(match.group(2))
+    return props
+
