+_KOTLIN_TYPE_HEADER_REGEX = re.compile(
+    r"(?:^|\s)(?:(?:data|sealed|open|abstract|internal|public|private|protected|enum|annotation|value|inner)\s+)*"
+    r"(?:class|interface)\s+([A-Za-z_][\w]*)",
+    re.MULTILINE,
+)
+
+_KOTLIN_OBJECT_HEADER_REGEX = re.compile(
+    r"(?:^|\s)object\s+([A-Za-z_][\w]*)",
+    re.MULTILINE,
+)
+
+_KOTLIN_MEMBER_FUN_REGEX = re.compile(
+    r"\bfun\s+([A-Za-z_][\w]*)\s*(?:<[^>]*>\s*)?\((?:[^()]|\([^()]*\))*\)\s*"
+    r"(?::\s*([A-Za-z_][\w]*(?:\.[A-Za-z_][\w]*)*))?",
+)
+
+_KOTLIN_TOP_LEVEL_KEYWORDS = (
+    "fun", "val", "var", "class", "object", "interface", "import", "package",
+)
