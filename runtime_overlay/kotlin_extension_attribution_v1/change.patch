+def _kotlin_infer_init_type(init: str) -> Optional[str]:
+    """Infer a type from a `val x = <init>` initializer, or None.
+
+    Sound patterns only: a constructor call `Type(...)`, a cast
+    `expr as Type` / `as? Type`, or a call to a method whose return
+    type is in a small table of stable APIs (org.json accessors,
+    stdlib collection factories). Anything else is unknown — an
+    inferred wrong type would be worse than no evidence.
+    """
+    init = init.strip()
+    cast = re.search(r"\bas\??\s+([A-Za-z_][\w]*)\s*$", init)
+    if cast:
+        return cast.group(1)
+    ctor = re.match(r"((?:[A-Z][A-Za-z0-9_]*\.)*[A-Z][A-Za-z0-9_]*)\s*\(", init)
+    if ctor:
+        return ctor.group(1)
+    call = re.search(r"([A-Za-z_][\w]*)\s*\(", init)
+    if call:
+        return _KOTLIN_INFERRED_TYPE_METHODS.get(call.group(1))
+    return None
+
+
+def kotlin_local_declared_types(
+    content: str,
+    _stripped: Optional[str] = None,
+) -> Dict[str, str]:
+    """Map a file's own declared names -> their declared base types.
+
+    Covers `val`/`var name: Type` anywhere in the file, `name: Type`
+    params of `fun` headers, and `val`/`var name = <init>` where the
+    initializer's type is inferable (constructor call, cast, or a
+    tabled method such as `optJSONArray` -> `JSONArray`). First
+    declaration wins; a name declared with two different types is
+    dropped (ambiguous). Used only as receiver-type evidence for
+    extension resolution in the same file.
+    """
+    clean = _stripped if _stripped is not None else kotlin_strip_comments_and_strings(content)
+    types: Dict[str, str] = {}
+    ambiguous: Set[str] = set()
+
+    def _add(name: str, typ: str) -> None:
+        if name in ambiguous:
+            return
+        if name in types and types[name] != typ:
+            del types[name]
+            ambiguous.add(name)
+        else:
+            types[name] = typ
+
+    for match in _KOTLIN_PROP_TYPE_REGEX.finditer(clean):
+        _add(match.group(1), match.group(2))
+    for match in re.finditer(
+        r"\bfun\s+[\w.]+\s*(?:<[^>]*>\s*)?\(([^)]*)\)", clean
+    ):
+        for param in _KOTLIN_PARAM_TYPE_REGEX.finditer(match.group(1)):
+            _add(param.group(1), param.group(2))
+    for match in _KOTLIN_INFERRED_INIT_REGEX.finditer(clean):
+        if match.group(1) in types or match.group(1) in ambiguous:
+            continue
+        inferred = _kotlin_infer_init_type(match.group(2))
+        if inferred:
+            _add(match.group(1), inferred)
+    return types
+
