+_KOTLIN_INFERRED_TYPE_METHODS = {
+    "optJSONArray": "JSONArray",
+    "getJSONArray": "JSONArray",
+    "optJSONObject": "JSONObject",
+    "getJSONObject": "JSONObject",
+    "optString": "String",
