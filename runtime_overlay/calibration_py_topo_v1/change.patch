+def _go_grouped_type_names(content: str) -> Set[str]:
+    """Extract top-level identifiers declared inside Go `type ( ... )` blocks."""
+    names: Set[str] = set()
+    clean = _strip_js_comments(content)
+    in_type_group = False
+    paren_depth = 0
+    brace_depth = 0
+    for raw_line in clean.splitlines():
+        line = raw_line.strip()
+        if not in_type_group:
+            if brace_depth == 0 and re.match(r"^type\s*\(\s*$", line):
+                in_type_group = True
+                paren_depth = 1
+                continue
+        else:
+            if paren_depth == 1 and brace_depth == 0:
+                m = re.match(r"^([A-Za-z_]\w*)(?:\s*(?:\[|=|\bstruct\b|\binterface\b)|\s+\S)", line)
+                if m and _is_candidate(m.group(1)):
+                    names.add(m.group(1))
+        for ch in line:
+            if ch == "{":
+                brace_depth += 1
+            elif ch == "}" and brace_depth > 0:
+                brace_depth -= 1
+            elif in_type_group:
+                if ch == "(":
+                    paren_depth += 1
+                elif ch == ")":
+                    paren_depth -= 1
+                    if paren_depth <= 0:
+                        in_type_group = False
+                        paren_depth = 0
+                        break
+    return names
+
+
 def _definition_candidates(content: str, language: str) -> Set[str]:
+    if language == "rust":
+        return {n for n in _rust_top_level_names(content) if _is_candidate(n)}
