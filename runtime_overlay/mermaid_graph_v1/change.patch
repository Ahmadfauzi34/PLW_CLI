+        "change_risk_level": risk_level,
+        "declarations_count": len(decls),
+        "declarations_preview": shown_decls,
+    }]
+    edges_out = []
+
+    if shown_up:
+        lines.append(f'    subgraph UPSTREAM ["Direct Dependencies Imported by Target ({len(shown_up)}/{len(upstreams)})"]')
+        for idx, u_rel in enumerate(shown_up):
+            uid = f"U{idx}"
+            lines.append(f'        {uid}["{_mermaid_escape(os.path.basename(u_rel))}\\n{_mermaid_escape(os.path.dirname(u_rel))}"]:::upstream')
+            u_abs = all_rel_files.get(u_rel, "")
+            nat = edge_natures.get(f"{target_abs} -> {u_abs}", "runtime")
+            if u_rel in circ_refs:
+                lines.append(f'        T0 <-->|"cycle ({nat})"| {uid}')
+            elif nat == "same_package":
+                lines.append(f"        T0 -. same_pkg .-> {uid}")
+            elif nat == "type_only":
+                lines.append(f"        T0 -. type .-> {uid}")
+            else:
+                lines.append(f"        T0 -->|imports| {uid}")
+            nodes_out.append({"id": uid, "role": "direct_upstream", "file": u_rel})
+            edges_out.append({"from": target_rel, "to": u_rel, "relation": "imports", "nature": nat})
+        lines.append("    end")
+
+    if shown_down:
+        lines.append(f'    subgraph DOWNSTREAM ["Direct Dependents Importing Target ({len(shown_down)}/{len(downstreams)})"]')
+        for idx, d_rel in enumerate(shown_down):
+            did = f"D{idx}"
+            lines.append(f'        {did}["{_mermaid_escape(os.path.basename(d_rel))}\\n{_mermaid_escape(os.path.dirname(d_rel))}"]:::downstream')
+            d_abs = all_rel_files.get(d_rel, "")
+            nat = edge_natures.get(f"{d_abs} -> {target_abs}", "runtime")
+            if d_rel in circ_refs:
+                lines.append(f'        {did} <-->|"cycle ({nat})"| T0')
+            elif nat == "same_package":
+                lines.append(f"        {did} -. same_pkg .-> T0")
+            elif nat == "type_only":
+                lines.append(f"        {did} -. type .-> T0")
+            else:
+                lines.append(f"        {did} -->|imports| T0")
+            nodes_out.append({"id": did, "role": "direct_downstream", "file": d_rel})
+            edges_out.append({"from": d_rel, "to": target_rel, "relation": "imported_by", "nature": nat})
+        lines.append("    end")
+
+    if shown_eps:
+        lines.append('    subgraph ENTRYPOINTS ["Affected Entrypoints (Transitive Blast Radius)"]')
+        for idx, ep_rel in enumerate(shown_eps):
+            eid = f"EP{idx}"
+            lines.append(f'        {eid}["[ENTRYPOINT] {_mermaid_escape(os.path.basename(ep_rel))}\\n{_mermaid_escape(os.path.dirname(ep_rel))}"]:::entrypoint')
+            lines.append(f"        {eid} -. reaches .-> T0")
+            nodes_out.append({"id": eid, "role": "affected_entrypoint", "file": ep_rel})
+            edges_out.append({"from": ep_rel, "to": target_rel, "relation": "reaches_transitively"})
+        lines.append("    end")
+
+    zoom_hints = []
+    seen_hint_rels: set = set()
+    for n_rel in (shown_down[:4] + shown_up[:4]):
+        if n_rel in seen_hint_rels or len(seen_hint_rels) >= 5:
+            continue
+        seen_hint_rels.add(n_rel)
+        zoom_hints.append({
+            "target": n_rel,
+            "target_kind": "neighbor_file",
+            "reason": f"Pivot micro-neighborhood to connected file {os.path.basename(n_rel)}",
+            "command": f"plw mermaid {root_arg} --depth 4 --focus {n_rel}",
+        })
+    zoom_hints.append({
+        "target": target_rel,
+        "target_kind": "impact_projection",
+        "reason": "Run full transitive topological impact projection on this target",
+        "command": f"plw impact {target_rel} {root_arg} --json",
+    })
+
+    return {
+        "schema_version": "1.0.0-mermaid-graph",
+        "mode": "mermaid",
+        "decision": "MERMAID_GRAPH_READY",
+        "scan_root": scan_root,
+        "graph_signature": graph_sig,
+        "depth": depth,
+        "depth_name": _MERMAID_DEPTH_NAMES[depth],
+        "direction": norm_dir,
+        "focus": target_rel,
+        "requested_focus": focus,
+        "auto_selected_focus": auto_selected,
+        "include_tests": bool(include_tests),
+        "summary": {
+            "target_file": target_rel,
+            "lines": t_lines,
+            "declarations_count": len(decls),
+            "direct_upstream_count": len(upstreams),
+            "direct_downstream_count": len(downstreams),
+            "affected_entrypoints_count": len(aff_eps),
+            "circular_references_count": len(circ_refs),
+            "change_risk_level": risk_level,
+            "rendered_nodes": len(nodes_out),
+            "rendered_edges": len(edges_out),
+        },
+        "mermaid_source": "\n".join(lines),
+        "nodes": nodes_out,
+        "edges": edges_out,
+        "next_zoom_hints": zoom_hints,
+        "authority": {
+            "read_only": True,
+            "selects_PLW_capability": False,
+            "mutate_source": False,
+            "execute_runtime": False,
+            "commit_truth": False,
