+_MERMAID_DIRECTIONS = ("LR", "TD", "TB", "RL", "BT")
+_MERMAID_DEPTH_NAMES = {
+    1: "subsystem_overview",
+    2: "module_dependency_flow",
+    3: "file_architecture_graph",
+    4: "file_micro_neighborhood",
+}
+
+
+def _mermaid_escape(text: Any) -> str:
+    """Sanitize a string for safe inclusion inside a Mermaid ["..."] node/edge label."""
+    s = str(text or "")
+    s = s.replace("\\", "/")
+    s = s.replace('"', "'").replace("`", "'")
+    s = s.replace("<", "‹").replace(">", "›")
+    s = s.replace("{", "(").replace("}", ")")
+    return s
+
+
+def _mermaid_build_path_trie(rel_paths: List[str]) -> Dict[str, Any]:
+    """Build directory children and direct-file counts for path-trie compaction."""
+    from collections import defaultdict
+    dir_children: Dict[str, set] = defaultdict(set)
+    dir_direct_files: Dict[str, int] = defaultdict(int)
+    dir_total_files: Dict[str, int] = defaultdict(int)
+
+    for rel in rel_paths:
+        parts = [p for p in rel.split("/") if p]
+        if not parts:
+            continue
+        dir_total_files[""] += 1
+        if len(parts) == 1:
+            dir_direct_files[""] += 1
+            continue
+        dirs = parts[:-1]
+        cur = ""
+        for seg in dirs:
+            nxt = f"{cur}/{seg}" if cur else seg
+            dir_children[cur].add(nxt)
+            dir_total_files[nxt] += 1
+            cur = nxt
+        dir_direct_files[cur] += 1
+
+    return {
+        "dir_children": dir_children,
+        "dir_direct_files": dir_direct_files,
+        "dir_total_files": dir_total_files,
+    }
+
+
+def _mermaid_is_passthrough_dir(cur: str, trie: Dict[str, Any]) -> bool:
+    """Return True when `cur` has a single child directory that holds nearly all files."""
+    children = trie["dir_children"].get(cur, ())
+    if len(children) != 1:
+        return False
+    direct = trie["dir_direct_files"].get(cur, 0)
+    total = trie["dir_total_files"].get(cur, 0)
+    return direct == 0 or (direct <= 1 and total > 4)
+
+
+def _mermaid_compact_group(
+    rel_path: str,
+    trie: Dict[str, Any],
+    *,
+    target_splits: int = 1,
+) -> str:
+    """Derive a compacted directory group key by collapsing single-child pass-through dirs."""
+    parts = [p for p in rel_path.split("/") if p]
+    if len(parts) <= 1:
+        return "(root)"
+    dirs = parts[:-1]
+    dir_children = trie["dir_children"]
+    dir_direct_files = trie["dir_direct_files"]
+
+    # Refine depth=1 for nested sub-roots like android/host/src/pi-extensions
+    if target_splits == 1:
+        if "pi-extensions" in dirs:
+            pi_idx = dirs.index("pi-extensions")
+            return "/".join(dirs[: pi_idx + 1])
+        if len(dirs) >= 2 and dirs[0] == "android":
+            if dirs[1] == "host" and len(dirs) >= 3 and dirs[2] == "src":
+                return "android/host/src"
+            return f"android/{dirs[1]}"
+
+    splits_seen = 0
+    cur = ""
+    chosen = dirs[0]
+    for idx, seg in enumerate(dirs):
+        nxt = f"{cur}/{seg}" if cur else seg
+        parent_branches = (
+            len(dir_children.get(cur, ())) > 1
+            or (dir_direct_files.get(cur, 0) > 0 and not _mermaid_is_passthrough_dir(cur, trie))
+        )
+        is_boundary_seg = seg in ("pi-extensions", "packages", "apps", "crates", "plugins", "services")
+        if (idx == 0 and not _mermaid_is_passthrough_dir("", trie)) or parent_branches or is_boundary_seg:
+            splits_seen += 1
+        chosen = nxt
+        cur = nxt
+        if splits_seen >= target_splits:
+            collapsed_steps = 0
+            while _mermaid_is_passthrough_dir(cur, trie):
+                only_child = next(iter(dir_children[cur]))
+                cur = only_child
+                chosen = cur
+                collapsed_steps += 1
+            # If we collapsed a deep package chain (e.g. src/main/kotlin/io/jeph/pipkin)
+            # during module-level grouping (target_splits >= 2), step one level into
+            # the domain package under that namespace root if available.
+            if target_splits >= 2 and collapsed_steps >= 2:
+                rem_idx = len([p for p in cur.split("/") if p])
+                if rem_idx < len(dirs):
+                    chosen = f"{cur}/{dirs[rem_idx]}"
+                    cur = chosen
+            break
+
+    return chosen
+
+
+def _mermaid_short_module_label(group_key: str) -> str:
+    """Shorten long pass-through prefixes (e.g. src/main/kotlin/io/jeph/pipkin/...) for display."""
+    markers = ("/kotlin/io/jeph/", "/java/io/jeph/", "/src/main/kotlin/", "/src/main/java/")
+    for m in markers:
+        if m in group_key:
+            tail = group_key.split(m, 1)[1]
+            prefix = group_key.split("/src/", 1)[0]
+            if "/src/" in group_key:
+                after_src = group_key.split("/src/", 1)[1]
+                flavor = after_src.split("/", 1)[0]
+                if flavor and flavor != "main":
+                    prefix = f"{prefix}({flavor})" if prefix else flavor
+            return f"{prefix}: {tail}" if prefix else tail
+    return group_key
+
+
+def kernel_mermaid(
+    scan_root: str = ".",
+    *,
+    depth: int = 1,
+    focus: Optional[str] = None,
+    direction: str = "LR",
+    max_nodes: int = 24,
+    include_tests: bool = False,
+) -> Dict[str, Any]:
+    """Generate a multi-depth Mermaid architecture & dependency diagram from SharedGraph."""
+    if not SHARED_GRAPH_AVAILABLE or not TARGET_TOPOLOGY_AVAILABLE:
+        return {"error": "mermaid topology generator is unavailable", "available": False}
+    root_error = _validate_scan_root(scan_root)
+    if root_error:
+        return root_error
+    if isinstance(depth, bool) or not isinstance(depth, int) or depth not in (1, 2, 3, 4):
+        return _kernel_error(
+            "invalid_mermaid_depth",
+            "Mermaid depth must be an integer between 1 and 4.",
+            depth=depth,
+            supported_depths=[1, 2, 3, 4],
+        )
+    norm_dir = str(direction or "LR").strip().upper()
+    if norm_dir not in _MERMAID_DIRECTIONS:
+        return _kernel_error(
+            "invalid_mermaid_direction",
+            f"Mermaid direction must be one of {', '.join(_MERMAID_DIRECTIONS)}.",
+            direction=direction,
+            supported_directions=list(_MERMAID_DIRECTIONS),
+        )
+    if isinstance(max_nodes, bool) or not isinstance(max_nodes, int) or not 4 <= max_nodes <= 120:
+        return _kernel_error(
+            "invalid_mermaid_max_nodes",
+            "Mermaid max_nodes must be an integer between 4 and 120.",
+            max_nodes=max_nodes,
+            minimum=4,
+            maximum=120,
+        )
+
+    from collections import Counter, defaultdict
+
+    root_abs = os.path.abspath(scan_root)
+    graph = _build_kernel_graph(scan_root)
+    graph_sig = (graph.get("cache", {}) or {}).get("graph_content_signature")
+    if not graph_sig and callable(globals().get("graph_content_signature")):
+        try:
+            graph_sig = graph_content_signature(graph)
+        except Exception:
+            graph_sig = None
+
+    orientation = build_target_topology_orientation(
+        graph, top_n=min(50, max(12, max_nodes)), include_edges=True
+    )
+    inv = (orientation.get("inventory") or {})
+    vertices: List[str] = list(graph.get("vertices") or [])
+    raw_edges = list(graph.get("edges") or [])
+    edge_natures: Dict[str, str] = dict(graph.get("edge_natures") or {})
+    node_meta: Dict[str, Dict[str, Any]] = dict(graph.get("node_metadata") or {})
+
+    def _rel(p: str) -> str:
+        try:
+            return os.path.relpath(p, root_abs).replace("\\", "/")
+        except Exception:
+            return str(p).replace("\\", "/")
+
+    active_abs = [
+        v for v in vertices
+        if include_tests or not (node_meta.get(v) or {}).get("is_test", False)
+    ]
+    active_set = set(active_abs)
+    rel_by_abs = {v: _rel(v) for v in active_abs}
+    abs_by_rel = {rel_by_abs[v]: v for v in active_abs}
+
+    if not active_abs:
+        empty_mmd = f"flowchart {norm_dir}\n    EMPTY[\"No supported source files found in {_mermaid_escape(scan_root)}\"]"
+        return {
+            "schema_version": "1.0.0-mermaid-graph",
+            "mode": "mermaid",
+            "decision": "EMPTY_OR_UNRESOLVED_REPOSITORY",
+            "scan_root": scan_root,
+            "graph_signature": graph_sig,
+            "depth": depth,
+            "depth_name": _MERMAID_DEPTH_NAMES[depth],
+            "direction": norm_dir,
+            "focus": focus,
+            "include_tests": bool(include_tests),
+            "summary": {
+                "total_repo_files": len(vertices),
+                "active_files": 0,
+                "rendered_nodes": 0,
+                "rendered_edges": 0,
+            },
+            "mermaid_source": empty_mmd,
+            "nodes": [],
+            "edges": [],
+            "next_zoom_hints": [],
+            "authority": {
+                "read_only": True,
+                "selects_PLW_capability": False,
+                "mutate_source": False,
+                "execute_runtime": False,
+                "commit_truth": False,
+            },
+        }
+
+    trie = _mermaid_build_path_trie(list(rel_by_abs.values()))
+    sccs = list(orientation.get("strongly_connected_components") or [])
+    cyclic_files: set = set()
+    for scc in sccs:
+        for member in (scc.get("members") or []):
+            cyclic_files.add(str(member).replace("\\", "/"))
+
+    focus_norm = str(focus or "").strip().replace("\\", "/").strip("/")
+    root_arg = scan_root if scan_root != "." else "."
+
+    # =========================================================================
+    # DEPTH 1: SUBSYSTEM OVERVIEW
+    # =========================================================================
+    if depth == 1:
+        sub_by_rel = {
+            rel: _mermaid_compact_group(rel, trie, target_splits=1)
+            for rel in rel_by_abs.values()
+        }
+        # If total subsystems is 1 and there are multiple files, split one level deeper
+        if len(set(sub_by_rel.values())) == 1 and len(rel_by_abs) > 1:
+            sub_by_rel = {
+                rel: _mermaid_compact_group(rel, trie, target_splits=2)
+                for rel in rel_by_abs.values()
+            }
+
+        sub_files: Dict[str, List[str]] = defaultdict(list)
+        sub_langs: Dict[str, Counter] = defaultdict(Counter)
+        sub_entrypoints: Counter = Counter()
+        sub_cycles: Counter = Counter()
+        for v_abs, rel in rel_by_abs.items():
+            grp = sub_by_rel[rel]
+            sub_files[grp].append(rel)
+            meta = node_meta.get(v_abs) or {}
+            ext = os.path.splitext(rel)[1].lstrip(".") or str(meta.get("language") or "src")
+            sub_langs[grp][ext] += 1
+            if meta.get("is_entrypoint"):
+                sub_entrypoints[grp] += 1
+        for scc in sccs:
+            members = [str(m).replace("\\", "/") for m in (scc.get("members") or [])]
+            touched = {sub_by_rel[m] for m in members if m in sub_by_rel}
+            for grp in touched:
+                sub_cycles[grp] += 1
+
+        internal_edges: Counter = Counter()
+        cross_edges: Dict[tuple, Counter] = defaultdict(Counter)
+        for u_abs, v_abs in raw_edges:
+            if u_abs not in active_set or v_abs not in active_set:
+                continue
+            u_rel, v_rel = rel_by_abs[u_abs], rel_by_abs[v_abs]
+            gu, gv = sub_by_rel[u_rel], sub_by_rel[v_rel]
+            nat = edge_natures.get(f"{u_abs} -> {v_abs}", "runtime")
+            if gu == gv:
+                internal_edges[gu] += 1
+            else:
+                cross_edges[(gu, gv)][nat] += 1
+
+        all_subsystems = sorted(
+            sub_files.keys(),
+            key=lambda g: (-len(sub_files[g]), -internal_edges[g], g),
+        )
+        if focus_norm:
+            matched_subs = {
+                g for g in all_subsystems
+                if focus_norm.lower() in g.lower()
+                or any(focus_norm.lower() in f.lower() for f in sub_files[g])
+            }
+            if not matched_subs:
+                return {
+                    "schema_version": "1.0.0-mermaid-graph",
+                    "mode": "mermaid",
+                    "decision": "FOCUS_NOT_FOUND",
+                    "scan_root": scan_root,
+                    "graph_signature": graph_sig,
+                    "depth": depth,
+                    "depth_name": _MERMAID_DEPTH_NAMES[depth],
+                    "direction": norm_dir,
+                    "focus": focus,
+                    "available_subsystems": all_subsystems[:20],
+                    "mermaid_source": "",
+                    "nodes": [],
+                    "edges": [],
+                    "next_zoom_hints": [
+                        {
+                            "description": f"Explore subsystem {g} at depth 2",
+                            "command": f"plw mermaid {root_arg} --depth 2 --focus {g}",
+                        }
+                        for g in all_subsystems[:5]
+                    ],
+                    "authority": {
+                        "read_only": True,
+                        "selects_PLW_capability": False,
+                        "mutate_source": False,
+                        "execute_runtime": False,
+                        "commit_truth": False,
+                    },
+                }
+            neighbor_subs = set(matched_subs)
+            for (gu, gv), cnts in cross_edges.items():
+                if sum(cnts.values()) > 0 and (gu in matched_subs or gv in matched_subs):
+                    neighbor_subs.add(gu)
+                    neighbor_subs.add(gv)
+            selected_subs = [g for g in all_subsystems if g in neighbor_subs][:max_nodes]
+        else:
+            selected_subs = all_subsystems[:max_nodes]
+
+        selected_set = set(selected_subs)
+        lines = [
+            f"flowchart {norm_dir}",
+            "    classDef subsystem fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;",
+            "    classDef cyclic fill:#3b1d2e,stroke:#f43f5e,stroke-width:2px,color:#ffe4e6;",
+        ]
+        node_ids: Dict[str, str] = {}
+        nodes_out: List[Dict[str, Any]] = []
+        for idx, grp in enumerate(selected_subs):
+            nid = f"S{idx}"
+            node_ids[grp] = nid
+            f_cnt = len(sub_files[grp])
+            lang_str = ", ".join(f"{k}:{v}" for k, v in sub_langs[grp].most_common(3))
+            ep_cnt = sub_entrypoints[grp]
+            int_cnt = internal_edges[grp]
+            cyc_cnt = sub_cycles[grp]
+            cyc_tag = f" | cycles: {cyc_cnt}" if cyc_cnt else ""
+            label = (
+                f"{_mermaid_escape(grp)}\\n"
+                f"{f_cnt} files ({_mermaid_escape(lang_str)})\\n"
+                f"entrypoints: {ep_cnt} | internal edges: {int_cnt}{cyc_tag}"
+            )
+            cls = "cyclic" if cyc_cnt > 0 else "subsystem"
+            lines.append(f'    {nid}["{label}"]:::{cls}')
+            nodes_out.append({
+                "id": nid,
+                "subsystem": grp,
+                "files": f_cnt,
+                "languages": dict(sub_langs[grp]),
+                "entrypoints": ep_cnt,
+                "internal_edges": int_cnt,
+                "cyclic_sccs": cyc_cnt,
+            })
+
+        edges_out: List[Dict[str, Any]] = []
+        for (gu, gv), cnts in sorted(
+            cross_edges.items(),
+            key=lambda kv: (-sum(kv[1].values()), kv[0][0], kv[0][1]),
+        ):
+            if gu not in selected_set or gv not in selected_set:
+                continue
+            tot = sum(cnts.values())
+            rt = cnts.get("runtime", 0)
+            sp = cnts.get("same_package", 0)
+            to = cnts.get("type_only", 0)
+            parts = []
+            if rt:
+                parts.append(f"rt:{rt}")
+            if sp:
+                parts.append(f"pkg:{sp}")
+            if to:
+                parts.append(f"type:{to}")
+            edge_lbl = f"{tot} edges ({', '.join(parts)})"
+            lines.append(f'    {node_ids[gu]} -->|"{edge_lbl}"| {node_ids[gv]}')
+            edges_out.append({
+                "from": gu,
+                "to": gv,
+                "total": tot,
+                "natures": dict(cnts),
+            })
+
+        zoom_hints = [
+            {
+                "target": grp,
+                "target_kind": "subsystem",
+                "reason": f"{len(sub_files[grp])} files, {internal_edges[grp]} internal edges, {sub_entrypoints[grp]} entrypoints",
+                "command": f"plw mermaid {root_arg} --depth 2 --focus {grp}",
+            }
+            for grp in selected_subs[:6]
+        ]
+        zoom_hints.append({
+            "target": selected_subs[0] if selected_subs else ".",
+            "target_kind": "file_architecture",
+            "reason": "Inspect top entrypoints, hubs, and cyclic files across the repository",
+            "command": f"plw mermaid {root_arg} --depth 3",
+        })
+
+        return {
+            "schema_version": "1.0.0-mermaid-graph",
+            "mode": "mermaid",
+            "decision": "MERMAID_GRAPH_READY",
+            "scan_root": scan_root,
+            "graph_signature": graph_sig,
+            "depth": depth,
+            "depth_name": _MERMAID_DEPTH_NAMES[depth],
+            "direction": norm_dir,
+            "focus": focus,
+            "include_tests": bool(include_tests),
+            "summary": {
+                "total_repo_files": inv.get("files", len(vertices)),
+                "active_files": len(active_abs),
+                "total_subsystems": len(all_subsystems),
+                "rendered_nodes": len(nodes_out),
+                "rendered_edges": len(edges_out),
+                "internal_import_edges": inv.get("internal_import_edges", len(raw_edges)),
+                "entrypoints": inv.get("entrypoints", 0),
+                "cyclic_sccs": inv.get("cyclic_sccs", len(sccs)),
+            },
+            "mermaid_source": "\n".join(lines),
+            "nodes": nodes_out,
+            "edges": edges_out,
+            "next_zoom_hints": zoom_hints,
+            "authority": {
+                "read_only": True,
+                "selects_PLW_capability": False,
+                "mutate_source": False,
+                "execute_runtime": False,
+                "commit_truth": False,
+            },
+        }
+
+    # =========================================================================
+    # DEPTH 2: MODULE / DOMAIN PACKAGE FLOW
+    # =========================================================================
+    if depth == 2:
+        sub_by_rel = {
+            rel: _mermaid_compact_group(rel, trie, target_splits=1)
+            for rel in rel_by_abs.values()
+        }
+        mod_by_rel = {
+            rel: _mermaid_compact_group(rel, trie, target_splits=2)
+            for rel in rel_by_abs.values()
+        }
+        if len(set(mod_by_rel.values())) <= len(set(sub_by_rel.values())):
+            mod_by_rel = {
+                rel: _mermaid_compact_group(rel, trie, target_splits=3)
+                for rel in rel_by_abs.values()
+            }
+
+        mod_files: Dict[str, List[str]] = defaultdict(list)
+        mod_parent_sub: Dict[str, str] = {}
+        for v_abs, rel in rel_by_abs.items():
+            m = mod_by_rel[rel]
+            mod_files[m].append(rel)
+            mod_parent_sub[m] = sub_by_rel[rel]
+
+        mod_internal: Counter = Counter()
+        mod_cross: Dict[tuple, Counter] = defaultdict(Counter)
+        mod_traffic: Counter = Counter()
+        for u_abs, v_abs in raw_edges:
+            if u_abs not in active_set or v_abs not in active_set:
+                continue
+            u_rel, v_rel = rel_by_abs[u_abs], rel_by_abs[v_abs]
+            mu, mv = mod_by_rel[u_rel], mod_by_rel[v_rel]
+            nat = edge_natures.get(f"{u_abs} -> {v_abs}", "runtime")
+            if mu == mv:
+                mod_internal[mu] += 1
+            else:
+                mod_cross[(mu, mv)][nat] += 1
+                mod_traffic[mu] += 1
+                mod_traffic[mv] += 1
+
+        all_modules = sorted(
+            mod_files.keys(),
+            key=lambda m: (-(mod_traffic[m] + mod_internal[m] * 2 + len(mod_files[m])), m),
+        )
+        if focus_norm:
+            matched_mods = {
