+def cmd_mermaid(args: List[str]) -> int:
+    """Generate a multi-depth Mermaid architecture & dependency diagram (depths 1..4)."""
+    parser = _PlwArgumentParser(prog="plw mermaid")
+    parser.add_argument("root", nargs="?", default=".")
+    parser.add_argument("--root", default=None, dest="root_flag")
+    parser.add_argument("--depth", type=int, default=1)
+    parser.add_argument("--focus", default=None)
+    parser.add_argument("--direction", default="LR")
+    parser.add_argument("--max-nodes", type=int, default=24, dest="max_nodes")
+    parser.add_argument("--include-tests", action="store_true", dest="include_tests")
+    parser.add_argument("--out", default=None)
+    parser.add_argument("--json", action="store_true", dest="as_json")
+    opts = _parse_cli_args(parser, args)
+    opts.root = opts.root_flag if opts.root_flag is not None else opts.root
+
+    result = hott_kernel.kernel_mermaid(
+        opts.root,
+        depth=opts.depth,
+        focus=opts.focus,
+        direction=opts.direction,
+        max_nodes=opts.max_nodes,
+        include_tests=opts.include_tests,
+    )
+    has_err = bool(result.get("error")) or result.get("decision") == "FOCUS_NOT_FOUND"
+    code = 0 if not has_err else 3
+
+    if opts.out and not has_err and result.get("mermaid_source"):
+        try:
+            out_abs = os.path.abspath(opts.out)
+            os.makedirs(os.path.dirname(out_abs) or ".", exist_ok=True)
+            mmd_src = str(result.get("mermaid_source") or "")
+            if out_abs.lower().endswith(".md"):
+                payload_text = (
+                    f"# PLW Mermaid Graph (`depth={result.get('depth')}: {result.get('depth_name')}`)\n\n"
+                    f"```mermaid\n{mmd_src}\n```\n"
+                )
+            else:
+                payload_text = mmd_src + "\n"
+            Path(out_abs).write_text(payload_text, encoding="utf-8")
+            result["written_to"] = out_abs
+        except OSError as exc:
+            return _cli_error(
+                f"Failed to write Mermaid output to {opts.out}: {exc}",
+                "io_error",
+                as_json=opts.as_json,
+                rc=2,
+            )
+
+    if opts.as_json:
+        print(json.dumps(result, indent=2, ensure_ascii=False))
+    else:
+        print("# [PLW Multi-Depth Mermaid Graph]")
+        print("# Authority: static structural visualization only; read-only")
+        if result.get("error"):
+            print("# Error: " + str(result.get("error")))
+            if result.get("message"):
+                print("# Message: " + str(result.get("message")))
+            return code
+        print(
+            f"# Depth: {result.get('depth')} ({result.get('depth_name')}) | "
+            f"Direction: {result.get('direction')} | "
+            f"Focus: {result.get('focus') or 'all'}"
+        )
+        summary = result.get("summary") or {}
+        print(
+            f"# Decision: {result.get('decision')} | "
+            f"Rendered nodes: {summary.get('rendered_nodes', 0)} | "
+            f"Rendered edges: {summary.get('rendered_edges', 0)}"
+        )
+        if result.get("written_to"):
+            print(f"# Written to: {result.get('written_to')}")
+        if result.get("decision") == "FOCUS_NOT_FOUND":
+            avail = result.get("available_subsystems") or result.get("available_modules") or []
+            if avail:
+                print("# Available targets: " + ", ".join(str(x) for x in avail[:10]))
+        mmd = result.get("mermaid_source") or ""
+        if mmd:
+            print("")
+            print(mmd)
+            print("")
+        hints = result.get("next_zoom_hints") or []
