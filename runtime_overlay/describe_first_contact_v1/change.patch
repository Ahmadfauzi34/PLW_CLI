+# First-contact commands (doctor, ast, agent, skill, capability, ui)
+# are real commands an agent meets first, but they are NOT registered
+# capabilities, so describe cannot return a contract for them. This
+# table teaches describe_command to point at their --help instead of
+# returning a bare not-registered error. It is a pointer, NOT an alias:
+# describe answers with `hint` only -- no `alias_of`, `known` stays
+# false, the error is unchanged. COMMAND_CONTRACTS stays untouched and
+# `capability list` never shows these names.
+FIRST_CONTACT_HELP = {
+    "agent": "plw agent --help",
+    "ast": "plw ast --help",
+    "capability": "plw capability --help",
+    "doctor": "plw doctor --help",
+    "skill": "plw skill --help",
+    "ui": "plw ui --help",
+}
+
 
