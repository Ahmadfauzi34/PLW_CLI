+def _engine_answer_summary(target_orientation: Dict[str, Any]) -> Dict[str, Any]:
+    """Summarize engine-located symbols for the agent decision frame.
+
+    The topology target may stay unresolved (or ambiguous) while the
+    engine layer already located symbol(s) in the target; the summary
+    lets the decision frame say so up front instead of reading as "no
+    answer". Returns {} when the engine located nothing, so the frame
+    stays silent instead of claiming an answer. Never raises.
+    """
+    try:
+        engine = (target_orientation or {}).get("engine") or {}
+        nodes = [n for n in (engine.get("symbol_nodes") or []) if isinstance(n, dict)]
+        edges = [e for e in (engine.get("symbol_edges") or []) if isinstance(e, dict)]
+        if not nodes and not edges:
+            return {}
+        return {
+            "symbols": [
+                {
+                    "symbol": n.get("symbol"),
+                    "file": n.get("file"),
+                    "line": n.get("line"),
+                    "kind": n.get("kind"),
+                    "authority": n.get("authority"),
+                }
+                for n in nodes[:4]
+            ],
+            "calls": [
+                {
+                    "caller": {
+                        "file": (e.get("caller") or {}).get("file"),
+                        "line": (e.get("caller") or {}).get("line"),
+                    },
+                    "callee": (e.get("callee") or {}).get("symbol"),
+                }
+                for e in edges[:4]
+            ],
+            "symbol_count": len(nodes),
+            "call_count": len(edges),
+        }
+    except Exception:
+        return {}
+
+
