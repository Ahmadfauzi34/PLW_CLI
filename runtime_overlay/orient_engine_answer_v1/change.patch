+def _project_engine_answer(answer: Mapping[str, Any] | None) -> Dict[str, Any] | None:
+    """Project an engine-answer summary into the decision frame, or None.
+
+    The frame owns its schema: only the known keys survive, only when at
+    least one located symbol or call is named. An empty or malformed
+    summary stays out of the frame instead of claiming an answer. The
+    summary shape is {symbols: [{symbol, file, line, kind, authority}],
+    calls: [{caller: {file, line}, callee: <symbol string>}]}; a callee
+    given as a raw edge dict is still accepted defensively.
+    """
+    if not isinstance(answer, Mapping):
+        return None
+    symbols = [
+        {
+            "symbol": s.get("symbol"),
+            "file": s.get("file"),
+            "line": s.get("line"),
+            "kind": s.get("kind"),
+            "authority": s.get("authority"),
+        }
+        for s in (answer.get("symbols") or [])[:4]
+        if isinstance(s, Mapping)
+    ]
+    calls = []
+    for c in (answer.get("calls") or [])[:4]:
+        if not isinstance(c, Mapping):
+            continue
+        caller = c.get("caller")
+        if not isinstance(caller, Mapping):
+            caller = {}
+        callee = c.get("callee")
+        if isinstance(callee, Mapping):
+            callee = callee.get("symbol")
+        calls.append(
+            {
+                "caller": {"file": caller.get("file"), "line": caller.get("line")},
+                "callee": callee if isinstance(callee, str) else None,
+            }
+        )
+    if not symbols and not calls:
+        return None
+    return {
+        "resolved": True,
+        "symbols": symbols,
+        "calls": calls,
+        "symbol_count": int(answer.get("symbol_count") or len(symbols)),
+        "call_count": int(answer.get("call_count") or len(calls)),
+        "detail_location": "target_orientation.engine",
+        "note": (
+            "Engine layer located symbol(s) in this target; detail in "
+            "target_orientation.engine, route in dynamic_context."
+        ),
+    }
+
+
