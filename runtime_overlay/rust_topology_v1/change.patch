+# ---------------------------------------------------------------------------
+# Rust frontend (R1). Stdlib-only, regex + small recursive descent — mirroring
+# the Kotlin frontend above. Rust has two import mechanisms:
+#   `use a::b::C;`, `use a::{B, C as D};`, `use a::b::*;` (glob),
+#   `use a::b as c;`, `use crate::...;`, `use self::...;`, `use super::...;`
+#   `mod foo;` / `pub mod foo;` (a file edge: foo.rs or foo/mod.rs)
+# Every import is runtime: Rust has no `import type`, and a `mod`
+# declaration is a file edge. `use` statements are matched with optional
+# leading whitespace, so uses inside function bodies and inline `mod`
+# blocks are captured too; `mod` is anchored at column 0 (rustfmt puts
+# top-level `mod` there) so a `mod inner;` inside an inline `mod outer`
+# block — whose file is outer/inner.rs, not inner.rs — never becomes a
+# wrong edge. `mod` is emitted with its bare name plus a `rust_mod`
+# marker: the graph resolves it in the Rust branch against sibling files
+# (`<name>.rs`, then `<name>/mod.rs` next to the declaring file) — NOT
+# through the relative-import branch, because a Rust `mod` is relative to
+# the declaring *module's* directory (`mod bar;` in `src/foo.rs` is
+# `src/foo/bar.rs`, while `./bar` from that file would wrongly mean
+# `src/bar.rs`).
+# Accepted noise (same class as the Kotlin frontend's): `strip_js_comments`
+# is not string-aware, so a `//` inside a string literal can hide a `use`
+# on the same line; nested block comments are not stripped either. The
+# resolver is name-based, not visibility-checked: a `use` of a private
+# item still resolves to the declaring file (an edge, not a proof the
+# import compiles) — the same honesty boundary as the engine's
+# name-based callers.
+# ---------------------------------------------------------------------------
+
+RUST_STDLIB_CRATES = ("std", "core", "alloc")
+
+# One `use ... ;` statement; DOTALL so rustfmt's multi-line groups match.
+# `[^;]+` stops at the statement's own semicolon (a `use` never contains
+# one inside its braces).
+RUST_USE_STATEMENT_REGEX = re.compile(
+    r"^[ \t]*(?:pub(?:\([^)]*\))?\s+)?use\s+([^;]+);",
+    re.MULTILINE | re.DOTALL,
+)
+
+# Top-level `mod` only: column-0 anchored (see the header comment).
+RUST_MOD_REGEX = re.compile(
+    r"^(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_][\w]*)\s*;",
+    re.MULTILINE,
+)
+
+# Top-level declarations only: anchored at column 0, so indented members
+# inside an `impl` block or an inline `mod` block never match. Tolerates
+# `pub(...)` visibility and the `async`/`unsafe`/`const`/`extern "..."`/
+# `default` modifiers (repeatable, any order). `impl` has no name and is
+# skipped; items inside an inline `mod` block are NOT indexed (accepted
+# limitation: a `use` of such an item classifies as rust_unresolved, not
+# as a wrong edge).
+RUST_DECL_REGEX = re.compile(
+    r"^(?:macro_rules!\s+([A-Za-z_][\w]*)|"
+    r"(?:pub(?:\([^)]*\))?\s+)?"
+    r"(?:async\s+|unsafe\s+|const\s+|extern\s+\"[^\"]*\"\s+|default\s+)*"
+    r"(?:fn|struct|enum|union|trait|type|const|static|mod)\s+([A-Za-z_][\w]*))",
+    re.MULTILINE,
+)
+
+_RUST_PATH_SEGMENT_REGEX = re.compile(r"^[A-Za-z_][\w]*$")
+
+RUST_CRATE_BIN_DIRS = ("bin", "examples", "tests", "benches")
+
+
+def rust_top_level_names(content: str) -> List[str]:
+    """Return top-level declaration names of a Rust file (R1)."""
+    names: List[str] = []
+    for macro_name, decl_name in RUST_DECL_REGEX.findall(strip_js_comments(content)):
+        name = macro_name or decl_name
+        if name:
+            names.append(name)
+    return names
+
+
+def _split_rust_use_group(body: str) -> List[str]:
+    """Split a `{...}` group body on top-level commas (R1)."""
+    parts: List[str] = []
+    depth = 0
+    current: List[str] = []
+    for ch in body:
+        if ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+        if ch == "," and depth == 0:
+            parts.append("".join(current))
+            current = []
+        else:
+            current.append(ch)
+    tail = "".join(current).strip()
+    if tail:
+        parts.append(tail)
+    return [p.strip() for p in parts if p.strip()]
+
+
+def _is_valid_rust_path(path: str) -> bool:
+    return bool(path) and all(
+        _RUST_PATH_SEGMENT_REGEX.match(seg) for seg in path.split("::")
+    )
+
+
+def _expand_rust_use_spec(spec: str, prefix: str = "") -> List[Any]:
+    """Expand one `use` spec into (path, alias, wildcard) triples (R1).
+
+    Handles `a::b`, `a::b as c`, `a::b::*`, and `{...}` groups at any
+    depth (`use a::{b::{c, d}, e};` -> `a::b::c`, `a::b::d`, `a::e`).
+    Malformed members are dropped, never emitted as garbage paths.
+    """
+    spec = " ".join(spec.split())
+    results: List[Any] = []
+    brace = spec.find("::{")
+    if brace != -1:
+        base = spec[:brace].strip()
+        full_base = f"{prefix}{base}" if prefix else base
+        depth = 0
+        end = -1
+        for i in range(brace + 2, len(spec)):
+            if spec[i] == "{":
+                depth += 1
+            elif spec[i] == "}":
+                depth -= 1
+                if depth == 0:
+                    end = i
+                    break
+        if end == -1 or not _is_valid_rust_path(full_base):
+            return []
+        body = spec[brace + 3 : end]
+        for member in _split_rust_use_group(body):
+            results.extend(_expand_rust_use_spec(member, prefix=full_base + "::"))
+        return results
+    alias: Optional[str] = None
+    if " as " in spec:
+        spec, alias = spec.rsplit(" as ", 1)
+        spec, alias = spec.strip(), alias.strip()
+    wildcard = spec.endswith("::*")
+    path = spec[:-3] if wildcard else spec
+    full = f"{prefix}{path}" if prefix else path
+    if not _is_valid_rust_path(full):
+        return []
+    if alias and not _RUST_PATH_SEGMENT_REGEX.match(alias):
+        return []
+    return [(full, alias, wildcard)]
+
+
+def parse_rust_imports(content: str) -> List[Dict[str, Any]]:
+    """Parse Rust `use` + `mod` statements (R1). Every import is runtime."""
+    clean = strip_js_comments(content)
+    results: List[Dict[str, Any]] = []
+    for match in RUST_USE_STATEMENT_REGEX.finditer(clean):
+        for path, alias, wildcard in _expand_rust_use_spec(match.group(1)):
+            symbol = alias or path.rsplit("::", 1)[-1]
+            results.append({
+                "raw_import": path,
+                "import_nature": "runtime",
+                "statement": match.group(0).strip(),
+                "symbols": [symbol],
+                "semantic_usages": [],
+                "language": "rust",
+                "is_relative": False,
+                "alias": alias,
+                "wildcard": wildcard,
+            })
+    for match in RUST_MOD_REGEX.finditer(clean):
+        name = match.group(1)
+        results.append({
+            "raw_import": name,
+            "import_nature": "runtime",
+            "statement": match.group(0).strip(),
+            "symbols": [name],
+            "semantic_usages": [],
+            "language": "rust",
+            "is_relative": False,
+            "alias": None,
+            "wildcard": False,
+            "rust_mod": True,
+        })
+    return results
+
+
+def _rust_modpath_from_rel(rel: str) -> Tuple[str, ...]:
+    if rel.endswith(".rs"):
+        rel = rel[:-3]
+    parts = tuple(p for p in rel.split("/") if p not in ("", "."))
+    if parts and parts[-1] == "mod":
+        parts = parts[:-1]
+    return parts
+
+
+def rust_module_path_of(file_path: str, all_files: Iterable[str]) -> Tuple[str, Tuple[str, ...]]:
+    """Return (crate_root, module_path) for a Rust file (R1).
+
+    Crate root determination, in order:
+    1. `lib.rs` / `main.rs` -> its own directory is the root, module ().
+    2. A file directly under a `bin` / `examples` / `tests` / `benches`
+       directory is its own crate (Cargo semantics), module ().
+    3. The nearest ancestor directory containing `lib.rs` or `main.rs`
+       (checked against the corpus file set, not the filesystem).
+    4. Otherwise the file itself is a standalone crate root, module ().
+    Module path: the path from the root, `.rs` stripped, `/` -> `::`,
+    with a trailing `mod` segment dropped (`foo/mod.rs` is module `foo`).
+    """
+    norm = normalize_path(file_path)
+    base = os.path.basename(norm)
+    parent = os.path.dirname(norm)
+    if base in ("lib.rs", "main.rs"):
+        return parent or ".", ()
+    if os.path.basename(parent) in RUST_CRATE_BIN_DIRS:
+        return norm, ()
+    files = set(normalize_path(f) for f in all_files)
+    ancestors: List[str] = []
+    cur = parent
+    while True:
+        ancestors.append(cur)
+        if not cur or cur in (".", "/"):
+            break
+        nxt = os.path.dirname(cur)
+        if nxt == cur:
+            break
+        cur = nxt
+    for ancestor in ancestors:
+        prefix = (ancestor + "/") if ancestor not in ("", ".") else ""
+        if prefix + "lib.rs" in files or prefix + "main.rs" in files:
+            root = ancestor or "."
+            if root == ".":
+                rel = norm
+            else:
+                rel = norm[len(root) + 1 :] if norm.startswith(root + "/") else norm
+            return root, _rust_modpath_from_rel(rel)
+    return norm, ()
+
+
+_RUST_TOML_SECTION_REGEX = re.compile(r"^\[(.+?)\]\s*$", re.MULTILINE)
+_RUST_TOML_NAME_REGEX = re.compile(r"^name\s*=\s*\"([^\"]+)\"", re.MULTILINE)
+
+
+def rust_cargo_package_name(manifest_text: str) -> Tuple[str, str]:
+    """Return (package_name, lib_name) from a Cargo.toml text (R1).
+
+    The lib target name defaults to the package name with `-` -> `_`;
+    an explicit `[lib] name` overrides it. Returns ("", "") when no
+    `[package] name` is present.
+    """
+    sections: Dict[str, str] = {}
+    current = ""
+    start = 0
+    for match in _RUST_TOML_SECTION_REGEX.finditer(manifest_text):
+        sections[current] = manifest_text[start : match.start()]
+        current = match.group(1).strip()
+        start = match.end()
+    sections[current] = manifest_text[start:]
+    package_text = sections.get("package", "")
+    pkg_match = _RUST_TOML_NAME_REGEX.search(package_text)
+    if not pkg_match:
+        return "", ""
+    package = pkg_match.group(1)
+    lib_match = _RUST_TOML_NAME_REGEX.search(sections.get("lib", ""))
+    lib_name = lib_match.group(1) if lib_match else package.replace("-", "_")
+    return package, lib_name
