+def _rust_package_for_file(file_path: str) -> Tuple[str, str]:
+    """Return (lib_name, lib_root) for a Rust file from its nearest Cargo.toml (R1).
+
+    The lib target name defaults to the package name with `-` -> `_` (an
+    explicit `[lib] name` wins — see `rust_cargo_package_name`). The lib
+    root is the package dir's `src`, in corpus path form. Returns ("", "")
+    when no manifest is found or the package has no `[package] name`
+    (e.g. snapshot mode) — the caller then treats `<pkg>::` imports as
+    external, never as wrong edges.
+    """
+    directory = os.path.dirname(file_path)
+    while True:
+        fs_dir = os.path.abspath(directory) if directory else os.getcwd()
+        manifest = os.path.join(fs_dir, "Cargo.toml")
+        if os.path.isfile(manifest):
+            try:
+                with open(manifest, encoding="utf-8", errors="ignore") as f:
+                    text = f.read()
+            except OSError:
+                return "", ""
+            _package, lib_name = _rust_cargo_package_name(text)
+            if not lib_name:
+                return "", ""
+            lib_root = _normalize_path(os.path.join(directory, "src")) if directory else "src"
+            return lib_name, lib_root
+        if not directory:
+            return "", ""
+        parent = os.path.dirname(directory)
+        if parent == directory:
+            return "", ""
+        directory = parent
