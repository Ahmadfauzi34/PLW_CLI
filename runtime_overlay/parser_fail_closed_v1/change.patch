+def _cli_error(message, code="invalid_arguments", *, as_json, rc=2) -> int:
+    """Emit one CLI error on the channel the output mode requires (H1/K4).
+
+    --json: a JSON envelope {"error", "detail"} on stdout, stderr empty.
+    Human: "[PLW Error] ..." on stderr, stdout empty.
+    Returns rc so callers can `return _cli_error(...)`.
+    """
+    if as_json:
+        print(json.dumps({"error": code, "detail": message}, ensure_ascii=False))
+    else:
+        print(f"[PLW Error] {message}", file=sys.stderr)
+    return rc
+
+
+class _PlwArgumentParser(argparse.ArgumentParser):
+    """ArgumentParser whose errors follow the --json contract (D2).
+
+    argparse's default error() prints usage to stderr and exits 2 --
+    right for humans, wrong for --json. This override emits through
+    _cli_error (JSON envelope on stdout when --json was passed) and
+    exits 2. The argv is stored by _parse_cli_args before parsing so
+    error() knows the output mode even when called after parsing
+    (e.g. cmd_ast's resolve_error path).
+    """
+
+    _plw_argv: List[str] = []
+
+    def error(self, message):
+        as_json = "--json" in self._plw_argv
+        if not as_json:
+            # Human mode keeps argparse's native shape: usage first,
+            # then the error line (the --json envelope carries no usage).
+            self.print_usage(sys.stderr)
+        _cli_error(message, "invalid_arguments", as_json=as_json, rc=2)
+        raise SystemExit(2)
+
+
+def _parse_cli_args(parser, argv):
+    """Parse argv with a _PlwArgumentParser (D2 wrapper).
+
+    parse_intermixed_args (not parse_args): options may appear in any
+    position, which is what the old manual parsers already accepted
+    (they scanned the whole argv). Plain parse_args fails on
+    `ast index --root DIR status` -- argparse cannot match a trailing
+    nargs="?" positional after an option -- while the intermixed form
+    handles it. No parser here uses subparsers, which intermixed
+    parsing does not support. The three REMAINDER parsers
+    (lease/proof/ledger forward raw args to the kernel) fall back to
+    parse_args: intermixed parsing raises TypeError for REMAINDER.
+    The error() override still routes their failures via _cli_error.
+    """
+    parser._plw_argv = list(argv)
+    try:
+        return parser.parse_intermixed_args(argv)
+    except TypeError:
+        return parser.parse_args(argv)
+
