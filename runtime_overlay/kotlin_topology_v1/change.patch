+# ---------------------------------------------------------------------------
+# Kotlin frontend (K5/K6). Stdlib-only, regex-based — mirroring the Python
+# frontend above. Kotlin imports are fully-qualified names, never relative
+# paths and never quoted: `import a.b.C`, `import a.b.C as D`,
+# `import a.b.*` (wildcard; 0 occurrences in the measured OOPBoT corpus).
+# ---------------------------------------------------------------------------
+
+KOTLIN_PACKAGE_REGEX = re.compile(r"^package\s+([\w.]+)\s*$", re.MULTILINE)
+
+KOTLIN_IMPORT_REGEX = re.compile(
+    r"^import\s+([\w.]+?)(\.\*)?(?:\s+as\s+(\w+))?\s*$", re.MULTILINE
+)
+
+# Top-level declarations only: anchored at column 0, so indented members
+# inside a class/object body never match. Tolerates same-line annotations,
+# modifiers (incl. `external` for JNI bridges), type parameters and
+# extension receivers (`val Context.appGraph`, `fun <T> Context.foo`).
+_KOTLIN_DECL_MODIFIERS = (
+    r"(?:public|internal|private|protected|open|abstract|data|sealed|final|"
+    r"expect|actual|inline|value|external|crossinline|noinline|tailrec|"
+    r"suspend|operator|infix|lateinit|const|companion|annotation)\s+"
+)
+KOTLIN_DECL_REGEX = re.compile(
+    r"^(?:@[\w.]+(?:\([^)]*\))?\s+)*"
+    + r"(?:" + _KOTLIN_DECL_MODIFIERS + r")*"
+    r"(?:class|interface|object|fun|val|var|typealias|enum)\s+"
+    r"(?:(?:class|interface)\s+)?(?:<[^>]*>\s+)?(?:[\w]+(?:<[^>]*>)?\??\.)?([A-Za-z_][\w]*)",
+    re.MULTILINE,
+)
+
+
+def kotlin_package_of(content: str) -> str:
+    """Return the declared `package a.b.c` of a Kotlin file, or ""."""
+    match = KOTLIN_PACKAGE_REGEX.search(strip_js_comments(content))
+    return match.group(1) if match else ""
+
+
+def kotlin_top_level_names(content: str) -> List[str]:
+    """Return top-level declaration names of a Kotlin file.
+
+    Column-0 anchor keeps class members out; annotation/modifier/receiver
+    tolerant so extension properties (`val Context.appGraph`) are indexed.
+    A declaration inside a function body that happens to sit at column 0
+    (unindented code) is indexed too — accepted noise, the resolver tries
+    FQN-as-path first and this index only second.
+    """
+    return KOTLIN_DECL_REGEX.findall(strip_js_comments(content))
+
+
+def kotlin_source_root(file_path: str, package: str) -> str:
+    """Derive the source root from a file path + its declared package (K5).
+
+    E.g. `src/main/kotlin/io/jeph/pipkin/host/Foo.kt` +
+    `io.jeph.pipkin.host` -> `src/main/kotlin`. Returns "" when the path
+    does not end with the package path. Works per file, so multi-module
+    layouts need no configuration.
+    """
+    if not package:
+        return ""
+    suffix = package.replace(".", "/") + "/" + os.path.basename(file_path)
+    norm = normalize_path(file_path)
+    if norm.endswith("/" + suffix):
+        return norm[: -len(suffix) - 1] or "."
+    if norm == suffix:
+        return "."
+    return ""
+
+
+def parse_kotlin_imports(content: str) -> List[Dict[str, Any]]:
+    """Parse Kotlin imports. Kotlin has no `import type`: every import is
+    runtime (K6), so `import_nature` is always "runtime"."""
+    clean = strip_js_comments(content)
+    results: List[Dict[str, Any]] = []
+    for match in KOTLIN_IMPORT_REGEX.finditer(clean):
+        fqn, wildcard, alias = match.group(1), bool(match.group(2)), match.group(3)
+        symbol = alias or fqn.rsplit(".", 1)[-1]
+        results.append({
+            "raw_import": fqn,
+            "import_nature": "runtime",
+            "statement": match.group(0).strip(),
+            "symbols": [symbol],
+            "semantic_usages": [],
+            "language": "kotlin",
+            "is_relative": False,
+            "alias": alias,
+            "wildcard": wildcard,
+        })
+    return results
+
+
+def kotlin_module_candidates(raw_import: str, roots: Iterable[str]) -> List[str]:
+    """Return FQN-as-path candidates under each Kotlin source root (K5)."""
+    candidates: List[str] = []
+    seen: Set[str] = set()
+
+    def add(candidate: str) -> None:
+        candidate = normalize_path(candidate)
+        if candidate and candidate not in seen:
+            seen.add(candidate)
+            candidates.append(candidate)
+
+    rel = raw_import.replace(".", "/")
+    for root in roots:
+        root_norm = normalize_path(str(root) or ".")
+        if root_norm in ("", "."):
+            continue
+        for candidate in candidate_targets(
+            normalize_path(os.path.join(root_norm, rel)), "kotlin"
+        ):
+            add(candidate)
+    return candidates
+
+
+def kotlin_is_internal_import(raw_import: str, packages: Iterable[str]) -> bool:
+    """True when a dotted prefix of the FQN is a package declared in the corpus."""
+    parts = raw_import.split(".")
+    pkg_set = set(packages)
+    return any(".".join(parts[:k]) in pkg_set for k in range(1, len(parts)))
+
+
+def kotlin_is_generated_import(raw_import: str, packages: Iterable[str]) -> bool:
+    """True for `<known-package>.R`: the Android generated R class, which has
+    no source file in the corpus and must not count as unresolved (K5)."""
+    return raw_import.endswith(".R") and raw_import[:-2] in set(packages)
+
