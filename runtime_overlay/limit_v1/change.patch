+def _apply_limit(result: Dict[str, Any], mode: str, limit: Optional[int]) -> Tuple[Optional[int], Optional[int]]:
+    """Slice the row list of a single-query engine result in place (F3).
+
+    Returns (total, shown): total = rows before slicing, shown = rows
+    after. The engine is never asked to slice defs/callers/related:
+    PLW owns its CLI contract, and slicing here keeps the engine
+    untouched. ``search`` is the exception — its limit is passed to
+    the engine (see run_query) — so this helper leaves it alone.
+    """
+    if limit is None:
+        return None, None
+    key = {"defs": "hits", "callers": "calls", "related": "related"}.get(mode)
+    if key is None:
+        return None, None
+    rows = result.get(key)
+    if not isinstance(rows, list):
+        return None, None
+    total = len(rows)
+    result[key] = rows[:limit]
+    return total, len(result[key])
+
+
+def _apply_batch_limit(
+    result: Dict[str, Any], mode: str,
+    grouped: Dict[str, List[Dict[str, Any]]], limit: Optional[int],
+) -> Tuple[Optional[int], Optional[int]]:
+    """Slice every row list of a batch result in place (F3): the flat
+    list in the engine result and every per-symbol list in ``grouped``.
+
+    Returns (total, shown) over all grouped rows, same semantics as
+    _apply_limit. The fallback path assembles ``grouped`` first, so
+    one slice here covers both the batch and the fallback shape.
+    """
+    if limit is None:
+        return None, None
+    total = sum(len(rows) for rows in grouped.values())
+    for name in grouped:
+        grouped[name] = grouped[name][:limit]
+    if mode == "defs":
+        for entry in result.get("queries") or []:
+            if isinstance(entry, dict) and isinstance(entry.get("hits"), list):
+                entry["hits"] = entry["hits"][:limit]
+    else:
+        # The flat list is the union of the per-symbol rows, so it is
+        # filtered per symbol — not cut to ``limit`` total. A plain
+        # [:limit] here would leave the flat list (3 rows) disagreeing
+        # with grouped (3 rows per symbol), and a caller reading
+        # engine_result would see a different answer than one reading
+        # grouped. Non-dict rows are dropped, as in the grouping above.
+        key = "calls" if mode == "callers" else "related"
+        field = "callee" if mode == "callers" else "symbol"
+        rows = result.get(key)
+        if isinstance(rows, list):
+            kept: Dict[str, int] = {}
+            out_rows: List[Dict[str, Any]] = []
+            for row in rows:
+                if not isinstance(row, dict):
+                    continue
+                owner = row.get(field)
+                if mode == "callers":
+                    owner = _callee_base(owner)
+                count = kept.get(str(owner), 0)
+                if count < limit:
+                    out_rows.append(row)
+                    kept[str(owner)] = count + 1
+            result[key] = out_rows
+    shown = sum(len(rows) for rows in grouped.values())
+    return total, shown
+
+
