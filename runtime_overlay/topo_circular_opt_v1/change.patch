+def _seed_shortest_scc_cycles(
+    scc_nodes: List[str],
+    scc_adj: Dict[str, List[str]],
+    scc_adj_sets: Dict[str, Set[str]],
+    budget: int,
+    seen_cores: Set[Tuple[str, ...]],
+) -> List[List[str]]:
+    """Prioritize shortest actionable cycles (2-cycles, then shortest BFS witness per node) on dense SCCs."""
+    seeded: List[List[str]] = []
+    covered_nodes: Set[str] = set()
+
+    # 1. Harvest all direct 2-cycles (u <-> v) in O(E_scc)
+    for u in scc_nodes:
+        if len(seeded) >= budget:
+            return seeded
+        for v in scc_adj[u]:
+            if u < v and u in scc_adj_sets[v]:
+                core_key = (u, v)
+                if core_key not in seen_cores:
+                    seen_cores.add(core_key)
+                    seeded.append([u, v, u])
+                    covered_nodes.add(u)
+                    covered_nodes.add(v)
+                    if len(seeded) >= budget:
+                        return seeded
+
+    # 2. Shortest BFS cycle witness for any SCC node not yet covered
+    for start in scc_nodes:
+        if len(seeded) >= budget:
+            break
+        if start in covered_nodes:
+            continue
+        parent: Dict[str, Optional[str]] = {}
+        q: deque[str] = deque()
+        for nbr in scc_adj[start]:
+            if nbr == start:
+                continue
+            if nbr not in parent:
+                parent[nbr] = start
+                q.append(nbr)
+        found_core: Optional[List[str]] = None
+        while q and found_core is None:
+            cur = q.popleft()
+            for nxt in scc_adj[cur]:
+                if nxt == start:
+                    path: List[str] = [cur]
+                    p = parent.get(cur)
+                    while p is not None and p != start:
+                        path.append(p)
+                        p = parent.get(p)
+                    path.append(start)
+                    path.reverse()
+                    found_core = path
+                    break
+                if nxt not in parent and nxt != start:
+                    parent[nxt] = cur
+                    q.append(nxt)
+        if found_core:
+            core_key, closed = _canonicalize_cycle_core(found_core)
+            if core_key not in seen_cores:
+                seen_cores.add(core_key)
+                seeded.append(closed)
+                covered_nodes.update(core_key)
+
+    return seeded
+
