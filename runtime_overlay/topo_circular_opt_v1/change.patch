+def _enumerate_scc_elementary_cycles(
+    scc_nodes: List[str],
+    adj: Dict[str, List[str]],
+    self_loops: Set[str],
+    max_cycles: int,
+) -> Tuple[List[List[str]], bool, int]:
+    """Iterative Johnson elementary cycle enumeration inside a single cyclic SCC.
+
+    Guarantees:
+    - Zero Python recursion (safe on 1,000+ node rings).
+    - Complete elementary cycle extraction whenever count <= max_cycles.
+    - Shortest-cycle seeding on dense SCCs so bounded results stay compact and actionable.
+    """
+    scc_set = set(scc_nodes)
+    scc_adj: Dict[str, List[str]] = {}
+    scc_adj_sets: Dict[str, Set[str]] = {}
+    scc_edge_count = 0
+    for u in scc_nodes:
+        nbrs = [v for v in adj.get(u, ()) if v in scc_set and v != u]
+        scc_adj[u] = nbrs
+        scc_adj_sets[u] = set(nbrs)
+        scc_edge_count += len(nbrs)
+
+    seen_cores: Set[Tuple[str, ...]] = set()
+    found_cycles: List[List[str]] = []
+    truncated = False
+
+    # Self-loops inside this SCC
+    for u in scc_nodes:
+        if u in self_loops:
+            scc_edge_count += 1
+            if len(found_cycles) < max_cycles:
+                seen_cores.add((u,))
+                found_cycles.append([u, u])
+            else:
+                truncated = True
+
+    if len(scc_nodes) < 2 or max_cycles <= 0:
+        return found_cycles, truncated, scc_edge_count
+
+    non_loop_edges = sum(len(v) for v in scc_adj.values())
+    # Pure directed ring fast-path: in an SCC with |E| == |V|, every node has out-degree 1
+    # so there is mathematically exactly ONE elementary cycle (O(|V|) instead of O(|V|^2)).
+    if non_loop_edges == len(scc_nodes):
+        ring_core: List[str] = []
+        cur = scc_nodes[0]
+        visited_ring: Set[str] = set()
+        while cur not in visited_ring:
+            visited_ring.add(cur)
+            ring_core.append(cur)
+            cur = scc_adj[cur][0]
+        core_key = tuple(ring_core)
+        if core_key not in seen_cores:
+            if len(found_cycles) < max_cycles:
+                seen_cores.add(core_key)
+                found_cycles.append(ring_core + [ring_core[0]])
+            else:
+                truncated = True
+        return found_cycles, truncated, scc_edge_count
+
+    # On dense SCCs (high cyclomatic excess), seed shortest cycles first so caps
+    # prioritize 2-cycles & minimal witnesses over deep Hamiltonian paths.
+    if non_loop_edges > len(scc_nodes) + _DENSE_SCC_EXCESS_EDGE_THRESHOLD and len(found_cycles) < max_cycles:
+        seeded = _seed_shortest_scc_cycles(
+            scc_nodes,
+            scc_adj,
+            scc_adj_sets,
+            max_cycles - len(found_cycles),
+            seen_cores,
+        )
+        found_cycles.extend(seeded)
+
+    # Iterative Johnson (1975) with SCC-decomposition worklist:
+    # After enumerating cycles rooted at least-vertex `s` in a cyclic component,
+    # decompose `component \ {s}` into its remaining cyclic sub-SCCs so acyclic
+    # tails/chords are pruned immediately in O(V + E) instead of O(V^2).
+    worklist: List[List[str]] = [list(scc_nodes)]
+    while worklist:
+        # Always process the component with the smallest minimum vertex first
+        worklist.sort(key=lambda comp: comp[0])
+        comp = worklist.pop(0)
+        if len(comp) < 2:
+            continue
+        s = comp[0]
+        sub_scc = set(comp)
+        sub_adj: Dict[str, List[str]] = {
+            u: [v for v in scc_adj[u] if v in sub_scc]
+            for u in comp
+        }
+
+        blocked: Set[str] = {s}
+        block_map: Dict[str, Set[str]] = {}
+        path: List[str] = [s]
+        # Stack frame: [node, neighbor_idx, found_cycle_in_subtree]
+        frames: List[List[Any]] = [[s, 0, False]]
+
+        def _unblock(node: str) -> None:
+            ub_stack = [node]
+            while ub_stack:
+                cur_u = ub_stack.pop()
+                if cur_u in blocked:
+                    blocked.remove(cur_u)
+                    deps = block_map.pop(cur_u, None)
+                    if deps:
+                        ub_stack.extend(deps)
+
+        while frames:
+            frame = frames[-1]
+            v = frame[0]
+            nbr_idx = frame[1]
+            nbrs = sub_adj[v]
+
+            if nbr_idx < len(nbrs):
+                w = nbrs[nbr_idx]
+                frame[1] = nbr_idx + 1
+                if w == s:
+                    core_key = tuple(path)
+                    if core_key not in seen_cores:
+                        if len(found_cycles) >= max_cycles:
+                            truncated = True
+                            frames.clear()
+                            break
+                        seen_cores.add(core_key)
+                        found_cycles.append(list(core_key) + [s])
+                    frame[2] = True
+                elif w not in blocked:
+                    blocked.add(w)
+                    path.append(w)
+                    frames.append([w, 0, False])
+            else:
+                frames.pop()
+                path.pop()
+                if frame[2]:
+                    _unblock(v)
+                    if frames:
+                        frames[-1][2] = True
+                else:
+                    for w in nbrs:
+                        block_map.setdefault(w, set()).add(v)
+
+        if truncated:
+            break
+
+        # Remove `s` and push any remaining cyclic sub-SCCs of `comp \ {s}`
+        rem_nodes = comp[1:]
+        if len(rem_nodes) >= 2:
+            rem_set = set(rem_nodes)
+            rem_adj: Dict[str, List[str]] = {
+                u: [v for v in sub_adj[u] if v in rem_set]
+                for u in rem_nodes
+            }
+            sub_comps = find_cyclic_sccs(rem_nodes, rem_adj, self_loops=set())
+            for sc in sub_comps:
+                if len(sc) >= 2:
+                    worklist.append(sc)
+
+    return found_cycles, truncated, scc_edge_count
+
