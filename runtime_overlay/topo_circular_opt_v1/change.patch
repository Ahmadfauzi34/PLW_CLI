+def find_directed_cycles_with_metadata(
+    shared_graph: Dict[str, Any],
+    *,
+    max_cycles_per_scc: int = DEFAULT_MAX_CYCLES_PER_SCC,
+    max_total_cycles: int = DEFAULT_MAX_TOTAL_CYCLES,
+) -> Dict[str, Any]:
+    """Detect directed elementary cycles using Iterative Tarjan SCC + Bounded Iterative Johnson.
+
+    Returns:
+      - cycles: deterministically sorted list of canonical closed cycle paths [n0, ..., n0]
+      - cyclic_sccs: per-SCC metadata (node_count, edge_count, truncated, sample_nodes)
+      - files_in_cycles: exact sorted list of all vertices belonging to any cyclic SCC
+      - truncated: True iff any SCC or global cycle budget cap was hit
+    """
+    vertices, adj, self_loops = _build_directed_adjacency(shared_graph)
+    cyclic_sccs = find_cyclic_sccs(vertices, adj, self_loops)
+
+    if not cyclic_sccs:
+        return {
+            "cycles": [],
