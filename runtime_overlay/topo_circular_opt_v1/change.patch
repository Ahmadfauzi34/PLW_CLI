+def _canonicalize_cycle_core(core: Sequence[str]) -> Tuple[Tuple[str, ...], List[str]]:
+    """Rotate cycle core so the lexicographically smallest node comes first."""
+    min_node = min(core)
+    min_idx = core.index(min_node)
+    rotated = tuple(core[min_idx:]) + tuple(core[:min_idx])
+    return rotated, list(rotated) + [rotated[0]]
+
