+    norm_dir = str(direction or "LR").strip().upper()
+    if norm_dir not in MERMAID_DIRECTIONS:
+        return err_fn(
+            "invalid_mermaid_direction",
+            f"Mermaid direction must be one of {', '.join(MERMAID_DIRECTIONS)}.",
+            direction=direction,
+            supported_directions=list(MERMAID_DIRECTIONS),
+        )
+    if isinstance(max_nodes, bool) or not isinstance(max_nodes, int) or not 4 <= max_nodes <= 120:
+        return err_fn(
+            "invalid_mermaid_max_nodes",
+            "Mermaid max_nodes must be an integer between 4 and 120.",
+            max_nodes=max_nodes,
+            minimum=4,
+            maximum=120,
