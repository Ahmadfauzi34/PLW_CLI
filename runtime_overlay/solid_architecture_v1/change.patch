+def generate_mermaid_diagram(
+    scan_root: str = ".",
+    *,
+    depth: int = 1,
+    focus: Optional[str] = None,
+    direction: str = "LR",
+    max_nodes: int = 24,
+    include_tests: bool = False,
+    graph: Optional[Dict[str, Any]] = None,
+    graph_builder: Optional[Callable[[str], Dict[str, Any]]] = None,
+    orientation_builder: Optional[Callable[..., Dict[str, Any]]] = None,
+    impact_querier: Optional[Callable[[Dict[str, Any], str], Dict[str, Any]]] = None,
+    outline_querier: Optional[Callable[[Dict[str, Any], str], Dict[str, Any]]] = None,
+    signature_fn: Optional[Callable[[Dict[str, Any]], Optional[str]]] = None,
+    error_factory: Optional[Callable[..., Dict[str, Any]]] = None,
+) -> Dict[str, Any]:
+    """Generate a multi-depth Mermaid architecture & dependency diagram from SharedGraph."""
+    err_fn = error_factory if callable(error_factory) else _default_error
+
+    if isinstance(depth, bool) or not isinstance(depth, int) or depth not in (1, 2, 3, 4):
