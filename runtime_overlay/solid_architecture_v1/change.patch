+def _find_directed_cycles_from_graph(shared_graph: Dict[str, Any]) -> List[List[str]]:
+    """Find deduplicated directed cycles in shared_graph using sorted DFS."""
+    vertices: List[str] = list(shared_graph.get("vertices", []))
+    edges = shared_graph.get("edges")
+    edge_natures = shared_graph.get("edge_natures", {})
+
+    adj: Dict[str, List[str]] = {}
+    if edges is not None:
+        for src, tgt in edges:
+            if edge_natures.get(f"{src} -> {tgt}", "runtime") == "same_package":
+                continue
+            adj.setdefault(src, []).append(tgt)
+    else:
+        adj = shared_graph.get("adjacency", {})
+
+    if not vertices and adj:
+        vertices = sorted(adj.keys())
+
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {v: WHITE for v in vertices}
+    raw_cycles: List[List[str]] = []
+
+    def _dfs(node: str, path: List[str]) -> None:
+        color[node] = GRAY
+        path.append(node)
+        for neighbor in sorted(adj.get(node, [])):
+            c = color.get(neighbor, WHITE)
+            if c == GRAY:
+                cycle_start = path.index(neighbor)
+                raw_cycles.append(path[cycle_start:] + [neighbor])
+            elif c == WHITE:
+                _dfs(neighbor, path)
+        path.pop()
+        color[node] = BLACK
+
+    for v in sorted(vertices):
+        if color.get(v, WHITE) == WHITE:
+            _dfs(v, [])
+
+    seen: Set[str] = set()
+    normalized_cycles: List[Tuple[int, str, List[str]]] = []
+    for cycle in raw_cycles:
+        core = cycle[:-1]
+        if not core:
+            continue
+        min_idx = core.index(min(core))
+        rotated = core[min_idx:] + core[:min_idx]
+        key = " -> ".join(rotated)
+        if key not in seen:
+            seen.add(key)
+            normalized_cycles.append((len(rotated), rotated[0], rotated + [rotated[0]]))
+
+    normalized_cycles.sort(key=lambda item: (item[0], item[1]))
+    return [item[2] for item in normalized_cycles]
+
