+        include_tests=include_tests,
+        vertices=vertices,
+        edge_natures=edge_natures,
+        node_meta=node_meta,
+        rel_by_abs=rel_by_abs,
+        abs_by_rel=abs_by_rel,
+        rel_fn=_rel,
+        impact_querier=impact_querier,
+        outline_querier=outline_querier,
+    )
