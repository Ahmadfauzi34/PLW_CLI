+    by_sub: Dict[str, List[str]] = defaultdict(list)
+    for m in selected_mods:
+        by_sub[mod_parent_sub.get(m, "(root)")].append(m)
+
+    lines = [
+        f"flowchart {norm_dir}",
+        "    classDef mod fill:#0f172a,stroke:#38bdf8,stroke-width:1.5px,color:#f1f5f9;",
+        "    classDef hubmod fill:#1e1b4b,stroke:#818cf8,stroke-width:2px,color:#e0e7ff;",
+    ]
+    node_ids: Dict[str, str] = {}
+    nodes_out: List[Dict[str, Any]] = []
+    idx = 0
+    top_hub_files_for_hints: List[tuple] = []
+
+    for sub_name, mods in sorted(by_sub.items(), key=lambda kv: (-len(kv[1]), kv[0])):
+        sg_id = f"SG_{abs(hash(sub_name)) % 100000}"
+        lines.append(f'    subgraph {sg_id} ["{mermaid_escape(sub_name)}"]')
+        for m in sorted(mods):
+            nid = f"M{idx}"
+            idx += 1
+            node_ids[m] = nid
+            files_in_m = mod_files[m]
+            scored_files = []
+            for f_rel in files_in_m:
+                v_abs = abs_by_rel.get(f_rel, "")
+                meta = node_meta.get(v_abs) or {}
+                fi = int(meta.get("fan_in", 0))
+                fo = int(meta.get("fan_out", 0))
+                ep = bool(meta.get("is_entrypoint", False))
+                scored_files.append((fi + fo + (10 if ep else 0), fi, fo, ep, f_rel))
+            scored_files.sort(reverse=True)
+            if scored_files:
+                top_hub_files_for_hints.append(scored_files[0])
+            top_names = [
+                f"{os.path.basename(t[4])} ({t[1] + t[2]})"
+                for t in scored_files[:2]
+                if (t[1] + t[2]) > 0 or t[3]
+            ]
+            hub_line = f"\\nhubs: {mermaid_escape(', '.join(top_names))}" if top_names else ""
+            short_lbl = mermaid_short_module_label(m)
+            lbl = f"{mermaid_escape(short_lbl)}\\n{len(files_in_m)} files | int:{mod_internal[m]}{hub_line}"
+            cls = "hubmod" if (mod_traffic[m] + mod_internal[m]) >= 12 else "mod"
+            lines.append(f'        {nid}["{lbl}"]:::{cls}')
+            nodes_out.append({
+                "id": nid,
+                "module": m,
+                "subsystem": sub_name,
+                "files": len(files_in_m),
+                "internal_edges": mod_internal[m],
+                "cross_module_traffic": mod_traffic[m],
+                "top_files": [t[4] for t in scored_files[:3]],
+            })
+        lines.append("    end")
+
+    edges_out: List[Dict[str, Any]] = []
+    ranked_edges = sorted(
+        [
+            ((mu, mv), cnts)
+            for (mu, mv), cnts in mod_cross.items()
+            if mu in selected_set and mv in selected_set
+        ],
+        key=lambda kv: (-sum(kv[1].values()), kv[0][0], kv[0][1]),
+    )
+    for (mu, mv), cnts in ranked_edges[: max_nodes * 3]:
+        tot = sum(cnts.values())
+        rt = cnts.get("runtime", 0)
+        sp = cnts.get("same_package", 0)
+        to = cnts.get("type_only", 0)
+        if rt > 0:
+            lines.append(f'    {node_ids[mu]} -->|"{tot}"| {node_ids[mv]}')
+        elif sp > 0:
+            lines.append(f'    {node_ids[mu]} -. "pkg:{sp}" .-> {node_ids[mv]}')
+        else:
+            lines.append(f'    {node_ids[mu]} -. "type:{to}" .-> {node_ids[mv]}')
+        edges_out.append({
+            "from": mu,
+            "to": mv,
+            "total": tot,
+            "natures": dict(cnts),
+        })
+
+    top_hub_files_for_hints.sort(reverse=True)
+    zoom_hints = [
+        {
+            "target": m,
+            "target_kind": "module_files",
+            "reason": f"Inspect file-to-file connections inside module {m} ({len(mod_files[m])} files)",
+            "command": f"plw mermaid {root_arg} --depth 3 --focus {m}",
+        }
+        for m in selected_mods[:4]
+    ]
+    for _score, fi, fo, _ep, f_rel in top_hub_files_for_hints[:3]:
+        zoom_hints.append({
+            "target": f_rel,
+            "target_kind": "file_micro_neighborhood",
+            "reason": f"Inspect symbol declarations & blast radius of hub {os.path.basename(f_rel)} (in={fi}, out={fo})",
+            "command": f"plw mermaid {root_arg} --depth 4 --focus {f_rel}",
+        })
+
+    return {
+        "schema_version": "1.0.0-mermaid-graph",
+        "mode": "mermaid",
+        "decision": "MERMAID_GRAPH_READY",
+        "scan_root": scan_root,
+        "graph_signature": graph_sig,
+        "depth": 2,
+        "depth_name": MERMAID_DEPTH_NAMES[2],
+        "direction": norm_dir,
+        "focus": focus,
+        "include_tests": bool(include_tests),
+        "summary": {
+            "total_repo_files": inv.get("files", len(vertices)),
+            "active_files": len(active_abs),
+            "total_modules": len(all_modules),
+            "rendered_nodes": len(nodes_out),
+            "rendered_edges": len(edges_out),
+        },
+        "mermaid_source": "\n".join(lines),
+        "nodes": nodes_out,
+        "edges": edges_out,
+        "next_zoom_hints": zoom_hints,
+        "authority": _read_only_authority(),
+    }
+
+
+def _render_depth_3_files(
+    *,
+    scan_root: str,
+    root_arg: str,
+    graph_sig: Any,
+    norm_dir: str,
+    focus: Optional[str],
+    focus_norm: str,
+    max_nodes: int,
+    include_tests: bool,
+    inv: Dict[str, Any],
+    vertices: List[str],
+    raw_edges: List[Any],
+    edge_natures: Dict[str, str],
+    node_meta: Dict[str, Dict[str, Any]],
+    active_abs: List[str],
+    active_set: set,
+    rel_by_abs: Dict[str, str],
+    abs_by_rel: Dict[str, str],
+    trie: Dict[str, Any],
+    cyclic_files: set,
+) -> Dict[str, Any]:
+    mod_by_rel = {
+        rel: mermaid_compact_group(rel, trie, target_splits=2)
+        for rel in rel_by_abs.values()
+    }
+    scored_all: List[tuple] = []
+    for v_abs, rel in rel_by_abs.items():
+        meta = node_meta.get(v_abs) or {}
+        fi = int(meta.get("fan_in", 0))
+        fo = int(meta.get("fan_out", 0))
+        ep = bool(meta.get("is_entrypoint", False))
+        in_cyc = rel in cyclic_files
+        score = (fi * 2) + fo + (25 if ep else 0) + (20 if in_cyc else 0)
+        scored_all.append((score, fi, fo, ep, in_cyc, rel, v_abs))
+    scored_all.sort(reverse=True)
+
+    if focus_norm:
+        seed_rels = {
+            item[5] for item in scored_all
+            if focus_norm.lower() in item[5].lower()
+            or focus_norm.lower() in mod_by_rel.get(item[5], "").lower()
+        }
+        if not seed_rels:
+            return {
+                "schema_version": "1.0.0-mermaid-graph",
+                "mode": "mermaid",
+                "decision": "FOCUS_NOT_FOUND",
+                "scan_root": scan_root,
+                "graph_signature": graph_sig,
+                "depth": 3,
+                "depth_name": MERMAID_DEPTH_NAMES[3],
+                "direction": norm_dir,
+                "focus": focus,
+                "mermaid_source": "",
+                "nodes": [],
+                "edges": [],
+                "next_zoom_hints": [
+                    {
+                        "target": item[5],
+                        "target_kind": "file",
+                        "command": f"plw mermaid {root_arg} --depth 3 --focus {os.path.dirname(item[5]) or item[5]}",
+                    }
+                    for item in scored_all[:5]
+                ],
+                "authority": _read_only_authority(),
+            }
+        selected_rels: List[str] = [
+            item[5] for item in scored_all if item[5] in seed_rels
+        ][:max_nodes]
+        # Add 1-hop neighbors if room remains
+        if len(selected_rels) < max_nodes:
+            neighbor_rels: set = set()
+            for u_abs, v_abs in raw_edges:
+                if u_abs not in active_set or v_abs not in active_set:
+                    continue
+                ur, vr = rel_by_abs[u_abs], rel_by_abs[v_abs]
+                if ur in seed_rels:
+                    neighbor_rels.add(vr)
+                if vr in seed_rels:
+                    neighbor_rels.add(ur)
+            for item in scored_all:
+                if len(selected_rels) >= max_nodes:
+                    break
+                if item[5] in neighbor_rels and item[5] not in selected_rels:
+                    selected_rels.append(item[5])
+    else:
+        selected_rels = [item[5] for item in scored_all[:max_nodes]]
+
+    selected_rel_set = set(selected_rels)
+    by_mod: Dict[str, List[str]] = defaultdict(list)
+    for rel in selected_rels:
+        by_mod[mod_by_rel.get(rel, "(root)")].append(rel)
+
+    lines = [
+        f"flowchart {norm_dir}",
+        "    classDef entrypoint fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#ecfdf5;",
+        "    classDef hub fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#e0e7ff;",
+        "    classDef cycle fill:#4c0519,stroke:#f43f5e,stroke-width:2.5px,color:#ffe4e6;",
+        "    classDef file fill:#0f172a,stroke:#475569,stroke-width:1px,color:#f1f5f9;",
+    ]
+    node_ids: Dict[str, str] = {}
+    nodes_out: List[Dict[str, Any]] = []
+    idx = 0
+    for mod_name, rels in sorted(by_mod.items(), key=lambda kv: (-len(kv[1]), kv[0])):
+        sg_id = f"FG_{abs(hash(mod_name)) % 100000}"
+        short_mod = mermaid_short_module_label(mod_name)
+        lines.append(f'    subgraph {sg_id} ["{mermaid_escape(short_mod)}"]')
+        for rel in sorted(rels):
+            nid = f"F{idx}"
+            idx += 1
+            node_ids[rel] = nid
+            v_abs = abs_by_rel[rel]
+            meta = node_meta.get(v_abs) or {}
+            fi = int(meta.get("fan_in", 0))
+            fo = int(meta.get("fan_out", 0))
+            ep = bool(meta.get("is_entrypoint", False))
+            ep_kind = str(meta.get("entrypoint_kind") or "")
+            in_cyc = rel in cyclic_files
+            badges = []
+            if ep:
+                badges.append(f"ENTRYPOINT:{ep_kind}" if ep_kind else "ENTRYPOINT")
+            if in_cyc:
+                badges.append("CYCLE")
+            if fi >= 6 or fo >= 8:
+                badges.append("HUB")
+            badge_line = f"[{mermaid_escape(', '.join(badges))}]\\n" if badges else ""
+            bname = os.path.basename(rel)
+            lbl = f"{badge_line}{mermaid_escape(bname)}\\nin={fi} out={fo}"
+            if in_cyc:
+                cls = "cycle"
+            elif ep:
+                cls = "entrypoint"
+            elif fi >= 6 or fo >= 8:
+                cls = "hub"
+            else:
+                cls = "file"
+            lines.append(f'        {nid}["{lbl}"]:::{cls}')
+            nodes_out.append({
+                "id": nid,
+                "file": rel,
+                "module": mod_name,
+                "fan_in": fi,
+                "fan_out": fo,
+                "is_entrypoint": ep,
+                "entrypoint_kind": ep_kind or None,
+                "in_cycle": in_cyc,
+            })
+        lines.append("    end")
+
+    edges_out: List[Dict[str, Any]] = []
+    for u_abs, v_abs in raw_edges:
+        if u_abs not in active_set or v_abs not in active_set:
+            continue
+        ur, vr = rel_by_abs[u_abs], rel_by_abs[v_abs]
+        if ur not in selected_rel_set or vr not in selected_rel_set or ur == vr:
+            continue
+        nat = edge_natures.get(f"{u_abs} -> {v_abs}", "runtime")
+        if nat == "same_package":
+            lines.append(f"    {node_ids[ur]} -. same_pkg .-> {node_ids[vr]}")
+        elif nat == "type_only":
+            lines.append(f"    {node_ids[ur]} -. type .-> {node_ids[vr]}")
+        else:
+            lines.append(f"    {node_ids[ur]} --> {node_ids[vr]}")
+        edges_out.append({
+            "from": ur,
+            "to": vr,
+            "nature": nat,
+        })
+
+    zoom_hints = [
+        {
+            "target": n["file"],
+            "target_kind": "file_micro_neighborhood",
+            "reason": f"Inspect internal symbols and blast radius of {os.path.basename(n['file'])} (in={n['fan_in']}, out={n['fan_out']})",
+            "command": f"plw mermaid {root_arg} --depth 4 --focus {n['file']}",
+        }
+        for n in sorted(
+            nodes_out,
+            key=lambda x: (-(x["fan_in"] * 2 + x["fan_out"] + (20 if x["in_cycle"] else 0)), x["file"]),
+        )[:6]
+    ]
+
+    return {
+        "schema_version": "1.0.0-mermaid-graph",
+        "mode": "mermaid",
+        "decision": "MERMAID_GRAPH_READY",
+        "scan_root": scan_root,
+        "graph_signature": graph_sig,
+        "depth": 3,
+        "depth_name": MERMAID_DEPTH_NAMES[3],
+        "direction": norm_dir,
+        "focus": focus,
+        "include_tests": bool(include_tests),
+        "summary": {
+            "total_repo_files": inv.get("files", len(vertices)),
+            "active_files": len(active_abs),
+            "rendered_nodes": len(nodes_out),
+            "rendered_edges": len(edges_out),
+            "cyclic_files_rendered": sum(1 for n in nodes_out if n["in_cycle"]),
+            "entrypoints_rendered": sum(1 for n in nodes_out if n["is_entrypoint"]),
+        },
+        "mermaid_source": "\n".join(lines),
+        "nodes": nodes_out,
+        "edges": edges_out,
+        "next_zoom_hints": zoom_hints,
+        "authority": _read_only_authority(),
+    }
+
+
+def _render_depth_4_neighborhood(
+    *,
+    scan_root: str,
+    root_arg: str,
+    graph: Dict[str, Any],
+    graph_sig: Any,
+    norm_dir: str,
+    focus: Optional[str],
+    focus_norm: str,
+    max_nodes: int,
+    include_tests: bool,
+    vertices: List[str],
+    edge_natures: Dict[str, str],
+    node_meta: Dict[str, Dict[str, Any]],
+    rel_by_abs: Dict[str, str],
+    abs_by_rel: Dict[str, str],
+    rel_fn: Callable[[str], str],
+    impact_querier: Optional[Callable[[Dict[str, Any], str], Dict[str, Any]]],
+    outline_querier: Optional[Callable[[Dict[str, Any], str], Dict[str, Any]]],
+) -> Dict[str, Any]:
+    all_rel_files = {rel_fn(v): v for v in vertices}
+    target_rel: Optional[str] = None
+    auto_selected = False
+
+    if focus_norm:
+        # 1. Exact relative path match
+        if focus_norm in all_rel_files:
+            target_rel = focus_norm
+        else:
+            # 2. Suffix or basename match
+            suffix_matches = sorted(
+                r for r in all_rel_files
+                if r.endswith("/" + focus_norm) or os.path.basename(r) == focus_norm
+            )
+            if len(suffix_matches) == 1:
+                target_rel = suffix_matches[0]
+            elif len(suffix_matches) > 1:
+                # Pick highest fan_in + fan_out among suffix matches
+                suffix_matches.sort(
+                    key=lambda r: -(
+                        int((node_meta.get(all_rel_files[r]) or {}).get("fan_in", 0))
+                        + int((node_meta.get(all_rel_files[r]) or {}).get("fan_out", 0))
+                    )
+                )
+                target_rel = suffix_matches[0]
+            else:
+                # 3. Substring match (file or directory)
+                sub_matches = sorted(
+                    r for r in all_rel_files if focus_norm.lower() in r.lower()
+                )
+                if sub_matches:
+                    sub_matches.sort(
+                        key=lambda r: -(
+                            int((node_meta.get(all_rel_files[r]) or {}).get("fan_in", 0)) * 2
+                            + int((node_meta.get(all_rel_files[r]) or {}).get("fan_out", 0))
+                        )
+                    )
+                    target_rel = sub_matches[0]
+                    auto_selected = len(sub_matches) > 1
+
+        if target_rel is None:
+            return {
+                "schema_version": "1.0.0-mermaid-graph",
+                "mode": "mermaid",
+                "decision": "FOCUS_NOT_FOUND",
+                "scan_root": scan_root,
+                "graph_signature": graph_sig,
+                "depth": 4,
+                "depth_name": MERMAID_DEPTH_NAMES[4],
+                "direction": norm_dir,
+                "focus": focus,
+                "mermaid_source": "",
+                "nodes": [],
+                "edges": [],
+                "next_zoom_hints": [
+                    {
+                        "target": r,
+                        "target_kind": "file",
+                        "command": f"plw mermaid {root_arg} --depth 4 --focus {r}",
+                    }
+                    for r in sorted(
+                        rel_by_abs.values(),
+                        key=lambda r: -(
+                            int((node_meta.get(abs_by_rel[r]) or {}).get("fan_in", 0)) * 2
+                            + int((node_meta.get(abs_by_rel[r]) or {}).get("fan_out", 0))
+                        ),
+                    )[:5]
+                ],
+                "authority": _read_only_authority(),
+            }
+    else:
+        # Auto-select top hub/entrypoint file in repo
+        auto_selected = True
+        ranked_rels = sorted(
+            rel_by_abs.values(),
+            key=lambda r: -(
+                int((node_meta.get(abs_by_rel[r]) or {}).get("fan_in", 0)) * 2
+                + int((node_meta.get(abs_by_rel[r]) or {}).get("fan_out", 0))
+                + (15 if (node_meta.get(abs_by_rel[r]) or {}).get("is_entrypoint") else 0)
+            ),
+        )
+        target_rel = ranked_rels[0]
+
+    target_abs = all_rel_files[target_rel]
+    t_meta = node_meta.get(target_abs) or {}
+    outline_data = outline_querier(graph, target_abs) if callable(outline_querier) else {}
+    impact_data = impact_querier(graph, target_abs) if callable(impact_querier) else {}
+
+    decls = list(outline_data.get("declarations") or [])
+    decorators = list(outline_data.get("decorators") or [])
+    stats = dict(outline_data.get("stats") or {})
+    upstreams = [rel_fn(p) for p in (impact_data.get("direct_upstream") or [])]
+    downstreams = [rel_fn(p) for p in (impact_data.get("direct_downstream") or [])]
+    aff_eps = [rel_fn(p) for p in (impact_data.get("affected_entrypoints") or [])]
+    circ_refs = [rel_fn(p) for p in (impact_data.get("circular_references") or [])]
+    risk_level = str(impact_data.get("change_risk_level") or "unknown")
+
+    neighbor_cap = max(4, (max_nodes - 2) // 2)
+    shown_up = upstreams[:neighbor_cap]
+    shown_down = downstreams[:neighbor_cap]
+    shown_eps = [ep for ep in aff_eps if ep != target_rel and ep not in shown_down][:4]
+    shown_decls = decls[:10]
+
+    lines = [
+        f"flowchart {norm_dir}",
+        "    classDef target fill:#7c2d12,stroke:#f97316,stroke-width:3px,color:#ffedd5;",
+        "    classDef sym fill:#1e293b,stroke:#94a3b8,stroke-width:1px,color:#f8fafc;",
+        "    classDef upstream fill:#0f172a,stroke:#38bdf8,stroke-width:1.5px,color:#e0f2fe;",
+        "    classDef downstream fill:#064e3b,stroke:#34d399,stroke-width:1.5px,color:#d1fae5;",
+        "    classDef entrypoint fill:#3b0764,stroke:#c084fc,stroke-width:2px,color:#f3e8ff;",
+    ]
+
+    lines.append(f'    subgraph TARGET_BOX ["Focused Target: {mermaid_escape(target_rel)}"]')
+    t_lines = stats.get("total_lines", t_meta.get("lines", "?"))
+    t_fi = impact_data.get("target_fan_in", t_meta.get("fan_in", 0))
+    t_fo = impact_data.get("target_fan_out", t_meta.get("fan_out", 0))
+    dec_str = f"\\ndecorators: {mermaid_escape(', '.join(decorators[:3]))}" if decorators else ""
+    t_lbl = (
+        f"[TARGET] {mermaid_escape(os.path.basename(target_rel))}\\n"
+        f"lines={t_lines} | in={t_fi} out={t_fo} | risk={mermaid_escape(risk_level)}{dec_str}"
+    )
+    lines.append(f'        T0["{t_lbl}"]:::target')
+    for idx, d in enumerate(shown_decls):
+        sid = f"SYM{idx}"
+        kind = mermaid_escape(d.get("kind", "symbol"))
+        name = mermaid_escape(d.get("name", "?"))
+        lineno = d.get("line", "?")
+        exp_tag = " [export]" if d.get("exported") else ""
+        lines.append(f'        {sid}["{kind}: {name} (L{lineno}){exp_tag}"]:::sym')
+        lines.append(f"        T0 --- {sid}")
+    lines.append("    end")
+
+    nodes_out = [{
+        "id": "T0",
+        "role": "target",
+        "file": target_rel,
+        "lines": t_lines,
+        "fan_in": t_fi,
+        "fan_out": t_fo,
+        "change_risk_level": risk_level,
+        "declarations_count": len(decls),
+        "declarations_preview": shown_decls,
+    }]
+    edges_out = []
+
+    if shown_up:
+        lines.append(f'    subgraph UPSTREAM ["Direct Dependencies Imported by Target ({len(shown_up)}/{len(upstreams)})"]')
+        for idx, u_rel in enumerate(shown_up):
+            uid = f"U{idx}"
+            lines.append(f'        {uid}["{mermaid_escape(os.path.basename(u_rel))}\\n{mermaid_escape(os.path.dirname(u_rel))}"]:::upstream')
+            u_abs = all_rel_files.get(u_rel, "")
+            nat = edge_natures.get(f"{target_abs} -> {u_abs}", "runtime")
+            if u_rel in circ_refs:
+                lines.append(f'        T0 <-->|"cycle ({nat})"| {uid}')
+            elif nat == "same_package":
+                lines.append(f"        T0 -. same_pkg .-> {uid}")
+            elif nat == "type_only":
+                lines.append(f"        T0 -. type .-> {uid}")
+            else:
+                lines.append(f"        T0 -->|imports| {uid}")
+            nodes_out.append({"id": uid, "role": "direct_upstream", "file": u_rel})
+            edges_out.append({"from": target_rel, "to": u_rel, "relation": "imports", "nature": nat})
+        lines.append("    end")
+
+    if shown_down:
+        lines.append(f'    subgraph DOWNSTREAM ["Direct Dependents Importing Target ({len(shown_down)}/{len(downstreams)})"]')
+        for idx, d_rel in enumerate(shown_down):
+            did = f"D{idx}"
+            lines.append(f'        {did}["{mermaid_escape(os.path.basename(d_rel))}\\n{mermaid_escape(os.path.dirname(d_rel))}"]:::downstream')
+            d_abs = all_rel_files.get(d_rel, "")
+            nat = edge_natures.get(f"{d_abs} -> {target_abs}", "runtime")
+            if d_rel in circ_refs:
+                lines.append(f'        {did} <-->|"cycle ({nat})"| T0')
+            elif nat == "same_package":
+                lines.append(f"        {did} -. same_pkg .-> T0")
+            elif nat == "type_only":
+                lines.append(f"        {did} -. type .-> T0")
+            else:
+                lines.append(f"        {did} -->|imports| T0")
+            nodes_out.append({"id": did, "role": "direct_downstream", "file": d_rel})
+            edges_out.append({"from": d_rel, "to": target_rel, "relation": "imported_by", "nature": nat})
+        lines.append("    end")
+
+    if shown_eps:
+        lines.append('    subgraph ENTRYPOINTS ["Affected Entrypoints (Transitive Blast Radius)"]')
+        for idx, ep_rel in enumerate(shown_eps):
+            eid = f"EP{idx}"
+            lines.append(f'        {eid}["[ENTRYPOINT] {mermaid_escape(os.path.basename(ep_rel))}\\n{mermaid_escape(os.path.dirname(ep_rel))}"]:::entrypoint')
+            lines.append(f"        {eid} -. reaches .-> T0")
+            nodes_out.append({"id": eid, "role": "affected_entrypoint", "file": ep_rel})
+            edges_out.append({"from": ep_rel, "to": target_rel, "relation": "reaches_transitively"})
+        lines.append("    end")
+
+    zoom_hints = []
+    seen_hint_rels: set = set()
+    for n_rel in (shown_down[:4] + shown_up[:4]):
+        if n_rel in seen_hint_rels or len(seen_hint_rels) >= 5:
+            continue
+        seen_hint_rels.add(n_rel)
+        zoom_hints.append({
+            "target": n_rel,
+            "target_kind": "neighbor_file",
+            "reason": f"Pivot micro-neighborhood to connected file {os.path.basename(n_rel)}",
+            "command": f"plw mermaid {root_arg} --depth 4 --focus {n_rel}",
+        })
+    zoom_hints.append({
+        "target": target_rel,
+        "target_kind": "impact_projection",
+        "reason": "Run full transitive topological impact projection on this target",
+        "command": f"plw impact {target_rel} {root_arg} --json",
+    })
+
+    return {
+        "schema_version": "1.0.0-mermaid-graph",
+        "mode": "mermaid",
+        "decision": "MERMAID_GRAPH_READY",
+        "scan_root": scan_root,
+        "graph_signature": graph_sig,
+        "depth": 4,
+        "depth_name": MERMAID_DEPTH_NAMES[4],
+        "direction": norm_dir,
+        "focus": target_rel,
+        "requested_focus": focus,
+        "auto_selected_focus": auto_selected,
+        "include_tests": bool(include_tests),
+        "summary": {
+            "target_file": target_rel,
+            "lines": t_lines,
+            "declarations_count": len(decls),
+            "direct_upstream_count": len(upstreams),
+            "direct_downstream_count": len(downstreams),
+            "affected_entrypoints_count": len(aff_eps),
+            "circular_references_count": len(circ_refs),
+            "change_risk_level": risk_level,
+            "rendered_nodes": len(nodes_out),
+            "rendered_edges": len(edges_out),
+        },
+        "mermaid_source": "\n".join(lines),
+        "nodes": nodes_out,
+        "edges": edges_out,
+        "next_zoom_hints": zoom_hints,
+        "authority": _read_only_authority(),
+    }
