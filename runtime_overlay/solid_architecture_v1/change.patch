+            focus=focus,
+            focus_norm=focus_norm,
+            max_nodes=max_nodes,
+            include_tests=include_tests,
+            inv=inv,
+            vertices=vertices,
+            raw_edges=raw_edges,
+            edge_natures=edge_natures,
+            node_meta=node_meta,
+            active_abs=active_abs,
+            active_set=active_set,
+            rel_by_abs=rel_by_abs,
+            trie=trie,
+            sccs=sccs,
+        )
+
+    if depth == 2:
+        return _render_depth_2_modules(
+            scan_root=scan_root,
+            root_arg=root_arg,
+            graph_sig=graph_sig,
+            norm_dir=norm_dir,
+            focus=focus,
+            focus_norm=focus_norm,
+            max_nodes=max_nodes,
+            include_tests=include_tests,
+            inv=inv,
+            vertices=vertices,
+            raw_edges=raw_edges,
+            edge_natures=edge_natures,
+            node_meta=node_meta,
+            active_abs=active_abs,
+            active_set=active_set,
+            rel_by_abs=rel_by_abs,
+            abs_by_rel=abs_by_rel,
+            trie=trie,
+        )
+
+    if depth == 3:
+        return _render_depth_3_files(
+            scan_root=scan_root,
+            root_arg=root_arg,
+            graph_sig=graph_sig,
+            norm_dir=norm_dir,
+            focus=focus,
+            focus_norm=focus_norm,
+            max_nodes=max_nodes,
+            include_tests=include_tests,
+            inv=inv,
+            vertices=vertices,
+            raw_edges=raw_edges,
+            edge_natures=edge_natures,
+            node_meta=node_meta,
+            active_abs=active_abs,
+            active_set=active_set,
+            rel_by_abs=rel_by_abs,
+            abs_by_rel=abs_by_rel,
+            trie=trie,
+            cyclic_files=cyclic_files,
+        )
+
+    return _render_depth_4_neighborhood(
+        scan_root=scan_root,
+        root_arg=root_arg,
+        graph=graph,
+        graph_sig=graph_sig,
+        norm_dir=norm_dir,
+        focus=focus,
