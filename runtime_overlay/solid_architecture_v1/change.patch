+def _render_depth_1_subsystems(
+    *,
+    scan_root: str,
+    root_arg: str,
+    graph_sig: Any,
+    norm_dir: str,
+    focus: Optional[str],
+    focus_norm: str,
+    max_nodes: int,
+    include_tests: bool,
+    inv: Dict[str, Any],
+    vertices: List[str],
+    raw_edges: List[Any],
+    edge_natures: Dict[str, str],
+    node_meta: Dict[str, Dict[str, Any]],
+    active_abs: List[str],
+    active_set: set,
