+def _cache_dir_supported(binary: Path, cache_dir: Path) -> bool:
+    """Probe whether the engine accepts --cache-dir (G9).
+
+    Runs ``--version`` with the flag: new engines answer 0, engines
+    that predate the flag exit non-zero. Never raises: any failure —
+    non-zero exit, timeout, or spawn error — means 'not supported',
+    and the engine is used without the flag (its pre-G9 behaviour).
+    The query itself still fail-closes if the engine is genuinely
+    broken. Raising here would break minimal engines that only answer
+    a bare ``--version`` (the G6 V6 stub: ``$1`` is ``--cache-dir``,
+    not ``--version``) and timeout stubs (G6 V7: the probe would burn
+    the full version timeout before the query ever runs).
+    """
+    try:
+        proc = subprocess.run(
+            [str(binary), "--cache-dir", str(cache_dir), "--version"],
+            check=False,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            timeout=PROBE_TIMEOUT_S,
+            shell=False,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return False
+    return proc.returncode == 0
+
