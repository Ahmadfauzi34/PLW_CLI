+def default_cache_dir() -> Path:
+    """Where the engine's gob index lives under PLW's control (G9).
+
+    PLW's own cache root (``PLW_CACHE_HOME`` / ``PLW_HOME`` / XDG /
+    ``$HOME/.cache``), segment ``codebase/codesearch`` — the same root
+    the graph cache uses, so the index is state PLW owns, not a hidden
+    directory the engine chose on its own.
+    """
+    return Path(cache_path("codebase", "codesearch"))
