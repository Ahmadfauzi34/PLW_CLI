+def resolve_cache_dir(explicit: Optional[str] = None) -> Path:
+    """Cache-dir precedence (G9): explicit flag > CODESEARCH_CACHE_DIR
+    env > PLW default. The resolved dir is passed to the engine with
+    ``--cache-dir`` on every invocation, so the engine never falls
+    back to its standalone default while running under PLW.
+    """
+    if explicit:
+        return Path(explicit).expanduser().resolve()
+    env = os.environ.get("CODESEARCH_CACHE_DIR")
+    if env:
+        return Path(env).expanduser().resolve()
+    return default_cache_dir()
+
