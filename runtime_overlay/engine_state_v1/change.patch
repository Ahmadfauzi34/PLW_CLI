+def run_index_command(
+    operation: str,
+    root: Path,
+    binary: Path,
+    discovered_via: str,
+    timeout_s: int,
+    cache_dir: Optional[str] = None,
+) -> Dict[str, Any]:
+    """One index command end to end (G9): status, warm, or clean.
+
+    The engine check runs first; an engine that predates index
+    management is refused here with a plain message (fail-closed),
+    instead of letting the unknown flag surface as a generic exit-2
+    error. The envelope is the ``run_query`` envelope with
+    ``mode: "index"`` and an ``"operation"`` key, so callers read the
+    status JSON from ``engine_result`` exactly as they read query
+    results.
+    """
+    if operation not in ("status", "warm", "clean"):
+        raise EngineError(f"unknown index operation: {operation}")
+    engine = engine_status(binary, discovered_via, cache_dir)
+    if not engine["cache_dir_supported"]:
+        raise EngineError(
+            "codesearch engine predates index management "
+            f"(--index-{operation} needs a newer codesearch-go build)"
+        )
+    result = _run_codesearch(
+        binary, root, [f"--index-{operation}"], timeout_s,
+        Path(str(engine["cache_dir"])), True,
+    )
+    out = envelope("index", root, operation, engine, result)
+    out["operation"] = operation
+    return out
