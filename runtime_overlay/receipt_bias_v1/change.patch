+def _load_receipt_arg(value):
+    """Parse a --receipt value (JSON string or @path). Raises ValueError."""
+    raw = value
+    if value.startswith("@"):
+        raw = Path(value[1:]).read_text(encoding="utf-8")
+    data = json.loads(raw)
+    if not isinstance(data, dict):
+        raise ValueError("--receipt must be a JSON object")
+    return data
+
+
+def _receipt_arg_error(message, code="receipt_mismatch"):
+    print(json.dumps({"error": code, "detail": message}, ensure_ascii=False))
+    return 3
+
+
+def _validate_task_receipt(stage, task, scan_root, receipt):
+    """Check a previous stage's receipt against this invocation.
+
+    Returns None when the receipt chains here, else an error string.
+    """
+    if not isinstance(receipt, dict):
+        return "receipt must be a JSON object"
+    if receipt.get("schema_version") != hott_kernel._TASK_RECEIPT_SCHEMA:
+        return "receipt schema_version must be %s" % hott_kernel._TASK_RECEIPT_SCHEMA
+    prev_stage = receipt.get("stage")
+    allowed, _ = hott_kernel._TASK_PIPELINE[stage]
+    if prev_stage not in allowed:
+        return "stage %s cannot follow receipt stage %s (expected one of: %s)" % (
+            stage, prev_stage, ", ".join(allowed),
+        )
+    if receipt.get("task") != task:
+        return "receipt task %r does not match this task %r" % (receipt.get("task"), task)
+    prev_root = receipt.get("scan_root")
+    if prev_root is not None and scan_root is not None:
+        if os.path.abspath(prev_root) != os.path.abspath(scan_root):
+            return "receipt scan_root %r does not match this root %r" % (prev_root, scan_root)
+    expect = hott_kernel._task_receipt_fingerprint(prev_stage, receipt.get("task") or "", prev_root)
+    if receipt.get("fingerprint") != expect:
+        return "receipt fingerprint does not match its stage/task/root"
+    return None
+
+
+def _check_receipt_arg(value, stage, task, scan_root):
+    """Validate a --receipt value for a stage. Returns an exit code or None."""
+    if value is None:
+        return None
+    try:
+        receipt = _load_receipt_arg(value)
+    except (OSError, json.JSONDecodeError, ValueError) as exc:
+        print("[PLW Error] --receipt unreadable: %s" % exc, file=sys.stderr)
+        return 2
+    err = _validate_task_receipt(stage, task, scan_root, receipt)
+    if err is not None:
+        return _receipt_arg_error(err)
+    return None
+
+
+def _receipt_next_lines(result):
+    """Human-form lines for a result carrying receipt+next."""
+    lines = []
+    receipt = result.get("receipt") or {}
+    if receipt.get("fingerprint"):
+        lines.append("# Receipt: %s %s (task=%s, root=%s)" % (
+            receipt.get("stage"), str(receipt.get("fingerprint"))[:19],
+            receipt.get("task"), receipt.get("scan_root"),
+        ))
+    nxt = result.get("next")
+    if nxt:
+        lines.append("# Next: %s %s" % (nxt["command"], " ".join(nxt["args"])))
+    else:
+        lines.append("# Next: pipeline complete — no further stage.")
+    return lines
+
