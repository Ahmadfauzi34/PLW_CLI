+# --- Task-pipeline receipts (B2-remainder: receipt bias) -------------------
+# Every task-routing stage issues a receipt and names the next stage, so an
+# agent can see the receipt exists and carry it forward. The next stage
+# accepts --receipt and validates it (task + stage order + root). Receipts
+# are deterministic (no timestamp): fingerprint = sha256 of
+# stage + "\n" + task + "\n" + (scan_root or "").
+
+_TASK_RECEIPT_SCHEMA = "plw-task-receipt-v1"
+
+# stage -> (allowed previous stages, next stage or None)
+_TASK_PIPELINE = {
+    "orient": ((), "resolve-target"),
+    "work": ((), "resolve-target"),
+    "resolve-target": (("orient", "work", "semantic-route"), "evidence-needs"),
+    "evidence-needs": (("resolve-target",), "capability-match"),
+    "capability-match": (("evidence-needs",), "candidate-select"),
+    "candidate-select": (("capability-match",), None),
+    "candidate-capability-match": (("capability-match",), None),
+    "semantic-route": (("orient", "work"), "resolve-target"),
+}
+
+_TASK_RECEIPT_COMMANDS = {
+    "orient": "plw agent orient",
+    "work": "plw work",
+    "resolve-target": "plw resolve-target",
+    "evidence-needs": "plw evidence-needs",
+    "capability-match": "plw capability-match",
+    "candidate-select": "plw candidate select",
+    "candidate-capability-match": "plw candidate capability-match",
+    "semantic-route": "plw semantic route",
+}
+
+
+def _task_receipt_fingerprint(stage, task, scan_root):
+    material = stage + "\n" + task + "\n" + (scan_root or "")
+    return "sha256:" + hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def _task_receipt(stage, task, scan_root):
+    return {
+        "schema_version": _TASK_RECEIPT_SCHEMA,
+        "stage": stage,
+        "task": task,
+        "scan_root": scan_root,
+        "fingerprint": _task_receipt_fingerprint(stage, task, scan_root),
+    }
+
+
+def _task_next(stage, task, scan_root):
+    nxt = _TASK_PIPELINE[stage][1]
+    if nxt is None:
+        return None
+    cmd = _TASK_RECEIPT_COMMANDS[nxt]
+    args = [task] if scan_root is None else [task, scan_root]
+    return {"command": cmd, "args": args, "stage": nxt}
+
+
+def _attach_task_receipt(result, stage, task, scan_root):
+    """Add receipt+next to a successful stage result (new dict)."""
+    if not isinstance(result, dict) or result.get("error"):
+        return result
+    out = dict(result)
+    out["receipt"] = _task_receipt(stage, task, scan_root)
+    out["next"] = _task_next(stage, task, scan_root)
+    return out
+
+
