+            counter_name = counter_match.group(0)
+            bound_match = re.search(
+                rf"\b{re.escape(counter_name)}\b\s*(?:<=?|>=?)\s*(\d+|[A-Z][A-Z0-9_]+)\b",
+                cond_clean,
+            )
+            if bound_match and _is_small_retry_bound(bound_match.group(1)):
+                return True
