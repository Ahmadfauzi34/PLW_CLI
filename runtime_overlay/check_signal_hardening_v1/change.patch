+def _extract_paren_call_and_args(
+    text: str,
+    open_paren_idx: int,
+    max_chars: int = 4096,
+) -> Tuple[str, List[str]]:
+    """Extract balanced `(...)` call substring and top-level comma arguments."""
+    if open_paren_idx < 0 or open_paren_idx >= len(text) or text[open_paren_idx] != "(":
+        return "", []
+    limit = min(len(text), open_paren_idx + max_chars)
+    paren_depth = 0
+    brace_depth = 0
+    bracket_depth = 0
+    quote: Optional[str] = None
+    escaped = False
+    args: List[str] = []
+    arg_start = open_paren_idx + 1
+
+    for idx in range(open_paren_idx, limit):
+        ch = text[idx]
+        if quote is not None:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == quote:
+                quote = None
+            continue
+        if ch in ("'", '"', "`"):
+            quote = ch
+            continue
+        if ch == "(":
+            paren_depth += 1
+        elif ch == ")":
+            paren_depth -= 1
+            if paren_depth == 0:
+                last_arg = text[arg_start:idx].strip()
+                if last_arg or args:
+                    args.append(last_arg)
+                return text[open_paren_idx : idx + 1], args
+        elif paren_depth == 1:
+            if ch == "{":
+                brace_depth += 1
+            elif ch == "}":
+                brace_depth = max(0, brace_depth - 1)
+            elif ch == "[":
+                bracket_depth += 1
+            elif ch == "]":
+                bracket_depth = max(0, bracket_depth - 1)
+            elif ch == "," and brace_depth == 0 and bracket_depth == 0:
+                args.append(text[arg_start:idx].strip())
+                arg_start = idx + 1
+    return text[open_paren_idx:limit], args
+
+
+def _brace_depth_at(content: str, pos: int) -> int:
+    """Compute `{` minus `}` depth before character index *pos*, skipping strings."""
+    depth = 0
+    quote: Optional[str] = None
+    escaped = False
+    for ch in content[:pos]:
+        if quote is not None:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == quote:
+                quote = None
+            continue
+        if ch in ("'", '"', "`"):
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth = max(0, depth - 1)
+    return depth
+
+
+def _is_non_escaping_local_container(
+    content: str,
+    var_name: str,
+    *,
+    is_member: bool = False,
+) -> bool:
+    """Return True when *var_name* is declared inside a function/method block and does not escape."""
+    if is_member or not var_name:
+        return False
+    decl_re = re.compile(
+        rf"(?:^|[;{{\n])\s*((?:const|let|var)\s+{re.escape(var_name)}\b"
+        rf"(?:\s*:[^=;\n]+)?\s*=\s*new\s+(?:Map|Set|WeakMap|WeakSet)\b)",
+        re.MULTILINE,
+    )
+    decls = list(decl_re.finditer(content))
+    if not decls:
+        return False
+    if any(_brace_depth_at(content, match.start(1)) == 0 for match in decls):
+        return False
+    if re.search(rf"\bexport\b[^\n;]*\b{re.escape(var_name)}\b", content):
+        return False
+    for ret_match in re.finditer(r"\breturn\b([^;\n]*)", content):
+        ret_expr = ret_match.group(1)
+        if re.search(
+            rf"\b{re.escape(var_name)}\b(?!\s*\.(?:has|get|set|delete|clear|size|keys|values|entries|forEach)\b)",
+            ret_expr,
+        ):
+            return False
+    if re.search(rf"[\w$.\]]+\s*=\s*{re.escape(var_name)}\s*(?:[;,\n]|$)", content):
+        return False
+    return True
+
+
+def _has_cache_eviction_guard(content: str, var_name: str, is_member: bool) -> bool:
+    """Return True when *content* bounds *var_name* by size and deletes/clears entries."""
+    target_pat = rf"(?:this\.)?{re.escape(var_name)}" if is_member else re.escape(var_name)
+    has_size_bound = bool(re.search(
+        rf"\b{target_pat}\s*\.\s*size\s*(?:>=|>|<=|<|===?|!==?)\s*[\w$.]+|"
+        rf"[\w$.]+\s*(?:<=|<|>=|>)\s*{target_pat}\s*\.\s*size\b",
+        content,
+    ))
+    if not has_size_bound:
+        return False
+    return bool(re.search(rf"\b{target_pat}\s*\.\s*(?:delete|clear)\s*\(", content))
+
