+def _is_bounded_retry_loop(lines: List[str], header_idx: int, end_idx: int) -> bool:
+    """Return True when the enclosing loop is a small bounded retry loop."""
+    header_clean = _strip_strings(lines[header_idx]).strip()
+    block_clean = _strip_strings("\n".join(lines[header_idx : end_idx + 1]))
+
+    for_match = _FOR_CLAUSE_REGEX.match(header_clean)
+    if for_match:
+        init_clause, cond_clause, update_clause = (
+            for_match.group(1),
+            for_match.group(2),
+            for_match.group(3),
+        )
+        counter_match = (
+            _RETRY_COUNTER_NAME_REGEX.search(init_clause)
+            or _RETRY_COUNTER_NAME_REGEX.search(cond_clause)
+            or _RETRY_COUNTER_NAME_REGEX.search(update_clause)
+        )
+        if counter_match:
+            counter_name = counter_match.group(0)
+            cond_clean = cond_clause.strip()
+            if cond_clean:
+                if ".length" in cond_clean:
+                    return False
+                bound_match = re.search(
+                    rf"\b{re.escape(counter_name)}\b\s*(<=?|>=?|!==?)\s*(\d+|[A-Z][A-Z0-9_]+)\b|"
+                    rf"\b(\d+|[A-Z][A-Z0-9_]+)\s*(<=?|>=?)\s*\b{re.escape(counter_name)}\b",
+                    cond_clean,
+                )
+                if bound_match:
+                    limit_tok = bound_match.group(2) or bound_match.group(3)
+                    if limit_tok and _is_small_retry_bound(limit_tok):
+                        return True
+            else:
+                # Pattern: `for (let attempt = 0; ; attempt++) { ... if (... || attempt === 2) throw ...; }`
+                body_bound = re.search(
+                    rf"\b{re.escape(counter_name)}\b\s*(===?|>=?|<=|<)\s*(\d+|[A-Z][A-Z0-9_]+)\b",
+                    block_clean,
+                )
+                has_exit = bool(re.search(r"\b(?:break|throw|return)\b", block_clean))
+                if body_bound and has_exit and _is_small_retry_bound(body_bound.group(2)):
                     return True
+
+        # Generic small numeric try/catch retry loop (e.g. `for (let i = 0; i < 3; i++) { try { ... break; } catch {} }`)
+        small_loop = re.search(
+            r"(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*([01])\s*;\s*"
+            r"\1\s*(<=?)\s*(\d+)\s*;",
+            header_clean,
+        )
+        if small_loop and re.search(r"\bcatch\b", block_clean) and re.search(
+            r"\b(?:break|throw|return)\b", block_clean
+        ):
+            start_val = int(small_loop.group(2))
+            op = small_loop.group(3)
+            limit_val = int(small_loop.group(4))
+            iterations = (limit_val - start_val) + (1 if op == "<=" else 0)
+            if 1 <= iterations <= 5:
+                return True
+        return False
+
+    while_match = _WHILE_CLAUSE_REGEX.match(header_clean)
