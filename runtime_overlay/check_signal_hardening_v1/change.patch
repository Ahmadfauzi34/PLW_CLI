+def _is_small_retry_bound(limit_token: str) -> bool:
+    if limit_token.isdigit():
+        return int(limit_token) <= 10
+    # Uppercase constant such as ATTEMPTS / MAX_RETRIES
+    return bool(re.match(r"^[A-Z][A-Z0-9_]+$", limit_token))
