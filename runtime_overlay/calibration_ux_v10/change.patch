+def _is_sequential_or_stream_await(
+    lines: List[str], header_idx: int, end_idx: int, line_idx: int, line: str
+) -> bool:
+    """Return True when an await inside a loop is inherently sequential (stream read, serial executor, or state reducer)."""
+    if re.search(r"\bawait\s+[\w$.]+\.(?:read|next|shift)\s*\(", line):
+        return True
+    if re.search(r"\bexecuteToolsSerial\b|\bexecutePhase\b", line):
+        return True
+    header_clean = _strip_strings(lines[header_idx]).strip()
+    block_clean = _strip_strings("\n".join(lines[header_idx : end_idx + 1]))
+    # Enclosing function explicitly named *Serial / *Sequential
+    fn_window = "\n".join(lines[max(0, header_idx - 8) : header_idx + 1])
+    if re.search(r"\basync\s+\w*(?:Serial|Sequential)\w*\s*\(", fn_window):
+        return True
+    # State-threading pipeline loop: `for (const step of this.steps) { const res = await step(current); ... current = res.value; }`
+    m_call = re.search(r"\bawait\s+[\w$.]+\(\s*([A-Za-z_$][\w$]*)\s*[,)]", line)
+    if m_call:
+        state_var = m_call.group(1)
+        if re.search(rf"\b{re.escape(state_var)}\s*=", block_clean):
+            return True
+    if re.search(r"\bfor\s+await\s*\(", "\n".join(lines[max(0, line_idx - 40) : line_idx + 1])):
+        return True
+    return False
