+def _blank_multiline_template_literals(content: str) -> str:
+    """Blank contents of multi-line JS/TS backtick template literals while preserving newlines and single-line quote safety."""
+    if "`" not in content:
+        return content
+    out: List[str] = []
+    n = len(content)
+    i = 0
+    while i < n:
+        ch = content[i]
+        if ch in ('"', "'"):
+            quote = ch
+            out.append(ch)
+            i += 1
+            while i < n:
+                c = content[i]
+                out.append(c)
+                i += 1
+                if c == "\\" and i < n:
+                    out.append(content[i])
+                    i += 1
+                elif c == quote or c == "\n":
+                    break
+        elif ch == "`":
+            start = i
+            i += 1
+            while i < n:
+                c = content[i]
+                i += 1
+                if c == "\\" and i < n:
+                    i += 1
+                elif c == "`":
+                    break
+            segment = content[start:i]
+            if "\n" in segment:
+                out.append("`" + ("\n" * segment.count("\n")) + "`")
+            else:
+                out.append(segment)
+        else:
+            out.append(ch)
+            i += 1
+    return "".join(out)
+
